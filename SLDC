  function adicionarListenerCheckboxes() {
    const matTable = document.querySelector('mat-table');
    if (!matTable) return;

    matTable.querySelectorAll('input[type="checkbox"]').forEach(cb => {
      if (cb.dataset.autonomoListener === '1') return;
