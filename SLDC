        verificarSeOpcoesSelecionadasSaoProcessaveis(componenteOriginalSIGEO) {

            let creenciadosSaudeSelecionados = this.obterRegistrosSelecionadosCredenciadosSaudePJ();
            let alugueisSelecionados = this.obterRegistrosSelecionadosAlugueis();
            let manutençõesPrediaisSelecionadas = this.obterRegistrosSelecionadosManutençãoPredial();

            let credenciadosSaude = creenciadosSaudeSelecionados.length > 0;
            let aluguel = alugueisSelecionados.length > 0;
            let manutencaoPredial = manutençõesPrediaisSelecionadas.length > 0;

            if (credenciadosSaude) {
                let botaoExistente = this.document.querySelector("#sigeo-botao-processar-credenciados-saude");
                if (!botaoExistente) {
                    logDebug(`Adicionando botão de credenciados de saúde após detectar ${creenciadosSaudeSelecionados.lenght} credenciados de saúde selecionados.`);
                    let botaoCredenciadosSaude = this.criarBotaoProcessarCredenciadosSaude();
                    this.adicionarBotaoProximoComponenteExportarCSVDoSIGEO(botaoCredenciadosSaude, componenteOriginalSIGEO);
                }
                else {
                    logDebug('Botão já existente.')
                }
                credenciadosSaudePJSelecionados = creenciadosSaudeSelecionados;
            }
            else {
                credenciadosSaudePJSelecionados.length = 0;
            }

            if (aluguel) {
                let botaoExistente = this.document.querySelector("#sigeo-botao-processar-alugueis");
                if (!botaoExistente) {
                    let botaoAlugueis = this.criarBotaoProcessarAlugueis();
                    this.adicionarBotaoProximoComponenteExportarCSVDoSIGEO(botaoAlugueis, componenteOriginalSIGEO);
                }
                else {
                    logDebug('Botão já existente.')
                }
                locatariosAlugueisSelecionados = alugueisSelecionados;
            }
            else {
                locatariosAlugueisSelecionados.length = 0;
            }

            if (manutencaoPredial) {
                let botaoExistente = this.document.querySelector("#sigeo-botao-processar-manutenção-predial");

                if (!botaoExistente) {
                    let botaoManutençãoPredial = this.criarBotaoProcessarManutençãoPredial();
                    this.adicionarBotaoProximoComponenteExportarCSVDoSIGEO(botaoManutençãoPredial, componenteOriginalSIGEO);
                }
                else {
                    logDebug('Botão já existente.');
                }
                manutencoesPredenciaisSelecionadas = manutençõesPrediaisSelecionadas;
            }
            else {
                manutencoesPredenciaisSelecionadas.length = 0;
            }

            let servicosSelecionadosAgora = this.obterRegistrosSelecionadosServicos();
            let temServicos = servicosSelecionadosAgora.length > 0;
            if (temServicos) {
                let botaoExistente = this.document.querySelector("#sigeo-botao-processar-servicos");
