                padding: 2px 6px; font-size: 12px; color: #1e3a5f;
                background: white; cursor: pointer;
            `;

            // Opção padrão
            const optTodos = this.document.createElement('option');
            optTodos.value = '';
            optTodos.textContent = 'Todos';
            select.appendChild(optTodos);

            // Opção para sem responsável
            const optSem = this.document.createElement('option');
            optSem.value = '__sem__';
            optSem.textContent = 'Sem responsável';
            select.appendChild(optSem);

            // Nomes ordenados
            [...nomes].sort().forEach(nome => {
                const opt = this.document.createElement('option');
                opt.value = nome;
                opt.textContent = nome;
                select.appendChild(opt);
            });

            const contador = this.document.createElement('span');
