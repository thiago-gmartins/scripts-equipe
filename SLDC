  function bgTextoSelect(el) {
    if (!el) return '';
    const trigger = el.querySelector(
      '.mat-select-value-text span, .mat-mdc-select-value-text span, ' +
      '.mat-select-value-text, .mat-mdc-select-value-text'
    );
    if (trigger && trigger.textContent.trim()) return trigger.textContent.trim();
    const reflected = el.getAttribute('ng-reflect-value') || '';
    if (reflected.trim()) return reflected.trim();
    if (el.tagName === 'SELECT' && el.selectedIndex >= 0) {
      return el.options[el.selectedIndex]?.text?.trim() || '';
    }
    return '';
  }

  function bgCalcularCodigoIRRF(tipoAtividade, servidorFederal, situacao) {
    const tipo = String(tipoAtividade || '').toLowerCase().trim();
    const servidor = String(servidorFederal || '').toLowerCase().trim();
    const sit = String(situacao || '').toLowerCase().trim();

    // Código 1: Encargo de curso ou concurso + servidor federal Sim + NÃO inativo
    if (/encargo\s*de\s*curso\s*ou\s*concurso/i.test(tipo) && /sim/i.test(servidor) && !/inativo/i.test(sit)) {
      return '1';
    }
    // Código 2: Encargo de curso ou concurso + servidor federal Não
    if (/encargo\s*de\s*curso\s*ou\s*concurso/i.test(tipo) && /n[aã]o/i.test(servidor)) {
      return '2';
    }
    // Código 3: Prestador de serviço OU Encargo de curso/concurso + servidor federal Sim + Inativo
    if (/prestador\s*de\s*servi[cç]o/i.test(tipo)) {
      return '3';
    }
    if (/encargo\s*de\s*curso\s*ou\s*concurso/i.test(tipo) && /sim/i.test(servidor) && /inativo/i.test(sit)) {
      return '3';
    }

    return '';
  }

  function bgColetarCamposParametros(scope, win) {
    // modal = scope inteiro — a busca por formcontrolname filtra os campos corretos
    const modal = scope;

    // Diagnóstico: lista TODOS os formcontrolnames do modal para confirmar quais estão disponíveis
    const todosSelects = Array.from(modal.querySelectorAll('mat-select, select'));
    autonomosLog(`bgColetarCamposParametros: ${todosSelects.length} selects no modal:`);
    todosSelects.forEach((el, i) => {
      const fc = el.getAttribute('formcontrolname') || el.getAttribute('ng-reflect-name') || '(sem fc)';
      autonomosLog(`  [${i}] fc="${fc}" texto="${bgTextoSelect(el)}"`);
    });

    const empenhoPatronalMarcado = bgCheckboxPossuiEmpenhoPatronal(scope);
    const empenhoPatronal = empenhoPatronalMarcado
      ? bgLerCampoCodigoNotaEmpenho(scope)
      : '';

    // Lê por formcontrolname — único método confiável em iframe oculto
    // (visibilidade não funciona pois getBoundingClientRect retorna zero no iframe fora de tela)
    const tipoAtividade    = bgLerSelectPorFormControl(modal, 'tipoAtividade');
    const servidorFederal  = bgLerSelectPorFormControl(modal, 'ehServidorFederal');
    const situacao         = bgLerSelectPorFormControl(modal, 'situacao');
    const codigoIRRF       = bgCalcularCodigoIRRF(tipoAtividade, servidorFederal, situacao);

    return {
      possuiEmpenhoPatronal: empenhoPatronalMarcado,
      empenhoPatronal: String(empenhoPatronal || '').trim(),
      tipoAtividade,
      servidorFederal,
      situacao,
      codigoIRRF
    };
  }

  function bgCamposValidos(campos) {
    if (campos.possuiEmpenhoPatronal && !campos.empenhoPatronal) return false;
    // Aguarda até que tipoAtividade esteja preenchido (indica que a aba carregou)
    if (!campos.tipoAtividade) return false;
    return true;
  }

  async function bgEsperarCamposParametros(scope, win) {
    const inicio = Date.now();
    let ultimo = bgColetarCamposParametros(scope, win);

    while (Date.now() - inicio < TEMPO_ESPERA_CAMPOS) {
      const atual = bgColetarCamposParametros(scope, win);
      ultimo = atual;
      if (bgCamposValidos(atual)) return atual;
      await sleep(160);
    }

    return ultimo;
  }

  function bgObterBotaoListaNotas(modal, win) {
    const candidatos = Array.from(modal.querySelectorAll('[title], [aria-label], button, mat-icon, .mat-icon, [role="button"], div, span'))
      ;

    let alvo = candidatos.find(el => {
      const ref = [
        bgTexto(el),
        el.getAttribute?.('aria-label') || '',
        el.getAttribute?.('title') || '',
        el.getAttribute?.('mattooltip') || ''
      ].join(' ');
      return /Lista de notas de empenho/i.test(ref);
    });

    if (alvo) return alvo;

    const modalRect = modal.getBoundingClientRect();
    const cantoSuperiorDireito = candidatos
      .map(el => ({ el, rect: el.getBoundingClientRect() }))
      .filter(item =>
        item.rect.top >= modalRect.top &&
        item.rect.top <= modalRect.top + 120 &&
        item.rect.left >= modalRect.right - 260 &&
        item.rect.right <= modalRect.right + 5
      )
      .sort((a, b) => a.rect.left - b.rect.left);

    return cantoSuperiorDireito[0]?.el || null;
  }

  async function bgAbrirPopupNotas(modal, doc, win) {
    const alvo = bgObterBotaoListaNotas(modal, win);
    if (!alvo) return null;

    bgClick(win, alvo);
    await sleep(450);

    return await bgEsperar(() => {
      const dialogs = Array.from(doc.querySelectorAll('mat-dialog-container, .cdk-overlay-pane, .mat-dialog-container'))
        ;

      return dialogs.find(el => /Notas de Empenho/i.test(bgTexto(el))) ||
        dialogs.find(el => /Número|Data Emissão|Descrição|Valor/i.test(bgTexto(el))) ||
        null;
    }, 9000, 120);
  }

  function bgLerEmpenhosNoPopup(popup) {
    const encontrados = [];
    const vistos = new Set();

    const rows = Array.from(popup.querySelectorAll('mat-row, tr'));
    for (const row of rows) {
      const lista = extrairEmpenhosTexto(bgTexto(row));
      for (const emp of lista) {
        if (!vistos.has(emp)) {
          vistos.add(emp);
          encontrados.push(emp);
        }
      }
    }

    if (!encontrados.length) {
      const listaGeral = extrairEmpenhosTexto(popup.innerText || '');
      for (const emp of listaGeral) {
        if (!vistos.has(emp)) {
          vistos.add(emp);
          encontrados.push(emp);
        }
      }
    }

    return encontrados;
  }

