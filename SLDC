    /**
     * Extrai CNPJ, número e data de emissão do registro SIGEO para consulta ao Sheets.
     */
    function extrairChaveNFDoRegistro(registro) {
        if (!registro) return null;

        // Campos confirmados pela inspeção do objeto real do SIGEO:
        const cnpjRaw      = registro?.fornecedor?.documento || '';
        const numeroNFRaw  = registro?.numero                || '';
        const dataEmissaoRaw = registro?.dataEmissao         || '';

        if (!cnpjRaw || !numeroNFRaw || !dataEmissaoRaw) {
            console.warn('[SIGEO×Sheets] Campos insuficientes. Chaves:', JSON.stringify(Object.keys(registro || {})), '| cnpj=', cnpjRaw, '| nf=', numeroNFRaw, '| data=', dataEmissaoRaw, '| registro completo=', JSON.stringify(registro));
            return null;
        }

        const cnpj    = String(cnpjRaw).replace(/\D/g, '').padStart(14, '0');
        const numeroNF = String(numeroNFRaw).trim();

        let dataEmissao = '';
        const sData = String(dataEmissaoRaw).trim();
        const mISO  = sData.match(/^(\d{4})-(\d{2})-(\d{2})/);
        const mBR   = sData.match(/^(\d{2})\/(\d{2})\/(\d{4})/);
        if (mISO) {
            dataEmissao = `${mISO[1]}-${mISO[2]}-${mISO[3]}`;
        } else if (mBR) {
            dataEmissao = `${mBR[3]}-${mBR[2]}-${mBR[1]}`;
        } else {
            try {
                const d = new Date(dataEmissaoRaw);
                if (!isNaN(d)) dataEmissao = d.toISOString().split('T')[0];
            } catch (_) {}
        }

        if (!dataEmissao) {
            console.warn('[SIGEO×Sheets] Não foi possível normalizar a data:', dataEmissaoRaw);
            return null;
        }

        return { cnpj, numeroNF, dataEmissao };
    }

