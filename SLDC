    async function exibirModalServicos() {
        const unimed = documentosProcessados.filter(documentoEUnimed);
        const demais = documentosProcessados.filter(d => !documentoEUnimed(d));
        const mercadoriaDocs = demais.filter(d => d.destinoPlanilha === 'mercadoria');
        const servicosDocs = demais.filter(d => d.destinoPlanilha !== 'mercadoria');

        const linhasUnimed = unimed.map(montarLinhaUnimed);
        const linhasServicos = servicosDocs.map(montarLinhaServicos);
        const linhasMercadoria = mercadoriaDocs.map(montarLinhaServicos);

        if (documentosProcessados.length === 0) {
            montarModalSaida({
                id: 'modal-servicos-sigeo',
                titulo: '🔧 Documentos processados de Serviços',
                secoesHtml: '<mat-card>ℹ️ Nenhum documento de serviços.</mat-card>'
            });
            return;
        }

        let secoes = '';
        if (linhasUnimed.length) {
            secoes += montarTabelaSaida(COLUNAS_UNIMED, linhasUnimed, {
                idCopiar: 'copiar-tudo-unimed', titulo: '🏥 Unimed'
            });
        }
        if (linhasServicos.length) {
            secoes += montarTabelaSaida(COLUNAS_SERVICOS, linhasServicos, {
                idCopiar: 'copiar-tudo-servicos',
                titulo: linhasUnimed.length || linhasMercadoria.length ? '🔧 Serviços' : '',
                textoCopiar: '📋 Copiar para planilha — 1 colagem',
                notaCopia: 'Cole uma única vez a partir de “Responsável pela Análise”. O robô coloca o analista e, logo depois, Viviane Renata como conferente. Antes desse ponto ficam apenas os campos que não vêm do robô.',
                exibirStatus: true
            });
        }
        if (linhasMercadoria.length) {
            secoes += montarTabelaSaida(COLUNAS_SERVICOS, linhasMercadoria, {
                idCopiar: 'copiar-tudo-mercadoria-processada',
                titulo: '📦 Água / Correios / Energia / Mercadoria / Telefonia',
                textoCopiar: '📋 Copiar para planilha — 1 colagem',
                notaCopia: 'Cole uma única vez a partir de “Responsável pela Análise”. O robô coloca o analista e, logo depois, Viviane Renata como conferente. O bloco é contínuo, de I até AE; a última assinatura do TRD entra em Data Recbto Definitivo (R).'
            });
        }

        montarModalSaida({ id: 'modal-servicos-sigeo', titulo: '🔧 Documentos processados', secoesHtml: secoes });

        if (linhasUnimed.length) ligarBotaoCopiar('copiar-tudo-unimed', linhasUnimed);
        if (linhasServicos.length) {
            ligarBotaoColagemPlanilha('copiar-tudo-servicos', servicosDocs, 'servicos');
        }
        if (linhasMercadoria.length) {
            ligarBotaoColagemPlanilha('copiar-tudo-mercadoria-processada', mercadoriaDocs, 'mercadoria');
        }
        ligarBotoesVisualizacao([...linhasUnimed, ...linhasServicos, ...linhasMercadoria]);
    }

