  function obterEmpenhoRapido(registro) {
    const candidatos = [
      registro?.empenho,
      registro?.numeroEmpenho,
      registro?.notaEmpenho,
      registro?.codigoNotaEmpenho,
      registro?.contratacao?.empenho,
      registro?.contratacao?.numeroEmpenho,
      registro?.contratacao?.notaEmpenho,
      registro?.contratacao?.codigoNotaEmpenho
    ];

    for (const c of candidatos) {
      const val = normalizarNumeroEmpenho(String(c || '').trim());
      if (val) return val;
    }

    return '';
  }

  /**
   * Wrapper com retry para obterDadosContratacaoViaBackground.
   * Tenta até MAX_TENTATIVAS vezes. Se falhar, faz reset do iframe e tenta de novo.
   * Retorna o melhor resultado obtido (mesmo que parcial).
   */
  async function obterDadosContratacaoComRetry(registro, iframeCtx, maxTentativas = 3) {
    const cpfCnpj = obterCnpjCpfBase(registro);
    const proad   = obterProadBase(registro);

    for (let tentativa = 1; tentativa <= maxTentativas; tentativa++) {
      autonomosLog(`🔁 Contratação tentativa ${tentativa}/${maxTentativas} — PROAD: ${proad}`);

      // Na 2ª tentativa em diante, reseta o iframe antes de tentar
      if (tentativa > 1 && iframeCtx) {
        autonomosLog('⚠️ Tentativa anterior falhou. Resetando iframe antes de nova tentativa...');
        await bgResetarEstadoIframe(iframeCtx.doc, iframeCtx.win);
        await sleep(500 * tentativa); // espera progressiva
      }

      const resultado = await obterDadosContratacaoViaBackground(registro, iframeCtx);

      // Considera sucesso se tiver ao menos empenho ou codigoIRRF
      const temDados = !!(resultado.empenho || resultado.codigoIRRF || resultado.tipoAtividade);
      if (temDados) {
        autonomosLog(`✅ Dados obtidos na tentativa ${tentativa}.`);
        return resultado;
      }

      autonomosLog(`⚠️ Tentativa ${tentativa} sem dados úteis (empenho/IRRF vazios).`);
    }

    autonomosWarn(`❌ Todas as ${maxTentativas} tentativas falharam para PROAD: ${proad}`);
    return { empenho: '', empenhoPatronal: '' };
  }

  async function obterDadosContratacaoViaBackground(registro, iframeCtx = null) {
    const cpfCnpj = obterCnpjCpfBase(registro);
    const proad = obterProadBase(registro);

    autonomosLog('CPF/CNPJ base:', cpfCnpj);
    autonomosLog('PROAD base:', proad);

    if (!cpfCnpj || !proad) {
      return { empenho: '', empenhoPatronal: '' };
    }

    // Se recebemos um iframe já pronto (lote), reutilizamos sem recriar
    const _reutilizando = !!(iframeCtx);
    let host = null;

    try {
      let doc, win;

      if (iframeCtx) {
        // Reutiliza o iframe compartilhado do lote
        doc = iframeCtx.doc;
        win = iframeCtx.win;
        autonomosLog('♻️ Reutilizando iframe compartilhado.');
        // Reset: fecha modais do documento anterior antes de começar o próximo
        await bgResetarEstadoIframe(doc, win);
      } else {
        // Fluxo individual: cria e aguarda iframe próprio
        const criado = criarHostBackground();
        host = criado.host;
        const iframe = criado.iframe;

        const pronto = await esperarIframePronto(iframe);
        if (!pronto) {
          autonomosWarn('Iframe background não ficou pronto.');
          return { empenho: '', empenhoPatronal: '' };
        }
        doc = pronto.doc;
        win = pronto.win;
      }

      autonomosLog('bgFlow: abrindo filtro...');
      if (!await bgAbrirFiltro(doc, win)) {
        autonomosWarn('Não abriu filtro em background.');
        return { empenho: '', empenhoPatronal: '' };
      }
      autonomosLog('bgFlow: filtro aberto. Preenchendo CPF/CNPJ:', cpfCnpj);

      if (!await bgPreencherCpfCnpj(doc, win, cpfCnpj)) {
        autonomosWarn('Não preencheu CPF/CNPJ em background.');
        return { empenho: '', empenhoPatronal: '' };
      }
      autonomosLog('bgFlow: CPF/CNPJ preenchido. Aplicando filtro...');

      if (!await bgAplicarFiltro(doc, win)) {
        autonomosWarn('Não aplicou filtro em background.');
        return { empenho: '', empenhoPatronal: '' };
      }
      autonomosLog('bgFlow: filtro aplicado. Aguardando tabela carregar...');

      // Aguarda a tabela aparecer após o filtro ser aplicado
      await bgEsperar(() => {
        const rows = doc.querySelectorAll('mat-row');
        return rows.length > 0 ? true : null;
      }, 8000, 150);
      await sleep(300);

      autonomosLog('bgFlow: tabela carregada. Expandindo pageSize...');

      // Expande pageSize para garantir que todos os PROADs apareçam sem paginação
      await bgForcarPageSize(doc, win);

      // Aguarda a tabela recarregar com o novo pageSize antes de buscar o PROAD
      // (sem isso, o PROAD pode não estar visível ainda)
      await bgEsperar(() => {
        const rows = doc.querySelectorAll('mat-row');
        return rows.length > 0 ? true : null;
      }, 5000, 150);
      await sleep(400); // pausa extra para o Angular terminar de renderizar

      // Diagnóstico: mostrar quantas linhas existem e seus textos
      const todasLinhas = Array.from(doc.querySelectorAll('mat-row, tr'));
      autonomosLog(`bgFlow: buscando PROAD "${proad}" em ${todasLinhas.length} linhas`);
      todasLinhas.slice(0, 5).forEach((r, i) => {
        autonomosLog(`  linha[${i}]: "${bgTexto(r).substring(0, 80)}"`);
      });

      // Busca o PROAD na página atual; se não achar, caminha pelas páginas
      // seguintes (essencial quando bgForcarPageSize falha ou o fornecedor
      // tem mais contratações do que cabe numa página).
      let linha = await bgEsperar(() => bgLocalizarLinhaPorProad(doc, proad), 2500, 120);

      const MAX_PAGINAS = 15;
      let paginaAtual = 1;
      while (!linha && paginaAtual < MAX_PAGINAS) {
        const avancou = await bgAvancarPaginaContratacoes(doc, win);
        if (!avancou) break; // não há próxima página (ou botão não encontrado)
        paginaAtual++;
        autonomosLog(`bgFlow: PROAD não estava na página anterior; buscando na página ${paginaAtual}...`);
        linha = bgLocalizarLinhaPorProad(doc, proad);
      }

      if (!linha) {
        autonomosWarn(`Não encontrou linha da contratação em background (varridas ${paginaAtual} página(s)).`);
        // Diagnóstico extra: mostrar todos os PROADs visíveis
        const linhasAtuais = Array.from(doc.querySelectorAll('mat-row, tr'));
        autonomosWarn(`Linhas disponíveis (${linhasAtuais.length}):`);
        linhasAtuais.forEach((r, i) => autonomosWarn(`  [${i}]: "${bgTexto(r).substring(0, 100)}"`));
        return { empenho: '', empenhoPatronal: '' };
      }
      autonomosLog('bgFlow: linha encontrada!');

      const modal = await bgAbrirModalEdicao(doc, win, linha);
      if (!modal) {
        autonomosWarn('Modal de edição não abriu em background.');
        return { empenho: '', empenhoPatronal: '' };
      }

      if (!await bgAbrirAbaParametros(modal, win)) {
        autonomosWarn('Aba parâmetros não abriu em background.');
        return { empenho: '', empenhoPatronal: '' };
      }

      const campos = await bgEsperarCamposParametros(modal, win);
      const empenhoDoCampo = normalizarNumeroEmpenho(campos.empenhoPatronal || '');

      const popup = await bgAbrirPopupNotas(modal, doc, win);
      const empenhosPopup = popup ? bgLerEmpenhosNoPopup(popup) : [];

      const listaFinal = [];
      const vistos = new Set();

      if (empenhoDoCampo) {
        vistos.add(empenhoDoCampo);
        listaFinal.push(empenhoDoCampo);
      }

      for (const emp of empenhosPopup) {
        if (emp && !vistos.has(emp)) {
          vistos.add(emp);
          listaFinal.push(emp);
        }
      }

      let empenhoPatronal = '';
      let empenho = '';

      if (listaFinal.length >= 2) {
        empenhoPatronal = listaFinal[0];
        empenho = listaFinal[1];
      } else if (listaFinal.length === 1) {
        empenho = listaFinal[0];
        empenhoPatronal = '';
      }

      autonomosLog('lista final de empenhos:', listaFinal);
      autonomosLog('empenho principal:', empenho);
      autonomosLog('empenho patronal:', empenhoPatronal);
      autonomosLog('tipoAtividade:', campos.tipoAtividade);
      autonomosLog('servidorFederal:', campos.servidorFederal);
      autonomosLog('situacao:', campos.situacao);
      autonomosLog('codigoIRRF:', campos.codigoIRRF);

      if (popup) {
        bgFecharDialogPorTexto(doc, win, /^fechar$/i);
        await sleep(120);
      }

      bgFecharDialogPorTexto(doc, win, /^cancelar$/i);
      await sleep(120);

      // Se estamos reutilizando o iframe, fecha também o modal de filtro
      // caso ainda esteja aberto, para não contaminar o próximo documento
      if (_reutilizando) {
        bgFecharDialogPorTexto(doc, win, /^fechar$/i);
        bgFecharDialogPorTexto(doc, win, /^cancelar$/i);
        await sleep(150);
      }

      return {
        empenho,
        empenhoPatronal: empenhoPatronal || '',
        tipoAtividade: campos.tipoAtividade || '',
        servidorFederal: campos.servidorFederal || '',
        situacao: campos.situacao || '',
        codigoIRRF: campos.codigoIRRF || ''
      };
    } catch (error) {
      autonomosErr('Erro no background:', error);
      return { empenho: '', empenhoPatronal: '' };
    } finally {
      // Só destrói o iframe se ele foi criado por esta chamada (não compartilhado)
      if (!_reutilizando && host) destruirHostBackground();
    }
  }

