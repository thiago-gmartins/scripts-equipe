                if (pdfIconOverlay) linhaInfo.botoes.pdf = pdfIconOverlay.closest("button");
                if (xmlIconOverlay) linhaInfo.botoes.xml = xmlIconOverlay.closest("button");
            }
        }

        // ========== PASSO 3: BAIXAR XML E PDF ==========
        if (!documento.xml || !documento.pdf) {
            logDebug('[SIGEO Script] [3/3] Baixando documentos...');
        }

        const idNF = registroSelecionado?.notaFiscalServico?.id;

        if (idNF && !documento.xml) {
            let dadosXML = await capturarXMLNotaFiscal(idNF, BEARER_TOKEN);
            if (dadosXML) { documento.xml = dadosXML; documento.fontes.push('xml'); logDebug('[SIGEO Script] ✓ XML capturado via API', documento.xml); }
            else { console.warn('[SIGEO Script] XML não disponível para id=' + idNF); }
        }

        if (idNF && !documento.pdf) {
            let dadosPDF = await capturarPDFNotaFiscal(idNF, BEARER_TOKEN);
            if (dadosPDF) { documento.pdf = dadosPDF; documento.pdfTexto = dadosPDF.textoCompleto; documento.fontes.push('pdf'); logDebug('[SIGEO Script] ✓ PDF capturado via API id=' + idNF); }
            else { console.warn('[SIGEO Script] PDF não disponível para id=' + idNF); }
