    function obterPrimeiraNaturezaRendimento(registro) {
        let naturezasRendimento = registro?.naturezasRendimento;

        if (naturezasRendimento) {
            if (Array.isArray(naturezasRendimento) && naturezasRendimento.length > 0) return naturezasRendimento[0];
            if (typeof naturezasRendimento === 'object') {
                const valores = Object.values(naturezasRendimento);
                if (valores.length > 0) return valores[0];
            }
        }

        return null;
    }


    function obterCodigoNaturezaRendimento(registro) {
        let item = obterPrimeiraNaturezaRendimento(registro);

        if (item) {
            return item.naturezaRendimento.id;
        }
        else {
            logDebug(`Recebido natureza de rendimento que não é um array para recuperar a descrição da natureza de rendimento.`, registro);
        }

        return '';
    }

    function obterNaturezaRendimento(registro) {
        let item = obterPrimeiraNaturezaRendimento(registro);

        if (item) {
            let descricao = `${item.naturezaRendimento.id} - ${item.naturezaRendimento.descricao}`;
            return descricao;
        }
        else {
            logDebug(`Recebido natureza de rendimento que não é um array para recuperar a descrição da natureza de rendimento.`, registro);
        }

        return '';
    }

    function obterValorBrutoNaturezaRendimento(registro) {
        let naturezaRendimento = obterPrimeiraNaturezaRendimento(registro);

        if (naturezaRendimento) {
            let valor = `R$ ${Formatacao.formatarValorBrasileiro(naturezaRendimento.baseCalculo)}`;
            return valor;
        }
        else {
            logDebug(`Recebido natureza de rendimento que não é um array para recuperar a o valor bruto da natureza de rendimento.`, registro);
        }

        return '';
    }

