  async function bgForcarPageSize(doc, win) {
    // Tenta expandir a quantidade de registros por página para 100.
    // Seletores cobrem Angular Material clássico e MDC; verifica se a
    // expansão de fato aconteceu (não confia só no clique).
    try {
      const linhasAntes = doc.querySelectorAll('mat-row, tbody tr').length;

      const seletorPageSize =
        doc.querySelector('mat-paginator mat-select') ||
        doc.querySelector('.mat-paginator-page-size mat-select') ||
        doc.querySelector('.mat-mdc-paginator-page-size mat-select') ||
        doc.querySelector('mat-select[aria-label*="página"], mat-select[aria-label*="page"], mat-select[formcontrolname*="pageSize"], mat-select[ng-reflect-value]');

      if (!seletorPageSize) {
        autonomosWarn('bgForcarPageSize: paginador não encontrado — seguirá com paginação manual.');
        return false;
      }

      bgClick(win, seletorPageSize);
      await sleep(400);
      const opcoes = Array.from(doc.querySelectorAll('mat-option'));
      // Prefere 100; se não tiver, pega o maior valor disponível
      const opcao100 = opcoes.find(el => bgTexto(el) === '100');
      const maiorOpcao = opcoes.reduce((max, el) => {
        const v = parseInt(bgTexto(el), 10);
        return v > (parseInt(bgTexto(max), 10) || 0) ? el : max;
      }, opcoes[0]);
      const alvo = opcao100 || maiorOpcao;
      if (!alvo) {
        autonomosWarn('bgForcarPageSize: nenhuma opção de pageSize encontrada.');
        return false;
      }

      bgClick(win, alvo);
      await sleep(800);

      // Verificação: a tabela recarregou com mais linhas (ou já cabia em 1 página)?
      const linhasDepois = doc.querySelectorAll('mat-row, tbody tr').length;
      const expandiu = linhasDepois > linhasAntes;
      autonomosLog(`bgForcarPageSize: pageSize solicitado=${bgTexto(alvo)}, linhas ${linhasAntes}→${linhasDepois}`);
      if (!expandiu && linhasAntes >= 5) {
        autonomosWarn('bgForcarPageSize: expansão não surtiu efeito — seguirá com paginação manual.');
      }
      return expandiu;
    } catch (e) {
      autonomosWarn('bgForcarPageSize: erro ao tentar expandir pageSize', e);
      return false;
    }
  }

