  async function processarLinhaAutonomo(registroSelecionado, indice, iframeCtx = null) {
    const documento = {
      uuid: crypto.randomUUID(),
      indice: indice + 1,
      status: 'processando',
      pdf: null,
      pdfTexto: null,
      fontes: [],
      ...registroSelecionado
    };

    try {
      const [dadosPDF, atestes, dadosContratacao, dadosBancarios] = await Promise.all([
        capturarPDFRPA(registroSelecionado.id, BEARER_TOKEN),
        capturarAtestes(registroSelecionado.id, BEARER_TOKEN),
        iframeCtx ? obterDadosContratacaoComRetry(registroSelecionado, iframeCtx) : obterDadosContratacaoViaBackground(registroSelecionado, null),
        obterDadosBancariosAutonomo(registroSelecionado)
      ]);

      if (dadosPDF) {
        documento.pdf = dadosPDF;
        documento.pdfTexto = dadosPDF.textoCompleto;
        documento.fontes.push('pdf');
      }

      documento.registrosAtestes = atestes;

      if (atestes.length > 0) {
        documento.ateste = { ...atestes[0] };
        documento.dataAteste = atestes[0].data || '';
      }

      documento.empenhoPatronal = dadosContratacao.empenhoPatronal || '';
      documento.empenho = dadosContratacao.empenho || obterEmpenhoRapido(registroSelecionado);
      documento.tipoAtividade    = dadosContratacao.tipoAtividade    || '';
      documento.servidorFederal  = dadosContratacao.servidorFederal  || '';
      documento.situacaoContratacao = dadosContratacao.situacao      || '';
      documento.codigoIRRF       = dadosContratacao.codigoIRRF       || '';

      // Dados bancários pelo mesmo endpoint da saúde (primeira conta ativa),
      // com fallback automático para os dados da contratação.
      documento.bancoCalculado = dadosBancarios.banco;
      documento.agenciaCalculada = dadosBancarios.agencia;
      documento.contaCalculada = dadosBancarios.conta;

      documento.numeroDocumentoCalculado =
        registroSelecionado?.numero ||
        registroSelecionado?.numeroDocumento ||
        registroSelecionado?.documentoFiscalNumero ||
        '';

      documento.cpfCalculado =
        somenteNumeros(registroSelecionado?.fornecedor?.documento) ||
        somenteNumeros(documento?.pdf?.cpf) ||
        '';

      documento.nomeFornecedorCalculado =
        registroSelecionado?.__nomeFornecedorTela ||
        registroSelecionado?.fornecedor?.nome ||
        registroSelecionado?.fornecedor?.razaoSocial ||
        registroSelecionado?.fornecedor?.nomeFantasia ||
        '';

      const valorRegistro = Number(registroSelecionado?.valor || 0);
      const valorPdf = Number(documento?.pdf?.valor || 0);

      documento.valorDocumentoCalculado =
        valorRegistro > 0 ? valorRegistro : valorPdf;

      documento.dataEmissaoCalculada =
        documento?.pdf?.dataEmissao ||
        registroSelecionado?.dataEmissao ||
        '';

      documento.status = documento.fontes.length > 0 ? 'sucesso' : 'parcial';
    } catch (error) {
      autonomosErr('Erro ao processar linha:', error);
      documento.status = 'erro';
      documento.erro = error.message;
    }

    return documento;
  }

  async function processarLoteAutonomos() {
    if (!BEARER_TOKEN) {
      alert('Não consegui capturar o token do SIGEO ainda. Recarregue a tela de Documentos Fiscais e tente novamente.');
      return;
    }

    autonomosSelecionados = obterRegistrosSelecionadosAutonomos();
    if (!autonomosSelecionados.length) {
      alert('Nenhum documento RPA selecionado.');
      return;
    }

    documentosProcessados = [];
    mostrarModalProgresso(`Preparando ${autonomosSelecionados.length} documento(s)...`);

    // ── Iframe compartilhado ────────────────────────────────────────────────
    // Cria o iframe UMA vez para todo o lote. Isso evita recriação e espera
    // do Angular a cada documento, que é a principal causa de instabilidade.
    let iframeCompartilhado = null;
    if (autonomosSelecionados.length > 0) {
      atualizarModalProgresso('Carregando tela de contratações...');
      try {
        const criado = criarHostBackground();
        iframeCompartilhado = await esperarIframePronto(criado.iframe);
        if (iframeCompartilhado) {
          autonomosLog('✅ Iframe compartilhado pronto para o lote.');
        } else {
          autonomosWarn('⚠️ Iframe não ficou pronto. Processamento continuará sem contratação.');
        }
      } catch (e) {
        autonomosWarn('Erro ao criar iframe compartilhado:', e);
      }
    }

    try {
      for (let i = 0; i < autonomosSelecionados.length; i++) {
        atualizarModalProgresso(`Processando ${i + 1} de ${autonomosSelecionados.length}...`);
        const doc = await processarLinhaAutonomo(autonomosSelecionados[i], i, iframeCompartilhado);
        documentosProcessados.push(doc);
        // Pausa entre documentos — maior conforme o tamanho do lote
        if (i < autonomosSelecionados.length - 1) {
          const pausa = autonomosSelecionados.length > 10 ? 600 : 300;
          await sleep(pausa);
        }
      }

      fecharModalProgresso();
      exibirModalAutonomos();
    } catch (e) {
      fecharModalProgresso();
      autonomosErr('Erro no lote:', e);
      alert(`Erro ao processar lote de autônomos: ${e.message}`);
    } finally {
      destruirHostBackground();
    }
  }

  function gerarTextoCopia(documentos) {
    const linhas = documentos.map(doc => {
      const cc = _centroCustosPartes(doc);
      return [
        doc.codigoIRRF || '',
        doc.nomeFornecedorCalculado || '',
        somenteNumeros(doc.cpfCalculado),
        String((doc?.contratacao?.processoAdministrativo || doc?.processoAdministrativo || doc?.proad || '').replace('PROAD', '').trim()),
        doc.numeroDocumentoCalculado || '',
        FormatacaoAutonomos.formatarValorBrasileiro(doc.valorDocumentoCalculado),
        FormatacaoAutonomos.formatarDataBrasileira(doc.dataEmissaoCalculada),
        FormatacaoAutonomos.formatarDataBrasileira(doc.dataAteste || ''),
        doc.empenho || '',
        doc.bancoCalculado || '',
        doc.agenciaCalculada || '',
        doc.contaCalculada || '',
        formatarPercentual2(cc.percentual),
        _formatarValorCentroCusto(cc.v1, cc.temDados),
        _formatarValorCentroCusto(cc.v2, cc.temDados)
      ].join('\t');
    });

    return linhas.join('\n');
  }

