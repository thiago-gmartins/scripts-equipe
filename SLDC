        const notaCopiaHtml = opcoes.notaCopia
            ? `<div style="margin-top:7px;font-size:12px;color:#555;">${escaparHtml(opcoes.notaCopia)}</div>` : '';

        const exibirStatus = !!opcoes.exibirStatus;
        const thStatus = exibirStatus
            ? '<th class="mat-header-cell cdk-header-cell" style="position:sticky;left:0;z-index:4;background:white;min-width:112px;">Status</th>'
            : '';
        const theadPadrao = `
            <tr class="mat-header-row cdk-header-row">
                ${thStatus}
                ${colunas.map(c => `<th class="mat-header-cell cdk-header-cell">${escaparHtml(c)}</th>`).join('')}
                <th class="mat-header-cell cdk-header-cell">Ações</th>
            </tr>`;

        const corpo = linhas.map(l => {
            const tds = l.celulas.map(c => {
                const estilos = [];
                if (c.vermelho) estilos.push('color:#c62828;font-weight:800;box-shadow:inset 0 -3px 0 #c62828;');
                if (c.fundo) estilos.push(`background-color:${c.fundo};`);
                const attrTitulo = c.titulo ? ` title="${escaparAtributo(c.titulo)}"` : '';
                const attrEstilo = estilos.length ? ` style="${estilos.join('')}"` : '';
                return `<td class="mat-cell cdk-cell"${attrTitulo}${attrEstilo}>${c.html || escaparHtml(c.texto)}</td>`;
            }).join('');
            const status = l.statusVisual || _montarStatusConferencia();
            const corStatus = _corStatusLinha(status);
            const tdStatus = exibirStatus
                ? `<td class="mat-cell cdk-cell" style="position:sticky;left:0;z-index:2;background:white;border-left:5px solid ${corStatus};box-shadow:2px 0 4px rgba(0,0,0,.05);">${_htmlStatusConferencia(status)}</td>`
                : '';
            const fundoLinha = status.nivel === 'erro'
                ? 'background:linear-gradient(90deg,rgba(198,40,40,.055),rgba(255,255,255,0) 32%);'
                : status.nivel === 'alerta'
                    ? 'background:linear-gradient(90deg,rgba(249,168,37,.055),rgba(255,255,255,0) 32%);'
                    : '';
            return `
                <tr class="mat-row cdk-row" style="${fundoLinha}">${tdStatus}${tds}<td class="mat-cell cdk-cell">${_htmlBotoesDoc(l.doc)}</td></tr>
                <tr class="mat-row cdk-row" id="visualizacao-inline-${l.doc.uuid}" style="display:none;">
                    <td colspan="${colunas.length + 1 + (exibirStatus ? 1 : 0)}" style="padding:5px 1px;max-width:1px;width:100%" id="conteudo-visualizacao-${l.doc.uuid}"></td>
                </tr>`;
        }).join('');

        return `
            <section style="margin-bottom:24px;">
                <h3 style="margin:6px 0;">${escaparHtml(titulo)}${titulo ? ' — ' : ''}${total} documento${total > 1 ? 's' : ''}</h3>
                <button id="${idCopiar}" mat-raised-button="" color="accent"
                        class="mat-focus-indicator mat-raised-button mat-button-base mat-accent ng-star-inserted">
                    ${escaparHtml(textoCopiar)}
                </button>
                ${botoesExtrasHtml}
                ${notaCopiaHtml}
                <div style="overflow-x:auto;width:100%;">
                    <table class="mat-table cdk-table mat-elevation-z8 sigeo-tabela-saida"
                           style="margin-top:10px;width:max-content;border-collapse:collapse;">
                        <thead>${opcoes.theadHtml || theadPadrao}</thead>
                        <tbody>${corpo}</tbody>
                    </table>
                </div>
            </section>`;
    }

    function gerarCopiaTSV(linhas) {
        return linhas.map(l => (l.celulasCopia || l.celulas).map(c => c.texto).join('\t')).join('\n');
