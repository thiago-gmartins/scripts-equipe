        const norm = (cabecalho || []).map(_normalizarCabecalhoSheets);
        for (const alias of aliases) {
            const alvo = _normalizarCabecalhoSheets(alias);
            const idx = norm.findIndex(v => v === alvo);
            if (idx >= 0) return idx;
        }
        return -1;
    }

    function _mapearTabelaSheetsPorCabecalho(data, aliasesPorCampo) {
        const rows = data?.values || [];
        if (!rows.length) return { indices: {}, dados: [] };

        // Procura nas primeiras linhas uma linha que contenha os campos-chave.
        let idxCab = -1;
        let indices = {};
        const limite = Math.min(rows.length, 8);
        for (let r = 0; r < limite; r++) {
            const tentativa = {};
            for (const [campo, aliases] of Object.entries(aliasesPorCampo)) {
                tentativa[campo] = _indiceCabecalhoSheets(rows[r], aliases);
            }
            if (tentativa.cnpj >= 0 && tentativa.numeroNF >= 0 && tentativa.dataEmissao >= 0) {
                idxCab = r;
                indices = tentativa;
                break;
            }
        }
        if (idxCab < 0) {
            console.warn('[SIGEO×Sheets] Cabeçalho não reconhecido após reorganização das colunas.', rows.slice(0, limite));
            return { indices: {}, dados: [] };
        }
        return { indices, dados: rows.slice(idxCab + 1) };
    }

