        registroECredenciadoSaudePJ = (registro) => {
            if (!registro) {
                return false;
            }

            const TIPOS_DOCUMENTO_ACEITOS = ['NFS', 'NFe', 'NFSe'];

            const naoEhRPA = String(registro?.tipo || '').toUpperCase() !== 'RPA';
            const cadastroSaude = registro?.tipoCadastro?.id === 1
                || String(registro?.tipoCadastro?.nome || '').toLowerCase().trim() === 'credenciado de plano de saúde';

            return naoEhRPA && cadastroSaude;
        }

        registroEServico = (registro) => {
            if (!registro) return false;
            const tipo = String(registro?.tipo || '').toUpperCase();
            // Exclui RPA
            if (tipo === 'RPA') return false;
            // Exclui Credenciado Saúde PJ
            if (this.registroECredenciadoSaudePJ(registro)) return false;
            // Exclui Manutenção Predial
            if (this.registroÉManutençãoPredial(registro)) return false;
            // Exclui Aluguel
            if (this.registroEAluguel(registro)) return false;
            // Aceita NFSe, NFS, NFe, DDF e outros
            const TIPOS_ACEITOS = ['NFSE', 'NFS', 'NFE', 'DDF', 'NFE', 'AL'];
            return ['NFSE','NFS','NFE','DDF'].includes(tipo) || (!['RPA','AL'].includes(tipo));
        }

        registroEAluguel = (registro) => {
            if (!registro) {
                return false;
            }

            const TIPOS_DOCUMENTO_ACEITOS = ['AL'];

            let tipoDocFiscalAceito = TIPOS_DOCUMENTO_ACEITOS.includes(registro?.tipo);
            let cadastroAluguel = registro?.tipoCadastro?.id === 4 || String(registro?.tipoCadastro?.nome || '').toLowerCase().trim() === 'locador de imóveis';

            return tipoDocFiscalAceito && cadastroAluguel;
        }

        registroÉManutençãoPredial = (registro) => {
            if (!registro) {
                return false;
            }

            const TIPOS_DOCUMENTO_ACEITOS = ['NFS', 'NFe', 'NFSe', 'NFSE'];
            const CODIGOS_NATUREZA_RENDIMENTO_POSSIVEIS = [17003, 17004, 17099];
            const SIGLA_SETORES = ['SEGPRE', 'SENG'];
            const EXPRESSOES_OBJETO = ['Contratação continuada', 'Prestação de serviços', 'Manutenção predial'];

            let tipoDocFiscal = registro?.tipo;
            let codigosNaturezaRendimento = new Set(registro?.contratacao?.naturezasRendimento?.map(nr => nr.id));
            let setor = registro?.contratacao?.setor?.sigla || '';
            let objeto = registro?.contratacao?.objeto || '';

            let tipoDocFiscalAceito = TIPOS_DOCUMENTO_ACEITOS.includes(tipoDocFiscal);
