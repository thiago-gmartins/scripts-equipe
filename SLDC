    // Campos de TRD para os modais legados (montados em HTML direto).
    // Mesma informação das colunas dos módulos novos: sem validação, só traz.
    function _trdParaHtml(doc) {
        const t = doc?.trd;
        if (!t || !t.encontrado) {
            const motivo = t?.motivo || 'TRD não consultado';
            const attrs = ` style="background-color:${CORES.AMARELO_CLARO};"`
                + ` title="${escaparAtributo('TRD não localizado: ' + motivo)}"`;
            return {
                solicitacao: '', competencia: '', assinatura: '', documento: 'TRD não localizado',
                attrs, attrsSolicitacao: attrs
            };
        }

        const solicitacao = _pProc(t.solicitacaoProvidencia || '') || '';
        const detalhe = [
            solicitacao ? `Solicitação de Providência: ${solicitacao}${t.solicitacaoSituacao ? ` [${t.solicitacaoSituacao}]` : ''}` : '',
            t.ondeEstava ? `Encontrado em: ${t.ondeEstava}` : '',
            t.descricao || '',
            t.contrato ? `Contrato ${t.contrato}` : '',
            t.fornecedor || '',
            t.notas?.length ? `Nota(s) no TRD: ${t.notas.join(', ')}` : '',
            t.assinaturas?.length
                ? 'Assinaturas: ' + t.assinaturas.map(a => `${a.nome || '?'} (${a.data || 's/ data'})`).join(' · ')
                : '',
            t.avisoNota || '',
            t.avisoCnpj || ''
        ].filter(Boolean).join(' | ');
        const incerto = !!t.avisoNota || !!t.avisoCnpj || t.semTexto;
        const attrs = (incerto ? ` style="background-color:${CORES.AMARELO_CLARO};"` : '')
            + ` title="${escaparAtributo(detalhe)}"`;
        const attrsSolicitacao = solicitacao
            ? attrs
            : ` style="background-color:${CORES.AMARELO_CLARO};"`
                + ` title="${escaparAtributo('TRD localizado, mas a Solicitação de Providência referente à NF não foi identificada com segurança.')}"`;
        return {
            solicitacao: escaparHtml(solicitacao),
            competencia: escaparHtml(t.competencia || ''),
            assinatura: escaparHtml(t.ultimaAssinatura || ''),
            documento: escaparHtml(`DOC ${t.docNumero || '?'} @ ${t.proadConsultado || ''}`),
            attrs, attrsSolicitacao
        };
    }

