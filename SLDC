    function extrairDadosTextoReciboAluguel(texto) {
        let dados = {
            numero: '',
            cpfCnpj: '',
            dataEmissao: '',
            valor: '',
            textoCompleto: texto
        };

        // Regex para número do recibo de aluguel
        // Padrão observado: Nº 08000825AL0000073
        const regexNumero = /N[ºo]?\s*([0-9A-Z]+[A-Z]{0,2}[0-9]+)/i;
        const matchNumero = texto.match(regexNumero);
        if (matchNumero) {
            dados.numero = matchNumero[1];
        }

        // Regex para CPF/CNPJ
        // Formato: 12.345.678/0001-90 ou 12345678000190
        const regexCNPJ = /CPF\/CNPJ[\s:]*([\d.\-\/]{11,18})\b/i;
        const matchCNPJ = texto.match(regexCNPJ);
        if (matchCNPJ) {
            dados.cpfCnpj = matchCNPJ[1];
        }

        const regexDataEmissao = /Emitido\s+em:\s*(\d{2}\/\d{2}\/\d{4})/i;

        const matchDataEmissao = texto.match(regexDataEmissao);
        if (matchDataEmissao) {
            dados.dataEmissao = matchDataEmissao[1];
        }

        const regexValor = /(?:R?\$)\s*(\d{1,3}(?:[\.\s]\d{3})*(?:[.,]\d{2}))/i;

        const matchValor = texto.match(regexValor);
        if (matchValor) {
            dados.valor = matchValor[1]
                .replaceAll(/\./g, '')   // remove separadores de milhar
                .replace(',', '.');   // converte vírgula decimal para ponto
        }

        return dados;
    }
