    class ProcessamentoDocsFiscais {
        document;
        resultadoConsultaTabela;
        dadosConsultaTabelaDocsFiscais;
        urlPadraoTabela = '/sidof-service/documentosFiscais/jt';
        xhrOriginalInterceptado = false;
        bearerToken = null;

        constructor(documentJanela) {
            this.document = documentJanela;
        }

        interceptarConsultaDadosTabela() {
            // Evita interceptar múltiplas vezes
            if (this.xhrOriginalInterceptado) {
                logDebug('[SIGEO Script] XHR já interceptado anteriormente.');
                return;
            }

            const originalOpen = XMLHttpRequest.prototype.open;

            // Guardar os getters originais de TODAS as propriedades de resposta
            const originalGetters = {
                response: Object.getOwnPropertyDescriptor(XMLHttpRequest.prototype, 'response').get,
                responseText: Object.getOwnPropertyDescriptor(XMLHttpRequest.prototype, 'responseText').get,
                responseJSON: Object.getOwnPropertyDescriptor(XMLHttpRequest.prototype, 'responseJSON')?.get
            };

            let self = this;

            // Sobrescrever XMLHttpRequest.open
            XMLHttpRequest.prototype.open = function (method, url) {
                this._url = url;
                this._method = method;
                this._dadosFiltrados = null; // Armazenar dados filtrados aqui

                this.addEventListener('load', function () {
                    try {
                        // Captura dados da tabela base
                        if (typeof url === 'string' && url.includes(self.urlPadraoTabela) && this.status === 200) {
                            let dados = null;
                            if (this.getResponseHeader('content-type')?.includes('application/json')) {
                                dados = JSON.parse(this.responseText);
                            } else {
                                dados = this.responseText;
                            }

                            self.resultadoConsultaTabela = {
                                url: url,
                                status: this.status,
                                response: dados
                            };

                            self.dadosConsultaTabelaDocsFiscais = dados?.results;
                            window._sigeoUltimosDadosTabela = dados?.results;
                            window.dispatchEvent(new CustomEvent('_sigeoTabelaAtualizada', { detail: dados }));

                            logDebug('[SIGEO Script] ❇ Dados capturados da tabela base:', self.resultadoConsultaTabela);

                            self.controlarExibicaoBotoesRobo();
                        }
                    } catch (e) {
                        console.error('[SIGEO Script] Erro ao capturar/parsing XHR:', e);
                    }
                });
                return originalOpen.apply(this, arguments);
            };

            // Interceptar RESPONSE (principal)
            Object.defineProperty(XMLHttpRequest.prototype, 'response', {
                get: function () {
                    // Se tem dados filtrados, retornar eles
                    if (this._dadosFiltrados !== null && this._dadosFiltrados != undefined) {
                        logDebug('[SIGEO] 📦 Retornando response filtrado - this._dadosFiltrados != null', this._dadosFiltrados);
                        return this._dadosFiltrados;
                    }

                    const originalResponse = originalGetters.response.call(this);

                    // Verificar se é a URL da tabela e se precisa filtrar
                    if (this._url?.includes(self.urlPadraoTabela) &&
                        this.readyState === 4 &&
                        this.status === 200) {

                        try {
                            logDebug(`Analisando resposta...`);
                            let dados = null;

                            // Parse baseado no tipo
                            if (typeof originalResponse === 'string') {
                                dados = JSON.parse(originalResponse);
                            } else if (typeof originalResponse === 'object') {
                                dados = originalResponse;
                            }

                            // Aplicar filtro se necessário
                            if (dados?.results && FILTRO_ATESTE_ATUAL.filtroAplicado && (FILTRO_ATESTE_ATUAL?.dataAtesteInicio || FILTRO_ATESTE_ATUAL?.dataAtesteFim)) {
                                logDebug('[SIGEO] 🔍 Filtrando response - Total original:', dados.results.length);

                                const resultadosOriginais = [...dados.results]; // Backup

                                dados.results = self.filtrarPorDataAteste(
                                    dados.results,
                                    FILTRO_ATESTE_ATUAL.dataAtesteInicio,
                                    FILTRO_ATESTE_ATUAL.dataAtesteFim
                                );

                                logDebug('[SIGEO] ✅ Filtrado:', dados.results.length, 'de', resultadosOriginais.length);

                                let h2 = document.querySelector("h2");

                                if (h2) {
                                    h2.textContent = `Documentos Fiscais (${dados.results.length}/${resultadosOriginais.length})`;
                                }
                                // Armazenar dados filtrados
                                this._dadosFiltrados = dados;
                                self.dadosConsultaTabelaDocsFiscais = dados?.results;

                                return dados;
                            }
                        } catch (e) {
                            console.error('[SIGEO] Erro ao filtrar response:', e);
                        }
                    }

                    return originalResponse;
                },
                configurable: true
            });

            this.xhrOriginalInterceptado = true;
        }

        filtrarPorDataAteste(resultados, dataInicio, dataFim) {
            if (!dataInicio && !dataFim) {
                return resultados; // Sem filtro, retorna tudo
            }

            return resultados.filter(item => {
                // Verificar se o item tem dataAteste
                // Ajuste o nome do campo conforme sua API (pode ser dataAteste, data_ateste, etc.)
                const dataAteste = item.dataAteste || item.data_ateste || item.DataAteste;

                if (!dataAteste) {
                    // Se não tem data ateste, decidir se inclui ou não
                    // Opção 1: Excluir itens sem data ateste
                    return false;

                    // Opção 2: Incluir itens sem data ateste
                    // return true;
                }

                // Converter para Date para comparação
                const dataAtesteDate = this.parseData(dataAteste);

                // Filtrar por data início
                if (dataInicio) {
                    const dataInicioDate = new Date(`${dataInicio}T00:00:00-03:00`);
                    dataInicioDate.setHours(0, 0, 0, 0); // Início do dia

                    if (dataAtesteDate < dataInicioDate) {
                        return false; // Data ateste antes do início
                    }
                }

                // Filtrar por data fim
                if (dataFim) {
                    const dataFimDate = new Date(`${dataFim}T00:00:00-03:00`);
                    dataFimDate.setHours(23, 59, 59, 999); // Fim do dia

                    if (dataAtesteDate > dataFimDate) {
                        return false; // Data ateste depois do fim
                    }
                }

                return true; // Passou nos filtros
            });
        }

        // NOVA FUNÇÃO: Parse de data flexível
        parseData(data) {
            if (!data) return null;

            // Se já é Date
            if (data instanceof Date) {
                return data;
            }

            // Se é string no formato ISO (2025-11-18T10:30:00)
            if (typeof data === 'string') {
                // Formato ISO ou yyyy-mm-dd
                if (data.includes('T') || data.includes('-')) {
                    return new Date(data);
                }

                // Formato dd/mm/yyyy
                if (data.includes('/')) {
                    const [dia, mes, ano] = data.split('/');
                    return new Date(`${ano}-${mes}-${dia}`);
                }
            }

            // Tentar conversão direta
            return new Date(data);
        }

