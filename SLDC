  function iniciarMonitorDOM() {
    // ── Execução imediata ────────────────────────────────────────────────────
    // Se o Angular já renderizou as linhas antes deste módulo inicializar,
    // o MutationObserver nunca dispara. Por isso rodamos agora e em polling
    // rápido até as mat-row aparecerem, sem esperar nenhum evento.
    let _jaRodouComLinhas = false;
    const _pollDOM = setInterval(() => {
      const rows = document.querySelectorAll('mat-table mat-row');
      if (rows.length > 0) {
        clearInterval(_pollDOM);
        _jaRodouComLinhas = true;
        adicionarListenerCheckboxes();
        marcarLinhasAutonomo();
        controlarExibicaoBotoesAutonomo();
        autonomosLog('✅ iniciarMonitorDOM: linhas detectadas no poll, marcação executada.');
      }
    }, 50);

    // Para o poll após 15s para não ficar rodando para sempre
    setTimeout(() => clearInterval(_pollDOM), 15000);

    // ── MutationObserver: captura renderizações futuras (paginação, filtros) ─
    const observer = new MutationObserver(() => {
      adicionarListenerCheckboxes();
      marcarLinhasAutonomo();
      controlarExibicaoBotoesAutonomo();
    });

    if (document.body) {
      observer.observe(document.body, { childList: true, subtree: true });
    } else {
      document.addEventListener('DOMContentLoaded', () => {
        observer.observe(document.body, { childList: true, subtree: true });
      });
    }

    // ── Segurança: re-aplica a cada 3s ──────────────────────────────────────
    setInterval(() => {
      adicionarListenerCheckboxes();
      controlarExibicaoBotoesAutonomo();
    }, 3000);
  }

  async function capturarAtestes(idDocumentoFiscal, tokenBearer) {
    const url = `https://api.sigeo.jt.jus.br${URL_ATESTES}?idDocumentoFiscal=${encodeURIComponent(idDocumentoFiscal)}&idUnidadeGestora=${ID_UG}&apenasSemRegistroLiquidacao=false&sortField=data&sortDirection=desc&pageSize=20&pageIndex=0`;

    try {
      const response = await fetch(url, {
        method: 'GET',
        headers: {
          'Authorization': `Bearer ${tokenBearer}`,
          'Accept': 'application/json'
        }
      });

      if (!response.ok) throw new Error(`${response.status} ${response.statusText}`);

      const data = await response.json();
      if (!Array.isArray(data?.results)) return [];

      return data.results.map(registro => {
        const valor = Number(registro.valor || 0);
        const valorPrimeiroGrau = Number(registro.valorPrimeiroGrau || 0);

        return {
          id: registro.id,
          data: registro.data || registro.dataAteste || '',
          valor,
          valorGlosa: Number(registro.valorGlosa || 0),
          valorPrimeiroGrau,
          valorSegundoGrau: valor - valorPrimeiroGrau
        };
      });
    } catch (error) {
      autonomosErr('Erro ao capturar atestes:', error);
      return [];
    }
  }

  async function capturarPDFRPA(idDocumentoFiscal, tokenBearer) {
    const url = `https://api.sigeo.jt.jus.br${URL_ARQUIVO_DOC}${encodeURIComponent(idDocumentoFiscal)}/arquivo/jt`;

    try {
      const response = await fetch(url, {
        method: 'GET',
        headers: {
          'Authorization': `Bearer ${tokenBearer}`,
          'Accept': 'application/json, text/plain, */*'
        }
      });

      if (!response.ok) throw new Error(`${response.status} ${response.statusText}`);

      const blob = await response.blob();
      return await extrairDadosPDFRPA(blob);
    } catch (error) {
      autonomosErr('Erro ao capturar PDF RPA:', error);
      return null;
    }
  }

  async function extrairDadosPDFRPA(blob) {
    try {
      if (typeof pdfjsLib === 'undefined') {
        autonomosErr('PDF.js não carregado.');
        return null;
      }

      const arrayBuffer = await blob.arrayBuffer();
      const uint8Array = new Uint8Array(arrayBuffer);
      const pdf = await pdfjsLib.getDocument({ data: uint8Array }).promise;

      let textoCompleto = '';
      for (let pageNum = 1; pageNum <= pdf.numPages; pageNum++) {
        const page = await pdf.getPage(pageNum);
        const textContent = await page.getTextContent();
        const pageText = textContent.items.map(item => item.str).join(' ');
        textoCompleto += pageText + '\n';
      }

      const dados = extrairDadosTextoRPA(textoCompleto);
      dados.arrayBuffer = arrayBuffer;
      dados.blob = blob;
      return dados;
    } catch (error) {
      autonomosErr('Erro ao extrair PDF RPA:', error);
      return null;
    }
  }

  function extrairDadosTextoRPA(textoCompleto) {
    const dados = {
      cpf: '',
      dataEmissao: '',
      valor: '',
      textoCompleto
    };

    const regexCPF = /(?:CPF|CPF\/CNPJ)[\s:]*([\d.\-]{11,14})/i;
    const matchCPF = textoCompleto.match(regexCPF);
    if (matchCPF) dados.cpf = matchCPF[1].trim();

    const regexData = /(?:Emitido\s+em|Data\s+de\s+Emiss[ãa]o|Emiss[ãa]o)[\s:]*?(\d{2}\/\d{2}\/\d{4})/i;
    const matchData = textoCompleto.match(regexData);
    if (matchData) {
      const [dia, mes, ano] = matchData[1].split('/');
      dados.dataEmissao = `${ano}-${mes}-${dia}T00:00:00`;
    }

    const regexValor = /(?:Valor\s*(?:L[íi]quido|Bruto|Total)?|R\$\s*)(?:[^0-9]{0,10})?(\d{1,3}(?:\.\d{3})*,\d{2})/i;
    const matchValor = textoCompleto.match(regexValor);
    if (matchValor) {
      dados.valor = matchValor[1].replace(/\./g, '').replace(',', '.');
    }

    return dados;
  }

  function obterCnpjCpfBase(registro) {
    return somenteNumeros(
      registro?.fornecedor?.documento ||
      registro?.cpfCnpj ||
      registro?.documento ||
      ''
    );
  }

  function obterProadBase(registro) {
    return normalizarProad(
      registro?.contratacao?.processoAdministrativo ||
      registro?.processoAdministrativo ||
      registro?.proad ||
      registro?.linhaFallbackTexto ||
      ''
    );
  }

  function obterBancoAgenciaConta(registro) {
    const itemBanco =
      registro?.contratacao?.contaBancaria ||
      registro?.contaBancaria ||
      null;

    let banco = '';
    let agencia = '';
    let conta = '';

    if (itemBanco?.agencia?.banco?.id != null) {
      banco = somenteNumeros(itemBanco.agencia.banco.id);
    } else if (itemBanco?.agencia?.banco?.codigo != null) {
      banco = somenteNumeros(itemBanco.agencia.banco.codigo);
    }

    if (itemBanco?.agencia?.codigo != null) {
      agencia = somenteNumeros(itemBanco.agencia.codigo);
    }

    if (itemBanco?.numero != null) {
      conta = somenteNumeros(itemBanco.numero);
      if (itemBanco?.digitoVerificador != null && itemBanco.digitoVerificador !== '') {
        // Preserva DV alfanumérico (ex.: "X" do Banco do Brasil) — somenteNumeros o apagaria
        conta += String(itemBanco.digitoVerificador).replace(/[^0-9A-Za-z]/g, '').toUpperCase();
      }
    }

    return { banco, agencia, conta };
  }

  // Cache de contas bancárias por fornecedor para não repetir a mesma
  // requisição quando várias linhas do lote pertencem ao mesmo fornecedor.
  const cacheContasBancariasAutonomos = new Map();

  /**
   * Conta bancária do autônomo SEMPRE a partir do cadastro da CONTRATAÇÃO:
   *   1) conta já embutida no registro (registro.contratacao.contaBancaria);
   *   2) consulta a /contratacoes/jt por PROAD, com fallback por CPF/CNPJ;
   *   3) só se PERMITIR_FALLBACK_FORNECEDOR estiver ligado, cai para a
   *      primeira conta ATIVA do cadastro do fornecedor.
   * Formatação idêntica à da cópia em lote (banco = código; agência com 4
   * dígitos; conta = número + DV, preservando DVs alfanuméricos e DV zero).
   */
  function formatarContaBancariaAutonomo(item) {
    if (!item) return null;

    let banco = '';
    if (item?.agencia?.banco?.id != null) banco = String(item.agencia.banco.id);
    else if (item?.agencia?.banco?.codigo != null) banco = String(item.agencia.banco.codigo);

    let agencia = item?.agencia?.codigo != null ? String(item.agencia.codigo) : '';
    if (agencia && agencia.length < 4) agencia = agencia.padStart(4, '0');

    const dv = (item?.digitoVerificador != null && item.digitoVerificador !== '')
      ? String(item.digitoVerificador).replace(/[^0-9A-Za-z]/g, '').toUpperCase()
      : '';
    const conta = `${item?.numero != null ? item.numero : ''}${dv}`;

    if (!banco && !agencia && !conta) return null;
    return { banco, agencia, conta };
  }

  async function obterDadosBancariosAutonomo(registro) {
    // 1) Conta da contratação já presente no registro
    let dados = formatarContaBancariaAutonomo(
      registro?.contratacao?.contaBancaria || registro?.contaBancaria || null
    );
    if (dados) return dados;

    // 2) Consulta ao cadastro de contratações
    try {
      const proad = obterProadBase(registro);
      const cpfCnpj = obterCnpjCpfBase(registro);
      const achado = await buscarContaBancariaContratacao(proad, cpfCnpj, BEARER_TOKEN);
      dados = formatarContaBancariaAutonomo(achado?.contaBancaria);
      if (dados) return dados;
      autonomosWarn(`Contratação sem conta bancária (PROAD=${proad || '?'}, doc=${cpfCnpj || '?'}).`);
    } catch (e) {
      autonomosWarn('Falha ao buscar conta bancária no cadastro de contratações:', e);
    }

    // 3) Fallback opcional para o cadastro do fornecedor
    const idFornecedor = registro?.fornecedor?.id;
    if (PERMITIR_FALLBACK_FORNECEDOR && idFornecedor && BEARER_TOKEN) {
      try {
        let contas;
        if (cacheContasBancariasAutonomos.has(idFornecedor)) {
          contas = cacheContasBancariasAutonomos.get(idFornecedor);
        } else {
          const resp = await fetch(`https://api.sigeo.jt.jus.br/sidof-service/fornecedores/${idFornecedor}/contasBancarias/jt`, {
            headers: { 'Authorization': `Bearer ${BEARER_TOKEN}` }
          });
          if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
          contas = await resp.json();
          cacheContasBancariasAutonomos.set(idFornecedor, contas);
        }
        dados = formatarContaBancariaAutonomo(obterPrimeirosDadosBancariosAtivos(contas));
        if (dados) return dados;
      } catch (e) {
        autonomosWarn(`Falha ao buscar contas bancárias do fornecedor id=${idFornecedor}:`, e);
      }
    }

    return { banco: '', agencia: '', conta: '' };
  }

