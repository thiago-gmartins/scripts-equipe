            const marcoCheckBoxIndividual = matRow;

            if (marcoCheckBoxIndividual) {
                this.verificarIndicadoresPorLinha(indice, checkboxMarcado, matRow);
            }
            else {
                for (let i = 0; i < todasAsLinhas.length; i++) {
                    this.verificarIndicadoresPorLinha(i, checkboxMarcado, todasAsLinhas[i]);
