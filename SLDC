    /**
     * Polling unificado MERCADORIA + AUTÔNOMOS — UM timer de 5 segundos.
     * Cada planilha está em um projeto próprio do Google Cloud (chaves de API distintas),
     * então as cotas não se misturam entre si nem com os módulos existentes.
     *
     * Por que 5s (e não 2s): a cota do Sheets API é de 300 leituras/min POR PROJETO.
     * Com 15 usuários, 5s ⇒ 12 req/min por usuário ⇒ 180 req/min no projeto (60% da
     * cota), sobrando folga para o gatilho de foco, múltiplas abas abertas e retries.
     * A 2s seriam 450 req/min ⇒ estouro da cota (HTTP 429) e badges parados.
     */
    let _pollingMercAutRodando = false;
    let _reinjetandoBadgesMercAut = false;
    let _reinjecaoPendenteMercAut = { mercadoria: false, autonomos: false, unimed: false };

    async function reinjetarBadgesMercAut({ mercadoria = false, autonomos = false, unimed = false } = {}) {
        if (mercadoria) {
            Object.keys(_sheetsCacheMercadoria).forEach(k => delete _sheetsCacheMercadoria[k]);
            document.querySelectorAll('[data-id="sigeo-badge-mercadoria"]').forEach(badge => badge.remove());
        }
        if (autonomos) {
            Object.keys(_sheetsCacheAutonomosResp).forEach(k => delete _sheetsCacheAutonomosResp[k]);
            document.querySelectorAll('[data-id="sigeo-badge-autonomos"]').forEach(badge => badge.remove());
        }
        if (unimed) {
            Object.keys(_sheetsCacheUnimed).forEach(k => delete _sheetsCacheUnimed[k]);
            document.querySelectorAll('[data-id="sigeo-badge-unimed"]').forEach(badge => badge.remove());
        }
        if (mercadoria || autonomos || unimed) {
            const filtroExistente = document.querySelector('#sigeo-filtro-responsavel');
            if (filtroExistente) filtroExistente.remove();
        }

        const proc = window._sigeoProcessamento;
        if (!proc) return;

        if (_reinjetandoBadgesMercAut) {
            if (mercadoria) _reinjecaoPendenteMercAut.mercadoria = true;
            if (autonomos)  _reinjecaoPendenteMercAut.autonomos = true;
            if (unimed)     _reinjecaoPendenteMercAut.unimed = true;
            return;
        }

        _reinjetandoBadgesMercAut = true;
        try {
            let pendMerc = mercadoria;
            let pendAut  = autonomos;
            let pendUni  = unimed;
            do {
                _reinjecaoPendenteMercAut.mercadoria = false;
                _reinjecaoPendenteMercAut.autonomos = false;
                _reinjecaoPendenteMercAut.unimed = false;

                const tarefas = [];
                if (pendMerc && typeof proc.injetarBadgesMercadoria === 'function') {
                    tarefas.push(proc.injetarBadgesMercadoria());
                }
                if (pendAut && typeof proc.injetarBadgesAutonomosSheets === 'function') {
                    tarefas.push(proc.injetarBadgesAutonomosSheets());
                }
                if (pendUni && typeof proc.injetarBadgesUnimed === 'function') {
                    tarefas.push(proc.injetarBadgesUnimed());
                }
                await Promise.all(tarefas);

                pendMerc = _reinjecaoPendenteMercAut.mercadoria;
                pendAut  = _reinjecaoPendenteMercAut.autonomos;
                pendUni  = _reinjecaoPendenteMercAut.unimed;
            } while (pendMerc || pendAut || pendUni);
        } finally {
            _reinjetandoBadgesMercAut = false;
        }
    }

    (function iniciarPollingMercadoriaAutonomos() {
        const INTERVALO_MS = 5000; // ver justificativa da cota no comentário acima

        async function executarCicloMercAut() {
            if (_pollingMercAutRodando) return;
            _pollingMercAutRodando = true;

            try {
                const [resultadoMerc, resultadoAut, resultadoUni] = await Promise.allSettled([
                    baixarPlanilhaMercadoriaDaAPI({ silencioso: true }),
                    baixarPlanilhaAutonomosDaAPI({ silencioso: true }),
                    baixarPlanilhaUnimedDaAPI({ silencioso: true })
                ]);

                let alterouMerc = false;
                let alterouAut = false;
                let alterouUni = false;

                if (resultadoMerc.status === 'fulfilled') {
                    const dadosMerc = resultadoMerc.value;
                    const hashMerc = JSON.stringify(dadosMerc);
                    if (_hashPlanilhaMercadoria !== hashMerc) {
                        _dadosPlanilhaMercadoria = dadosMerc;
                        _indicePlanilhaMercadoria = construirIndicePlanilha(dadosMerc);
                        _hashPlanilhaMercadoria = hashMerc;
                        alterouMerc = true;
                        logDebug(`[SIGEO×Sheets-Merc] ${dadosMerc.length} registros de mercadoria carregados`);
                    }
                } else {
                    console.warn('[SIGEO×Sheets-Merc] Polling mercadoria: erro silencioso, tentará novamente em 5s.', resultadoMerc.reason);
                }

                if (resultadoAut.status === 'fulfilled') {
                    const dadosAut = resultadoAut.value;
                    const hashAut = JSON.stringify(dadosAut);
                    if (_hashPlanilhaAutonomos !== hashAut) {
                        _dadosPlanilhaAutonomos = dadosAut;
                        _indicePlanilhaAutonomos = construirIndicePlanilha(dadosAut);
                        _hashPlanilhaAutonomos = hashAut;
                        alterouAut = true;
                        logDebug(`[SIGEO×Sheets-Aut] ${dadosAut.length} registros de autônomos carregados`);
                    }
                } else {
                    console.warn('[SIGEO×Sheets-Aut] Polling autônomos: erro silencioso, tentará novamente em 5s.', resultadoAut.reason);
                }

                if (resultadoUni.status === 'fulfilled') {
                    const dadosUni = resultadoUni.value;
                    const hashUni = JSON.stringify(dadosUni);
                    if (_hashPlanilhaUnimed !== hashUni) {
                        _dadosPlanilhaUnimed = dadosUni;
                        _indicePlanilhaUnimed = construirIndicePlanilha(dadosUni);
                        _hashPlanilhaUnimed = hashUni;
                        alterouUni = true;
                        logDebug(`[SIGEO×Sheets-Unimed] ${dadosUni.length} registros da Unimed carregados`);
                    }
                } else {
                    console.warn('[SIGEO×Sheets-Unimed] Polling Unimed: erro silencioso, tentará novamente em 5s.', resultadoUni.reason);
                }

                if (alterouMerc || alterouAut || alterouUni) {
                    logDebug(`[SIGEO×Sheets-Merc/Aut/Uni] Dados atualizados — reinjeção. Mercadoria=${alterouMerc}; Autônomos=${alterouAut}; Unimed=${alterouUni}`);
                    await reinjetarBadgesMercAut({ mercadoria: alterouMerc, autonomos: alterouAut, unimed: alterouUni });
                }
            } finally {
                _pollingMercAutRodando = false;
            }
        }

        // Gatilho de foco de janela — mesma lógica do polling saúde+manutenção.
        window.addEventListener('focus', () => {
            if (!_pollingMercAutRodando) {
                logDebug('[SIGEO×Sheets-Merc/Aut] Janela ganhou foco — buscando atualização imediata.');
                executarCicloMercAut();
            }
        });

        // Primeiro ciclo imediato — aquece a conexão logo na inicialização.
        executarCicloMercAut();
        setInterval(executarCicloMercAut, INTERVALO_MS);

        logDebug('[SIGEO×Sheets-Merc/Aut/Uni] Polling unificado Mercadoria + Autônomos + Unimed ativo — 1 timer a cada 5s.');
    })();

    // FIM MÓDULO AUTÔNOMOS (SHEETS) + POLLING MERCADORIA/AUTÔNOMOS
    // ==========================================================================


    // Cache em memória por sessão
    const _sheetsCache = {};
    let _dadosPlanilha = null;
    let _indicePlanilha = null;
    let _carregandoPlanilha = false;
    let _callbacksPendentes = [];

    /**
     * Carrega todos os dados da planilha via API v4 — uma única vez por sessão.
     */
    let _hashPlanilha = null;
    let _pollingCarregandoPlanilha = false;

    // Índice CNPJ → PROAD Principal do cadastro de credenciados.
    // É separado do cache da aba de liquidação porque precisa funcionar ANTES
    // de a nota ser preenchida na planilha e, portanto, antes de existir badge.
    let _indiceCadastroSaudeProad = null;
    let _promessaCadastroSaudeProad = null;

    function montarIndiceCadastroSaudeProad(data) {
        const cnpjs = data?.valueRanges?.[0]?.values || [];
        const proads = data?.valueRanges?.[1]?.values || [];
        const situacoes = data?.valueRanges?.[2]?.values || [];
        const total = Math.max(cnpjs.length, proads.length, situacoes.length);
        const agrupado = new Map();

        for (let i = 0; i < total; i++) {
            const cnpj = normalizarCNPJLocal(cnpjs[i]?.[0] || '');
            const proad = _pProc(proads[i]?.[0] || '');
            const situacao = String(situacoes[i]?.[0] || '').trim();
            if (!cnpj || !proad) continue;
            if (!agrupado.has(cnpj)) agrupado.set(cnpj, []);
            agrupado.get(cnpj).push({ proad, situacao });
        }

        const indice = new Map();
        for (const [cnpj, linhas] of agrupado) {
            const vigentes = linhas.filter(x => /vigente/i.test(x.situacao));
            const universo = vigentes.length ? vigentes : linhas;
            const proadsUnicos = [...new Set(universo.map(x => x.proad).filter(Boolean))];
            if (proadsUnicos.length === 1) {
                indice.set(cnpj, proadsUnicos[0]);
            } else if (proadsUnicos.length > 1) {
                console.warn(`[SIGEO×Sheets-Saúde] CNPJ ${cnpj} possui mais de um PROAD Principal utilizável:`, proadsUnicos);
            }
        }
        return indice;
    }

    async function carregarIndiceCadastroSaudeProad() {
        if (_indiceCadastroSaudeProad) return _indiceCadastroSaudeProad;
        if (_promessaCadastroSaudeProad) return _promessaCadastroSaudeProad;

        _promessaCadastroSaudeProad = (async () => {
            try {
                const res = await fetch(SHEETS_CADASTRO_SAUDE_API_URL, {
                    method: 'GET', headers: { 'Accept': 'application/json' }
                });
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                const data = await res.json();
                _indiceCadastroSaudeProad = montarIndiceCadastroSaudeProad(data);
                logDebug(`[SIGEO×Sheets-Saúde] ${_indiceCadastroSaudeProad.size} CNPJ(s) com PROAD Principal carregados do cadastro`);
                return _indiceCadastroSaudeProad;
            } catch (e) {
                console.error('[SIGEO×Sheets-Saúde] Falha ao carregar CNPJ → PROAD Principal:', e);
                // Mantém mapa vazio nesta sessão; o processamento de Saúde cai para
                // a busca global por NF+CNPJ, sem usar um PROAD possivelmente errado do SIGEO.
                _indiceCadastroSaudeProad = new Map();
                return _indiceCadastroSaudeProad;
            } finally {
                _promessaCadastroSaudeProad = null;
            }
        })();

        return _promessaCadastroSaudeProad;
    }

    async function obterProadPrincipalSaudePorCnpj(cnpj) {
        const chave = normalizarCNPJLocal(cnpj);
        if (!chave) return null;
        const indice = await carregarIndiceCadastroSaudeProad();
        return indice.get(chave) || null;
    }

    function montarDadosSaudeAPartirDaAPI(data) {
        if (Array.isArray(data?.valueRanges)) {
            const { qtd, valor } = _colunasBatchGetSheets(data);
            const dados = [];
            for (let i = 0; i < qtd; i++) {
                const r = { respAnalise: valor(0,i), respConferencia: valor(1,i), numeroNP: valor(2,i), proadAteste: valor(3,i), cnpj: normalizarCNPJLocal(valor(4,i)), numeroNF: valor(5,i), dataEmissao: normalizarDataLocal(valor(6,i)) };
                if (r.cnpj && r.numeroNF && r.dataEmissao) dados.push(r);
            }
            return dados;
        }
        return _montarDadosSheetsPorCabecalho(data);
    }

    async function baixarPlanilhaSaudeDaAPI({ silencioso = false } = {}) {
        if (!silencioso) logDebug('[SIGEO×Sheets] Carregando planilha via API...');
        // fetch() nativo em vez de GM_xmlhttpRequest: mesma migração feita em manutenção e
        // serviços, pra evitar o bug confirmado de serialização do GM_xmlhttpRequest no
        // Tampermonkey MV3.
        const res = await fetch(SHEETS_API_URL, { method: 'GET', headers: { 'Accept': 'application/json' } });
        if (!res.ok) throw new Error(`[SIGEO×Sheets] HTTP ${res.status} ao buscar planilha`);
        const data = await res.json();
        return montarDadosSaudeAPartirDaAPI(data);
    }

    /**
     * Carrega todos os dados da planilha via API v4 — leitura instantânea quando já existe cache.
     */
    function carregarPlanilha() {
        return new Promise((resolve) => {
            if (_dadosPlanilha !== null) { resolve(_dadosPlanilha); return; }
            if (_carregandoPlanilha) { _callbacksPendentes.push(resolve); return; }

            _carregandoPlanilha = true;
            baixarPlanilhaSaudeDaAPI({ silencioso: false })
                .then(dados => {
                    _dadosPlanilha = dados;
                    _indicePlanilha = construirIndicePlanilha(dados);
                    _hashPlanilha = JSON.stringify(dados);
                    logDebug(`[SIGEO×Sheets] ${_dadosPlanilha.length} registros carregados`);
                })
                .catch(e => {
                    console.error('[SIGEO×Sheets] Erro na API/parse:', e);
                    _dadosPlanilha = [];
                    _indicePlanilha = new Map();
                    _hashPlanilha = JSON.stringify([]);
                })
                .finally(() => {
                    _carregandoPlanilha = false;
                    resolve(_dadosPlanilha);
                    _callbacksPendentes.forEach(cb => cb(_dadosPlanilha));
                    _callbacksPendentes = [];
                });
        });
    }

    function normalizarCNPJLocal(val) {
        if (val === null || val === undefined) return '';
        let s = String(val).trim();
        if (!s) return '';

        // Corrige CNPJ/CPF vindo do Google Sheets ou Excel em formato numérico/científico
        // Ex.: 18286492000199.0 ou 1.8286492000199E13
        if (/e\+?\d+$/i.test(s)) {
            const n = Number(s.replace(',', '.'));
            if (Number.isFinite(n)) {
                s = Math.trunc(n).toLocaleString('fullwide', { useGrouping: false });
            }
        }

        s = s.replace(/\.0+$/, '').replace(/\D/g, '');
        if (!s) return '';

        // CNPJ deve ficar com 14 dígitos. Se vier maior por causa do expoente, usa os 14 primeiros dígitos úteis.
        if (s.length > 14) s = s.slice(0, 14);
        return s.padStart(14, '0');
    }


    // ── Cadastro → PROAD Principal (Serviços / Manutenção / Mercadoria) ─────
    // O Cadastro é a fonte preferencial. Em caso de ambiguidade, o robô não
    // escolhe arbitrariamente: cai para o PROAD informado pelo SIGEO.
    const _cadastrosProadGerais = {
        manutencao: { url: SHEETS_CADASTRO_MANUTENCAO_API_URL, indice: null, promessa: null, nome: 'Manutenção' },
        servicos:   { url: SHEETS_CADASTRO_SERVICOS_API_URL, indice: null, promessa: null, nome: 'Serviços' },
        mercadoria: { url: SHEETS_CADASTRO_MERCADORIA_API_URL, indice: null, promessa: null, nome: 'Mercadoria' }
    };

    function normalizarContratoEmpenhoCadastro(valor) {
        return String(valor || '')
            .trim().toUpperCase()
            .replace(/\s+/g, '')
            .replace(/^0+(?=\d)/, '');
    }

    function montarIndiceCadastroProadGeral(data) {
        const contratos = data?.valueRanges?.[0]?.values || [];
        const cnpjs = data?.valueRanges?.[1]?.values || [];
        const proads = data?.valueRanges?.[2]?.values || [];
        const situacoes = data?.valueRanges?.[3]?.values || [];
        const total = Math.max(contratos.length, cnpjs.length, proads.length, situacoes.length);
        const linhas = [];
        for (let i = 0; i < total; i++) {
            const contrato = normalizarContratoEmpenhoCadastro(contratos[i]?.[0] || '');
            const cnpj = normalizarCNPJLocal(cnpjs[i]?.[0] || '');
            const proad = _pProc(proads[i]?.[0] || '');
            const situacao = String(situacoes[i]?.[0] || '').trim();
            if (!proad || (!contrato && !cnpj)) continue;
            linhas.push({ contrato, cnpj, proad, situacao });
        }
        return linhas;
    }

    function _proadUnicoCadastro(linhas) {
        const proads = [...new Set((linhas || []).map(x => x.proad).filter(Boolean))];
        return proads.length === 1 ? proads[0] : null;
    }

    function _vigentesCadastro(linhas) {
        const vigentes = (linhas || []).filter(x => /vigente/i.test(x.situacao || ''));
        return vigentes.length ? vigentes : (linhas || []);
    }

    function resolverProadNoIndiceCadastro(linhas, contratoEmpenho, cnpj) {
        const contrato = normalizarContratoEmpenhoCadastro(contratoEmpenho);
        const doc = normalizarCNPJLocal(cnpj);

        // 1) contrato + CNPJ; 2) contrato; 3) CNPJ. Sempre prefere Vigente.
        const tentativas = [];
        if (contrato && doc) tentativas.push({ criterio: 'contrato+cnpj', linhas: linhas.filter(x => x.contrato === contrato && x.cnpj === doc) });
        if (contrato) tentativas.push({ criterio: 'contrato', linhas: linhas.filter(x => x.contrato === contrato) });
        if (doc) tentativas.push({ criterio: 'cnpj', linhas: linhas.filter(x => x.cnpj === doc) });

        for (const tentativa of tentativas) {
            if (!tentativa.linhas.length) continue;
            const universo = _vigentesCadastro(tentativa.linhas);
            const proad = _proadUnicoCadastro(universo);
            if (proad) return { proad, criterio: tentativa.criterio };
        }
        return null;
    }


    // v11.40.24 — resolução ESTRITA usada somente pela Manutenção Predial.
    // Se contrato e CNPJ existem, eles precisam ser coerentes entre si. Isso impede
    // que um codigoContrato antigo/desalinhado selecione o PROAD de outro fornecedor
    // pelo fallback "contrato apenas".
    async function obterProadPrincipalManutencaoSeguro(contratoEmpenho, cnpj) {
        const linhas = await carregarIndiceCadastroProadGeral('manutencao');
        const contrato = normalizarContratoEmpenhoCadastro(contratoEmpenho);
        const doc = normalizarCNPJLocal(cnpj);

        if (contrato && doc) {
            const porAmbos = linhas.filter(x => x.contrato === contrato && x.cnpj === doc);
            if (porAmbos.length) {
                const proad = _proadUnicoCadastro(_vigentesCadastro(porAmbos));
                if (proad) return { proad, criterio: 'contrato+cnpj' };
            }

            // Contrato + CNPJ não casaram. NÃO tenta contrato sozinho: se o contrato
            // pertencer a outro fornecedor, isso contaminaria a NF atual.
            const linhasContrato = linhas.filter(x => x.contrato === contrato);
            if (linhasContrato.length) {
                const cnpjsContrato = [...new Set(linhasContrato.map(x => x.cnpj).filter(Boolean))];
                if (cnpjsContrato.length && !cnpjsContrato.includes(doc)) {
                    console.warn(
                        `[SIGEO×PROAD] Manutenção: contrato ${contrato} não pertence ao CNPJ ${doc} no Cadastro; `
                        + `contrato isolado será ignorado por segurança.`
                    );
                }
            }

            // CNPJ sozinho só é aceito se apontar para um único PROAD vigente.
            const porCnpj = linhas.filter(x => x.cnpj === doc);
            if (porCnpj.length) {
                const proad = _proadUnicoCadastro(_vigentesCadastro(porCnpj));
                if (proad) return { proad, criterio: 'cnpj' };
            }
            return null;
        }

        // Quando só uma chave existe, preserva exatamente o comportamento anterior.
        if (contrato) {
            const porContrato = linhas.filter(x => x.contrato === contrato);
            if (porContrato.length) {
                const proad = _proadUnicoCadastro(_vigentesCadastro(porContrato));
                if (proad) return { proad, criterio: 'contrato' };
            }
        }
        if (doc) {
            const porCnpj = linhas.filter(x => x.cnpj === doc);
            if (porCnpj.length) {
                const proad = _proadUnicoCadastro(_vigentesCadastro(porCnpj));
                if (proad) return { proad, criterio: 'cnpj' };
            }
        }
        return null;
    }

    async function carregarIndiceCadastroProadGeral(tipo) {
        const cfg = _cadastrosProadGerais[tipo];
        if (!cfg) return [];
        if (cfg.indice) return cfg.indice;
        if (cfg.promessa) return cfg.promessa;

        cfg.promessa = (async () => {
            try {
                const res = await fetch(cfg.url, { method: 'GET', headers: { 'Accept': 'application/json' } });
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                cfg.indice = montarIndiceCadastroProadGeral(await res.json());
                logDebug(`[SIGEO×Sheets-${cfg.nome}] ${cfg.indice.length} linha(s) de Cadastro carregadas para PROAD Principal`);
            } catch (e) {
                console.warn(`[SIGEO×Sheets-${cfg.nome}] Cadastro de PROAD Principal indisponível:`, e);
                cfg.indice = [];
            } finally {
                cfg.promessa = null;
            }
            return cfg.indice;
        })();
        return cfg.promessa;
    }

    async function obterProadPrincipalCadastroGeral(tipo, contratoEmpenho, cnpj) {
        const linhas = await carregarIndiceCadastroProadGeral(tipo);
        return resolverProadNoIndiceCadastro(linhas, contratoEmpenho, cnpj);
    }

    async function obterProadPrincipalServicosOuMercadoria(contratoEmpenho, cnpj) {
        const [servicos, mercadoria] = await Promise.all([
            obterProadPrincipalCadastroGeral('servicos', contratoEmpenho, cnpj),
            obterProadPrincipalCadastroGeral('mercadoria', contratoEmpenho, cnpj)
        ]);
        if (servicos && !mercadoria) return { ...servicos, origem: 'cadastro-servicos', destino: 'servicos' };
        if (mercadoria && !servicos) return { ...mercadoria, origem: 'cadastro-mercadoria', destino: 'mercadoria' };
        if (servicos && mercadoria && servicos.proad === mercadoria.proad) {
            // Se o mesmo cadastro apareceu nos dois universos, preserva a classificação
            // por existência da nota nos índices já carregados quando possível.
            return { ...servicos, origem: 'cadastro-servicos+mercadoria', destino: null };
        }
        if (servicos && mercadoria) {
            console.warn('[SIGEO×Sheets] Cadastro ambíguo entre Serviços e Mercadoria; usando SIGEO como fallback.', { servicos, mercadoria });
        }
        return null;
    }

    function obterContratoEmpenhoParaCadastro(documento, registroSelecionado) {
        return registroSelecionado?.contratacao?.codigoContrato
            || documento?.contratacao?.codigoContrato
            || registroSelecionado?.contratacao?.numeroEmpenho
            || documento?.contratacao?.numeroEmpenho
            || registroSelecionado?.contratoEmpenho
            || documento?.contratoEmpenho
            || '';
    }

    function limparCacheSaudeEReinjetar() {
        Object.keys(_sheetsCache).forEach(k => delete _sheetsCache[k]);
        document.querySelectorAll('[data-id="sigeo-badge-responsaveis"]').forEach(badge => badge.remove());
        const filtroExistente = document.querySelector('#sigeo-filtro-responsavel');
        if (filtroExistente) filtroExistente.remove();
        const proc = window._sigeoProcessamento;
        if (proc && typeof proc.injetarBadgesSaude === 'function') {
            return proc.injetarBadgesSaude();
        }
        return Promise.resolve();
    }

    /**
     * Polling unificado Saúde + Manutenção — UM ÚNICO timer de 2 segundos.
     * EXATAMENTE igual à versão de referência (só saúde + manutenção), sem nenhuma
     * alteração — é o padrão que precisa continuar rápido.
     *
     * Por quê unificado: ter dois setInterval independentes (um para saúde, outro para
     * manutenção) podia disparar duas reinjeções de badges quase ao mesmo tempo, dobrando
     * o trabalho de DOM e dando sensação de "tranco" na tela. Aqui as duas APIs são
     * consultadas em paralelo dentro do MESMO ciclo, mas cada módulo só redesenha os
     * próprios badges (sem reprocessar o que não mudou) — e existe um guard que evita
     * reinjeções sobrepostas, enfileirando só mais uma passada se uma mudança nova chegar
     * enquanto a reinjeção anterior ainda está em andamento.
     */
    let _pollingSheetsUnificadoRodando = false;
    let _reinjetandoBadgesSheets = false;
    let _reinjecaoPendente = { saude: false, manutencao: false };

    async function reinjetarBadgesUnificado({ saude = false, manutencao = false } = {}) {
        if (saude) {
            Object.keys(_sheetsCache).forEach(k => delete _sheetsCache[k]);
            document.querySelectorAll('[data-id="sigeo-badge-responsaveis"]').forEach(badge => badge.remove());
        }
        if (manutencao) {
            Object.keys(_sheetsCacheManutencao).forEach(k => delete _sheetsCacheManutencao[k]);
            document.querySelectorAll('[data-id="sigeo-badge-manutencao"]').forEach(badge => badge.remove());
        }
        if (saude || manutencao) {
            const filtroExistente = document.querySelector('#sigeo-filtro-responsavel');
            if (filtroExistente) filtroExistente.remove();
        }

        const proc = window._sigeoProcessamento;
        if (!proc) return;

        // Se já existe uma reinjeção em andamento, só marca o que ficou pendente
        // e deixa o loop abaixo cuidar de rodar mais uma passada sem esperar o próximo ciclo de 2s.
        if (_reinjetandoBadgesSheets) {
            if (saude) _reinjecaoPendente.saude = true;
            if (manutencao) _reinjecaoPendente.manutencao = true;
            return;
        }

        _reinjetandoBadgesSheets = true;
        try {
            let pendSaude = saude;
            let pendManutencao = manutencao;
            do {
                _reinjecaoPendente.saude = false;
                _reinjecaoPendente.manutencao = false;

                const tarefas = [];
                if (pendSaude && typeof proc.injetarBadgesSaude === 'function') {
                    tarefas.push(proc.injetarBadgesSaude());
                }
                if (pendManutencao && typeof proc.injetarBadgesManutencao === 'function') {
                    tarefas.push(proc.injetarBadgesManutencao());
                }
                await Promise.all(tarefas);

                pendSaude = _reinjecaoPendente.saude;
                pendManutencao = _reinjecaoPendente.manutencao;
            } while (pendSaude || pendManutencao);
        } finally {
            _reinjetandoBadgesSheets = false;
        }
    }

    (function iniciarPollingSheetsUnificado() {
        const INTERVALO_MS = 5000; // 5s: com 15 usuários = 180 req/min por projeto (cota Sheets API = 300/min/projeto)

        async function executarCicloSaudeManutencao() {
            if (_pollingSheetsUnificadoRodando) return;
            _pollingSheetsUnificadoRodando = true;

            try {
                const [resultadoSaude, resultadoManutencao] = await Promise.allSettled([
                    baixarPlanilhaSaudeDaAPI({ silencioso: true }),
                    baixarPlanilhaManutencaoDaAPI({ silencioso: true })
                ]);

                let alterouSaude = false;
                let alterouManutencao = false;

                if (resultadoSaude.status === 'fulfilled') {
                    const dadosSaude = resultadoSaude.value;
                    const hashSaude = JSON.stringify(dadosSaude);
                    if (_hashPlanilha !== hashSaude) {
                        _dadosPlanilha = dadosSaude;
                        _indicePlanilha = construirIndicePlanilha(dadosSaude);
                        _hashPlanilha = hashSaude;
                        alterouSaude = true;
                        logDebug(`[SIGEO×Sheets] ${dadosSaude.length} registros carregados`);
                    }
                } else {
                    console.warn('[SIGEO×Sheets] Polling saúde: erro silencioso, tentará novamente em 5s.', resultadoSaude.reason);
                }

                if (resultadoManutencao.status === 'fulfilled') {
                    const dadosManutencao = resultadoManutencao.value;
                    const hashManutencao = JSON.stringify(dadosManutencao);
                    if (_hashPlanilhaManutencao !== hashManutencao) {
                        _dadosPlanilhaManutencao = dadosManutencao;
                        _indicePlanilhaManutencao = construirIndicePlanilha(dadosManutencao);
                        _hashPlanilhaManutencao = hashManutencao;
                        alterouManutencao = true;
                        logDebug(`[SIGEO×Sheets-Man] ${dadosManutencao.length} registros de manutenção carregados`);
                    }
                } else {
                    console.warn('[SIGEO×Sheets-Man] Polling manutenção: erro silencioso, tentará novamente em 5s.', resultadoManutencao.reason);
                }

                if (alterouSaude || alterouManutencao) {
                    logDebug(`[SIGEO×Sheets] Dados atualizados — reinjeção de badges. Saúde=${alterouSaude}; Manutenção=${alterouManutencao}`);
                    await reinjetarBadgesUnificado({ saude: alterouSaude, manutencao: alterouManutencao });
                }
            } finally {
                _pollingSheetsUnificadoRodando = false;
            }
        }

        // Gatilho de foco de janela — cobre o cenário de duas telas onde a aba nunca fica
        // oculta, mas o usuário clica na janela do SIGEO depois de editar a planilha.
        window.addEventListener('focus', () => {
            if (!_pollingSheetsUnificadoRodando) {
                logDebug('[SIGEO×Sheets] Janela ganhou foco — buscando atualização imediata de saúde/manutenção.');
                executarCicloSaudeManutencao();
            }
        });

        // Primeiro ciclo imediato — aquece a conexão logo na inicialização.
        executarCicloSaudeManutencao();
        // Ciclos seguintes a cada 2s.
        setInterval(executarCicloSaudeManutencao, INTERVALO_MS);

        logDebug('[SIGEO×Sheets] Polling unificado Saúde + Manutenção ativo — 1 timer a cada 5s, reinjeção independente por módulo.');
    })();

    /**
     * Polling de SERVIÇOS — timer 100% independente do polling saúde+manutenção acima.
     * Não compartilha guard, não compartilha Promise.all/allSettled, não compartilha
     * setInterval. Mesmo que a API de Serviços demore mais pra responder (range maior,
     * mais registros), ela NUNCA atrasa a atualização de saúde/manutenção, porque roda
     * em um ciclo totalmente à parte.
     */
    let _reinjetandoBadgesServicos = false;
    let _reinjecaoPendenteServicos = false;

    async function reinjetarBadgesServicosIsolado() {
        Object.keys(_sheetsCacheServicos).forEach(k => delete _sheetsCacheServicos[k]);
        document.querySelectorAll('[data-id="sigeo-badge-servicos"]').forEach(badge => badge.remove());
        const filtroExistente = document.querySelector('#sigeo-filtro-responsavel');
        if (filtroExistente) filtroExistente.remove();

        const proc = window._sigeoProcessamento;
        if (!proc || typeof proc.injetarBadgesServicos !== 'function') return;

        if (_reinjetandoBadgesServicos) {
            _reinjecaoPendenteServicos = true;
            return;
        }

        _reinjetandoBadgesServicos = true;
        try {
            do {
                _reinjecaoPendenteServicos = false;
                await proc.injetarBadgesServicos();
            } while (_reinjecaoPendenteServicos);
        } finally {
            _reinjetandoBadgesServicos = false;
        }
    }

    (function iniciarPollingServicos() {
        const INTERVALO_MS = 5000; // intervalo MÍNIMO entre o fim de uma busca e o início da próxima (5s: cota de 300 req/min/projeto com 15 usuários)

        // Loop auto-agendado em vez de setInterval fixo: a próxima busca só é agendada
        // depois que a anterior TERMINA, esperando o INTERVALO_MS a partir daí. Isso elimina
        // o "ciclo pulado" — se o fetch demorar 3s, a próxima tentativa começa ~3s+2s depois,
        // em vez de competir com um timer fixo de 2s e ser descartada repetidamente.
        let _cicloServicosEmExecucao = false;
        let _timeoutServicosHandle = null;
        let _abortControllerServicos = null;
        let _retomarImediatamenteServicos = false;

        async function cicloServicos() {
            if (_cicloServicosEmExecucao) return; // já tem um ciclo rodando
            _cicloServicosEmExecucao = true;
            _abortControllerServicos = new AbortController();
            const _tFetchInicio = performance.now();
            try {
                const dadosServicos = await baixarPlanilhaServicosDaAPI({ silencioso: true, signal: _abortControllerServicos.signal });
                const _tFetchFim = performance.now();
                const hashServicos = JSON.stringify(dadosServicos);
                if (_hashPlanilhaServicos !== hashServicos) {
                    _dadosPlanilhaServicos = dadosServicos;
                    _indicePlanilhaServicos = construirIndicePlanilha(dadosServicos);
                    _hashPlanilhaServicos = hashServicos;
                    logDebug(`[SIGEO×Sheets-Serv] ${dadosServicos.length} registros de serviços carregados`);
                    logDebug(`[SIGEO×Sheets-Serv][TEMPO] fetch API = ${(_tFetchFim - _tFetchInicio).toFixed(1)}ms`);
                    logDebug('[SIGEO×Sheets-Serv] Dados atualizados — redesenhando badges de serviços...');
                    const _tReinjecaoInicio = performance.now();
                    await reinjetarBadgesServicosIsolado();
                    const _tReinjecaoFim = performance.now();
                    logDebug(`[SIGEO×Sheets-Serv][TEMPO] reinjeção completa = ${(_tReinjecaoFim - _tReinjecaoInicio).toFixed(1)}ms | CICLO TOTAL = ${(_tReinjecaoFim - _tFetchInicio).toFixed(1)}ms`);
                } else {
                    logDebug(`[SIGEO×Sheets-Serv][TEMPO] fetch API = ${(_tFetchFim - _tFetchInicio).toFixed(1)}ms | sem mudanças, nada a redesenhar`);
                }
            } catch (e) {
                if (e.name === 'AbortError') {
                    logDebug('[SIGEO×Sheets-Serv][TEMPO] fetch cancelado (estava travado em segundo plano) — tentando de novo agora.');
                } else {
                    console.warn('[SIGEO×Sheets-Serv] Polling erro silencioso:', e);
                }
            } finally {
                _cicloServicosEmExecucao = false;
                _abortControllerServicos = null;
                clearTimeout(_timeoutServicosHandle);
                if (_retomarImediatamenteServicos) {
                    _retomarImediatamenteServicos = false;
                    _timeoutServicosHandle = setTimeout(cicloServicos, 0); // retomada instantânea pós-cancelamento
                } else {
                    _timeoutServicosHandle = setTimeout(cicloServicos, INTERVALO_MS);
                }
            }
        }

        // O navegador "throttla" (desacelera) o JS de abas em segundo plano — e isso não afeta
        // só o setTimeout, também pode CONGELAR uma requisição de rede já em andamento (o fetch
        // fica "preso" esperando a aba ganhar prioridade de novo, ainda que o servidor já tenha
        // respondido há tempos). Por isso, ao voltar a visibilidade: se um ciclo já está em
        // andamento (provavelmente travado), cancelamos via AbortController e marcamos retomada
        // imediata — em vez de só esperar o travado descongelar sozinho ou esperar mais 2s.
        // Gatilho 1: aba voltou a ficar visível (cenário de aba minimizada/trocada)
        document.addEventListener('visibilitychange', () => {
            if (!document.hidden) {
                if (_cicloServicosEmExecucao && _abortControllerServicos) {
                    logDebug('[SIGEO×Sheets-Serv] Aba voltou a ficar visível — cancelando fetch travado e buscando de novo.');
                    _retomarImediatamenteServicos = true;
                    _abortControllerServicos.abort();
                } else {
                    logDebug('[SIGEO×Sheets-Serv] Aba voltou a ficar visível — buscando atualização imediata.');
                    clearTimeout(_timeoutServicosHandle);
                    cicloServicos();
                }
            }
        });

        // Gatilho 2: janela do navegador ganhou foco (cenário de duas telas — a aba do SIGEO
        // nunca fica oculta, então visibilitychange nunca dispara; mas quando o usuário clica
        // na janela do SIGEO depois de editar a planilha em outra janela, window ganha focus).
        window.addEventListener('focus', () => {
            if (!_cicloServicosEmExecucao) {
                logDebug('[SIGEO×Sheets-Serv] Janela ganhou foco — buscando atualização imediata.');
                clearTimeout(_timeoutServicosHandle);
                cicloServicos();
            }
        });

        // Primeiro ciclo imediato — aquece a conexão com o Google Sheets logo na inicialização,
        // eliminando o "cold start" (DNS + TLS + primeira resposta) que acontecia justamente
        // no momento em que o usuário voltava ao SIGEO depois de editar a planilha.
        // Os ciclos seguintes continuam com o intervalo normal de 2s.
        _timeoutServicosHandle = setTimeout(cicloServicos, 0);

        logDebug('[SIGEO×Sheets-Serv] Polling serviços ativo — loop auto-agendado + gatilho de troca de aba, isolado de saúde/manutenção.');
    })();

    function normalizarDataLocal(val) {
        if (!val) return '';
        const mISO = val.match(/^(\d{4})-(\d{2})-(\d{2})/);
        if (mISO) return `${mISO[1]}-${mISO[2]}-${mISO[3]}`;
        const mBR = val.match(/^(\d{2})\/(\d{2})\/(\d{4})/);
        if (mBR) return `${mBR[3]}-${mBR[2]}-${mBR[1]}`;
        return val;
    }

    async function consultarResponsaveisEmLote(chaves) {
        await carregarPlanilha();
        const indice = _indicePlanilha || new Map();
        chaves.forEach(c => {
            if (_sheetsCache[c.chaveCache] !== undefined) return;
            const linhas = indice.get(`${c.cnpj}|${c.numeroNF}|${c.dataEmissao}`) || [];
            if (linhas.length > 1) {
                // Duplicidade detectada — armazena objeto especial
                _sheetsCache[c.chaveCache] = {
                    duplicado: true,
                    responsavelAnalise: linhas.map(l => l.respAnalise).filter(Boolean).join(', ')
                };
            } else if (linhas.length === 1) {
                const linha = linhas[0];
                // Abreviar NP: só se o valor contiver "NP", ex: 2026NP002501 → NP2501
                const npRaw = linha.numeroNP || '';
                const npMatch = npRaw.match(/NP(\d+)/i);
                const npAbrev = npMatch ? `NP${parseInt(npMatch[1], 10)}` : null;

                // Texto vermelho: se tiver texto no campo NP que não seja NP nem DH
                const temTextoDiverso = npRaw && !npMatch && !npRaw.match(/^DH/i);

                _sheetsCache[c.chaveCache] = {
                    responsavelAnalise:            linha.respAnalise || null,
                    responsavelConferencia:         linha.respConferencia || null,
                    responsavelAnaliseResumido:     (linha.respAnalise || '').split(' ')[0] || null,
                    responsavelConferenciaResumido: (linha.respConferencia || '').split(' ')[0] || null,
                    numeroNP:        npAbrev,
                    npTextoAlerta:   temTextoDiverso ? npRaw : null,
                    proadAteste:     linha.proadAteste || null,
                };
            } else {
                _sheetsCache[c.chaveCache] = null;
            }
        });
    }

    function consultarResponsaveisSheets(cnpj, numeroNF, dataEmissao) {
        const chaveCache = `${cnpj}|${numeroNF}|${dataEmissao}`;
        return consultarResponsaveisEmLote([{ cnpj, numeroNF, dataEmissao, chaveCache }])
            .then(() => {
                const val = _sheetsCache[chaveCache];
                return val ? { responsavelAnalise: val, responsavelConferencia: null,
                               responsavelAnaliseResumido: val.split(' ')[0],
                               responsavelConferenciaResumido: null } : null;
            });
    }

