    // CPF pode vir do Sheets como número (perde zeros à esquerda) ou notação científica —
    // mesmo tratamento do normalizarCNPJLocal, mas com 11 dígitos.
    function normalizarCPFLocal(val) {
        if (val === null || val === undefined) return '';
        let s = String(val).trim();
        if (!s) return '';
        if (/e\+?\d+$/i.test(s)) {
            const n = Number(s.replace(',', '.'));
            if (Number.isFinite(n)) {
                s = Math.trunc(n).toLocaleString('fullwide', { useGrouping: false });
            }
        }
        s = s.replace(/\.0+$/, '').replace(/\D/g, '');
        if (!s) return '';
        if (s.length > 11) s = s.slice(0, 11);
        return s.padStart(11, '0');
    }

    // Nº RPA: "08000826RA000262" — normaliza para maiúsculas e só alfanuméricos,
    // pra tolerar espaços/traços digitados na planilha.
    function normalizarRPALocal(val) {
        if (val === null || val === undefined) return '';
        return String(val).toUpperCase().replace(/[^A-Z0-9]/g, '');
    }

    function montarDadosAutonomosAPartirDaAPI(data) {
        const { qtd, valor } = _colunasBatchGetSheets(data);
        const dados = [];
        for (let i = 0; i < qtd; i++) {
            const r = {
                respAnalise:     valor(0, i), // C
                respConferencia: valor(1, i), // D
                numeroNP:        valor(2, i), // G — Nº RP
                proadAteste:     valor(3, i), // I — PROAD Solicitação
                cnpj:            normalizarCPFLocal(valor(4, i)), // L — CPF
                numeroNF:        normalizarRPALocal(valor(5, i)), // N — Nº RPA
                dataEmissao:     normalizarDataLocal(valor(6, i)), // P
            };
            if (r.cnpj && r.numeroNF && r.dataEmissao) dados.push(r);
        }
        return dados;
    }

    async function baixarPlanilhaAutonomosDaAPI({ silencioso = false, signal = null } = {}) {
        if (!silencioso) logDebug('[SIGEO×Sheets-Aut] Carregando planilha de autônomos via API...');
        const opts = { method: 'GET', headers: { 'Accept': 'application/json' } };
        if (signal) opts.signal = signal;
        const res = await fetch(SHEETS_AUTONOMOS_API_URL, opts);
        if (!res.ok) throw new Error(`[SIGEO×Sheets-Aut] HTTP ${res.status} ao buscar planilha de autônomos`);
        const data = await res.json();
        return montarDadosAutonomosAPartirDaAPI(data);
    }

    function carregarPlanilhaAutonomos() {
        return new Promise((resolve) => {
            if (_dadosPlanilhaAutonomos !== null) { resolve(_dadosPlanilhaAutonomos); return; }
            if (_carregandoPlanilhaAutonomos) { _callbacksPendentesAutonomos.push(resolve); return; }

            _carregandoPlanilhaAutonomos = true;
            baixarPlanilhaAutonomosDaAPI({ silencioso: false })
                .then(dados => {
                    _dadosPlanilhaAutonomos = dados;
                    _indicePlanilhaAutonomos = construirIndicePlanilha(dados);
                    _hashPlanilhaAutonomos = JSON.stringify(dados);
                    logDebug(`[SIGEO×Sheets-Aut] ${_dadosPlanilhaAutonomos.length} registros de autônomos carregados`);
                })
                .catch(e => {
                    console.error('[SIGEO×Sheets-Aut] Erro na API/parse de autônomos:', e);
                    _dadosPlanilhaAutonomos = [];
                    _indicePlanilhaAutonomos = new Map();
                    _hashPlanilhaAutonomos = JSON.stringify([]);
                })
                .finally(() => {
                    _carregandoPlanilhaAutonomos = false;
                    resolve(_dadosPlanilhaAutonomos);
                    _callbacksPendentesAutonomos.forEach(cb => cb(_dadosPlanilhaAutonomos));
                    _callbacksPendentesAutonomos = [];
                });
        });
    }

    async function consultarResponsaveisAutonomosEmLote(chaves) {
        await carregarPlanilhaAutonomos();
        const indice = _indicePlanilhaAutonomos || new Map();
        chaves.forEach(c => {
            if (_sheetsCacheAutonomosResp[c.chaveCache] !== undefined) return;

            const correspondencias = indice.get(`${c.cnpj}|${c.numeroNF}|${c.dataEmissao}`) || [];

            if (correspondencias.length > 1) {
                _sheetsCacheAutonomosResp[c.chaveCache] = { duplicado: true, responsavelAnalise: correspondencias.map(l => l.respAnalise).filter(Boolean).join(', ') };
            } else if (correspondencias.length === 1) {
                const linha = correspondencias[0];
                const npRaw = linha.numeroNP || '';
                const npMatch = npRaw.match(/(NP|RP)(\d+)/i);
                const npAbrev = npMatch ? `${npMatch[1].toUpperCase()}${parseInt(npMatch[2], 10)}` : null;
                const temTextoDiverso = npRaw && !npMatch && !npRaw.match(/^DH/i);

                _sheetsCacheAutonomosResp[c.chaveCache] = {
                    responsavelAnalise:              linha.respAnalise || null,
                    responsavelConferencia:          linha.respConferencia || null,
                    responsavelAnaliseResumido:      (linha.respAnalise || '').split(' ')[0] || null,
                    responsavelConferenciaResumido:  (linha.respConferencia || '').split(' ')[0] || null,
                    numeroNP:        npAbrev,
                    npTextoAlerta:   temTextoDiverso ? npRaw : null,
                    proadAteste:     linha.proadAteste || null,
                };
            } else {
                _sheetsCacheAutonomosResp[c.chaveCache] = null;
            }
        });
    }

    /**
     * Extrai a chave de cruzamento de um registro RPA do SIGEO:
     * CPF (11 dígitos) + Nº RPA normalizado + data de emissão ISO.
     */
    function extrairChaveRPADoRegistro(registro) {
        if (!registro) return null;

        const cpfRaw       = registro?.fornecedor?.documento || '';
        const numeroRPARaw = registro?.numero                || '';
        const dataEmissaoRaw = registro?.dataEmissao         || '';

        if (!cpfRaw || !numeroRPARaw || !dataEmissaoRaw) {
            console.warn('[SIGEO×Sheets-Aut] Campos insuficientes para RPA. cpf=', cpfRaw, '| rpa=', numeroRPARaw, '| data=', dataEmissaoRaw);
            return null;
        }

        const cnpj     = String(cpfRaw).replace(/\D/g, '').padStart(11, '0');
        const numeroNF = normalizarRPALocal(numeroRPARaw);

        let dataEmissao = '';
        const sData = String(dataEmissaoRaw).trim();
        const mISO  = sData.match(/^(\d{4})-(\d{2})-(\d{2})/);
        const mBR   = sData.match(/^(\d{2})\/(\d{2})\/(\d{4})/);
        if (mISO) {
            dataEmissao = `${mISO[1]}-${mISO[2]}-${mISO[3]}`;
        } else if (mBR) {
            dataEmissao = `${mBR[3]}-${mBR[2]}-${mBR[1]}`;
        } else {
            try {
                const d = new Date(dataEmissaoRaw);
                if (!isNaN(d)) dataEmissao = d.toISOString().split('T')[0];
            } catch (_) {}
        }

        if (!dataEmissao) return null;

        return { cnpj, numeroNF, dataEmissao };
    }

