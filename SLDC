                })(),
                codigoMunicipio: extrairValorXML(xmlDoc, ['MunicipioIncidencia', 'CodigoMunicipio', 'cLocIncid']),
                optanteSimplesNacional: extrairValorXML(xmlDoc, ['OptanteSimplesNacional']),
                regimeEspecialTributacao: extrairValorXML(xmlDoc, ['RegimeEspecialTributacao']),
