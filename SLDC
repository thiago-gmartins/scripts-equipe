  async function esperar(condicao, timeout = 10000, intervalo = 120) {
    const inicio = Date.now();
    while (Date.now() - inicio < timeout) {
      const valor = await condicao();
      if (valor) return valor;
      await sleep(intervalo);
    }
    return null;
  }

  function texto(el) {
    return String(el?.textContent || '').trim();
  }

  function somenteNumeros(valor) {
    return String(valor || '').replace(/\D/g, '');
  }

  function normalizarProad(valor) {
    return String(valor || '')
      .replace(/PROAD/gi, '')
      .trim()
      .replace(/\s+/g, '')
      .replace(/[^\d/]/g, '');
  }

  function normalizarNumeroEmpenho(valor) {
    const txt = String(valor || '').trim().toUpperCase();
    const match = txt.match(/(\d{4}NE\d{6})/i);
    return match ? match[1] : '';
  }

  function extrairEmpenhosTexto(valor) {
    const txt = String(valor || '').toUpperCase();
    const matches = txt.match(/\d{4}NE\d+/gi) || [];
    const vistos = new Set();
    const lista = [];

    for (const m of matches) {
      const emp = normalizarNumeroEmpenho(m);
      if (emp && !vistos.has(emp)) {
        vistos.add(emp);
        lista.push(emp);
      }
    }

    return lista;
  }

  function isVisible(el) {
    if (!el) return false;
    const r = el.getBoundingClientRect();
    const s = getComputedStyle(el);
    return r.width > 0 && r.height > 0 && s.visibility !== 'hidden' && s.display !== 'none';
  }

  function clicarElemento(el) {
    if (!el) return false;
    try {
      el.scrollIntoView({ block: 'center', inline: 'center' });
    } catch {}
    el.dispatchEvent(new MouseEvent('pointerdown', { bubbles: true }));
    el.dispatchEvent(new MouseEvent('mousedown', { bubbles: true }));
    el.dispatchEvent(new MouseEvent('mouseup', { bubbles: true }));
    el.dispatchEvent(new MouseEvent('click', { bubbles: true }));
    if (typeof el.click === 'function') el.click();
    return true;
  }

  const FormatacaoAutonomos = {
    formatarValorBrasileiro(valor) {
      if (valor === null || valor === undefined || valor === '') return '';
      const num = typeof valor === 'string'
        ? Number(String(valor).replace(/\./g, '').replace(',', '.'))
        : Number(valor);
      if (Number.isNaN(num)) return '';
      return num.toLocaleString('pt-BR', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      });
    },

    formatarDataBrasileira(dataISO) {
      if (!dataISO) return '';
      const txt = String(dataISO);
      if (/^\d{2}\/\d{2}\/\d{4}$/.test(txt)) return txt;

      const partes = txt.includes('T')
        ? txt.split('T')[0].split('-')
        : txt.split(' ')[0].split('-');

      if (partes.length !== 3) return txt;
      const [ano, mes, dia] = partes;
      return `${dia}/${mes}/${ano}`;
    }
  };

