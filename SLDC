    function mostrarSnackbar(message) {
        // Remove snackbar anterior se existir
        let oldSnackbar = document.getElementById('snackbar-msg');
        if (oldSnackbar) oldSnackbar.remove();

        // Criar snackbar
        // div branca do modal — qualquer um dos modais de resultado
        const modalContent =
            document.querySelector('#modal-final-sigeo > div > div') ||
            document.querySelector('#modal-alugueis-sigeo > div > div') ||
            document.querySelector('#modal-manutenção-predial > div > div') ||
            document.querySelector('#modal-servicos-sigeo > div > div') ||
            document.querySelector('#modal-autonomos-sigeo > div > div');
        const snackbar = document.createElement('div');
        snackbar.id = 'snackbar-msg';
        snackbar.textContent = message;
        snackbar.style.backgroundColor = '#006d00';
        snackbar.style.color = '#fff';
        snackbar.style.padding = '14px 24px';
        snackbar.style.borderRadius = '4px';
        snackbar.style.boxShadow = '0px 2px 10px rgba(0,0,0,0.3)';
        snackbar.style.fontFamily = 'Roboto, Arial, sans-serif';
        snackbar.style.fontSize = '14px';
        snackbar.style.opacity = '0';
        snackbar.style.transition = 'opacity 0.3s ease-in-out';

        // Container do modal, com position: relative para conter a posição absoluta
        let container = document.getElementById('modal-final-sigeo') || document.querySelector('#modal-alugueis-sigeo > div > div');
        if (!container) container = document.body;

        // Se container não tem position, forçar relative para posicionar o snackbar
        const style = window.getComputedStyle(container);
        if (style.position === 'static') {
            container.style.position = 'relative';
        }

        if (modalContent) {
            modalContent.insertBefore(snackbar, modalContent.firstChild);
        } else {
            // Sem modal aberto: exibe fixo no topo da página.
            snackbar.style.cssText += 'position:fixed;top:16px;left:50%;transform:translateX(-50%);z-index:1000000;';
            document.body.appendChild(snackbar);
        }

        // Fade in
        requestAnimationFrame(() => {
            snackbar.style.opacity = '1';
        });

        // Fade out + remover após 5s
        setTimeout(() => {
            snackbar.style.opacity = '0';
            snackbar.addEventListener('transitionend', () => snackbar.remove());
        }, 2500);
    }

    function copiarClipboard(texto) {
        navigator.clipboard.writeText(texto).then(() => {
            mostrarSnackbar('Conteúdo copiado para a área de transferência.');
        }).catch(err => {
            mostrarErroSnackbar('Erro ao copiar para área de transferência: ' + err);
        });
    }


    function atualizarProgresso(atual, total, status) {
        const progressoAtual = document.getElementById('progresso-atual');
        const barraProgresso = document.getElementById('barra-progresso');
        const statusProgresso = document.getElementById('status-progresso');

        if (progressoAtual) progressoAtual.textContent = atual;
