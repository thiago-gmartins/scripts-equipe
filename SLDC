    // ─── CONTA BANCÁRIA: ORIGEM POR MÓDULO ──────────────────────────────────
    // Regra vigente: SAÚDE usa o cadastro do FORNECEDOR (primeira conta ativa
    // em /fornecedores/{id}/contasBancarias/jt). TODOS os demais módulos
    // (aluguéis, serviços, manutenção predial e autônomos) usam o cadastro da
    // CONTRATAÇÃO — a conta vinculada ao contrato/PROAD.
    //
    // Se true, quando a contratação não tiver conta bancária o robô cai para a
    // conta ativa do fornecedor em vez de deixar os campos em branco.
    const PERMITIR_FALLBACK_FORNECEDOR = false;

    // Cache por PROAD+documento para não repetir a mesma consulta no lote.
    const cacheContratacoesContaBancaria = new Map();

    async function buscarContaBancariaContratacao(proad, cnpjCpfFornecedor, token) {
        const chaveCache = `${proad || ''}|${cnpjCpfFornecedor || ''}`;
        if (cacheContratacoesContaBancaria.has(chaveCache)) {
            return cacheContratacoesContaBancaria.get(chaveCache);
        }

        let resultado = null;

        try {
            // 1) Filtra por PROAD principal
            let url = `https://api.sigeo.jt.jus.br/sidof-service/contratacoes/jt?pageSize=10&pageIndex=0`;
            if (proad) url += `&processoAdministrativo=${encodeURIComponent(proad)}`;
            const resp = await fetch(url, { headers: { 'Authorization': `Bearer ${token}` } });
            if (!resp.ok) throw new Error(resp.status);
            const data = await resp.json();
            for (const cont of (data?.results || [])) {
                if (cont?.contaBancaria) {
                    resultado = { contratacao: cont, contaBancaria: cont.contaBancaria };
                    break;
                }
            }

            // 2) Fallback: filtra por CNPJ/CPF do fornecedor
            if (!resultado && cnpjCpfFornecedor) {
                const url2 = `https://api.sigeo.jt.jus.br/sidof-service/contratacoes/jt?pageSize=10&pageIndex=0&cnpjCpfFornecedor=${cnpjCpfFornecedor}`;
                const resp2 = await fetch(url2, { headers: { 'Authorization': `Bearer ${token}` } });
                if (resp2.ok) {
                    const data2 = await resp2.json();
                    for (const cont of (data2?.results || [])) {
                        if (cont?.contaBancaria) {
                            resultado = { contratacao: cont, contaBancaria: cont.contaBancaria };
                            break;
                        }
                    }
                }
            }
        } catch (e) {
            console.warn('[SIGEO] buscarContaBancariaContratacao erro:', e);
        }

        cacheContratacoesContaBancaria.set(chaveCache, resultado);
        return resultado;
    }

    // Garante documento.contaBancariaContratacao: usa a conta já embutida no
    // registro da listagem e, se não houver, consulta o cadastro de contratações.
    async function definirContaBancariaContratacao(documento, registro, token) {
        let conta = registro?.contratacao?.contaBancaria
            || documento?.contratacao?.contaBancaria
            || null;

        if (!conta) {
            const proad = String(
                registro?.contratacao?.processoAdministrativo
                || documento?.contratacao?.processoAdministrativo
                || ''
            ).replace(/PROAD/gi, '').trim();
            const cnpjCpf = String(
                registro?.fornecedor?.documento
                || documento?.fornecedor?.documento
                || ''
            ).replace(/\D/g, '');

            const achado = await buscarContaBancariaContratacao(proad, cnpjCpf, token);
            conta = achado?.contaBancaria || null;
            if (achado?.contratacao && !documento.contratacao) {
                documento.contratacao = achado.contratacao;
            }
            if (!conta) {
                console.warn(`[SIGEO] Contratação sem conta bancária (PROAD=${proad || '?'}, doc=${cnpjCpf || '?'}).`);
            }
        }

        documento.contaBancariaContratacao = conta;
        documento.origemContaBancaria = 'contratacao';
        return conta;
    }

    // Fonte ÚNICA da conta usada tanto na tela quanto na cópia para a planilha.
    function obterContaBancariaParaSaida(doc) {
        if (doc?.origemContaBancaria === 'fornecedor') {
            return obterPrimeirosDadosBancariosAtivos(doc?.dadosBancarios);
        }

        const conta = doc?.contaBancariaContratacao
            || doc?.dadosBancarios?.contaBancaria
            || doc?.contratacao?.contaBancaria
            || null;

        if (conta) return conta;

        return PERMITIR_FALLBACK_FORNECEDOR
            ? obterPrimeirosDadosBancariosAtivos(doc?.dadosBancarios)
            : null;
    }

    function registroEhNFSe(registro) {
        // Sinal estrutural do próprio SIGEO: quando existe notaFiscalServico.id,
        // o documento é uma NFS-e. A planilha onde uma linha histórica foi encontrada
        // nunca pode transformar uma NFS-e em Mercadoria.
        return !!registro?.notaFiscalServico?.id;
    }

    function inferirDestinoPlanilhaServico(registroSelecionado) {
        // v11.40.27 — regra de precedência por natureza fiscal.
        // NFS-e é serviço por definição do próprio registro do SIGEO e deve permanecer
        // em Serviços, ainda que CNPJ+NF+data também exista/tenha existido na planilha
        // Água/Correios/Energia/Mercadoria/Telefonia.
        if (registroEhNFSe(registroSelecionado)) return 'servicos';

        // Para documentos que NÃO são NFS-e, preserva a regra histórica de destino
        // pela existência inequívoca da chave na planilha correspondente.
        const chave = extrairChaveNFDoRegistro(registroSelecionado);
        if (!chave) return null;
        const k = `${chave.cnpj}|${chave.numeroNF}|${chave.dataEmissao}`;
        const emServicos = (_indicePlanilhaServicos?.get(k) || []).length > 0;
        const emMercadoria = (_indicePlanilhaMercadoria?.get(k) || []).length > 0;
        if (emServicos && !emMercadoria) return 'servicos';
        if (emMercadoria && !emServicos) return 'mercadoria';
        return null;
    }

    async function processarLinhaServico(linhaInfo, documento, registroSelecionado) {
        const idNFServico = registroSelecionado?.notaFiscalServico?.id;
        const idDocFiscal = registroSelecionado?.id;

        // NFS-e nunca é Mercadoria. Grava isso antes do enriquecimento com PROAD/TRD
        // para que toda a cadeia use a classificação correta.
        documento.ehNFSe = !!idNFServico;
        documento.destinoPlanilha = idNFServico
            ? 'servicos'
            : (documento.destinoPlanilha || inferirDestinoPlanilhaServico(registroSelecionado));

        // Tenta XML via endpoint NFS-e
        if (idNFServico && !documento.xml) {
            const dadosXML = await capturarXMLNotaFiscal(idNFServico, BEARER_TOKEN);
            if (dadosXML) { documento.xml = dadosXML; documento.fontes.push('xml'); }
        }

        // Tenta PDF via endpoint NFS-e
        if (idNFServico && !documento.pdf) {
            const dadosPDF = await capturarPDFNotaFiscal(idNFServico, BEARER_TOKEN);
            if (dadosPDF) { documento.pdf = dadosPDF; documento.pdfTexto = dadosPDF.textoCompleto; documento.fontes.push('pdf'); }
        }

        // Fallback para NFe de mercadoria: usa endpoint genérico de documentos fiscais
        if (!documento.pdf && idDocFiscal) {
            const dadosPDF = await capturarPDFAluguel(idDocFiscal, BEARER_TOKEN);
            if (dadosPDF) { documento.pdf = dadosPDF; documento.pdfTexto = dadosPDF.textoCompleto; documento.fontes.push('pdf-arquivo'); }
            logDebug('[SIGEO Serviços] PDF via /arquivo/jt id=' + idDocFiscal, !!dadosPDF);
        }

        // PROAD: busca o TRD e traz competência e data da última assinatura
        await enriquecerComTRD(documento, registroSelecionado, 'servicos', linhaInfo);
    }

    async function processarLoteManutençãoPredial() {
        if (config.processandoLote) {
            mostrarErroSnackbar('Já existe um processamento em andamento. Aguarde...');
            return;
        }

        config.processandoLote = true;
        documentosProcessados.length = 0;

        try {
            let linhasSelecionadas = manutencoesPredenciaisSelecionadas.map(c => c.linha);

            if (linhasSelecionadas.length === 0) {
                mostrarErroSnackbar('Nenhuma linha selecionada! Marque as checkboxes das notas fiscais que deseja processar.');
                config.processandoLote = false;
                return;
            }

            logDebug(`[SIGEO Script] Iniciando processamento de ${linhasSelecionadas.length} linha(s)...`);
            carregarIndiceCadastroProadGeral('manutencao').catch(() => {});

            exibirModalProgresso(linhasSelecionadas.length);

            for (let i = 0; i < linhasSelecionadas.length; i++) {
                atualizarProgresso(i + 1, linhasSelecionadas.length, 'processando');

                let documento = {};
                let dados_linha = await processarLinha(linhasSelecionadas[i], i, manutencoesPredenciaisSelecionadas[i], 'manutenção-predial');
                documento = {
                    ...manutencoesPredenciaisSelecionadas[i]
                    , ...dados_linha
                }
                documento.linha = linhasSelecionadas[i];
                documento.uuid = crypto.randomUUID();

                // Validação do tomador
                const CNPJ_TRT3_MAN = '01298583000141';
                documento.tomadorCnpj = documento?.xml?.tomadorCnpj || null;
                documento.tomadorNome = documento?.xml?.tomadorNome || null;
                documento.tomadorFonte = documento?.xml?.tomadorCnpj ? 'xml' : null;
                documento.tomadorOk = documento.tomadorCnpj === CNPJ_TRT3_MAN;

                documentosProcessados.push(documento);

                atualizarProgresso(i + 1, linhasSelecionadas.length, documento.status);

                await new Promise(resolve => setTimeout(resolve, 800));
            }

            logDebug('[SIGEO Script] Buscando CSV para dados adicionais...');
            await simularCliqueCSV();

            setTimeout(() => {
                exibirModalManutençãoPredial();
            }, 1000);

        } catch (error) {
            console.error('[SIGEO Script] Erro no processamento em lote:', error);
            mostrarErroSnackbar('Erro no processamento: ' + error.message);
        } finally {
            config.processandoLote = false;
        }
    }

