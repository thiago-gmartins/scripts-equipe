    // ========== AGUARDAR OVERLAY ABRIR ==========
    function aguardarOverlay() {
        return new Promise((resolve) => {
            let finalizado = false;
            let observer = null;
            let tempoMaximo = null;

            const localizarOverlay = () => {
                // Não depende de .mat-menu-content (classe antiga do Angular Material).
                // Identifica o pane pelo conteúdo que efetivamente precisamos.
                const panes = [...document.querySelectorAll('.cdk-overlay-pane')].reverse();
                return panes.find(pane => {
                    const icones = [...pane.querySelectorAll('button mat-icon')];
                    return icones.some(icon =>
                        icon.textContent.trim() === 'picture_as_pdf'
                        || icon.classList.contains('icon_xml'));
                }) || null;
            };

            const concluir = (overlay) => {
                if (finalizado) return;
                finalizado = true;
                if (tempoMaximo) clearTimeout(tempoMaximo);
                if (observer) observer.disconnect();
                resolve(overlay);
            };

            observer = new MutationObserver(() => {
                const overlay = localizarOverlay();
                if (overlay) {
                    logDebug('[SIGEO Script] Overlay detectado');
                    concluir(overlay);
                }
            });
            observer.observe(document.body, { childList: true, subtree: true });

            const existente = localizarOverlay();
            if (existente) {
                concluir(existente);
                return;
            }

            tempoMaximo = setTimeout(() => {
                console.warn('[SIGEO Script] Timeout aguardando overlay');
                concluir(null);
            }, 4000);
        });
    }


    // v11.40.25 — fallback excepcional pela contratação atual da própria NF.
    // Abre o modal de edição da LINHA ATUAL, confirma que é a NF esperada, lê o
    // PROAD mostrado em "Contratação" e fecha por Cancelar. Nunca confirma alteração.
    // Usado em Manutenção e Serviços quando o Cadastro não resolve o PROAD com segurança.
    async function obterProadPrincipalAtualNoModalSIGEO(linhaInfo, numeroNotaEsperado = null, contextoRotulo = 'SIGEO') {
        const botaoEditar = linhaInfo?.botoes?.edit;
        if (!botaoEditar) return null;

        const pausa = ms => new Promise(resolve => setTimeout(resolve, ms));
        const notaEsperada = _pNotaDeReferencia(numeroNotaEsperado) || '';

        const localizarDialogo = () => {
            const candidatos = [
                ...document.querySelectorAll(
                    'mat-dialog-container, .mat-dialog-container, .mat-mdc-dialog-container, .cdk-overlay-pane'
                )
            ].reverse();
            return candidatos.find(el => {
                const t = String(el?.textContent || '').replace(/\s+/g, ' ').trim();
                return /Edi[cç][aã]o\s+de\s+Nota\s+Fiscal/i.test(t)
                    && /Contrata[cç][aã]o/i.test(t);
            }) || null;
        };

        const coletar = dialogo => {
            const partes = [];
            const add = v => {
                const s = String(v ?? '').replace(/\s+/g, ' ').trim();
                if (s) partes.push(s);
            };
            add(dialogo?.textContent);
            add(dialogo?.innerText);
            for (const el of dialogo?.querySelectorAll(
                'mat-select,.mat-select-trigger,.mat-select-value,.mat-select-value-text,'
                + '.mat-mdc-select-trigger,.mat-mdc-select-value,.mat-mdc-select-value-text,'
                + '[role="combobox"],input,textarea'
            ) || []) {
                add(el.textContent);
                add(el.innerText);
                add(el.value);
                add(el.getAttribute?.('aria-label'));
                add(el.getAttribute?.('aria-valuetext'));
                add(el.getAttribute?.('title'));
            }
            return partes.join(' | ');
        };

        const modalEhDaNotaEsperada = dialogo => {
            if (!notaEsperada) return true;
            const valores = [...(dialogo?.querySelectorAll('input') || [])]
                .map(el => String(el.value || '').trim())
                .filter(Boolean);
            if (valores.some(v => _pNotaDeReferencia(v) === notaEsperada)) return true;

            const texto = coletar(dialogo);
            const nums = texto.match(/\d{1,20}/g) || [];
            return nums.some(n => _pNotaDeReferencia(n) === notaEsperada);
        };

        const fecharSemSalvar = async dialogo => {
            const cancelar = [...(dialogo?.querySelectorAll('button') || [])]
                .find(btn => /^Cancelar$/i.test(String(btn.textContent || '').trim()));
            if (cancelar) cancelar.click();
            else {
                document.dispatchEvent(new KeyboardEvent('keydown', {
                    key: 'Escape', code: 'Escape', keyCode: 27, which: 27,
                    bubbles: true, cancelable: true
                }));
            }

            const limite = Date.now() + 1500;
            while (Date.now() < limite && localizarDialogo()) await pausa(50);
        };

        let dialogo = null;
        try {
            // Não reutiliza um modal antigo por engano.
            const antigo = localizarDialogo();
            if (antigo) await fecharSemSalvar(antigo);

            botaoEditar.click();
            const limiteAbertura = Date.now() + 4000;
            while (Date.now() < limiteAbertura) {
                await pausa(80);
                dialogo = localizarDialogo();
                if (dialogo && modalEhDaNotaEsperada(dialogo)) break;
            }

            if (!dialogo || !modalEhDaNotaEsperada(dialogo)) {
                console.warn(
                    `[SIGEO×PROAD] ${contextoRotulo} NF ${notaEsperada || '?'}: `
                    + 'não consegui confirmar o modal da própria nota; fallback antigo será mantido.'
                );
                if (dialogo) await fecharSemSalvar(dialogo);
                return null;
            }

            let proad = null;
            const limiteValor = Date.now() + 4000;
            while (Date.now() < limiteValor) {
                const texto = coletar(dialogo);
                const pos = texto.search(/Contrata[cç][aã]o/i);
                const janela = pos >= 0 ? texto.slice(pos, pos + 1800) : texto;
                const m = janela.match(/\bPROAD\s*[-–—:]?\s*(\d+\s*\/\s*20\d{2})\b/i)
                    || texto.match(/\bPROAD\s*[-–—:]?\s*(\d+\s*\/\s*20\d{2})\b/i);
                if (m) {
                    proad = _pProc(m[1]);
                    break;
                }
                await pausa(120);
            }

            if (proad) {
                console.log(
                    `[SIGEO×PROAD] ${contextoRotulo} NF ${notaEsperada || '?'}: `
                    + `contratação atual lida no SIGEO → ${proad}`
                );
            } else {
                console.warn(
                    `[SIGEO×PROAD] ${contextoRotulo} NF ${notaEsperada || '?'}: `
                    + 'modal correto abriu, mas o PROAD da Contratação não ficou legível.'
                );
            }

            await fecharSemSalvar(dialogo);
            return proad;
        } catch (e) {
            console.warn(
                `[SIGEO×PROAD] ${contextoRotulo} NF ${notaEsperada || '?'}: falha ao ler a contratação atual — `
                + `${e?.message || e}`
            );
            if (dialogo) {
                try { await fecharSemSalvar(dialogo); } catch (_) {}
            }
            return null;
        }
    }

    async function capturarAtestes(idDocumentoFiscal, tokenBearer) {
        const url = `https://api.sigeo.jt.jus.br/sidof-service/atestesDocumentosFiscais/jt?idDocumentoFiscal=${encodeURIComponent(idDocumentoFiscal)}&idUnidadeGestora=80008&apenasSemRegistroLiquidacao=false&sortField=data&sortDirection=desc&pageSize=20&pageIndex=0`;

        try {
            const response = await fetch(url, {
                method: 'GET',
                headers: {
                    'Authorization': 'Bearer ' + tokenBearer,
                    'Accept': 'application/json'
                }
            });

            if (!response.ok) {
                throw new Error(`Erro na requisição: ${response.status} ${response.statusText}`);
            }

            const data = await response.json();

            if (!Array.isArray(data.results)) {
                throw new Error('Formato inesperado da resposta: "results" não é um array');
            }

            // Itera pelos registros e monta o objeto desejado
            const atestes = data.results.map(registro => {
                const valor = registro.valor || 0;
                const valorPrimeiroGrau = registro.valorPrimeiroGrau || 0;
                return {
                    id: registro.id,
                    valor: valor,
                    valorGlosa: registro.valorGlosa || 0,
                    valorPrimeiroGrau: valorPrimeiroGrau,
                    valorSegundoGrau: valor - valorPrimeiroGrau
                };
            });

            return atestes;

        } catch (error) {
            console.error('Erro ao capturar atestes:', error);
            return [];
        }
    }


