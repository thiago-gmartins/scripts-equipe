    // ==========================================================================

    const CORES = {
        TRANSPARENTE: 'transparent',
        VERDE_CLARO: '#e8f5e9',
        AMARELO_CLARO: '#fff9c4',
        VERMELHO_CLARO: '#ffebee',
        PRETO: 'black'
    };

    // ══════════════════════════════════════════════════════════════════════════
    // MÓDULO PROAD — TRD (Termo de Recebimento Definitivo)   ·   arquitetura v2
    // --------------------------------------------------------------------------
    // POR QUE ASSIM: o PROAD tem filtro anti-CSRF. O GET atravessa de outra
    // origem, mas o POST do rowSelect volta 403 — o servidor emite um cookie
    // `csfcfc` novo a cada GET e exige recebê-lo de volta, o que só acontece em
    // requisição same-site. Nenhum cabeçalho resolve isso de forma confiável.
    //
    // SOLUÇÃO: o mesmo userscript roda também no PROAD (@match), e lá ele vira um
    // TRABALHADOR. O lado SIGEO manda o pedido por GM_setValue; o trabalhador
    // executa com fetch same-origin (sem CSRF, sem 403), processa o PDF na
    // própria aba e devolve um JSON pequeno. Os 573 KB do PDF nunca trafegam
    // entre as abas.
    //
    // Se não houver aba do PROAD aberta, o cliente abre uma em segundo plano e
    // a fecha sozinho após 60 s de ociosidade.
    // ══════════════════════════════════════════════════════════════════════════

    const PROAD_CFG = {
        base: 'https://proad.trt3.jus.br',
        caminhoFicha: '/proad/pages/fichadoprocesso.xhtml',
        paginaLeve: '/proad/pages/estoutratando.xhtml',   // usada para abrir o trabalhador
        filtroTRD: /(?:^|[^A-Za-z0-9])TRD(?:$|[^A-Za-z0-9])|Recebimento[\s_-]*Definitivo|Termo[^]{0,40}Recebimento/i,
        maxTrdsPorProcesso: 5,          // 4 providências em paralelo + 1 tentativa no principal
        timeoutPedidoMs: 14000,       // trabalhador tem prazos internos menores e deve responder antes daqui
        timeoutAbrirAbaMs: 7000,
        ociosidadeParaFecharMs: 60000
    };

    function proadLog(...args) { logDebug('[SIGEO×PROAD]', ...args); }

    // ─── Normalizadores ────────────────────────────────────────────────────────
    // Declarados como `function` (não `const`) de propósito: assim ficam
    // disponíveis por hoisting mesmo quando o trabalhador retorna cedo na IIFE.
    function _pSemEspacos(s) { return String(s || '').replace(/\s+/g, ''); }
    function _pSoDigitos(s)  { return String(s || '').replace(/\D/g, ''); }
    function _pProc(s)  { const m = _pSemEspacos(s).match(/(\d+)\/(\d{4})/); return m ? `${Number(m[1])}/${m[2]}` : null; }
    function _pData(s)  { const m = String(s || '').match(/(\d{2})\s*\/\s*(\d{2})\s*\/\s*(\d{4})/); return m ? `${m[1]}/${m[2]}/${m[3]}` : null; }
    function _pValor(s) { const m = _pSemEspacos(s).match(/[\d.]+,\d{2}/); return m ? parseFloat(m[0].replace(/\./g, '').replace(',', '.')) : null; }
    function _pPausa(ms) { return new Promise(r => setTimeout(r, ms)); }

    function _pSemAcentos(s) {
        return String(s || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    }

    function _pUnicos(lista) {
        return [...new Set((lista || []).filter(Boolean))];
    }

    // Número de NF usado na comparação interna. Remove apenas formatação e zeros
    // à esquerda; não presume que todo bloco com quatro dígitos seja ano.
    function _pNumeroNota(s) {
        const d = _pSoDigitos(s);
        return d ? d.replace(/^0+(?=\d)/, '') : '';
    }

    function _pEhAno(s) {
        return /^20\d{2}$/.test(String(s || '').trim());
    }

    function _pNumeroNotaParaPROAD(documento, registro) {
        // Prioriza o número fiscal real. `numeroDocumento` pode ser uma chave
        // interna longa da NFS-e (ex.: 202600000000380), não o nº fiscal 380.
        const candidatos = [
            { origem: 'SIGEO.numero', valor: registro?.numero },
            { origem: 'XML.numero', valor: documento?.xml?.numero },
            { origem: 'XML.numeroNota', valor: documento?.xml?.numeroNota },
            { origem: 'SIGEO.documentoFiscalNumero', valor: registro?.documentoFiscalNumero },
            { origem: 'SIGEO.numeroDocumento', valor: registro?.numeroDocumento },
            { origem: 'documento.numero', valor: documento?.numero }
        ];

        for (const c of candidatos) {
            const normalizado = _pNotaDeReferencia(c.valor);
            if (!normalizado) continue;

            const chaveInterna = String(registro?.numeroDocumento || '').trim();
            const chaveNormalizada = _pNotaDeReferencia(chaveInterna);
            if (
                chaveInterna
                && _pSoDigitos(chaveInterna).length >= 10
                && chaveNormalizada
                && chaveNormalizada !== normalizado
                && c.origem !== 'SIGEO.numeroDocumento'
            ) {
                console.log(
                    `[SIGEO×PROAD] número fiscal para busca: ${normalizado} `
                    + `(fonte ${c.origem}); ignorando chave interna ${chaveInterna}`
                );
            }
            return normalizado;
        }
        return '';
    }

    // Há TRDs com 2025/202 (ano/número) e outros com 2375913/2026
    // ou 2672/2026 (número/ano). Detecta de que lado está o ano.
    // Algumas NFS-e do SIGEO também trazem uma CHAVE INTERNA sem barra:
    // AAAA + zeros de preenchimento + número fiscal, ex. 202600000000380.
    function _pNotaDeReferencia(ref) {
        const s = String(ref || '').trim();

        // v11.40.11 — algumas faturas de telecom usam número/MMYYYY no próprio
        // identificador fiscal, por exemplo 011096193/072026. No SIGEO, a mesma
        // NF aparece sem a barra e sem o zero inicial: 11096193072026.
        // A regra é deliberadamente restrita: o lado direito precisa ser MMYYYY
        // com mês válido, portanto não altera os formatos tradicionais número/AAAA.
        const mNumeroMesAno = s.match(/^\s*(\d{1,20})\s*\/\s*((?:0?[1-9]|1[0-2])20\d{2})\s*$/);
        if (mNumeroMesAno) {
            return _pNumeroNota(`${mNumeroMesAno[1]}${mNumeroMesAno[2]}`);
        }

        const m = s.match(/(\d{1,20})\s*\/\s*(\d{1,20})/);
        if (m) {
            const a = m[1], b = m[2];
            if (_pEhAno(a) && !_pEhAno(b)) return _pNumeroNota(b);
            if (_pEhAno(b) && !_pEhAno(a)) return _pNumeroNota(a);
            if (_pEhAno(b)) return _pNumeroNota(a);
            if (_pEhAno(a)) return _pNumeroNota(b);
            return _pNumeroNota(a);
        }

        const digitos = _pSoDigitos(s);

        // Regra restrita para não mutilar números fiscais longos:
        // ano plausível + pelo menos 5 zeros de padding + nº final de até 8 dígitos.
        const chaveInterna = digitos.match(/^(20\d{2})0{5,}([1-9]\d{0,7})$/);
        if (chaveInterna) {
            const fiscal = _pNumeroNota(chaveInterna[2]);
            if (fiscal) {
                console.log(`[SIGEO×PROAD] chave interna de NFS-e normalizada: ${digitos} → NF ${fiscal}`);
                return fiscal;
            }
        }

        return _pNumeroNota(s);
    }

    function _pCompFlexivel(s) {
        const bruto = String(s || '').replace(/\u00a0/g, ' ');
        const n = _pSemAcentos(bruto).toLowerCase();
        const meses = {
            janeiro: 1, jan: 1, fevereiro: 2, fev: 2, marco: 3, mar: 3,
            abril: 4, abr: 4, maio: 5, mai: 5, junho: 6, jun: 6,
            julho: 7, jul: 7, agosto: 8, ago: 8, setembro: 9, set: 9, sept: 9,
            outubro: 10, out: 10, novembro: 11, nov: 11, dezembro: 12, dez: 12
        };

        // Segurança: competência NÃO é inferida de números soltos. Só são aceitos
        // padrões inequívocos de mês/ano. Se nada confiável for encontrado, retorna
        // null para a planilha sinalizar ausência em vez de inventar um valor.
        const anoMaximo = new Date().getFullYear() + 1;
        const normalizarAno = (txt) => {
            const raw = String(txt || '').trim();
            const ano = Number(raw.length === 2 ? `20${raw}` : raw);
            return Number.isInteger(ano) && ano >= 2000 && ano <= anoMaximo ? ano : null;
        };
        const formatar = (mes, anoTxt) => {
            const ano = normalizarAno(anoTxt);
            return ano ? `${String(Number(mes)).padStart(2, '0')}/${ano}` : null;
        };

        // 1) Forma textual compacta — a mais segura em TRDs:
        //    julho.26 | junho/2025 | março-2026
        // Tem prioridade sobre datas por extenso como "18 de agosto de 2026".
        const reMesCompacto = /\b(janeiro|jan|fevereiro|fev|marco|mar|abril|abr|maio|mai|junho|jun|julho|jul|agosto|ago|setembro|set|sept|outubro|out|novembro|nov|dezembro|dez)\s*[\/.\-]\s*(20\d{2}|\d{2})\b/g;
        for (const m of n.matchAll(reMesCompacto)) {
            const r = formatar(meses[m[1]], m[2]);
            if (r) return r;
        }

        // 2) Forma numérica inequívoca — 07/2026, 07.2026 ou 07-2026.
        // Regras de borda impedem:
        //    04/08/2026 -> NÃO extrair 04/2008 nem 08/2026
        //    R$ 5.160,73 -> NÃO extrair 05/2016
        //    2144/2024   -> NÃO extrair trecho interno como competência
        const reNum = /(?<![\d\/])(0?[1-9]|1[0-2])\s*[\/.\-]\s*(20\d{2}|\d{2})(?![\d\/,])/g;
        for (const m of bruto.matchAll(reNum)) {
            const ini = m.index || 0;
            const contexto = _pSemAcentos(bruto.slice(Math.max(0, ini - 55), ini)).toLowerCase();
            const depois = bruto.slice(ini + m[0].length, ini + m[0].length + 45);

            // v11.40.15 — não tratar o primeiro DD/MM de um intervalo de datas como
            // competência MM/AA. Ex.: "11/07 a 10/08/2026" antes virava 11/2007.
            // A segunda data completa já é bloqueada pelas bordas do próprio reNum.
            if (/^\s*(?:a|à|ate|até|-)\s*\d{1,2}\s*\/\s*\d{1,2}\s*\/\s*(?:20)?\d{2}\b/i.test(depois)) {
                continue;
            }

            // Mesmo com a forma MM/AAAA, não aceita se estiver claramente rotulada
            // como outro identificador.
            if (/(?:proad|processo|contrato|doc(?:umento)?|ptres|nota\s+fiscal|\bnf)\s*(?:n[ºo°]?\s*)?[:#.-]?\s*$/.test(contexto)) {
                continue;
            }

            const r = formatar(m[1], m[2]);
            if (r) return r;
        }

        // 3) "julho de 2026". Só aceita quando NÃO faz parte de uma data civil
        // completa ("18 de agosto de 2026"), comum no rodapé/assinaturas.
        const reMesDeAno = /\b(janeiro|jan|fevereiro|fev|marco|mar|abril|abr|maio|mai|junho|jun|julho|jul|agosto|ago|setembro|set|sept|outubro|out|novembro|nov|dezembro|dez)\s+de\s+(20\d{2}|\d{2})\b/g;
        for (const m of n.matchAll(reMesDeAno)) {
            const ini = m.index || 0;
            const antes = n.slice(Math.max(0, ini - 28), ini);
            if (/\b\d{1,2}\s+de\s*$/.test(antes)) continue; // data: "18 de agosto..."
            const r = formatar(meses[m[1]], m[2]);
            if (r) return r;
        }

        // 4) Último recurso: mês por extenso logo após o rótulo, com o ano vindo
        // do próprio trecho — "AGOSTO – 3/08/2026 a 18/08/2026". As regras acima
        // não pegam porque o ano não está colado ao mês e as datas completas são
        // (corretamente) bloqueadas. Olha só o começo do trecho: mais adiante
        // viria a data de assinatura do rodapé, que não é competência.
        const cabeca = n.slice(0, 60);
        const mMes = cabeca.match(/\b(janeiro|fevereiro|marco|abril|maio|junho|julho|agosto|setembro|outubro|novembro|dezembro)\b/);
        if (mMes) {
            const mAno = n.slice(0, 140).match(/\b(20\d{2})\b/);
            if (mAno) {
                const r = formatar(meses[mMes[1]], mAno[1]);
                if (r) return r;
            }
        }

        return null;
    }

    function _pNormalizarTextoTRD(textoBruto) {
        return String(textoBruto || '')
            .replace(/\u00a0/g, ' ')
            // Nº(s) da(s) Nota(s) Fiscal(is) -> Nº da Nota Fiscal
            .replace(/\((?:s|es|is|ns|ais)\)/gi, '')
            .replace(/[ \t]+/g, ' ')
            .replace(/\r/g, '');
    }

    function _pTemCompetenciaMultipla(trecho) {
        const s = String(trecho || '').replace(/\u00a0/g, ' ');

        // Forma compacta usada no Termo de Recebimento da Saúde Ocupacional:
        // "07 e 08 /2026". Nesse caso não há uma competência única para a planilha.
        if (/\b(0?[1-9]|1[0-2])\s*(?:e|,|;)\s*(0?[1-9]|1[0-2])\s*\/\s*(20\d{2})\b/i.test(s)) {
            return true;
        }

        // Também cobre "07/2026 e 08/2026", sem capturar pedaços de datas
        // DD/MM/AAAA ou identificadores como PROAD/contrato número/ano.
        const unicas = new Set();
        for (const m of s.matchAll(/(?<![\d\/])(0?[1-9]|1[0-2])\s*\/\s*(20\d{2})(?![\d\/])/g)) {
            unicas.add(`${String(Number(m[1])).padStart(2, '0')}/${m[2]}`);
            if (unicas.size > 1) return true;
        }
        return false;
    }

    function _pExtrairNotasDoTrecho(trecho) {
        let s = String(trecho || '').replace(/\u00a0/g, ' ');
        const notas = [];

        // Primeiro consome referências com barra para não transformar o ano em NF.
        s = s.replace(/\b\d{1,20}\s*\/\s*\d{1,20}\b/g, ref => {
            notas.push(_pNotaDeReferencia(ref));
            return ' ';
        });

        // Descrições de documento às vezes usam NF_2026_153 ou NF-2026-153.
        s = s.replace(/\b20\d{2}\s*[_-]\s*\d{1,20}\b/g, ref => {
            notas.push(_pNotaDeReferencia(ref.replace(/[_-]/g, '/')));
            return ' ';
        });
        s = s.replace(/\b\d{1,20}\s*[_-]\s*20\d{2}\b/g, ref => {
            notas.push(_pNotaDeReferencia(ref.replace(/[_-]/g, '/')));
            return ' ';
        });

        // Restaram números simples: ex. 63304 ou o segundo item de "2025/202 e 203".
        for (const m of s.matchAll(/\b\d{1,20}\b/g)) {
            if (_pEhAno(m[0])) continue;
            notas.push(_pNumeroNota(m[0]));
        }
        return _pUnicos(notas);
    }

    function _pExtrairBlocosNotasTRD(t) {
        const blocos = [];
        // Formas observadas: "Nº da Nota Fiscal Eletrônica" e
        // "Notas Fiscais Eletrônicas" (sem Nº). Evita a frase introdutória.
        const rotulo = /(?:N[ºo°]\s*(?:da\s*)?Nota(?:s)?\s+Fiscal(?:is)?(?:\s+Eletr[ôo]nica(?:s)?)?|Notas\s+Fiscais\s+Eletr[ôo]nicas?|Nota\s+Fiscal\s+Eletr[ôo]nica\s+n[ºo°])/gi;
        let m;
        while ((m = rotulo.exec(t)) !== null) {
            const antes = t.slice(Math.max(0, m.index - 70), m.index);
            // Não confundir "Datas de emissão das Notas Fiscais..." nem
            // "Valor Global das Notas Fiscais..." com o campo que lista as NFs.
            if (/(?:emiss[ãa]o|valor\s+global)[^]{0,35}$/i.test(antes)) continue;

            const ini = rotulo.lastIndex;
            const resto = t.slice(ini, ini + 600);
            const corte = resto.search(/\b(?:Data(?:s)?\s+de\s+emiss|M[êe]s\s+de\s+compet[êe]ncia|Valor\s+Global|DADOS\s+PARA\s+O\s+CENTRO|Observa[çc][õo]es?|Processo\s+(?:PROAD|e\s*-?\s*PAD)|Contrato\s+n?[ºo°]?|Fornecedor\s*\/\s*Prestador|CNPJ\s+n?[ºo°]?|Objeto\s+(?:recebido)?|Belo\s+Horizonte)\b/i);
            const bloco = (corte >= 0 ? resto.slice(0, corte) : resto).trim();

            // Campo de tabela começa diretamente com número ou "NF ...".
            // Menções em texto corrido ("notas fiscais eletrônicas supracitadas") não.
            if (/^(?:(?:NF(?:S\s*-?\s*e)?\s*(?:n\s*\.?\s*[ºo°]?\s*)?)|(?:N\s*\.?\s*[ºo°]?\s*)|(?:Nota\s+Fiscal\s*:?\s*))?\d/i.test(bloco)) {
                blocos.push(bloco);
            }
        }
        return blocos;
    }

    function _pExtrairNotasTRD(t) {
        // 1) Modelo Saúde/Unimed: várias NFS-e aparecem numa frase corrida.
        // Essa é a evidência mais forte para TRDs de múltiplas notas e deve ser
        // resolvida antes das referências individuais.
        const listasCorridas = [];
        const reLista = /\bNFS?\s*-\s*e(?:s)?\b\s*([0-9\s,;._\/-]{3,320}?)(?=\s+e\s+aos?\s+documentos|\s+e\s+os\s+documentos|\s+colacionad|\s+PROAD\b|\s+referente\b|\s+relativ|\s+compet[êe]ncia\b|\s+contrat|\s+CNPJ\b|$)/gi;
        let ml;
        while ((ml = reLista.exec(t)) !== null) {
            listasCorridas.push(..._pExtrairNotasDoTrecho(ml[1]));
        }
        if (listasCorridas.length) return _pUnicos(listasCorridas);

        // 2) Referências explícitas fortes em texto corrido:
        // "NF 2026/2632", "NF 2632/2026", "Nota Fiscal 2632".
        //
        // Alguns PDFs gerados pelo Word embaralham visualmente os dígitos do
        // campo tabular. O mesmo TRD costuma repetir a NF corretamente no corpo.
        // Quando existe essa segunda referência explícita, ela prevalece sobre
        // qualquer fragmento lido da tabela. NÃO concatenamos dígitos.
        const notasExplicitas = [];
        // O lookbehind descarta "Data de emissão da Nota Fiscal ..." (nunca traz NF) e
        // o \b + lookahead impedem capturar só o "1" de "19/08/2026": a trava antiga
        // olhava depois da captura e o "9/08/2026" restante não a acionava.
        const reExplicita = /(?<!Data\s+de\s+emiss[ãa]o\s+da\s+)(?:\bNF(?:S\s*-?\s*e)?\b|Nota\s+Fiscal(?:\s+Eletr[ôo]nica)?(?:\s+n\s*\.?\s*[ºo°]?)?)\s*[:#._-]?\s*((?:20\d{2}\s*[\/_-]\s*)?\d{1,20}(?:\s*\/\s*(?:20\d{2}|(?:0?[1-9]|1[0-2])20\d{2}))?)\b(?!\s*[\/-]\s*\d)/gi;
        let me;
        while ((me = reExplicita.exec(t)) !== null) {
            const antes = t.slice(Math.max(0, me.index - 100), me.index);
            const depois = t.slice(me.index + me[0].length, me.index + me[0].length + 24);

            // Rótulos de tabela não são referências à NF. Sem esta trava,
            // "Valor Global da Nota Fiscal Eletrônica 33.740,77" vira NF 33.
            if (/(?:Data(?:s)?\s+de\s+emiss[ãa]o\s+da|Valor\s+Global\s+da)\s*$/i.test(antes)) continue;

            // Nunca aceita o dia de uma data como NF.
            // Ex.: "Data de emissão da Nota Fiscal Eletrônica 19/08/2026".
            if (/^\s*\/\s*\d{1,2}\s*\/\s*20\d{2}\b/.test(depois)) continue;

            let ref = me[1].replace(/_/g, '/');
            ref = ref.replace(/(20\d{2})-(\d+)/, '$1/$2').replace(/(\d+)-(20\d{2})/, '$1/$2');
            const nf = _pNotaDeReferencia(ref);
            if (nf) notasExplicitas.push(nf);
        }
        // 3) Campo tabular padrão.
        //
        // Importante: alguns TRDs com várias NFs repetem o rótulo apenas uma vez:
        //     Nº(s) da(s) Nota(s) Fiscal(is) Eletrônica(s)  2518/2026
        //                                                  2519/2026
        // Nesse layout a etapa de referência explícita acima encontra apenas a primeira
        // NF, porque a segunda linha não repete "NF"/"Nota Fiscal". Antes retornávamos
        // imediatamente e nunca chegávamos ao bloco tabular.
        //
        // Para preservar a proteção contra PDFs fragmentados, NÃO juntamos tabela e
        // referência explícita indiscriminadamente. Só ampliamos a lista quando o bloco
        // tabular contém ao menos uma das NFs explícitas; essa sobreposição confirma que
        // estamos lendo o mesmo campo, permitindo acrescentar com segurança as demais NFs.
        const notasTabela = [];
        for (const bloco of _pExtrairBlocosNotasTRD(t)) {
            notasTabela.push(..._pExtrairNotasDoTrecho(bloco));
        }

        if (notasExplicitas.length) {
            const explicitas = _pUnicos(notasExplicitas);
            const tabela = _pUnicos(notasTabela);
            const conjuntoExplicitas = new Set(explicitas);
            const haSobreposicaoSegura = tabela.some(nf => conjuntoExplicitas.has(nf));

            if (haSobreposicaoSegura) {
                const combinadas = _pUnicos([...explicitas, ...tabela]);
                if (combinadas.length > explicitas.length) {
                    console.log(
                        `[PROAD worker] TRD com múltiplas NFs no mesmo campo: `
                        + `referência explícita ${explicitas.join(', ')} ampliada pelo bloco tabular para `
                        + `${combinadas.join(', ')}.`
                    );
                }
                return combinadas;
            }

            return explicitas;
        }

        if (notasTabela.length) return _pUnicos(notasTabela);

        // 4) JasperReports observado no PROAD 3243/2025:
        // o pdf.js extrai TODOS os rótulos primeiro e só depois os valores:
        //
        // "Número da nota fiscal eletrônica: ... Data ... Competência ... 3243/2025
        //  ePAD 24599/2024 ... 2026/380 21/07/2026 07/2026 ..."
        //
        // Nesse layout não existe proximidade textual entre o rótulo e a NF.
        // O fallback abaixo é propositalmente MUITO restrito:
        // somente ANO/NÚMERO (ano plausível à esquerda), dentro do cabeçalho do TRD.
        // Isso não casa PROAD/ePAD 3243/2025, contratos número/ano, datas DD/MM/AAAA
        // ou competência MM/AAAA, pois neles o ano está à direita.
        const cabecalho = String(t || '').slice(0, 5000);
        const anosNumero = [];
        for (const x of cabecalho.matchAll(/\b(20\d{2})\s*\/\s*([1-9]\d{0,11})\b/g)) {
            const ano = Number(x[1]);
            const numero = _pNumeroNota(x[2]);
            if (ano < 2000 || ano > new Date().getFullYear() + 1) continue;
            if (!numero) continue;
            anosNumero.push(numero);
        }

        return _pUnicos(anosNumero);
    }

    function _pExtrairProadPrincipalTRD(t) {
        // Limita a procura ao cabeçalho para não capturar referências a outros
        // PROADs nas observações de um TRD complementar.
        const cab = String(t || '').slice(0, 3000);
        let m = cab.match(/Processo\s+PROAD\s+(?:principal\s*)?(?:n[ºo°]\s*)?:?\s*(\d+\s*\/\s*20\d{2})/i);
        if (m) return _pProc(m[1]);

        // Ex.: "Processo e-PAD - (PRINCIPAL) 42548/2023 PROAD 1990/2024".
        m = cab.match(/Processo\s+e\s*-?\s*PAD[^]{0,180}?\bPROAD\s*(?:n[ºo°]\s*)?:?\s*(\d+\s*\/\s*20\d{2})/i);
        if (m) return _pProc(m[1]);

        m = cab.match(/PROAD\s+principal\s*(?:n[ºo°]\s*)?:?\s*(\d+\s*\/\s*20\d{2})/i);
        return m ? _pProc(m[1]) : null;
    }

    function _pExtrairProadPagamentoTRD(t) {
        // Alguns modelos modernos trazem explicitamente o processo usado para o
        // pagamento/solicitação. Se estiver no próprio TRD, não precisamos procurar
        // outra providência apenas para descobrir este número.
        const cab = String(t || '').slice(0, 3500);
        const m = cab.match(/Processo\s+PROAD\s+(?:de\s+)?pagamento\s*(?:n[ºo°]\s*)?:?\s*(\d+\s*\/\s*20\d{2})/i);
        return m ? _pProc(m[1]) : null;
    }

    function _pNotasMarcadasNaDescricao(descricao) {
        const texto = String(descricao || '');
        const notas = [];
        const re = /(?:\bNF(?:S\s*-?\s*e)?\b|Nota\s+Fiscal(?:\s+Eletr[ôo]nica)?(?:\s+n?[ºo°])?)\s*[:#._-]?\s*((?:20\d{2}\s*[\/_-]\s*)?\d{1,20}(?:\s*\/\s*(?:20\d{2}|(?:0?[1-9]|1[0-2])20\d{2}))?)/gi;
        let m;
        while ((m = re.exec(texto)) !== null) {
            let ref = m[1].replace(/_/g, '/');
            ref = ref.replace(/(20\d{2})-(\d+)/, '$1/$2').replace(/(\d+)-(20\d{2})/, '$1/$2');
            notas.push(_pNotaDeReferencia(ref));
        }
        return _pUnicos(notas);
    }

    function proadDescricaoMencionaNota(descricao, numeroNota) {
        const alvo = _pNotaDeReferencia(numeroNota);
        if (!alvo) return false;
        const marcadas = _pNotasMarcadasNaDescricao(descricao);
        if (marcadas.includes(alvo)) return true;

        // Fallback apenas para priorização de candidatos. A confirmação real
        // continua sendo feita dentro do PDF pelo array trd.notas.
        const esc = alvo.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        return /(?:TRD|Recebimento|Nota|NF)/i.test(String(descricao || ''))
            && new RegExp(`(^|\\D)0*${esc}(\\D|$)`).test(String(descricao || ''));
    }

    // ─── Leitura da ficha e dos documentos ─────────────────────────────────────
    // "16/07/2026" → epoch. Usado para ordenar candidatos por proximidade entre a
    // juntada do documento e o ateste da nota.
    function _pDataParaMs(d) {
        const m = String(d || '').match(/(\d{2})\/(\d{2})\/(\d{4})/);
        return m ? Date.UTC(+m[3], +m[2] - 1, +m[1]) : null;
    }

    function proadListarDocumentos(doc) {
        const linhas = [...doc.querySelectorAll('tr')].filter(tr => {
            if (tr.hasAttribute('data-rk')) return true;
            const t = (tr.textContent || '').replace(/\s+/g, ' ').trim();
            return /DOCUMENTO|TRD|Recebimento|Termo|Medi[cç][aã]o|Nota|Certid/i.test(t)
                && /\b\d{1,8}\b/.test(t);
        });

        return linhas.map((tr, indice) => {
            const tds = [...tr.querySelectorAll('td')]
                .map(td => td.textContent.replace(/\s+/g, ' ').trim());

            const elNumero = tr.querySelector('[id$="docNumero"], [id$="numeroDocumento"]');
            const elDesc = tr.querySelector('[id$="docDescricao"], [id$="descricaoDocumento"]');

            const numero = (elNumero?.textContent || '').replace(/\s+/g, ' ').trim()
                || tds.find(v => /^\d{1,8}$/.test(v)) || '';

            let descricao = (elDesc?.textContent || '').replace(/\s+/g, ' ').trim();
            if (!descricao) {
                descricao = tds.find(v =>
                    /DOCUMENTO|TRD|Recebimento|Termo|Medi[cç][aã]o|Nota|Certid/i.test(v)
                    && !/^\d+$/.test(v)
                ) || tds.join(' ');
            }

            let rowKey = tr.getAttribute('data-rk')
                || tr.querySelector('[data-rk]')?.getAttribute('data-rk')
                || '';
            if (!rowKey) {
                const onclick = tr.getAttribute('onclick') || tr.innerHTML || '';
                const m = onclick.match(/(?:instantSelectedRowKey|selection)[^:=]*[:=]["']?([^,"' }<]+)/i);
                if (m) rowKey = m[1];
            }

            return {
                rowKey,
                numero,
                descricao,
                // A linha tem dois tooltips (assinantes e cadastro); só o segundo traz a
                // data. Fallback: a coluna "Data da Juntada" da própria tabela.
                cadastradoEm: ([...tr.querySelectorAll('.ui-tooltip-text')]
                    .map(el => (el.textContent || '').match(/Cadastrado\s+por[\s\S]{0,160}?em\s*(\d{2}\/\d{2}\/\d{4})/i))
                    .find(Boolean) || [])[1]
                    || (tds.find(v => /^\d{2}\/\d{2}\/\d{4}/.test(v)) || null),
                assinantes: (tr.querySelector('img[alt*="Assinado por"]')?.getAttribute('alt') || '')
                    .replace(/^Assinado por:\s*/i, '').replace(/^\[|\]\s*$/g, '').trim(),
                _indiceDom: indice
                };
                }).filter(d => d.descricao && (d.numero || d.rowKey));
    }

    // Parser tolerante aos layouts reais de TRD encontrados no PROAD.
    // A informação decisiva para o casamento é o array `notas`, sempre normalizado.
    function proadParseTRD(textoBruto) {
        const t = _pNormalizarTextoTRD(textoBruto);
        const pega = re => { const m = t.match(re); return m ? m[1] : null; };

        const notas = _pExtrairNotasTRD(t);

        // Saúde e alguns modelos não rotulam o CNPJ de forma uniforme; mantém fallback
        // para o primeiro CNPJ em formato completo encontrado no termo.
        const cnpjRotulado = pega(/CNPJ\s*n?[ºo°]?\s*:?\s*(\d{2}[.\s]?\d{3}[.\s]?\d{3}[\/\s]?\d{4}[-\s]?\d{2})/i);
        const cnpjSolto = pega(/(\d{2}\.\s?\d{3}\.\d{3}\/\s?\d{4}\s?-\s?\d{2})/);

        // Usa janelas locais porque a ordem dos itens extraídos de tabelas PDF pode
        // colocar o valor entre "MM" e "/AAAA", por exemplo.
        const mData = /Data(?:s)?\s+de\s+emiss[ãa]o/i.exec(t);
        const janelaData = mData ? t.slice(mData.index, mData.index + 420) : '';
        const datasEmissao = _pUnicos(
            [...janelaData.matchAll(/\b\d{2}\s*\/\s*\d{2}\s*\/\s*\d{4}\b/g)]
                .map(x => _pData(x[0]))
        );

        // Alguns TRDs agrupam as notas por competência, repetindo o rótulo:
        //     Mês de competência do serviço: 04/2026
        //     NF 2745/2026 ... NF 18386/2026
        //     Mês de competência do serviço: 06/2026
        //     NF 5399/2026 ...
        // Nesses casos a competência correta é a do bloco onde a nota aparece.
        const competenciaPorNota = {};
        {
            const reBloco = /M[êe]s\s+de\s+compet[êe]ncia[^:\n]*:?\s*(0?[1-9]|1[0-2])\s*\/\s*(20\d{2})/gi;
            const marcos = [];
            let mb;
            while ((mb = reBloco.exec(t)) !== null) {
                marcos.push({
                    indice: mb.index,
                    fimRotulo: mb.index + mb[0].length,
                    competencia: `${String(Number(mb[1])).padStart(2, '0')}/${mb[2]}`
                });
            }
            // Só faz sentido mapear quando há mais de um bloco: com um só, a
            // competência global já responde e evita-se qualquer efeito colateral.
            if (marcos.length > 1) {
                // Restringe às notas que o parser já reconheceu no documento. Sem isto o
                // mapa recolhe valores, datas e referências a documentos das Observações
                // — inclusive o número do próprio PROAD, que casaria com uma NF homônima.
                const notasLegitimas = new Set(notas);
                for (let i = 0; i < marcos.length; i++) {
                    const ini = marcos[i].fimRotulo;
                    const fim = (i + 1 < marcos.length) ? marcos[i + 1].indice : t.length;
                    const bloco = t.slice(ini, fim);
                    for (const nf of _pExtrairNotasDoTrecho(bloco)) {
                        if (notasLegitimas.has(nf) && !competenciaPorNota[nf]) {
                            competenciaPorNota[nf] = marcos[i].competencia;
                        }
                    }
                }
            }
        }

        const mComp = /M[êe]s\s+de\s+compet[êe]ncia/i.exec(t);
        let janelaComp = '';
        if (mComp) {
            // Em muitos PDFs de tabela o pdf.js entrega TODOS os rótulos primeiro
            // e só depois os valores. Por isso 260 caracteres era pouco para alcançar
            // "julho.26" no TRD da LA Viagens. Vai até o fim do cabeçalho, limitado
            // a 900 caracteres, antes de Centro de Custos/Observações.
            const ini = mComp.index;
            const resto = t.slice(ini, ini + 900);
            const corte = resto.search(/\b(?:Distribui[çc][ãa]o\s+dos\s+gastos|DADOS\s+PARA\s+O\s+CENTRO|Observa[çc][õo]es?)\b/i);
            janelaComp = corte > 0 ? resto.slice(0, corte) : resto;
        }
        let competenciaMultipla = _pTemCompetenciaMultipla(janelaComp);
        let competencia = competenciaMultipla ? null : _pCompFlexivel(janelaComp);

        // v11.40.10 — alguns Termos de Recebimento usam data completa em vez de
        // mês/ano: "Data de competência do serviço (DD/MM/AAAA) 26/08/2026".
        // Quando houver exatamente um mês/ano nesse campo, converte para MM/AAAA.
        // Se aparecerem meses/anos distintos, preserva a regra de segurança e
        // deixa a competência vazia, sem escolher arbitrariamente.
        if (!competencia && !competenciaMultipla) {
            const competenciasPorData = _pUnicos(
                [...t.matchAll(/\bData\s+de\s+compet[êe]ncia(?:\s+do\s+servi[çc]o)?(?:\s*\([^)]{0,60}\))?\s*:?\s*(\d{1,2})\s*\/\s*(\d{1,2})\s*\/\s*(20\d{2})\b/gi)]
                    .map(m => {
                        const dia = Number(m[1]);
                        const mes = Number(m[2]);
                        const ano = Number(m[3]);
                        const anoAtual = new Date().getFullYear();
                        if (dia < 1 || dia > 31 || mes < 1 || mes > 12 || ano < 2000 || ano > anoAtual + 1) {
                            return null;
                        }
                        return `${String(mes).padStart(2, '0')}/${ano}`;
                    })
                    .filter(Boolean)
            );

            if (competenciasPorData.length === 1) {
                competencia = competenciasPorData[0];
            } else if (competenciasPorData.length > 1) {
                competenciaMultipla = true;
                competencia = null;
            }
        }

        if (competenciaMultipla) {
            console.log('[PROAD worker] TRD com mais de uma competência explícita; Competência ficará em branco na planilha.');
        }

        // Fallback para PDFs em que o pdf.js extrai primeiro todos os rótulos da
        // tabela e só depois os valores. Nesses casos, o valor da competência pode
        // aparecer depois de Centro de Custos/PTRES (ex.: "julho.26"). A busca
        // continua restrita ao trecho posterior ao rótulo e para antes de
        // Observações/Belo Horizonte, evitando confundir datas de assinatura.
        if (!competencia && !competenciaMultipla && mComp) {
            const restoAmplo = t.slice(mComp.index, mComp.index + 2400);
            // Não corta em "Belo Horizonte": alguns PDFs (como o TRD da NF
            // 63304) extraem o rodapé da cidade ANTES do valor "julho.26".
            // O limite seguro é Observações, pois a competência pertence ao cabeçalho.
            const corteFinal = restoAmplo.search(/\bObserva[çc][ãa]o(?:es)?\b/i);
            const blocoAmplo = corteFinal > 0 ? restoAmplo.slice(0, corteFinal) : restoAmplo;
            competencia = _pCompFlexivel(blocoAmplo);
        }

        // Modelo Saúde/Unimed:
        // "... referente aos serviços prestados da competência 07/2026 ..."
        if (!competencia && !competenciaMultipla) {
            const mc = t.match(/\bcompet[êe]ncia\s*(?:do\s+servi[çc]o\s*)?(?:[:\-]\s*)?(0?[1-9]|1[0-2])\s*\/\s*(20\d{2})\b/i);
            if (mc) {
                const ano = Number(mc[2]);
                const anoAtual = new Date().getFullYear();
                if (ano >= 2000 && ano <= anoAtual + 1) {
                    competencia = `${String(Number(mc[1])).padStart(2, '0')}/${mc[2]}`;
                }
            }
        }

        const contrato = (pega(/Contrato\s*n?[ºo°]?\s*:?\s*([A-Z0-9.-]+(?:\/20\d{2})?)/i) || '')
            .replace(/\s+/g, '').trim() || null;

        const mValorGlobal = /Valor\s*Global\s+da(?:s)?\s+Nota(?:s)?\s+Fiscal(?:is)?(?:\s+Eletr[ôo]nica(?:s)?)?/i.exec(t);
        let valorGlobal = null;
        if (mValorGlobal) {
            const janelaValor = t.slice(mValorGlobal.index, mValorGlobal.index + 300);
            const corteValor = janelaValor.search(/\b(?:Valor\s+Contratual|Valor\s+Mensal|DADOS\s+PARA|Observa[çc][õo]es?|Distribui[çc][ãa]o|Belo\s+Horizonte)\b/i);
            const blocoValor = corteValor > 0 ? janelaValor.slice(0, corteValor) : janelaValor;
            valorGlobal = _pValor(blocoValor);
        }

        return {
            proadPrincipal: _pExtrairProadPrincipalTRD(t),
            proadPagamento: _pExtrairProadPagamentoTRD(t),
            contrato,
            protocolo: (pega(/N[ºo°]\s*do\s*protocolo\s*:?\s*([\d\s]{3,20}?)\s*(?:Prestador|Fornecedor)/i) || '').trim() || null,
            fornecedor: (pega(/(?:Fornecedor\s*\/\s*)?Prestador\s+de\s+Servi[çc]o[s]?\s*([^]{3,220}?)(?=\s*CNPJ\b)/i) || '')
                .replace(/\s+/g, ' ').trim() || null,
            cnpj: _pSoDigitos(cnpjRotulado || cnpjSolto).slice(0, 14) || null,
            notas,
            datasEmissao,
            dataEmissao: datasEmissao[0] || null,
            competencia,
            // Vazio quando o TRD tem competência única; preenchido quando ela varia
            // por grupo de notas dentro do mesmo documento.
            competenciaPorNota,
            valorGlobal,
            complementar: /\bTRD\s+(?:[ée]\s+)?complementar\b|\bcomplementar\s+ao\s+TRD\b/i.test(t),
            // Não tenta deduzir o número do DOC pelo corpo: TRD complementar pode citar
            // DOCs anteriores. O DOC atual vem da própria ficha do PROAD (`cand.numero`).
            semTexto: _pSemEspacos(t).length < 200
        };
    }

    // Relatório de Medição é usado SOMENTE como fallback de Manutenção Predial
    // quando nenhum TRD da NF é localizado. Reutiliza a leitura segura da NF/CNPJ
    // do parser de TRD, mas nunca herda competência: esse campo deve ficar vazio.
    function proadParseRelatorioMedicao(textoBruto) {
        const base = proadParseTRD(textoBruto);
        const t = _pNormalizarTextoTRD(textoBruto);

        // O relatório de manutenção traz na própria capa "Nota Fiscal: 39".
        // Essa referência tem prioridade porque as páginas seguintes podem conter
        // DANFSe, chave de acesso e datas que não podem virar número de NF.
        const notasCapa = [];
        const cabecalho = t.slice(0, 3500);
        for (const m of cabecalho.matchAll(/Nota\s+Fiscal\s*:?\s*(\d{1,20})(?!\s*\/\s*20\d{2})/gi)) {
            const nf = _pNumeroNota(m[1]);
            if (nf) notasCapa.push(nf);
        }

        return {
            ...base,
            notas: notasCapa.length ? _pUnicos(notasCapa) : (base.notas || []),
            competencia: null,
            tipoDocumento: 'relatorio-medicao'
        };
    }

    function _pTextoPdfEmOrdemVisual(items) {
        // O getTextContent() do pdf.js não garante ordem de leitura visual.
        // PDFs gerados pelo Word podem entregar os dígitos de uma mesma linha
        // fora de sequência. Reconstruímos as linhas pelas coordenadas do item.
        const tokens = (items || [])
            .filter(it => String(it?.str || '').trim())
            .map((it, indice) => {
                const tr = Array.isArray(it.transform) ? it.transform : [];
                const x = Number(tr[4]);
                const y = Number(tr[5]);
                const h = Math.abs(Number(it.height)) || Math.abs(Number(tr[3])) || 10;
                const w = Math.abs(Number(it.width)) || 0;
                return {
                    str: String(it.str || '').trim(),
                    x: Number.isFinite(x) ? x : 0,
                    y: Number.isFinite(y) ? y : 0,
                    h,
                    w,
                    indice
                };
            });

        if (!tokens.length) return '';

        // Primeiro Y decrescente (topo -> base no sistema do PDF), depois X.
        tokens.sort((a, b) => {
            const tol = Math.max(1.8, Math.min(4.5, Math.max(a.h, b.h) * 0.28));
            if (Math.abs(a.y - b.y) <= tol) return (a.x - b.x) || (a.indice - b.indice);
            return b.y - a.y;
        });

        const linhas = [];
        for (const tok of tokens) {
            let melhor = null;
            let melhorDif = Infinity;

            // Normalmente a linha correta está entre as últimas poucas criadas.
            for (let j = Math.max(0, linhas.length - 6); j < linhas.length; j++) {
                const linha = linhas[j];
                const tol = Math.max(1.8, Math.min(4.5, Math.max(tok.h, linha.hMed || tok.h) * 0.30));
                const dif = Math.abs(tok.y - linha.y);
                if (dif <= tol && dif < melhorDif) {
                    melhor = linha;
                    melhorDif = dif;
                }
            }

            if (!melhor) {
                melhor = { y: tok.y, hMed: tok.h, itens: [] };
                linhas.push(melhor);
            }
            melhor.itens.push(tok);
            melhor.y = (melhor.y * (melhor.itens.length - 1) + tok.y) / melhor.itens.length;
            melhor.hMed = (melhor.hMed * (melhor.itens.length - 1) + tok.h) / melhor.itens.length;
        }

        linhas.sort((a, b) => b.y - a.y);

        return linhas.map(linha => {
            linha.itens.sort((a, b) => (a.x - b.x) || (a.indice - b.indice));
            let out = '';
            let fimAnterior = null;
            for (const it of linha.itens) {
                // PDF.js frequentemente divide uma MESMA palavra/número em itens
                // consecutivos. Só insere espaço quando existe separação gráfica real.
                //
                // Ex. Word/PDF observado:
                //   item "263" imediatamente seguido de item "2/2026"
                // deve reconstruir "2632/2026", e não "263 2/2026".
                if (out) {
                    const gap = fimAnterior === null ? Infinity : (it.x - fimAnterior);
                    const toleranciaContato = Math.max(
                        0.45,
                        Math.min(1.35, (Number(it.h) || Number(linha.hMed) || 10) * 0.075)
                    );

                    // Gap positivo acima da tolerância = separação visual real.
                    // Pequeno overlap/contato = fragmentos do mesmo conteúdo.
                    if (!Number.isFinite(gap) || gap > toleranciaContato) out += ' ';
                }
                out += it.str;
                fimAnterior = it.x + (it.w || 0);
            }
            return out.replace(/\s+/g, ' ').trim();
        }).filter(Boolean).join('\n');
    }

    async function proadTextoDoPdf(buffer) {
        if (typeof pdfjsLib === 'undefined') throw new Error('pdf.js indisponível nesta aba');
        if (!pdfjsLib.GlobalWorkerOptions.workerSrc) {
            pdfjsLib.GlobalWorkerOptions.workerSrc =
                'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
        }
        const pdf = await pdfjsLib.getDocument({ data: buffer.slice(0) }).promise;
        let texto = '';
        for (let i = 1; i <= pdf.numPages; i++) {
            const pagina = await pdf.getPage(i);
            const c = await pagina.getTextContent();
            const visual = _pTextoPdfEmOrdemVisual(c.items);
            texto += visual + '\n';
        }
        return texto;
    }

    // ─── Assinaturas digitais (dicionário /Type /Sig dentro do PDF) ────────────
    function _pdfParaLatin1(u8) {
        let s = ''; const CH = 0x8000;
        for (let i = 0; i < u8.length; i += CH) s += String.fromCharCode.apply(null, u8.subarray(i, i + CH));
        return s;
    }

    async function _pdfInflar(bytes) {
        try {
            const ds = new DecompressionStream('deflate');
            const escritor = ds.writable.getWriter();
            escritor.write(bytes).catch(() => {});
            escritor.close().catch(() => {});
            const leitor = ds.readable.getReader();
            const partes = []; let total = 0;
            try {
                while (true) { const { done, value } = await leitor.read(); if (done) break; partes.push(value); total += value.length; }
            } catch (e) { /* lixo no fim do stream: fica com o que já veio */ }
            if (!total) return null;
            const saida = new Uint8Array(total); let off = 0;
            for (const p of partes) { saida.set(p, off); off += p.length; }
            return saida;
        } catch (e) { return null; }
    }

    // Assinaturas ICP-Brasil não preenchem /Name: o nome vem do certificado PKCS#7
    function _pdfNomeDoCertificado(corpus, posSig) {
        const iC = corpus.lastIndexOf('/Contents', posSig);
        if (iC < 0 || posSig - iC > 300000) return null;
        const ini = corpus.indexOf('<', iC), fim = corpus.indexOf('>', ini);
        if (ini < 0 || fim < 0) return null;
        const hex = corpus.slice(ini + 1, fim).replace(/[^0-9A-Fa-f]/g, '');
        let der = ''; const n = hex.length - (hex.length % 2);
        for (let i = 0; i < n; i += 2) der += String.fromCharCode(parseInt(hex.substr(i, 2), 16));
        const cand = der.match(/[A-ZÁÉÍÓÚÂÊÔÃÕÇ][A-ZÁÉÍÓÚÂÊÔÃÕÇ ]{9,58}(?::\d{8,14})?/g) || [];
        const bons = cand.map(c => c.trim()).filter(c => / /.test(c) &&
            !/^(BRASIL|ICP|AUTORIDADE|CERTIFICADORA|SECRETARIA|INSTITUTO|SERVICO|EMPRESA|CAIXA|SERPRO|VALID|SOLUTI|CERTISIGN|SERASA)/.test(c));
        return bons.sort((a, b) => b.length - a.length)[0] || null;
    }

    async function proadExtrairAssinaturas(buffer) {
        const u8 = new Uint8Array(buffer), bruto = _pdfParaLatin1(u8);
        let corpus = bruto;

        const re = /(^|[^d])stream\r?\n/g; let m;      // "stream" que não seja "endstream"
        while ((m = re.exec(bruto)) !== null) {
            const ini = m.index + m[0].length;
            let fim = bruto.indexOf('endstream', ini);
            if (fim < 0) continue;
            while (fim > ini && /[\r\n\s]/.test(bruto[fim - 1])) fim--;
            const inflado = await _pdfInflar(u8.subarray(ini, fim));
            if (inflado) corpus += '\n' + _pdfParaLatin1(inflado);
        }

        const fmt = d => { const x = String(d).match(/D:(\d{4})(\d{2})(\d{2})(\d{2})(\d{2})/);
            return x ? `${x[3]}/${x[2]}/${x[1]} ${x[4]}:${x[5]}` : null; };
        const ord = d => (String(d).match(/D:(\d{14})/) || ['', ''])[1];

        const achadas = []; const reSig = /\/Type\s*\/Sig/g; let s2;
        while ((s2 = reSig.exec(corpus)) !== null) {
            const t = corpus.slice(Math.max(0, s2.index - 700), s2.index + 400);
            let nome = (t.match(/\/Name\s*\(([^)]*)\)/) || [])[1] || null;
            const dt = (t.match(/\/M\s*\(?(D:\d{14})/) || t.match(/(D:\d{14})/) || [])[1] || null;
            if (!nome) nome = _pdfNomeDoCertificado(corpus, s2.index);
            if (nome || dt) achadas.push({ nome: nome ? nome.replace(/:\d+$/, '').trim() : null, data: fmt(dt), o: ord(dt) });
        }

        const unicas = [...new Map(achadas.map(a => [`${a.nome}|${a.data}`, a])).values()]
            .sort((a, b) => a.o.localeCompare(b.o));

        return {
            quantidade: unicas.length,
            assinaturas: unicas.map(({ nome, data }) => ({ nome, data })),
            ultimaAssinatura: unicas.length ? unicas[unicas.length - 1].data : null
        };
    }

    // ══════════════════════════════════════════════════════════════════════════
    // LADO PROAD — o trabalhador
    // Roda quando o script é injetado numa aba do proad.trt3.jus.br. Usa fetch
    // same-origin: os cookies e o token anti-CSRF funcionam normalmente.
    // ══════════════════════════════════════════════════════════════════════════
    function iniciarTrabalhadorProad() {
        // A guarda de domínio faz return antes da inicialização geral do
        // script, então o pdf.js precisa ser configurado aqui também —
        // sem isto, a leitura do PDF morre com "No GlobalWorkerOptions.workerSrc".
        if (typeof pdfjsLib !== 'undefined') {
            pdfjsLib.GlobalWorkerOptions.workerSrc =
                'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
        } else {
            console.error('[PROAD worker] pdf.js não carregou nesta aba — verifique o @require');
        }

        // Usa o MESMO canal versionado do cliente SIGEO.
        const CHAVES = PROAD_CHAVES;
        // Algumas unidades nomeiam o documento apenas como "DOCUMENTO - TRD".
        // A sigla é ambígua, então o conteúdo do PDF é conferido depois.
        // Atenção ao \b: em JavaScript o sublinhado é caractere de palavra, então
        // \bTRD\b NÃO casa em "DIA-01VT_DOC_TRD-Etapa-03" — que é justamente como
        // várias unidades nomeiam o arquivo. A fronteira precisa ser explícita.
        const FILTRO_TRD = /(?:^|[^A-Za-z0-9])TRD(?:$|[^A-Za-z0-9])|Recebimento[\s_-]*Definitivo|Termo[^]{0,40}Recebimento/i;
        const CONFIRMA_TRD = /TERMO\s+DE\s+RECEBIMENTO\s+DEFINITIVO|Atesto\s+o\s+recebimento\s+definitivo|recebimento\s+definitivo\s+do/i;

        function _pConfirmaConteudoTRD(texto, cand = null) {
            const bruto = String(texto || '');
            if (CONFIRMA_TRD.test(bruto)) return true;

            // Alguns PDFs da Secretaria de Saúde usam ligaturas/fontes que o pdf.js
            // converte em caracteres de controle no meio de "Definitivo".
            // Não reconstruímos a palavra: exigimos um conjunto forte de sinais.
            const limpo = bruto
                .replace(/[\u0000-\u001f\u007f]/g, ' ')
                .replace(/[ \t]+/g, ' ');

            const tituloRecebimento = /\bTermo\s+de\s+Recebimento\b/i.test(limpo);
            const atesteRecebimento = /\batesta\s+o\s+recebimento\b|\bAtesto\s+o\s+recebimento\b/i.test(limpo);
            const mencionaNf = /\bNFS?\s*-\s*e\b|\bNota(?:s)?\s+Fiscal(?:is)?\b/i.test(limpo);
            const descricaoEhTRD = !!cand && FILTRO_TRD.test(String(cand.descricao || ''));

            return descricaoEhTRD && tituloRecebimento && atesteRecebimento && mencionaNf;
        }
        // Fallback específico de Manutenção: aceita somente documentos explicitamente
        // descritos/confirmados como Relatório de Medição. Não confunde planilha de
        // medição, NF isolada ou outro documento com um TRD.
        const FILTRO_MEDICAO = /relat[oó]rio[\s_-]*(?:de[\s_-]*)?medi[cç][aã]o/i;
        const CONFIRMA_MEDICAO = /relat[oó]rio\s+de\s+medi[cç][aã]o|Medi[cç][aã]o\s+\d+\s*\/\s*20\d{2}\s*-\s*Termo\s+de\s+Recebimento/i;

        // Algumas unidades formalizam o ateste por CI/Comunicação Interna, em vez de TRD.
        // A descrição sozinha NUNCA basta: o conteúdo precisa mencionar a NF/Fatura exata
        // e declarar, de forma forte, que os serviços foram conferidos/prestados/atestados.
        const FILTRO_CI_ATESTE = /(?:^|\b)CI(?:\b|\s)|comunica[cç][aã]o\s+interna/i;
        const CONFIRMA_CI_ATESTE = /(?:servi[cç]os?|objeto)[^]{0,180}?(?:foram\s+)?(?:conferidos?|atestados?|efetivamente\s+prestados?|recebidos?)[^]{0,180}?(?:conformidade|prestados?|executados?|acordado)|(?:atesto|atestamos|certifico|informo)[^]{0,220}?(?:servi[cç]os?|objeto)[^]{0,180}?(?:prestados?|executados?|recebidos?|conferidos?)/i;
        const MAX_TRDS = 2;   // no máximo 2 TRDs cegos por processo; orçamento total limita ainda mais

        const anunciarVivo = () => { try { GM_setValue(CHAVES.vivo, Date.now()); } catch (e) {} };
        anunciarVivo();
        setInterval(anunciarVivo, 2000);

        const CACHE_FICHAS = new Map();     // "22725/2026" → ficha
        const CACHE_FICHAS_EM_CURSO = new Map(); // deduplica GET simultâneo da mesma ficha
        const CACHE_TRD_DOC = new Map();    // "proc|DOC|rowKey" → PDF já baixado/parseado
        const CACHE_TRD_NOTA = new Map();   // "proc|NF" → DOC já confirmado (inclui TRDs com várias NFs)

        // A certidão da providência referencia o DOC do TRD, não a nota. Num TRD que
        // cobre várias NFs (Unimed: 8 notas no DOC 437), o vínculo PODE ser o mesmo
        // para todas — mas só quando a certidão cita o DOC diretamente. Ver v11.38.1.
        const CACHE_SOLICITACAO_DOC = new Map();   // "proc|DOC[|NF]" → { numero, situacao, docCertidao }
        const CACHE_SOLICITACAO_NOTA = new Map();  // "proc|NF" → prova PROAD+NF antes de localizar TRD

        // v11.40.7 — cobertura da busca corrente. O worker serializa os pedidos, então
        // um único objeto ativo é suficiente e evita poluir todas as assinaturas de função.
        let _pCoberturaAtiva = null;
        function _pCoberturaInc(campo, qtd = 1) {
            if (!_pCoberturaAtiva) return;
            _pCoberturaAtiva[campo] = Number(_pCoberturaAtiva[campo] || 0) + Number(qtd || 0);
        }
        function _pResumoCobertura() {
            const c = _pCoberturaAtiva || {};
            return `cobertura: ${c.providencias || 0} providência(s) candidata(s); `
                + `${c.certidoes || 0} certidão(ões) lida(s); `
                + `${c.trdCandidatos || 0} TRD(s) listado(s) / ${c.trdPdfs || 0} PDF(s) de TRD lido(s); `
                + `${c.genericosCandidatos || 0} documento(s) genérico(s) candidato(s) / ${c.genericosPdfs || 0} PDF(s) lido(s)`
                + ((c.genericosSemTexto || 0) ? `; ${c.genericosSemTexto} sem camada de texto` : '');
        }

        // Texto já extraído de uma certidão, por idArquivo. Guarda a EVIDÊNCIA, nunca
        // o veredito: cada nota revalida o seu próprio bloco sobre este texto. Assim
        // oito notas fazem oito validações independentes com um único download.
        const CACHE_CERTIDAO_TEXTO = new Map();    // idArquivo → texto do PDF
        const CACHE_MEDICAO_DOC = new Map();  // fallback: Relatório de Medição já lido
        const CACHE_MEDICAO_NOTA = new Map(); // "proc|NF" → relatório confirmado
        const CACHE_CI_DOC = new Map();       // "proc|DOC|rowKey" → PDF/texto/assinaturas do CI
        const CACHE_CI_NOTA = new Map();      // "proc|NF" → CI de ateste confirmado
        const MAX_PROVIDENCIAS_RAPIDAS = 4;
        // A ficha do principal pode ser mais pesada do que uma providência. Ela agora é
        // fallback, portanto pode ter um pouco mais de tolerância sem travar o caminho rápido.
        const TIMEOUT_FICHA_MS = 4200;
        const TIMEOUT_LISTA_MS = 2200;
        const TIMEOUT_POSTBACK_MS = 2800;
        const TIMEOUT_PDF_MS = 3200;

        async function _pFetchRapido(url, options = {}, timeoutMs = 2500, rotulo = 'requisição') {
            const controller = new AbortController();
            const timer = setTimeout(() => controller.abort(), timeoutMs);
            try {
                return await fetch(url, { ...options, signal: controller.signal });
            } catch (e) {
                if (e?.name === 'AbortError') {
                    throw new Error(`${rotulo} excedeu ${timeoutMs} ms`);
                }
                throw e;
            } finally {
                clearTimeout(timer);
            }
        }

        function _pProcessoAtualDaPagina() {
            try {
                // Em aba recém-aberta pelo SIGEO, o script inicia em document-start,
                // antes de existir body. A URL direta da ficha já é suficiente para
                // identificar o processo alvo nesse primeiro instante.
                let pelaUrl = null;
                try {
                    const u = new URL(location.href);
                    const n = u.searchParams.get('numeroProtocolo');
                    const a = u.searchParams.get('numeroAno');
                    if (n && a) pelaUrl = _pProc(`${n}/${a}`);
                } catch (_) {}

                if (!document?.body) return pelaUrl;

                // Depois que a página carregou, o cabeçalho visível prevalece, pois
                // navegações AJAX do PROAD podem deixar a URL defasada.
                const texto = String(document.body.innerText || '').replace(/\s+/g, ' ');
                const semOriginal = texto
                    .replace(/PROAD\s+ORIGINAL\s+n\.?\s*\d{1,6}\s*\/\s*20\d{2}/ig, ' ')
                    .replace(/PROAD\s+DE\s+ORIGEM\s+n\.?\s*\d{1,6}\s*\/\s*20\d{2}/ig, ' ');

                const padroes = [
                    /\bFicha\s+do\s+Processo[^]{0,180}?\bPROAD\s+n\.?\s*(\d{1,6}\s*\/\s*20\d{2})/i,
                    /\bPROAD\s+n\.?\s*(\d{1,6}\s*\/\s*20\d{2})/i
                ];
                for (const re of padroes) {
                    const m = semOriginal.match(re);
                    if (m) {
                        const p = _pProc(m[1]);
                        if (p) return p;
                    }
                }
                return pelaUrl;
            } catch (_) {
                return null;
            }
        }

        async function _pAguardarProcessoPronto(alvo, timeoutMs = 5000) {
            const chave = _pProc(alvo);
            const limite = Date.now() + timeoutMs;
            while (Date.now() < limite) {
                const atual = _pProcessoAtualDaPagina();
                if (atual === chave && document?.body) {
                    // Não exige data-rk aqui. Basta a área de documentos ter surgido;
                    // proadListarDocumentos() possui fallbacks próprios.
                    const txt = String(document.body.innerText || '');
                    if (/Documentos/i.test(txt) && document.readyState !== 'loading') return true;
                }
                await _pPausa(80);
            }
            return _pProcessoAtualDaPagina() === chave && !!document?.body;
        }

        function _pFichaAtualDoProcesso(chave) {
            try {
                const alvo = _pProc(chave);
                if (!alvo || _pProcessoAtualDaPagina() !== alvo || !document?.body) return null;
                return {
                    url: location.href,
                    html: document.documentElement?.outerHTML || '',
                    doc: document,
                    origemDomAtual: true
                };
            } catch (_) {
                return null;
            }
        }

        async function lerFicha(numero, ano, opcoes = null) {
            const chave = `${Number(numero)}/${ano}`;
            const forcarFetch = !!opcoes?.forcarFetch;

            // v11.36.18 — modo de recuperação após dynamiccontent 404:
            // NÃO consulta o DOM vivo e NÃO reutiliza CACHE_FICHAS.
            // A ficha precisa vir de um GET real para obter ViewState/form atuais
            // e permitir um rowSelect sintético independente do viewer já aberto.
            if (forcarFetch) {
                const url = `${location.origin}/proad/pages/fichadoprocesso.xhtml`
                    + `?faces-redirect=true&numeroProtocolo=${numero}&numeroAno=${ano}`
                    + `&_trdRetry=${Date.now()}-${Math.random().toString(36).slice(2, 7)}`;

                const r = await _pFetchRapido(
                    url,
                    { credentials: 'include', cache: 'no-store' },
                    TIMEOUT_FICHA_MS,
                    `ficha fresca ${chave}`
                );
                if (!r.ok) throw new Error(`ficha fresca HTTP ${r.status}`);

                const html = await r.text();
                const ficha = {
                    url,
                    html,
                    doc: new DOMParser().parseFromString(html, 'text/html'),
                    origemFetchForcado: true
                };
                CACHE_FICHAS.set(chave, ficha);
                return ficha;
            }

            const fichaAtual = _pFichaAtualDoProcesso(chave);
            if (fichaAtual) {
                CACHE_FICHAS.set(chave, fichaAtual);
                return fichaAtual;
            }
            if (CACHE_FICHAS.has(chave)) return CACHE_FICHAS.get(chave);
            if (CACHE_FICHAS_EM_CURSO.has(chave)) return await CACHE_FICHAS_EM_CURSO.get(chave);

            const promessa = (async () => {
                const url = `${location.origin}/proad/pages/fichadoprocesso.xhtml`
                    + `?faces-redirect=true&numeroProtocolo=${numero}&numeroAno=${ano}`;
                const r = await _pFetchRapido(url, { credentials: 'include' }, TIMEOUT_FICHA_MS, `ficha ${chave}`);
                if (!r.ok) throw new Error(`ficha HTTP ${r.status}`);
                const html = await r.text();
                const ficha = { url, html, doc: new DOMParser().parseFromString(html, 'text/html') };
                CACHE_FICHAS.set(chave, ficha);
                return ficha;
            })();

            CACHE_FICHAS_EM_CURSO.set(chave, promessa);
            try {
                return await promessa;
            } finally {
                CACHE_FICHAS_EM_CURSO.delete(chave);
            }
        }

        // ── Índice das providências da seção ───────────────────────────────────
        // Fallback para quando não há PROAD Principal utilizável. A busca principal
        // de Saúde usa o Cadastro de Credenciados; esta lista só entra como rede de segurança.
        const LISTAS_PROVIDENCIAS = [
            '/proad/pages/estoutratando.xhtml',
            '/proad/pages/minhasareastratando.xhtml'
        ];
        let _indiceProvidencias = null;

        function _pExtrairProvidenciasDeDocumento(d) {
            const itens = [];
            for (const tr of d.querySelectorAll('tr')) {
                const t = tr.textContent.replace(/\s+/g, ' ').trim();
                const numero = (t.match(/(\d{3,6}\/20\d{2})/) || [])[1];
                if (!numero) continue;
                itens.push({
                    numero,
                    origem: (t.match(/(?:Originad[ao]\s+no\s+PROAD|PROAD\s+de\s+origem)\s*n\.?[ºo°]?\s*(\d+\/20\d{2})/i) || [])[1] || null,
                    area: (t.match(/para\s+(SLD[CS])\s+-/) || [])[1] || null,
                    texto: t
                });
            }
            return itens;
        }

        async function carregarIndiceProvidencias(forcarAtualizacao = false) {
            if (_indiceProvidencias && !forcarAtualizacao) return _indiceProvidencias;
            const encontradas = new Map();

            // As duas listas são independentes: carregar em paralelo evita somar dois
            // timeouts quando uma delas estiver lenta. Em uma REVALIDAÇÃO negativa, não
            // reutiliza o DOM nem o cache do navegador: documentos/providências podem ter
            // sido juntados depois que a aba worker foi aberta.
            const respostas = await Promise.allSettled(LISTAS_PROVIDENCIAS.map(async caminho => {
                // No caminho normal, o DOM atual é o atalho mais rápido. No refresh forçado,
                // faz GET real para enxergar providências criadas após a abertura da aba.
                if (!forcarAtualizacao && location.pathname === caminho) {
                    return { caminho, html: document.documentElement.outerHTML };
                }
                const r = await _pFetchRapido(
                    location.origin + caminho,
                    { credentials: 'include', cache: forcarAtualizacao ? 'no-store' : 'default' },
                    TIMEOUT_LISTA_MS,
                    `lista ${caminho}${forcarAtualizacao ? ' (atualização)' : ''}`
                );
                if (!r.ok) throw new Error(`HTTP ${r.status}`);
                return { caminho, html: await r.text() };
            }));

            for (const resp of respostas) {
                if (resp.status !== 'fulfilled') {
                    console.warn('[PROAD worker] lista:', resp.reason?.message || resp.reason);
                    continue;
                }
                const { html } = resp.value;
                const d = new DOMParser().parseFromString(html, 'text/html');
                for (const item of _pExtrairProvidenciasDeDocumento(d)) {
                    if (!item.numero || encontradas.has(item.numero)) continue;
                    // Estas páginas são listas de providências atualmente em tratamento.
                    // Pela regra de negócio, somente elas podem servir de Solicitação.
                    item.situacao = 'Em Aberto';
                    item.emAberto = true;
                    encontradas.set(item.numero, item);
                }
            }

            _indiceProvidencias = [...encontradas.values()];
            console.log(`[PROAD worker] índice: ${_indiceProvidencias.length} providência(s)`);
            return _indiceProvidencias;
        }

        async function _pProvidenciasVinculadasPeloIndice(chavePrincipal, numeroNota, cnpj) {
            const principal = _pProc(chavePrincipal);
            if (!principal) return [];

            const esc = principal.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
            const rePrincipal = new RegExp(`(^|\\D)${esc.replace('/', '\\/')}(\\D|$)`);
            const filtrarLigadas = lista => (lista || []).filter(p => {
                if (_pProc(p.origem) === principal) return true;
                if (_pProc(p.numero) === principal) return false;
                return rePrincipal.test(String(p.texto || ''));
            });

            // Caminho realmente instantâneo: antes de qualquer fetch, olha a própria página
            // do trabalhador. Se a providência vinculada já está visível, segue direto para ela.
            const visiveis = LISTAS_PROVIDENCIAS.includes(location.pathname)
                ? filtrarLigadas(_pExtrairProvidenciasDeDocumento(document).map(p => ({
                    ...p, situacao: 'Em Aberto', emAberto: true
                })))
                : [];
            if (visiveis.length) {
                return _pOrdenarProvidenciasRapido(
                    visiveis, _pNotaDeReferencia(numeroNota), cnpj
                ).slice(0, MAX_PROVIDENCIAS_RAPIDAS);
            }

            let todas = [];
            try {
                todas = await carregarIndiceProvidencias();
            } catch (e) {
                console.warn('[PROAD worker] índice de providências indisponível:', e.message);
                return [];
            }

            let ligadas = filtrarLigadas(todas);

            // v11.40.3 — o índice é mantido em memória enquanto a aba worker permanece
            // aberta. Se nenhuma providência do principal aparece, atualiza UMA vez as
            // listas reais antes de concluir que não há vínculo. Isso cobre solicitações
            // criadas durante o expediente sem transformar toda consulta em fetch extra.
            if (!ligadas.length) {
                try {
                    console.log(`[PROAD worker] ${principal}: nenhuma providência vinculada no índice em memória; atualizando o índice uma vez`);
                    const atualizadas = await carregarIndiceProvidencias(true);
                    ligadas = filtrarLigadas(atualizadas);
                    if (ligadas.length) {
                        console.log(`[PROAD worker] ${principal}: atualização encontrou ${ligadas.length} providência(s) vinculada(s)`);
                    }
                } catch (e) {
                    console.warn(`[PROAD worker] ${principal}: falha ao atualizar índice de providências:`, e?.message || e);
                }
            }

            return _pOrdenarProvidenciasRapido(
                ligadas,
                _pNotaDeReferencia(numeroNota),
                cnpj
            ).slice(0, MAX_PROVIDENCIAS_RAPIDAS);
        }

        function _pPontuarProvidencia(prov, nota, cnpj) {
            const texto = String(prov?.texto || '');
            let pontos = 0;
            if (nota && proadDescricaoMencionaNota(texto, nota)) pontos += 10000;
            const cnpjLimpo = _pSoDigitos(cnpj);
            if (cnpjLimpo && _pSoDigitos(texto).includes(cnpjLimpo)) pontos += 5000;
            if (prov?.emAberto) pontos += 500;
            const m = String(prov?.numero || '').match(/^(\d+)\/(20\d{2})$/);
            if (m) {
                if (Number(m[2]) === new Date().getFullYear()) pontos += 100;
                pontos += Math.min(Number(m[1]) / 100000, 0.99);
            }
            return pontos;
        }

        function _pOrdenarProvidenciasRapido(providencias, nota, cnpj) {
            return [...(providencias || [])].sort((a, b) => {
                const d = _pPontuarProvidencia(b, nota, cnpj) - _pPontuarProvidencia(a, nota, cnpj);
                if (d) return d;
                const nb = Number((String(b.numero || '').match(/^(\d+)/) || [0, 0])[1]);
                const na = Number((String(a.numero || '').match(/^(\d+)/) || [0, 0])[1]);
                return nb - na;
            });
        }

        // Sem PROAD principal, a chave passa a ser nota + CNPJ. O número da nota
        // costuma estar na própria descrição ("..._NF_2026_153"), então dá para
        // escolher onde entrar antes de baixar qualquer PDF.
        async function procurarTRDPorNotaECnpj(numeroNota, cnpj, tetoPdfs) {
            const nota = _pNotaDeReferencia(numeroNota);
            const cnpjLimpo = _pSoDigitos(cnpj);
            const orcamento = { restante: Math.max(1, Number(tetoPdfs) || 4) };
            if (!nota) return { encontrado: false, motivo: 'sem número de nota para procurar' };

            const todas = await carregarIndiceProvidencias();
            if (!todas.length) return { encontrado: false, motivo: 'nenhuma providência nas listas da seção' };

            const ordenadas = _pOrdenarProvidenciasRapido(todas, nota, cnpjLimpo);
            const fortes = ordenadas.filter(p => _pPontuarProvidencia(p, nota, cnpjLimpo) >= 5000);
            const fila = (fortes.length ? fortes : ordenadas).slice(0, MAX_PROVIDENCIAS_RAPIDAS);

            const alvosFortes = [], alvosCegos = [];
            for (const prov of fila) {
                try {
                    const [n, a] = prov.numero.split('/');
                    const ficha = await lerFicha(n, a);
                    const trds = proadListarDocumentos(ficha.doc)
                        .filter(d => FILTRO_TRD.test(d.descricao))
                        .sort((x, y) => Number(y.numero || 0) - Number(x.numero || 0));
                    for (const doc of trds) {
                        const alvo = { prov, ficha, doc };
                        (proadDescricaoMencionaNota(doc.descricao, nota) ? alvosFortes : alvosCegos).push(alvo);
                    }
                } catch (e) {
                    console.warn(`[PROAD worker] não foi possível ler a ficha ${prov.numero}:`, e.message);
                }
            }

            const candidatos = alvosFortes.length ? alvosFortes : alvosCegos;
            const incertosSemCnpj = [];
            for (const alvo of candidatos) {
                if (orcamento.restante <= 0) break;
                try {
                    const analisado = await analisarDocumentoTRD(alvo.prov.numero, alvo.ficha, alvo.doc, orcamento);
                    if (!analisado || analisado.esgotado || !analisado.valido) continue;
                    const { trd } = analisado;
                    if (!trd.notas.includes(nota)) continue;
                    if (cnpjLimpo && trd.cnpj && trd.cnpj !== cnpjLimpo) continue;

                    const registro = montarRegistroTRD(analisado, alvo.prov.numero, alvo.doc,
                        `providência ${alvo.prov.numero}${alvo.prov.origem ? ` (origem ${alvo.prov.origem})` : ''} — localizada por nota + CNPJ`,
                        alvo.prov.numero, nota);
                    registro.casouPelaNota = true;
                    registro.buscaSemProadPrincipal = true;
                    if (cnpjLimpo && !trd.cnpj) {
                        registro.avisoCnpj = 'NF confere, mas o CNPJ não pôde ser lido no TRD; confira manualmente';
                        incertosSemCnpj.push(registro);
                        continue;
                    }
                    return registro;
                } catch (e) {
                    console.warn(`[PROAD worker] ${alvo.prov.numero} DOC ${alvo.doc.numero}:`, e.message);
                }
            }

            if (incertosSemCnpj.length === 1) return incertosSemCnpj[0];
            if (incertosSemCnpj.length > 1) return {
                encontrado: false,
                motivo: `mais de um TRD menciona a nota ${nota}, mas o CNPJ não pôde ser confirmado`
            };
            return {
                encontrado: false,
                motivo: `nota ${nota} não localizada na busca rápida (${fila.length} providência(s), até ${Number(tetoPdfs) || 4} PDF(s))`
            };
        }


        function _pDecodificarEntidadesHtml(s) {
            return String(s || '')
                .replace(/&amp;/gi, '&')
                .replace(/&quot;/gi, '"')
                .replace(/&#39;/gi, "'")
                .replace(/&lt;/gi, '<')
                .replace(/&gt;/gi, '>');
        }

        function _pResolverUrlSemSuperDecodificar(valor, base = location.href) {
            if (!valor) return null;
            let s = _pDecodificarEntidadesHtml(valor).trim();
            if (/^(?:blob:|data:application\/pdf)/i.test(s)) return s;
            if (/^javascript:|^about:/i.test(s)) return null;
            try { return new URL(s, base).href; } catch (_) { return null; }
        }

        function _pArquivoDoViewer(viewerUrl, base = location.href) {
            try {
                const u = new URL(_pDecodificarEntidadesHtml(viewerUrl), base);
                if (!u.searchParams.has('file')) return null;

                // URLSearchParams.get() JÁ faz a decodificação necessária do parâmetro.
                // Não chamar decodeURIComponent novamente: tokens/URLs assinadas podem
                // conter %2F, %2B, %3D etc. e a superdecodificação causa HTTP 404.
                let arquivo = u.searchParams.get('file');
                if (!arquivo) return null;

                // Alguns viewers do PROAD deixam parâmetros que pertencem ao arquivo
                // fora do valor "file". Reanexa parâmetros não pertencentes ao PDF.js.
                const paramsViewer = new Set([
                    'file','page','zoom','pagemode','nameddest','search','phrase',
                    'locale','sidebarView','scrollMode','spreadMode'
                ]);
                const extras = [];
                for (const [k,v] of u.searchParams.entries()) {
                    if (!paramsViewer.has(k)) extras.push([k,v]);
                }

                let urlArquivo = _pResolverUrlSemSuperDecodificar(arquivo, u.href);
                if (!urlArquivo) return null;
                if (extras.length) {
                    const f = new URL(urlArquivo);
                    for (const [k,v] of extras) {
                        if (!f.searchParams.has(k)) f.searchParams.append(k,v);
                    }
                    urlArquivo = f.href;
                }
                return urlArquivo;
            } catch (_) { return null; }
        }

        function _pNormalizarUrlPdfVisivel(valor, base = location.href) {
            if (!valor) return null;
            const s = _pDecodificarEntidadesHtml(valor).trim();
            if (/^(?:blob:|data:application\/pdf)/i.test(s)) return s;

            const urlViewer = _pResolverUrlSemSuperDecodificar(s, base);
            if (!urlViewer) return null;

            const arquivo = _pArquivoDoViewer(urlViewer, base);
            if (arquivo) return arquivo;

            // Pode ser PDF direto ou servlet/endpoint sem extensão.
            if (/^https?:|^blob:/i.test(urlViewer)) return urlViewer;
            return null;
        }

        function _pEhReferenciaPdfProvavel(valor, base = location.href) {
            if (!valor) return false;
            const s = _pDecodificarEntidadesHtml(String(valor)).trim();
            if (/^(?:blob:|data:application\/pdf)/i.test(s)) return true;

            let u;
            try { u = new URL(s, base); } catch (_) { return false; }

            // O documento do PROAD é servido pelo próprio PROAD. Nunca segue
            // links de menu, portal, Keycloak, logout ou outros hosts.
            if (u.origin !== location.origin) return false;

            const alvo = `${u.pathname}${u.search}`.toLowerCase();
            return (
                /\.pdf(?:$|[?#])/i.test(alvo)
                || /\/documentviewer\//i.test(alvo)
                || /pdfviewer\.html\.xhtml/i.test(alvo)
                || /dynamiccontent\.properties\.xhtml/i.test(alvo)
                || u.searchParams.has('arquivoProtocoloSelecionadoRandomUuid')
                || u.searchParams.has('pfdrid')
                || u.searchParams.has('file')
            );
        }

        function _pCandidatosPdfDoTexto(texto, base = location.href) {
            const saida = [];
            const vistos = new Set();
            const adicionar = (v, b = base) => {
                if (!v || !_pEhReferenciaPdfProvavel(v, b)) return;
                const bruto = _pDecodificarEntidadesHtml(v).trim();
                const viewer = _pResolverUrlSemSuperDecodificar(bruto, b);
                if (viewer) {
                    const arquivo = _pArquivoDoViewer(viewer, b);
                    for (const u of [arquivo, viewer]) {
                        if (u && _pEhReferenciaPdfProvavel(u, b) && !vistos.has(u)) {
                            vistos.add(u); saida.push(u);
                        }
                    }
                    return;
                }
                const n = _pNormalizarUrlPdfVisivel(bruto, b);
                if (n && _pEhReferenciaPdfProvavel(n, b) && !vistos.has(n)) {
                    vistos.add(n); saida.push(n);
                }
            };

            const bruto = String(texto || '');

            // 1) Resposta partial-response JSF: cada <update> costuma conter CDATA HTML.
            try {
                const xml = new DOMParser().parseFromString(bruto, 'application/xml');
                for (const up of xml.querySelectorAll('update')) {
                    const html = up.textContent || '';
                    const d = new DOMParser().parseFromString(html, 'text/html');
                    for (const el of d.querySelectorAll('embed[src], object[data], iframe[src]')) {
                        adicionar(el.getAttribute('src') || el.getAttribute('data'), base);
                    }
                    for (const a of d.querySelectorAll('a[href]')) {
                        const h = a.getAttribute('href');
                        if (_pEhReferenciaPdfProvavel(h, base)) adicionar(h, base);
                    }
                }
            } catch (_) {}

            // 2) HTML normal/intermediário.
            try {
                const d = new DOMParser().parseFromString(bruto, 'text/html');
                for (const el of d.querySelectorAll('embed[src], object[data], iframe[src]')) {
                    adicionar(el.getAttribute('src') || el.getAttribute('data'), base);
                }
                for (const a of d.querySelectorAll('a[href]')) {
                    const h = a.getAttribute('href');
                    if (_pEhReferenciaPdfProvavel(h, base)) adicionar(h, base);
                }
            } catch (_) {}

            // 3) Strings/atributos escapados presentes em scripts ou XML.
            const limpo = _pDecodificarEntidadesHtml(bruto).replace(/\\\//g, '/');
            const regexUrls = /(?:https?:\/\/[^\s"'<>]+|\/[A-Za-z0-9_./%-]+(?:\?[^\s"'<>]+)?)/g;
            for (const m of limpo.matchAll(regexUrls)) {
                const v = m[0];
                if (_pEhReferenciaPdfProvavel(v, base)) adicionar(v, base);
            }

            // 4) Caso clássico do PDF.js em que só conseguimos ver "file=...".
            // Captura até aspas/markup, NÃO para no primeiro '&', para não truncar token.
            for (const m of limpo.matchAll(/(?:[?&]|\b)file=([^"'<>\s]+)/gi)) {
                let f = m[1].replace(/[),;]+$/,'');
                // Se vier percent-encoded do raw text, uma única decodificação é suficiente.
                try { f = decodeURIComponent(f); } catch (_) {}
                adicionar(f, base);
            }

            return saida;
        }

        function _pUrlPdfVisivel(doc) {
            try {
                const saida = [];
                const vistos = new Set();
                const adicionar = (v, base = location.href) => {
                    if (!v) return;
                    const viewer = _pResolverUrlSemSuperDecodificar(v, base);
                    const arquivo = viewer ? _pArquivoDoViewer(viewer, base) : null;
                    for (const u of [arquivo, viewer, _pNormalizarUrlPdfVisivel(v, base)]) {
                        if (u && !vistos.has(u)) { vistos.add(u); saida.push(u); }
                    }
                };

                const els = [...doc.querySelectorAll('embed[src], object[data], iframe[src]')];
                els.sort((a, b) => ((b.offsetParent !== null) ? 1 : 0) - ((a.offsetParent !== null) ? 1 : 0));
                for (const el of els) adicionar(el.getAttribute('src') || el.getAttribute('data'));
                for (const a of doc.querySelectorAll('a[href]')) {
                    const h = a.getAttribute('href');
                    if (/pdf|download|documento|arquivo|file=|visualiz/i.test(h || '')) adicionar(h);
                }

                if (saida.length) return saida[0];
                const candidatos = _pCandidatosPdfDoTexto(doc.documentElement?.innerHTML || '', location.href);
                return candidatos[0] || null;
            } catch (_) { return null; }
        }

        function _pLinhaSelecionada(row) {
            if (!row) return false;
            return row.getAttribute('aria-selected') === 'true'
                || row.classList.contains('ui-state-highlight')
                || row.classList.contains('p-highlight')
                || !!row.querySelector('input[type="radio"]:checked, input[type="checkbox"]:checked');
        }

        async function _pSelecionarNoDomVivo(ficha, candidato) {
            if (!ficha?.origemDomAtual || ficha.doc !== document) return null;
            const rowKey = typeof candidato === 'object' ? candidato?.rowKey : candidato;
            const numeroDoc = typeof candidato === 'object' ? String(candidato?.numero || '') : '';
            const descricaoDoc = typeof candidato === 'object' ? String(candidato?.descricao || '') : '';
            const rows = [...document.querySelectorAll('tr')];
            let row = rowKey ? rows.find(tr => String(tr.getAttribute('data-rk') || tr.querySelector('[data-rk]')?.getAttribute('data-rk') || '') === String(rowKey)) : null;
            if (!row && numeroDoc) row = rows.find(tr => { const t=(tr.textContent||'').replace(/\s+/g,' ').trim(); return new RegExp(`(^|\\D)${numeroDoc.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')}(\\D|$)`).test(t) && (!descricaoDoc || t.includes(descricaoDoc.slice(0,40))); });
            if (!row) return null;

            // Se o DOC já está selecionado no PROAD (como o DOC 323 do caso da NF 172),
            // usa diretamente o PDF que o próprio PROAD já carregou.
            const urlAntes = _pUrlPdfVisivel(document);
            if (_pLinhaSelecionada(row) && urlAntes) return urlAntes;

            // Fallback robusto para a página viva: deixa o próprio PrimeFaces executar
            // o rowSelect real, em vez de reconstruir manualmente o postback.
            try {
                const alvoClique = row.querySelector('[id$="docDescricao"], [id$="descricaoDocumento"]')
                    || row.querySelector('td:nth-child(3)')
                    || row;
                alvoClique.dispatchEvent(new MouseEvent('click', {
                    bubbles: true, cancelable: true, view: window
                }));
            } catch (_) {
                try { row.click(); } catch (_) { return null; }
            }

            const limite = Date.now() + 1800;
            while (Date.now() < limite) {
                await new Promise(r => setTimeout(r, 60));
                const urlAgora = _pUrlPdfVisivel(document);
                const selecionou = _pLinhaSelecionada(row);
                if (urlAgora && (selecionou || urlAgora !== urlAntes)) return urlAgora;
            }
            return null;
        }

        async function selecionar(ficha, candidato) {
            const doc = ficha.doc;
            const rowKey = typeof candidato === 'object' ? candidato?.rowKey : candidato;

            // Preferência absoluta quando estamos na própria ficha aberta no navegador:
            // usa o viewer/rowSelect real do PROAD. Isso evita diferenças de ViewState,
            // action e componentes JSF entre processos.
            const urlDomVivo = await _pSelecionarNoDomVivo(ficha, candidato);
            if (urlDomVivo) return urlDomVivo;

            // A linha é a âncora mais confiável. Em páginas atualizadas parcialmente
            // pelo JSF alguns ids internos mudam, mas data-rk permanece sendo a chave
            // usada pelo rowSelect.
            const row = [...doc.querySelectorAll('tr[data-rk]')]
                .find(tr => String(tr.getAttribute('data-rk')) === String(rowKey));

            const elDesc = row?.querySelector('[id$="docDescricao"], [id$="descricaoDocumento"]')
                || doc.querySelector('[id$="docDescricao"], [id$="descricaoDocumento"]');

            if (!row && !elDesc) throw new Error('linha do documento não encontrada');

            const form = row?.closest('form') || elDesc?.closest('form');
            if (!form) throw new Error('formulário da lista de documentos não encontrado');

            // Mantém o id que já funciona nos layouts antigos; se o wrapper
            // panelListaDocumentos não existir, sobe da linha até o componente
            // PrimeFaces que efetivamente contém a tabela.
            let componenteTabela = elDesc?.closest('[id$="panelListaDocumentos"]') || null;
            if (!componenteTabela && row) {
                const tabela = row.closest('table[id]');
                if (tabela) {
                    let idTabela = tabela.id.replace(/_data$/, '');
                    componenteTabela = doc.getElementById(idTabela) || tabela;
                }
            }
            if (!componenteTabela) throw new Error('componente da lista de documentos não encontrado');

            const idTabela = componenteTabela.id.replace(/_data$/, '');
            const idForm = form.id;
            const viewState = form.querySelector('input[name="jakarta.faces.ViewState"]')
                || doc.querySelector('input[name="jakarta.faces.ViewState"]');
            if (!viewState?.value) throw new Error('ViewState do PROAD não encontrado');

            const p = new URLSearchParams({
                'jakarta.faces.partial.ajax': 'true',
                'jakarta.faces.source': idTabela,
                'jakarta.faces.partial.execute': idTabela,
                'jakarta.faces.partial.render': '@all',
                'jakarta.faces.behavior.event': 'rowSelect',
                'jakarta.faces.partial.event': 'rowSelect',
                [`${idTabela}_instantSelectedRowKey`]: rowKey,
                [`${idTabela}_selection`]: rowKey,
                [idForm]: idForm,
                'jakarta.faces.ViewState': viewState.value
            });

            // IMPORTANTE: em navegação JSF a location.href pode não acompanhar a
            // ficha visível. O POST precisa ir para a ACTION do formulário atual.
            let destino = form.getAttribute('action') || ficha.url || location.href;
            try { destino = new URL(destino, location.origin).href; } catch (_) {}

            const r = await _pFetchRapido(destino, {
                method: 'POST', credentials: 'include',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                    'Faces-Request': 'partial/ajax', 'X-Requested-With': 'XMLHttpRequest'
                },
                body: p.toString()
            }, TIMEOUT_POSTBACK_MS, 'seleção do documento TRD');
            if (!r.ok) throw new Error(`postback HTTP ${r.status}`);
            const resposta = await r.text();

            // Não escolhe uma única URL por regex. O PROAD pode devolver viewer +
            // endpoint assinado com query/token. Preserva todos os candidatos e deixa
            // baixarPdf() confirmar qual deles realmente começa com %PDF.
            const candidatosPdf = _pCandidatosPdfDoTexto(resposta, destino);

            // NUNCA injeta o viewer que está aberto no DOM quando "ficha" veio de fetch.
            // O DOM pode estar mostrando outro processo/DOC (ex.: TRD DOC 323 do principal),
            // cujo dynamiccontent/RandomUuid é transitório e pode estar expirado.
            // Para ficha viva, _pSelecionarNoDomVivo() já foi tentado no início da função.
            if (!candidatosPdf.length) throw new Error('resposta sem URL de PDF');
            return { candidatosPdf, origem: 'postback', rowKey: candidato?.rowKey || '' };
        }

        // COMPROVADO em 22/08/2026 (9 testes, 3 processos de anos diferentes):
        // o data-rk da linha do documento É o idArquivo, e
        //     /proad/pages/exibirarquivo?idArquivo=<data-rk>
        // devolve 200 application/pdf sem postback, ViewState, dynamiccontent ou uuid.
        // Este é o caminho principal; o mecanismo antigo continua como fallback.
        async function baixarPdfDireto(rowKey) {
            if (!rowKey || !/^\d+$/.test(String(rowKey))) return null;
            const url = `${location.origin}/proad/pages/exibirarquivo?idArquivo=${rowKey}`;
            try {
                const r = await _pFetchRapido(url, { credentials: 'include' },
                    TIMEOUT_PDF_MS, 'download direto do PDF');
                if (!r.ok) {
                    console.log(`[PROAD worker] direto: idArquivo=${rowKey} → HTTP ${r.status}`);
                    return null;
                }
                const buf = await r.arrayBuffer();
                const inicio = new TextDecoder().decode(new Uint8Array(buf).slice(0, 5));
                if (!inicio.startsWith('%PDF')) {
                    console.log(`[PROAD worker] direto: idArquivo=${rowKey} → não é PDF`);
                    return null;
                }
                return buf;
            } catch (e) {
                console.log(`[PROAD worker] direto: idArquivo=${rowKey} → ${e.message}`);
                return null;
            }
        }

        async function baixarPdf(referencia, profundidade = 0, visitados = null) {
            if (!referencia) throw new Error('URL do PDF não encontrada');
            if (!visitados) visitados = new Set();

            // Caminho direto: dispensa toda a cadeia JSF quando há rowKey.
            if (profundidade === 0 && referencia && typeof referencia === 'object' && referencia.rowKey) {
                const direto = await baixarPdfDireto(referencia.rowKey);
                if (direto) return direto;
            }

            let candidatos = [];
            if (typeof referencia === 'string') candidatos = [referencia];
            else if (Array.isArray(referencia)) candidatos = referencia;
            else if (Array.isArray(referencia.candidatosPdf)) candidatos = referencia.candidatosPdf;
            else if (referencia.url) candidatos = [referencia.url];

            candidatos = candidatos.filter(Boolean);
            let ultimoErro = null;
            let erro404Dynamic = null;

            for (const bruto of candidatos) {
                const url = _pNormalizarUrlPdfVisivel(bruto, location.href) || bruto;
                if (!url || visitados.has(url)) continue;
                visitados.add(url);

                try {
                    if (/^data:application\/pdf/i.test(url)) {
                        const b64 = url.split(',')[1] || '';
                        const bin = atob(b64);
                        const arr = new Uint8Array(bin.length);
                        for (let i=0;i<bin.length;i++) arr[i]=bin.charCodeAt(i);
                        return arr.buffer;
                    }

                    const r = await _pFetchRapido(url, { credentials: 'include' }, TIMEOUT_PDF_MS, 'download do TRD');
                    if (!r.ok) {
                        ultimoErro = new Error(`PDF HTTP ${r.status}`);
                        if (r.status === 404 && /dynamiccontent\.properties\.xhtml/i.test(url)) {
                            erro404Dynamic = new Error(`PDF HTTP 404 dynamiccontent`);
                            erro404Dynamic.url = url;
                        }
                        console.warn(`[PROAD worker] candidato de PDF falhou HTTP ${r.status}: ${url}`);
                        continue;
                    }

                    const buf = await r.arrayBuffer();
                    const bytes = new Uint8Array(buf);
                    const inicio = new TextDecoder().decode(bytes.slice(0, 8));
                    if (inicio.startsWith('%PDF')) return buf;

                    // HTML/viewer intermediário: extrai TODAS as URLs candidatas e tenta.
                    if (profundidade < 3) {
                        const tipo = r.headers?.get?.('content-type') || '';
                        if (/html|xml|text|javascript/i.test(tipo) || inicio.startsWith('<!DOCT') || inicio.startsWith('<html') || inicio.startsWith('<?xml')) {
                            const textoResp = new TextDecoder('utf-8').decode(bytes);
                            const proximos = _pCandidatosPdfDoTexto(textoResp, url)
                                .filter(u => !visitados.has(u));
                            if (proximos.length) {
                                try {
                                    return await baixarPdf(proximos, profundidade + 1, visitados);
                                } catch (e) {
                                    ultimoErro = e;
                                    if (/\bPDF HTTP 404(?: dynamiccontent)?\b/i.test(String(e?.message || e || ''))) {
                                        erro404Dynamic = e;
                                    }
                                }
                            }
                        }
                    }

                    ultimoErro = new Error('resposta do viewer não contém PDF');
                } catch (e) {
                    ultimoErro = e;
                }
            }

            // Se em qualquer nível o dynamiccontent recém-gerado respondeu 404,
            // preserva esse diagnóstico. Não deixa um HTML/viewer genérico sobrescrevê-lo,
            // pois _pPdfCertidaoComRetry404 precisa deste sinal para refazer rowSelect.
            throw erro404Dynamic || ultimoErro || new Error('nenhum candidato de PDF válido');
        }

        async function _pPdfTRDComRetry404(chaveProcesso, ficha, cand) {
            const uuidDaRef = (referencia) => {
                try {
                    const candidatos = typeof referencia === 'string' ? [referencia]
                        : Array.isArray(referencia) ? referencia
                        : Array.isArray(referencia?.candidatosPdf) ? referencia.candidatosPdf
                        : referencia?.url ? [referencia.url] : [];
                    for (const bruto of candidatos) {
                        const s = String(bruto || '');
                        const m = s.match(/[?&]arquivoProtocoloSelecionadoRandomUuid=([^&#"'<>\s]+)/i);
                        if (m) return decodeURIComponent(m[1]);
                        try {
                            const u = new URL(s, location.href);
                            const v = u.searchParams.get('arquivoProtocoloSelecionadoRandomUuid');
                            if (v) return v;
                        } catch (_) {}
                    }
                } catch (_) {}
                return null;
            };

            const tentativa = async (fichaUsada, candUsado, numeroTentativa) => {
                // Atalho comprovado: idArquivo = data-rk, sem postback nenhum.
                const direto = await baixarPdfDireto(candUsado.rowKey);
                if (direto) {
                    console.log(`[PROAD worker] ${chaveProcesso} DOC ${candUsado.numero}: `
                        + `PDF direto (idArquivo=${candUsado.rowKey})`);
                    return { buf: direto, ficha: fichaUsada, cand: candUsado, uuid: null };
                }

                const ref = await selecionar(fichaUsada, candUsado);
                const uuid = uuidDaRef(ref);
                console.log(
                    `[PROAD worker] ${chaveProcesso} DOC ${candUsado.numero}: `
                    + `tentativa TRD ${numeroTentativa} (via postback)`
                    + (uuid ? ` · UUID ${uuid}` : ' · UUID não exposto')
                );
                const buf = await baixarPdf(ref);
                return { buf, ficha: fichaUsada, cand: candUsado, uuid };
            };

            let primeiraUuid404 = null;
            try {
                return await tentativa(ficha, cand, 1);
            } catch (e) {
                const msg = String(e?.message || e || '');
                if (!/\bPDF HTTP 404(?: dynamiccontent)?\b/i.test(msg)) throw e;
                try {
                    const uErro = String(e?.url || '');
                    primeiraUuid404 = (uErro.match(/[?&]arquivoProtocoloSelecionadoRandomUuid=([^&#]+)/i) || [])[1] || null;
                } catch (_) {}

                console.warn(
                    `[PROAD worker] ${chaveProcesso} DOC ${cand.numero}: dynamiccontent 404 no TRD; `
                    + `refazendo ficha + rowSelect uma única vez.`
                );

                CACHE_FICHAS.delete(chaveProcesso);
                CACHE_FICHAS_EM_CURSO.delete(chaveProcesso);
                await _pPausa(90);

                const [numero, ano] = chaveProcesso.split('/');
                const fichaNova = await lerFicha(numero, ano, { forcarFetch: true });
                console.log(
                    `[PROAD worker] ${chaveProcesso} DOC ${cand.numero}: `
                    + `ficha fresca obtida por GET forçado; DOM vivo ignorado no retry.`
                );
                const docsNovos = proadListarDocumentos(fichaNova.doc);

                const numeroAlvo = String(cand.numero || '').replace(/^0+/, '') || '0';
                const candNovo = docsNovos.find(d => {
                    const nDoc = String(d.numero || '').replace(/^0+/, '') || '0';
                    return nDoc === numeroAlvo;
                }) || docsNovos.find(d =>
                    String(d.descricao || '').trim() === String(cand.descricao || '').trim()
                );

                if (!candNovo) {
                    throw new Error(
                        `retry 404 TRD: DOC ${cand.numero} não encontrado na ficha fresca ${chaveProcesso}`
                    );
                }

                const segunda = await tentativa(fichaNova, candNovo, 2);
                if (segunda.uuid && primeiraUuid404 && segunda.uuid === primeiraUuid404) {
                    console.warn(
                        `[PROAD worker] ${chaveProcesso} DOC ${candNovo.numero}: `
                        + `ATENÇÃO — mesmo após GET forçado o UUID permaneceu igual (${segunda.uuid}).`
                    );
                }
                console.log(
                    `[PROAD worker] ${chaveProcesso} DOC ${candNovo.numero}: retry TRD após 404 concluído com sucesso.`
                );
                return segunda;
            }
        }

        async function analisarDocumentoTRD(chaveProcesso, ficha, cand, orcamento = null) {
            const chaveDoc = `${chaveProcesso}|${cand.numero || ''}|${cand.rowKey || ''}`;
            if (CACHE_TRD_DOC.has(chaveDoc)) return CACHE_TRD_DOC.get(chaveDoc);
            if (orcamento && orcamento.restante <= 0) return { esgotado: true };
            if (orcamento) orcamento.restante--;
            _pCoberturaInc('trdPdfs');

            const obtidoPdf = await _pPdfTRDComRetry404(chaveProcesso, ficha, cand);
            const buf = obtidoPdf.buf;
            const texto = await proadTextoDoPdf(buf);
            const trd = proadParseTRD(texto);
            const valido = !!(trd.semTexto || _pConfirmaConteudoTRD(texto, cand));
            const assinaturas = valido
                ? await proadExtrairAssinaturas(buf)
                : { quantidade: 0, assinaturas: [], ultimaAssinatura: null };
            const analisado = { valido, trd, assinaturas };
            CACHE_TRD_DOC.set(chaveDoc, analisado);

            if (valido) {
                console.log(
                    `[PROAD worker] ${chaveProcesso} DOC ${cand.numero}: TRD reconhecido; `
                    + `NF(s): ${(trd.notas || []).join(', ') || '(nenhuma)'}; `
                    + `competência: ${trd.competencia || '(não localizada)'}`
                );
                if ((trd.notas || []).some(n => /^\d{1,2}$/.test(String(n)))) {
                    console.warn(
                        `[PROAD worker] ${chaveProcesso} DOC ${cand.numero}: `
                        + `NF muito curta detectada após parsing (${(trd.notas || []).join(', ')}); `
                        + `possível fragmentação residual do PDF.`
                    );
                }
                for (const nf of (trd.notas || [])) {
                    CACHE_TRD_NOTA.set(`${chaveProcesso}|${nf}`, { cand, analisado });
                }
            }
            return analisado;
        }

        function montarRegistroTRD(analisado, chaveProcesso, cand, origem, solicitacaoProvidencia = null, notaAlvo = null) {
            const trd = analisado.trd || {};

            // Num TRD que agrupa notas por competência, vale a do bloco onde a nota
            // pesquisada aparece — não a primeira do documento.
            const nota = _pNotaDeReferencia(notaAlvo);
            const porNota = (nota && trd.competenciaPorNota) ? trd.competenciaPorNota[nota] : null;
            if (porNota && porNota !== trd.competencia) {
                console.log(`[PROAD worker] DOC ${cand.numero}: competência da NF ${nota} é `
                    + `${porNota} (o documento agrupa por competência; a primeira era ${trd.competencia})`);
            }

            return {
                encontrado: true,
                proadConsultado: chaveProcesso,
                solicitacaoProvidencia: _pProc(solicitacaoProvidencia) || _pProc(trd.proadPagamento) || null,
                ondeEstava: origem,
                ...trd,
                competencia: porNota || trd.competencia,
                ...(analisado.assinaturas || {}),
                docNumero: cand.numero,
                descricao: cand.descricao,
                assinantesNaFicha: cand.assinantes
            };
        }

        async function analisarDocumentoMedicao(chaveProcesso, ficha, cand, orcamento = null) {
            const chaveDoc = `${chaveProcesso}|${cand.numero || ''}|${cand.rowKey || ''}`;
            if (CACHE_MEDICAO_DOC.has(chaveDoc)) return CACHE_MEDICAO_DOC.get(chaveDoc);
            if (orcamento && orcamento.restante <= 0) return { esgotado: true };
            if (orcamento) orcamento.restante--;

            const buf = await baixarPdfDireto(cand.rowKey)
                || await baixarPdf(await selecionar(ficha, cand));
            const texto = await proadTextoDoPdf(buf);
            const medicao = proadParseRelatorioMedicao(texto);
            // Ao contrário do TRD, relatório sem camada de texto NÃO é aceito como
            // fallback: é preciso confirmar com segurança o tipo e a NF no conteúdo.
            const valido = !!CONFIRMA_MEDICAO.test(_pSemAcentos(texto));
            const assinaturas = valido
                ? await proadExtrairAssinaturas(buf)
                : { quantidade: 0, assinaturas: [], ultimaAssinatura: null };
            const analisado = { valido, trd: medicao, assinaturas };
            CACHE_MEDICAO_DOC.set(chaveDoc, analisado);

            if (valido) {
                for (const nf of (medicao.notas || [])) {
                    CACHE_MEDICAO_NOTA.set(`${chaveProcesso}|${nf}`, { cand, analisado });
                }
            }
            return analisado;
        }

        async function procurarMedicaoEmProcesso(chaveProcesso, numeroNota, cnpj, origem, solicitacaoProvidencia = null, maxCegos = Number.POSITIVE_INFINITY) {
            const [numero, ano] = chaveProcesso.split('/');
            const ficha = await lerFicha(numero, ano);
            const todos = proadListarDocumentos(ficha.doc)
                .filter(d => FILTRO_MEDICAO.test(d.descricao))
                .sort((a, b) => Number(b.numero || 0) - Number(a.numero || 0));
            if (!todos.length) return { ficha, registro: null, totalCandidatos: 0 };

            const nota = _pNotaDeReferencia(numeroNota);
            const cnpjAlvo = _pSoDigitos(cnpj);
            if (!nota) return { ficha, registro: null, totalCandidatos: todos.length };

            const hit = CACHE_MEDICAO_NOTA.get(`${chaveProcesso}|${nota}`);
            if (hit?.analisado?.valido) {
                const cnpjLido = _pSoDigitos(hit.analisado.trd?.cnpj);
                if (!cnpjAlvo || !cnpjLido || cnpjLido === cnpjAlvo) {
                    const registro = montarRegistroTRD(hit.analisado, chaveProcesso, hit.cand, origem, solicitacaoProvidencia, nota);
                    registro.casouPelaNota = true;
                    registro.tipoDocumento = 'relatorio-medicao';
                    registro.competencia = null;
                    registro.totalRelatoriosNoProcesso = todos.length;
                    return { ficha, registro, totalCandidatos: todos.length };
                }
            }

            // Primeiro tenta títulos que citam explicitamente a NF; depois percorre TODOS
            // os demais Relatórios de Medição. A confirmação continua sendo pelo conteúdo
            // do PDF (tipo do documento + NF exata + CNPJ quando disponível).
            const prioritarios = todos.filter(c => proadDescricaoMencionaNota(c.descricao, nota));
            const restantes = todos.filter(c => !prioritarios.includes(c));
            const limiteCegos = Number.isFinite(Number(maxCegos))
                ? Math.max(0, Number(maxCegos))
                : restantes.length;
            const candidatos = [...prioritarios, ...restantes.slice(0, limiteCegos)];

            console.log(
                `[PROAD worker] ${chaveProcesso}: ${todos.length} Relatório(s) de Medição visível(is); `
                + `NF ${nota}: ${prioritarios.length} candidato(s) pelo título + `
                + `${Math.max(0, candidatos.length - prioritarios.length)} por varredura documental`
            );

            const docsTestados = [];
            for (const cand of candidatos) {
                const docNum = String(cand.numero || '?');
                try {
                    const analisado = await analisarDocumentoMedicao(
                        chaveProcesso, ficha, cand, { restante: 1 }
                    );
                    if (!analisado || analisado.esgotado) continue;

                    const notasLidas = analisado.trd?.notas || [];
                    docsTestados.push(`${docNum}${notasLidas.length ? `[NF:${notasLidas.join(',')}]` : '[NF:?]'}`);

                    if (!analisado.valido) {
                        console.log(`[PROAD worker] ${chaveProcesso} DOC ${docNum}: candidato de medição descartado pelo conteúdo.`);
                        continue;
                    }
                    if (!notasLidas.includes(nota)) {
                        console.log(
                            `[PROAD worker] ${chaveProcesso} DOC ${docNum}: Relatório de Medição válido, `
                            + `mas NF ${nota} não casou; NF(s) lida(s): ${notasLidas.join(', ') || '(nenhuma)'}`
                        );
                        continue;
                    }

                    const cnpjLido = _pSoDigitos(analisado.trd?.cnpj);
                    if (cnpjAlvo && cnpjLido && cnpjLido !== cnpjAlvo) {
                        console.warn(
                            `[PROAD worker] ${chaveProcesso} DOC ${docNum}: NF ${nota} encontrada no Relatório de Medição, `
                            + `mas CNPJ diverge (${cnpjLido} × ${cnpjAlvo}).`
                        );
                        continue;
                    }

                    const registro = montarRegistroTRD(analisado, chaveProcesso, cand, origem, solicitacaoProvidencia, nota);
                    registro.casouPelaNota = true;
                    registro.notaCasada = nota;
                    registro.tipoDocumento = 'relatorio-medicao';
                    registro.competencia = null;
                    registro.totalRelatoriosNoProcesso = todos.length;
                    console.log(`[PROAD worker] ${chaveProcesso} DOC ${docNum}: Relatório de Medição CONFIRMADO para NF ${nota}.`);
                    return { ficha, registro, totalCandidatos: todos.length };
                } catch (e) {
                    docsTestados.push(`${docNum}[erro]`);
                    console.warn(`[PROAD worker] ${chaveProcesso} DOC ${docNum}: falha ao analisar Relatório de Medição — ${e?.message || e}`);
                }
            }

            console.log(
                `[PROAD worker] ${chaveProcesso}: nenhum Relatório de Medição confirmou a NF ${nota}. `
                + `DOC(s) testado(s): ${docsTestados.join(' · ') || '(nenhum)'}`
            );
            return { ficha, registro: null, totalCandidatos: todos.length };
        }


        function _pExtrairNotaFaturaCI(texto, numeroNota = null) {
            const t = String(texto || '').replace(/\s+/g, ' ');
            const alvo = _pNotaDeReferencia(numeroNota);

            // Quando já sabemos a NF/Fatura buscada, exigimos essa referência exata.
            if (alvo) {
                const esc = String(Number(alvo) || alvo).replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
                const reAlvo = new RegExp(
                    `\\b(?:Fatura|NF(?:S?\\s*-?\\s*e)?|Nota\\s+Fiscal)`
                    + `(?:\\s+(?:de\\s+)?n(?:[úu]mero|[ºo°])|\\s*n[ºo°])?\\s*[:#.-]?\\s*0*${esc}\\b`,
                    'i'
                );
                return reAlvo.test(t) ? alvo : null;
            }

            // Fallback para indexação/cache quando o chamador ainda não forneceu a nota.
            const m = t.match(
                /\b(?:Fatura|NF(?:S?\s*-?\s*e)?|Nota\s+Fiscal)(?:\s+(?:de\s+)?n(?:[úu]mero|[ºo°])|\s*n[ºo°])?\s*[:#.-]?\s*(\d{1,20})\b/i
            );
            return m ? _pNumeroNota(m[1]) : null;
        }

        function _pExtrairCompetenciaCI(texto) {
            const t = String(texto || '').replace(/\u00a0/g, ' ').replace(/\s+/g, ' ');

            // "Fatura de" pode aparecer primeiro em "Fatura de número 2581311" e só
            // depois em "tarifas constantes da fatura de JULHO/2026". Percorre TODAS
            // as ocorrências para não parar na primeira, que não contém competência.
            const indices = [];
            for (const m of t.matchAll(/\bfatura\s+de\b/gi)) indices.push(m.index);
            for (const m of t.matchAll(/\bcompet[eê]ncia\b/gi)) indices.push(m.index);
            for (const m of t.matchAll(/\breferente\s+(?:ao|aos|à|as?)\s+(?:m[eê]s|per[ií]odo)\b/gi)) indices.push(m.index);
            for (const m of t.matchAll(/\bservi[cç]os?\s+(?:de|do|da|referentes?\s+a)\b/gi)) indices.push(m.index);

            for (const idx of [...new Set(indices)].sort((a, b) => a - b)) {
                const trecho = t.slice(idx, idx + 240);
                const comp = _pCompFlexivel(trecho);
                if (comp) return comp;
            }
            return null;
        }

        function _pProadReferenciadoCI(texto) {
            // Lê apenas o cabeçalho. Ex.: "PROAD: 25037/2026".
            const cab = String(texto || '').slice(0, 2200);
            const m = cab.match(/\bPROAD\s*(?:n[ºo°]?\s*)?:?\s*(\d{3,6}\s*\/\s*20\d{2})\b/i);
            return m ? _pProc(m[1]) : null;
        }

        function _pConfirmaConteudoCI(texto, numeroNota, cand = null) {
            const t = String(texto || '').replace(/\s+/g, ' ').trim();
            const descricaoEhCI = !!cand && FILTRO_CI_ATESTE.test(String(cand.descricao || ''));
            if (!descricaoEhCI || !t || !CONFIRMA_CI_ATESTE.test(t)) return false;
            return !!_pExtrairNotaFaturaCI(t, numeroNota);
        }

        function proadParseCIAutorizacao(textoBruto, numeroNota = null) {
            const t = _pNormalizarTextoTRD(textoBruto);
            const nota = _pExtrairNotaFaturaCI(t, numeroNota);
            const contrato = (() => {
                const m = t.match(/\bcontrato\s+([A-Z0-9.\/-]{4,80})/i);
                return m ? String(m[1]).trim() : null;
            })();
            const valor = (() => {
                const m = t.match(/\bvalor\s+total\s+de\s+R\$\s*([\d.]+,\d{2})/i);
                return m ? _pValor(m[1]) : null;
            })();
            return {
                proadPrincipal: null,
                proadPagamento: null,
                proadReferenciadoCI: _pProadReferenciadoCI(t),
                contrato,
                fornecedor: null,
                cnpj: null,
                notas: nota ? [nota] : [],
                datasEmissao: [],
                dataEmissao: null,
                competencia: _pExtrairCompetenciaCI(t),
                competenciaPorNota: {},
                valorGlobal: valor,
                complementar: false,
                semTexto: _pSemEspacos(t).length < 120,
                tipoDocumento: 'ci-ateste'
            };
        }

        async function analisarDocumentoCI(chaveProcesso, ficha, cand, numeroNota) {
            const chaveDoc = `${chaveProcesso}|${cand.numero || ''}|${cand.rowKey || ''}`;
            let base = CACHE_CI_DOC.get(chaveDoc);
            if (!base) {
                const buf = await baixarPdfDireto(cand.rowKey)
                    || await baixarPdf(await selecionar(ficha, cand));
                const texto = await proadTextoDoPdf(buf);
                // Assinaturas são extraídas uma única vez por CI; o casamento da nota
                // continua sendo revalidado para cada NF/Fatura pesquisada.
                let assinaturas = await proadExtrairAssinaturas(buf);

                // Alguns CIs do PROAD exibem o carimbo de assinatura na própria página,
                // mas o PDF final não preserva um dicionário /Type /Sig (ex.: CI SEML 188/2026).
                // Nesses casos aceita SOMENTE timestamp visual completo dd/mm/aaaa hh:mm,
                // que é muito mais específico que a data civil do cabeçalho.
                if (!assinaturas?.ultimaAssinatura) {
                    const visuais = [...String(texto || '').matchAll(/\b(\d{2})\/(\d{2})\/(20\d{2})\s+(\d{2}):(\d{2})\b/g)]
                        .map(m => ({
                            texto: `${m[1]}/${m[2]}/${m[3]} ${m[4]}:${m[5]}`,
                            ordem: `${m[3]}${m[2]}${m[1]}${m[4]}${m[5]}`
                        }))
                        .sort((a, b) => a.ordem.localeCompare(b.ordem));
                    if (visuais.length) {
                        assinaturas = {
                            quantidade: 0,
                            assinaturas: [],
                            ultimaAssinatura: visuais[visuais.length - 1].texto,
                            dataVisualCI: true
                        };
                    }
                }
                base = { texto, assinaturas };
                CACHE_CI_DOC.set(chaveDoc, base);
            }

            const valido = _pConfirmaConteudoCI(base.texto, numeroNota, cand);
            const ci = proadParseCIAutorizacao(base.texto, numeroNota);
            const analisado = { valido, trd: ci, assinaturas: valido ? base.assinaturas : { quantidade: 0, assinaturas: [], ultimaAssinatura: null } };

            if (valido && ci.notas?.length) {
                for (const nf of ci.notas) CACHE_CI_NOTA.set(`${chaveProcesso}|${nf}`, { cand, analisado });
                console.log(
                    `[PROAD worker] ${chaveProcesso} DOC ${cand.numero}: CI de ateste reconhecido; `
                    + `NF/Fatura ${(ci.notas || []).join(', ')}; competência ${ci.competencia || '(não localizada)'}`
                );
            }
            return analisado;
        }

        async function procurarCIEmProcesso(chaveProcesso, numeroNota, origem, solicitacaoProvidencia = null, maxCegos = 4) {
            const [numero, ano] = chaveProcesso.split('/');
            const ficha = await lerFicha(numero, ano);
            const todos = proadListarDocumentos(ficha.doc)
                .filter(d => FILTRO_CI_ATESTE.test(d.descricao))
                .sort((a, b) => Number(b.numero || 0) - Number(a.numero || 0));
            if (!todos.length) return { ficha, registro: null, totalCandidatos: 0 };

            const nota = _pNotaDeReferencia(numeroNota);
            if (!nota) return { ficha, registro: null, totalCandidatos: todos.length };

            const hit = CACHE_CI_NOTA.get(`${chaveProcesso}|${nota}`);
            if (hit?.analisado?.valido) {
                const registro = montarRegistroTRD(hit.analisado, chaveProcesso, hit.cand, origem, solicitacaoProvidencia, nota);
                registro.casouPelaNota = true;
                registro.tipoDocumento = 'ci-ateste';
                registro.totalCIsNoProcesso = todos.length;
                return { ficha, registro, totalCandidatos: todos.length };
            }

            const prioritarios = todos.filter(c => proadDescricaoMencionaNota(c.descricao, nota));
            const restantes = todos.filter(c => !prioritarios.includes(c));
            const candidatos = [...prioritarios, ...restantes.slice(0, Math.max(0, maxCegos))];
            const docsTestados = [];

            console.log(
                `[PROAD worker] ${chaveProcesso}: ${todos.length} CI(s)/Comunicação(ões) Interna(s) visível(is); `
                + `NF/Fatura ${nota}: ${prioritarios.length} candidata(s) pelo título + `
                + `${Math.max(0, candidatos.length - prioritarios.length)} candidata(s) por varredura documental`
            );

            for (const cand of candidatos) {
                docsTestados.push(String(cand.numero || '?'));
                try {
                    const analisado = await analisarDocumentoCI(chaveProcesso, ficha, cand, nota);
                    if (!analisado?.valido || !(analisado.trd?.notas || []).includes(nota)) continue;
                    const registro = montarRegistroTRD(analisado, chaveProcesso, cand, origem, solicitacaoProvidencia, nota);
                    registro.casouPelaNota = true;
                    registro.notaCasada = nota;
                    registro.tipoDocumento = 'ci-ateste';
                    registro.totalCIsNoProcesso = todos.length;
                    return { ficha, registro, totalCandidatos: todos.length };
                } catch (e) {
                    console.warn(`[PROAD worker] ${chaveProcesso} DOC ${cand.numero}: falha ao analisar CI — ${e?.message || e}`);
                }
            }
            console.log(
                `[PROAD worker] ${chaveProcesso}: nenhuma CI confirmou a NF/Fatura ${nota}. `
                + `DOC(s) testado(s): ${docsTestados.join(', ') || '(nenhum)'}`
            );
            return { ficha, registro: null, totalCandidatos: todos.length };
        }

        // v11.40.7 — fallback final por CONTEÚDO, não por nome do arquivo.
        // Só roda depois de TRD/CI/Medição falharem. É propositalmente restrito:
        // poucos documentos, NF exata no PDF e linguagem forte de recebimento/ateste.
        const MAX_ATESTE_GENERICO = 5;
        const EXCLUI_ATESTE_GENERICO = /certid|consulta|optante|regularidade|nota\s+fiscal|nfs?\s*-?\s*e|danfe|empenho|contrato|proposta|or[cç]amento|boleto|darf|guia|comprovante|extrato/i;

        function _pOrdenarDocumentosGenericos(docs, numeroNota, dataReferencia) {
            const nota = _pNotaDeReferencia(numeroNota);
            const refMs = _pDataParaMs(dataReferencia);
            return [...(docs || [])].sort((a, b) => {
                const ma = nota && proadDescricaoMencionaNota(a.descricao, nota) ? 1 : 0;
                const mb = nota && proadDescricaoMencionaNota(b.descricao, nota) ? 1 : 0;
                if (ma !== mb) return mb - ma;
                const da = _pDataParaMs(a.cadastradoEm), db = _pDataParaMs(b.cadastradoEm);
                if (refMs && da && db) {
                    const dif = Math.abs(da - refMs) - Math.abs(db - refMs);
                    if (dif) return dif;
                } else if (refMs && da) return -1;
                else if (refMs && db) return 1;
                return Number(b.numero || 0) - Number(a.numero || 0);
            });
        }

        async function procurarAtesteGenericoEmProcesso(
            chaveProcesso, numeroNota, cnpj, origem,
            solicitacaoProvidencia = null, permitirRelatorioMedicao = false,
            dataReferencia = null, maxDocs = MAX_ATESTE_GENERICO
        ) {
            const nota = _pNotaDeReferencia(numeroNota);
            if (!nota) return null;
            const [numero, ano] = String(chaveProcesso || '').split('/');
            if (!numero || !ano) return null;

            // Fallback negativo deve olhar uma ficha realmente atual.
            const ficha = await lerFicha(numero, ano, { forcarFetch: true });
            const todos = proadListarDocumentos(ficha.doc);
            const conhecidos = d => FILTRO_TRD.test(d.descricao || '')
                || FILTRO_CI_ATESTE.test(d.descricao || '')
                || FILTRO_MEDICAO.test(d.descricao || '');
            const elegiveis = _pOrdenarDocumentosGenericos(
                todos.filter(d => !conhecidos(d) && !EXCLUI_ATESTE_GENERICO.test(d.descricao || '')),
                nota, dataReferencia
            ).slice(0, Math.max(1, Number(maxDocs) || MAX_ATESTE_GENERICO));

            _pCoberturaInc('genericosCandidatos', elegiveis.length);
            if (!elegiveis.length) return null;
            console.log(`[PROAD worker] ${chaveProcesso}: fallback por conteúdo — `
                + `${elegiveis.length} documento(s) recente(s) serão testados para NF ${nota}: `
                + elegiveis.map(d => `DOC ${d.numero} (${d.descricao})`).join(' | '));

            const cnpjAlvo = _pSoDigitos(cnpj);
            for (const cand of elegiveis) {
                try {
                    _pCoberturaInc('genericosPdfs');
                    const obtido = await _pPdfTRDComRetry404(chaveProcesso, ficha, cand);
                    const texto = await proadTextoDoPdf(obtido.buf);
                    if (_pSemEspacos(texto).length < 100) {
                        _pCoberturaInc('genericosSemTexto');
                        console.log(`[PROAD worker] ${chaveProcesso} DOC ${cand.numero}: fallback genérico sem camada de texto útil; ignorando.`);
                        continue;
                    }

                    let tipo = '';
                    let parsed = null;
                    const tSemAcentos = _pSemAcentos(texto);
                    if (_pConfirmaConteudoTRD(texto, cand)) {
                        tipo = 'trd-generico';
                        parsed = proadParseTRD(texto);
                    } else if (permitirRelatorioMedicao && CONFIRMA_MEDICAO.test(tSemAcentos)) {
                        tipo = 'relatorio-medicao-generico';
                        parsed = proadParseRelatorioMedicao(texto);
                    } else if (CONFIRMA_CI_ATESTE.test(String(texto || '').replace(/\s+/g, ' '))) {
                        tipo = 'ci-ateste-generico';
                        parsed = proadParseTRD(texto);
                    } else {
                        continue;
                    }

                    const notas = (parsed?.notas || []).map(_pNotaDeReferencia).filter(Boolean);
                    if (!notas.includes(nota)) continue;
                    const cnpjLido = _pSoDigitos(parsed?.cnpj);
                    if (cnpjAlvo && cnpjLido && cnpjAlvo !== cnpjLido) {
                        console.warn(`[PROAD worker] ${chaveProcesso} DOC ${cand.numero}: NF ${nota} aparece, mas CNPJ do PDF (${cnpjLido}) diverge do alvo (${cnpjAlvo}); rejeitando fallback genérico.`);
                        continue;
                    }

                    const assinaturas = await proadExtrairAssinaturas(obtido.buf);
                    const analisado = { valido: true, trd: parsed, assinaturas };
                    const registro = montarRegistroTRD(
                        analisado, chaveProcesso, cand,
                        `${origem} — localizado pelo conteúdo do PDF`,
                        solicitacaoProvidencia, nota
                    );
                    registro.casouPelaNota = true;
                    registro.notaCasada = nota;
                    registro.tipoDocumento = tipo;
                    registro.fallbackPorConteudo = true;
                    if (tipo === 'relatorio-medicao-generico') registro.competencia = null;
                    console.log(`[PROAD worker] ${chaveProcesso} DOC ${cand.numero}: fallback por conteúdo CONFIRMADO para NF ${nota} (${tipo}).`);
                    return registro;
                } catch (e) {
                    console.warn(`[PROAD worker] ${chaveProcesso} DOC ${cand.numero}: fallback por conteúdo falhou — ${e?.message || e}`);
                }
            }
            return null;
        }

async function procurarTRDEmProcesso(chaveProcesso, numeroNota, origem, solicitacaoProvidencia = null, orcamento = null, maxCegos = MAX_TRDS, dataReferencia = null, permitirAtualizacaoNegativa = true) {
                    const [numero, ano] = chaveProcesso.split('/');
                    // A segunda passagem, acionada apenas após resultado negativo, força uma
                    // ficha realmente nova. A primeira continua usando os atalhos/cache atuais.
                    const ficha = await lerFicha(numero, ano, permitirAtualizacaoNegativa ? null : { forcarFetch: true });
                    const todosCandidatos = proadListarDocumentos(ficha.doc)
                        .filter(d => FILTRO_TRD.test(d.descricao))
                        .sort((a, b) => Number(b.numero || 0) - Number(a.numero || 0));
                    _pCoberturaInc('trdCandidatos', todosCandidatos.length);
                    if (!todosCandidatos.length) {
                        if (permitirAtualizacaoNegativa) {
                            console.log(`[PROAD worker] ${chaveProcesso}: nenhum TRD no snapshot atual; atualizando a ficha uma vez antes de concluir`);
                            const orcamentoRetry = { restante: Math.max(2, Number(orcamento?.restante) || 0) };
                            return await procurarTRDEmProcesso(
                                chaveProcesso, numeroNota, origem, solicitacaoProvidencia,
                                orcamentoRetry, maxCegos, dataReferencia, false
                            );
                        }
                        return { ficha, registro: null, totalCandidatos: 0 };
                    }

                    const notaNormalizada = _pNotaDeReferencia(numeroNota);
                    if (notaNormalizada) {
                        const hit = CACHE_TRD_NOTA.get(`${chaveProcesso}|${notaNormalizada}`);
                        if (hit?.analisado?.valido) {
                            const registro = montarRegistroTRD(hit.analisado, chaveProcesso, hit.cand, origem, solicitacaoProvidencia, notaNormalizada);
                            registro.casouPelaNota = true;
                            // v11.36.22 — indispensável para TRDs com várias NFs:
                            // a certidão precisa saber QUAL NF deste TRD está sendo validada.
                            registro.notaCasada = notaNormalizada;
                            registro.totalTRDsNoProcesso = todosCandidatos.length;
                            return { ficha, registro, totalCandidatos: todosCandidatos.length };
                        }
                    }

                    const mencionaNota = cand =>
                        !!notaNormalizada && proadDescricaoMencionaNota(cand.descricao, notaNormalizada);
                    const prioritarios = todosCandidatos.filter(mencionaNota);

                    // Sem menção à nota no título, o desempate é a data de juntada: num contrato
                    // com muitas medições o TRD da nota é juntado perto do ateste dela. Só a
                    // numeração decrescente fazia o robô olhar apenas os TRDs mais novos — foi
                    // assim que o DOC 60 (NF 88, juntado no mesmo dia do ateste) ficou de fora.
                    const refMs = _pDataParaMs(dataReferencia);
                    const restantes = todosCandidatos
                        .filter(c => !mencionaNota(c))
                        .sort((a, b) => {
                            const da = _pDataParaMs(a.cadastradoEm), db = _pDataParaMs(b.cadastradoEm);
                            if (refMs && da && db) {
                                const dif = Math.abs(da - refMs) - Math.abs(db - refMs);
                                if (dif !== 0) return dif;
                            } else if (refMs && da) { return -1; }
                            else if (refMs && db) { return 1; }
                            return Number(b.numero || 0) - Number(a.numero || 0);
                        });

                    if (refMs && restantes.length) {
                        console.log(`[PROAD worker] ${chaveProcesso}: ordenando ${restantes.length} candidato(s) `
                            + `pela proximidade de ${dataReferencia} → `
                            + restantes.slice(0, 4).map(c => `DOC ${c.numero}${c.cadastradoEm ? '(' + c.cadastradoEm + ')' : ''}`).join(', '));
                    }

                    const candidatos = [
                        ...prioritarios,
                        ...restantes.slice(0, Math.max(0, maxCegos))
                    ];

                    let primeiro = null;
                    for (const cand of candidatos) {
                        const analisado = await analisarDocumentoTRD(chaveProcesso, ficha, cand, orcamento);
                        if (!analisado || analisado.esgotado) break;
                        if (!analisado.valido) continue;

                        const registro = montarRegistroTRD(analisado, chaveProcesso, cand, origem, solicitacaoProvidencia, notaNormalizada);
                        registro.casouPelaNota = !!(notaNormalizada && (analisado.trd.notas || []).includes(notaNormalizada));
                        registro.totalTRDsNoProcesso = todosCandidatos.length;
                        if (registro.casouPelaNota) {
                            registro.notaCasada = notaNormalizada;
                            return { ficha, registro, totalCandidatos: todosCandidatos.length };
                        }

                        console.log(
                            `[PROAD worker] ${chaveProcesso} DOC ${cand.numero}: TRD válido, `
                            + `mas NF ${notaNormalizada || numeroNota} não casou; `
                            + `NF(s) lida(s) no PDF: ${(analisado.trd.notas || []).join(', ') || '(nenhuma)'}`
                        );

                        if (!primeiro) primeiro = registro;
                    }
                    // Resultado negativo pode estar baseado numa ficha mantida em memória
                    // antes da juntada do documento. Faz UMA segunda passagem com GET real.
                    if (permitirAtualizacaoNegativa) {
                        console.log(`[PROAD worker] ${chaveProcesso}: NF ${notaNormalizada || numeroNota || '?'} não casou no snapshot atual; atualizando a ficha uma vez`);
                        const orcamentoRetry = { restante: Math.max(2, Number(orcamento?.restante) || 0) };
                        const atualizado = await procurarTRDEmProcesso(
                            chaveProcesso, numeroNota, origem, solicitacaoProvidencia,
                            orcamentoRetry, maxCegos, dataReferencia, false
                        );
                        if (atualizado?.registro?.casouPelaNota) {
                            console.log(`[PROAD worker] ${chaveProcesso}: atualização da ficha localizou a NF ${notaNormalizada || numeroNota}`);
                            return atualizado;
                        }
                    }

                    return { ficha, registro: primeiro, totalCandidatos: todosCandidatos.length };
                }

                // A aba Providências é um selectOneButton (formAbas:selecionarAba) com
                // valor "tabFichaProvidencias" e evento "change". Só carrega por postback.
                async function listarProvidencias(ficha) {
                    const componente = ficha.doc.querySelector('[id$="selecionarAba"]');
                    if (!componente) return [];
                    const idComponente = componente.id;
                    const idForm = componente.closest('form').id;
                    const viewState = ficha.doc.querySelector('input[name="jakarta.faces.ViewState"]').value;
                    const radio = [...componente.querySelectorAll('input[type="radio"]')]
                        .find(i => /providencias/i.test(i.getAttribute('value') || ''));
                    if (!radio) return [];

                    const p = new URLSearchParams({
                        'jakarta.faces.partial.ajax': 'true',
                        'jakarta.faces.source': idComponente,
                        'jakarta.faces.partial.execute': '@all',
                        'jakarta.faces.partial.render': '@all',
                        'jakarta.faces.behavior.event': 'change',
                        'jakarta.faces.partial.event': 'change',
                        [idComponente]: radio.getAttribute('value'),
                        [idForm]: idForm,
                        'jakarta.faces.ViewState': viewState
                    });

                    const r = await _pFetchRapido(ficha.url, {
                        method: 'POST', credentials: 'include',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                            'Faces-Request': 'partial/ajax', 'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: p.toString()
                    }, TIMEOUT_POSTBACK_MS, 'aba Providências');
                    if (!r.ok) throw new Error(`aba Providências HTTP ${r.status}`);
                    const texto = await r.text();

                    const d = new DOMParser().parseFromString(
                        texto.replace(/<!\[CDATA\[|\]\]>/g, ''), 'text/html');

                    return [...d.querySelectorAll('tr')].map(tr => {
                        const celulas = [...tr.querySelectorAll('td')]
                            .map(td => td.textContent.replace(/\$\(function\(\)[\s\S]*?\}\);/g, ' ')
                                .replace(/\s+/g, ' ').trim());
                        const numero = celulas.find(x => /^\d{3,6}\/20\d{2}$/.test(x));
                        if (!numero) return null;
                        // A célula de situação vem colada com data e script: basta o começo.
                        const bruta = celulas.find(x => /^(Em Aberto|Fechad|Cancelad)/i.test(x)) || '';
                        const situacao = (bruta.match(/^(Em Aberto|Fechad[ao]|Cancelad[ao])/i) || [''])[0];
                        return {
                            numero,
                            situacao,
                            emAberto: /^Em Aberto/i.test(bruta),
                            texto: celulas.join(' ')
                        };
                    }).filter(Boolean);
                }

                async function _pBuscarProvidenciasEmParalelo(providencias, chavePrincipal, numeroNota, orcamento) {
                    const fila = (providencias || [])
                        .filter(p => p?.emAberto === true || /^Em Aberto/i.test(p?.situacao || ''))
                        .slice(0, MAX_PROVIDENCIAS_RAPIDAS);
                    if (!fila.length || (orcamento && orcamento.restante <= 0)) return null;

                    // Apesar do nome histórico da função, a execução agora é SEQUENCIAL.
                    // O PrimeFaces mantém estado de documento selecionado por sessão: duas
                    // providências/rowSelect simultâneas podem invalidar dynamiccontent.
                    //
                    // Cada providência pode conter mais de um TRD do mesmo pagamento.
                    // Testa até 2 termos, em ordem, e para assim que a NF casar.
                    for (const prov of fila) {
                        if (orcamento && orcamento.restante <= 0) break;

                        const limiteLocal = Math.min(2, Math.max(1, orcamento?.restante || 2));
                        const orcamentoLocal = { restante: limiteLocal };

                        try {
                            const achado = await procurarTRDEmProcesso(
                                prov.numero,
                                numeroNota,
                                `providência ${prov.numero}${prov.situacao ? ` [${prov.situacao}]` : ''} (de ${chavePrincipal})`,
                                prov.numero,
                                orcamentoLocal,
                                limiteLocal
                            );

                            if (orcamento) {
                                const consumidos = limiteLocal - Math.max(0, orcamentoLocal.restante);
                                orcamento.restante = Math.max(0, orcamento.restante - consumidos);
                            }

                            if (!achado.registro?.casouPelaNota) {
                                // v11.36.24 — não tenta reconstruir a NF a partir de fragmentos
                                // do PDF. A certidão da PRÓPRIA providência precisa provar
                                // explicitamente NF pesquisada ↔ mesmo DOC do TRD.
                                if (achado.registro?.docNumero) {
                                    const confirmacao = await _pCertidaoConfirmaTRDdaNotaNaProvidencia(
                                        prov,
                                        chavePrincipal,
                                        numeroNota,
                                        achado.registro
                                    );

                                    if (confirmacao?.numero === _pProc(prov.numero)) {
                                        const notaAlvo = _pNotaDeReferencia(numeroNota);
                                        achado.registro.casouPelaNota = true;
                                        achado.registro.notaCasada = notaAlvo;
                                        achado.registro.solicitacaoProvidencia = confirmacao.numero;
                                        achado.registro.solicitacaoSituacao = confirmacao.situacao || prov.situacao || '';
                                        achado.registro.docCertidao = confirmacao.docCertidao || '';
                                        achado.registro.vinculoConfirmadoPorCertidao = true;
                                        achado.registro.proadPrincipalSIGEO = chavePrincipal;

                                        // Cacheia pelo número correto APENAS depois da confirmação documental.
                                        if (notaAlvo) {
                                            const candCache = {
                                                numero: achado.registro.docNumero,
                                                descricao: achado.registro.descricao || '',
                                                assinantes: achado.registro.assinantesNaFicha || []
                                            };
                                            const analisadoCache = CACHE_TRD_DOC.get(
                                                `${_pProc(prov.numero)}|${achado.registro.docNumero || ''}|${achado.registro.rowKey || ''}`
                                            );
                                            // Não depende desse cache auxiliar para funcionar; apenas evita
                                            // nova varredura quando já houver análise indexada por NF.
                                            if (!CACHE_TRD_NOTA.has(`${_pProc(prov.numero)}|${notaAlvo}`)) {
                                                const hitExistente = [...CACHE_TRD_DOC.entries()]
                                                    .find(([k, v]) =>
                                                        k.startsWith(`${_pProc(prov.numero)}|${achado.registro.docNumero}|`)
                                                        && v?.valido
                                                    );
                                                if (hitExistente) {
                                                    CACHE_TRD_NOTA.set(
                                                        `${_pProc(prov.numero)}|${notaAlvo}`,
                                                        { cand: candCache, analisado: hitExistente[1] }
                                                    );
                                                }
                                            }
                                        }

                                        console.log(
                                            `[PROAD worker] TRD da NF ${notaAlvo || numeroNota} confirmado pela CERTIDÃO `
                                            + `da providência ${prov.numero} DOC ${achado.registro.docNumero}; `
                                            + `texto do TRD tinha NF fragmentada: ${(achado.registro.notas || []).join(', ') || '(nenhuma)'}`
                                        );
                                        return achado.registro;
                                    }
                                }
                                continue;
                            }

                            achado.registro.solicitacaoProvidencia = prov.numero;
                            achado.registro.solicitacaoSituacao = prov.situacao || '';
                            achado.registro.proadPrincipalSIGEO = chavePrincipal;
                            console.log(
                                `[PROAD worker] TRD da NF ${_pNotaDeReferencia(numeroNota) || numeroNota} `
                                + `confirmado na providência ${prov.numero} DOC ${achado.registro.docNumero}`
                            );
                            return achado.registro;
                        } catch (e) {
                            console.warn(
                                `[PROAD worker] providência ${prov.numero}: falha ao procurar TRD da NF `
                                + `${_pNotaDeReferencia(numeroNota) || numeroNota}: ${e?.message || e}`
                            );
                        }
                    }
                    return null;
                }

                // v11.40.20 — caminho específico da Manutenção Predial.
                // Em vez de varrer TODAS as providências procurando TRD e só depois voltar
                // a todas elas procurando Relatório de Medição, resolve uma providência por vez:
                // TRD → Relatório de Medição → próxima providência.
                // A tentativa de TRD usa UMA ficha fresca e não refaz a mesma ficha após
                // resultado negativo; o Relatório reaproveita essa ficha pelo cache.
                async function _pBuscarAtesteManutencaoNasProvidencias(
                    providencias, chavePrincipal, numeroNota, cnpj, orcamento, tentadas = null
                ) {
                    const fila = (providencias || [])
                        .filter(p => p?.emAberto === true || /^Em Aberto/i.test(p?.situacao || ''))
                        .slice(0, MAX_PROVIDENCIAS_RAPIDAS);
                    if (!fila.length) return null;

                    for (const prov of fila) {
                        const procProv = _pProc(prov?.numero);
                        if (!procProv) continue;
                        if (tentadas?.has(procProv)) continue;
                        if (tentadas) tentadas.add(procProv);
                        if (orcamento && orcamento.restante <= 0) break;

                        const limiteLocal = Math.min(2, Math.max(1, orcamento?.restante || 2));
                        const orcamentoLocal = { restante: limiteLocal };

                        // 1) Mantém TRD como primeira preferência, mas sem a segunda
                        // atualização automática da ficha quando o resultado for negativo.
                        try {
                            const achado = await procurarTRDEmProcesso(
                                procProv,
                                numeroNota,
                                `providência ${procProv}${prov.situacao ? ` [${prov.situacao}]` : ''} (de ${chavePrincipal})`,
                                procProv,
                                orcamentoLocal,
                                limiteLocal,
                                null,
                                false
                            );

                            if (orcamento) {
                                const consumidos = limiteLocal - Math.max(0, orcamentoLocal.restante);
                                orcamento.restante = Math.max(0, orcamento.restante - consumidos);
                            }

                            if (achado.registro?.casouPelaNota) {
                                achado.registro.solicitacaoProvidencia = procProv;
                                achado.registro.solicitacaoSituacao = prov.situacao || '';
                                achado.registro.proadPrincipalSIGEO = chavePrincipal;
                                console.log(`[PROAD worker] Manutenção: TRD da NF ${_pNotaDeReferencia(numeroNota) || numeroNota} confirmado na providência ${procProv} DOC ${achado.registro.docNumero}`);
                                return achado.registro;
                            }

                            // Preserva a regra existente dos TRDs cujo número da NF ficou
                            // fragmentado no texto: a certidão da própria providência pode
                            // confirmar explicitamente NF ↔ DOC antes de aceitar o resultado.
                            if (achado.registro?.docNumero) {
                                const confirmacao = await _pCertidaoConfirmaTRDdaNotaNaProvidencia(
                                    prov, chavePrincipal, numeroNota, achado.registro
                                );
                                if (confirmacao?.numero === procProv) {
                                    const notaAlvo = _pNotaDeReferencia(numeroNota);
                                    achado.registro.casouPelaNota = true;
                                    achado.registro.notaCasada = notaAlvo;
                                    achado.registro.solicitacaoProvidencia = procProv;
                                    achado.registro.solicitacaoSituacao = confirmacao.situacao || prov.situacao || '';
                                    achado.registro.docCertidao = confirmacao.docCertidao || '';
                                    achado.registro.vinculoConfirmadoPorCertidao = true;
                                    achado.registro.proadPrincipalSIGEO = chavePrincipal;
                                    console.log(`[PROAD worker] Manutenção: TRD da NF ${notaAlvo || numeroNota} confirmado pela CERTIDÃO da providência ${procProv} DOC ${achado.registro.docNumero}`);
                                    return achado.registro;
                                }
                            }
                        } catch (e) {
                            console.warn(`[PROAD worker] Manutenção: falha ao procurar TRD da NF ${_pNotaDeReferencia(numeroNota) || numeroNota} na providência ${procProv}: ${e?.message || e}`);
                        }

                        // 2) Sem TRD confirmado nesta providência, tenta imediatamente o
                        // Relatório de Medição da MESMA NF antes de abrir a providência seguinte.
                        try {
                            const medicao = await procurarMedicaoEmProcesso(
                                procProv,
                                numeroNota,
                                cnpj,
                                `relatório de medição na providência ${procProv}${prov.situacao ? ` [${prov.situacao}]` : ''} (de ${chavePrincipal})`,
                                procProv,
                                Number.POSITIVE_INFINITY
                            );
                            if (medicao.registro?.casouPelaNota) {
                                medicao.registro.solicitacaoProvidencia = procProv;
                                medicao.registro.solicitacaoSituacao = prov.situacao || '';
                                medicao.registro.proadPrincipalSIGEO = chavePrincipal;
                                medicao.registro.competencia = null;
                                console.log(`[PROAD worker] Manutenção: Relatório de Medição da NF ${_pNotaDeReferencia(numeroNota) || numeroNota} confirmado na providência ${procProv} DOC ${medicao.registro.docNumero}`);
                                return medicao.registro;
                            }
                        } catch (e) {
                            console.warn(`[PROAD worker] Manutenção: medição na providência ${procProv}: ${e?.message || e}`);
                        }
                    }
                    return null;
                }

                async function _pBuscarMedicoesEmProvidenciasParalelo(providencias, chavePrincipal, numeroNota, cnpj) {
                    const fila = (providencias || [])
                        .filter(p => p?.emAberto === true || /^Em Aberto/i.test(p?.situacao || ''))
                        .slice(0, MAX_PROVIDENCIAS_RAPIDAS);
                    if (!fila.length) return null;

                    for (const prov of fila) {
                        try {
                            const achado = await procurarMedicaoEmProcesso(
                                prov.numero,
                                numeroNota,
                                cnpj,
                                `relatório de medição na providência ${prov.numero}${prov.situacao ? ` [${prov.situacao}]` : ''} (de ${chavePrincipal})`,
                                prov.numero,
                                Number.POSITIVE_INFINITY
                            );
                            if (!achado.registro?.casouPelaNota) continue;
                            achado.registro.solicitacaoProvidencia = prov.numero;
                            achado.registro.solicitacaoSituacao = prov.situacao || '';
                            achado.registro.proadPrincipalSIGEO = chavePrincipal;
                            achado.registro.competencia = null;
                            return achado.registro;
                        } catch (e) {
                            console.warn(`[PROAD worker] medição na providência ${prov.numero}: ${e?.message || e}`);
                        }
                    }
                    return null;
                }

                function _pSolicitacaoSeguraParaNota(providencias, numeroNota) {
                    const nota = _pNotaDeReferencia(numeroNota);
                    if (!nota) return null;
                    const candidatas = [];
                    const vistas = new Set();
                    for (const p of (providencias || [])) {
                        const numero = _pProc(p?.numero);
                        if (!numero || vistas.has(numero)) continue;
                        if (!proadDescricaoMencionaNota(p?.texto || '', nota)) continue;
                        vistas.add(numero);
                        candidatas.push(numero);
                    }
                    return candidatas.length === 1 ? candidatas[0] : null;
                }

                async function _pIdentificarProvidenciaPorDocumentos(providencias, numeroNota) {
                    const nota = _pNotaDeReferencia(numeroNota);
                    if (!nota) return null;
                    const fila = (providencias || []).slice(0, MAX_PROVIDENCIAS_RAPIDAS);
                    const resultados = await Promise.allSettled(fila.map(async p => {
                        const proc = _pProc(p?.numero);
                        if (!proc) return null;
                        const [n, a] = proc.split('/');
                        const ficha = await lerFicha(n, a); // normalmente já está em cache
                        const menciona = proadListarDocumentos(ficha.doc)
                            .some(d => proadDescricaoMencionaNota(d.descricao, nota));
                        return menciona ? proc : null;
                    }));
                    const unicas = _pUnicos(resultados
                        .filter(r => r.status === 'fulfilled' && r.value)
                        .map(r => r.value));
                    return unicas.length === 1 ? unicas[0] : null;
                }


                function _pTextoReferenciaDocPrincipal(
                    texto, chavePrincipal, docNumero, competencia = null, numeroNota = null
                ) {
                    const t = String(texto || '').replace(/\s+/g, ' ').trim();
                    const principal = _pProc(chavePrincipal);
                    const doc = String(docNumero || '').replace(/\D/g, '');
                    if (!t || !principal) return false;

                    const escPrincipal = principal.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
                        .replace('/', '\\s*\\/\\s*');

                    // A certidão pode citar outros processos, mas para prova por PROAD+NF
                    // o principal precisa aparecer explicitamente. Se só houver outro PROAD,
                    // o vínculo é rejeitado.
                    const proads = [...t.matchAll(/\b(\d{3,6}\s*\/\s*20\d{2})\b/g)]
                        .map(m => _pProc(m[1]))
                        .filter(Boolean);
                    if (proads.length && !proads.includes(principal)) return false;

                    // Competência explicitamente rotulada continua sendo uma trava adicional.
                    if (competencia) {
                        const comp = String(competencia).replace(/\s+/g, '');
                        const reComp = new RegExp(
                            `(?:compet[eê]ncia|per[ií]odo)[^]{0,80}?${comp.replace('/', '\\s*\\/\\s*')}`,
                            'i'
                        );
                        const temRotuloComp = /(?:compet[eê]ncia|per[ií]odo)/i.test(t);
                        if (temRotuloComp && !reComp.test(t)) return false;
                    }

                    // v11.40.6 — PROAD + NF é uma prova independente do TRD.
                    // Essa etapa vem ANTES de qualquer requisito de DOC, permitindo confirmar
                    // a Solicitação mesmo quando o documento de ateste ainda não foi localizado.
                    const nota = _pNotaDeReferencia(numeroNota);
                    let mNota = null;
                    if (nota) {
                        // v11.40.6 — não compara a NF por representação textual literal.
                        // Captura qualquer referência explicitamente rotulada como NF/Nota Fiscal
                        // e normaliza pelo mesmo núcleo usado no SIGEO. Assim, 14, 14/2026,
                        // 2026/14 e 202600000000014 representam a mesma NF fiscal 14.
                        const reRefsNF = /(?<!Data\s+de\s+emiss[ãa]o\s+da\s+)(?:\bNF(?:S?\s*-?\s*e)?(?:\s+n[ºo°]?)?|Nota\s+Fiscal(?:\s+Eletr[ôo]nica)?(?:\s+n?[ºo°])?)\s*[:#._-]?\s*((?:20\d{2}\s*[\/_-]\s*)?\d{1,20}(?:\s*\/\s*20\d{2})?)\b(?!\s*[\/-]\s*\d)/gi;
                        let mr;
                        while ((mr = reRefsNF.exec(t)) !== null) {
                            let ref = String(mr[1] || '').replace(/_/g, '/');
                            ref = ref.replace(/(20\d{2})-(\d+)/, '$1/$2').replace(/(\d+)-(20\d{2})/, '$1/$2');
                            if (_pNotaDeReferencia(ref) === nota) {
                                mNota = { index: mr.index, 0: mr[0], refNormalizada: nota };
                                break;
                            }
                        }
                        const citaPrincipal = new RegExp(`\\b${escPrincipal}\\b`, 'i').test(t);
                        if (mNota && citaPrincipal) {
                            return { ok: true, modo: 'proad-nf', nota };
                        }
                    }

                    // Daqui para baixo, as provas dependem de um DOC de TRD conhecido.
                    if (!doc) return false;
                    const escDoc = String(Number(doc) || doc).replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

                    // Forma clássica: "documento 323" / "doc. 323".
                    const reDocDireto = new RegExp(
                        `\\b(?:documento|doc\\.?)(?:\\s+n[ºo°]?)?\\s*[:#.-]?\\s*0*${escDoc}\\b`,
                        'i'
                    );
                    if (reDocDireto.test(t)) return { ok: true, modo: 'doc-direto' };

                    // Saúde/Unimed: DOC aparece apenas dentro do bloco da NF.
                    if (!nota || !mNota) return false;
                    const inicio = mNota.index;
                    const resto = t.slice(inicio, inicio + 700);
                    const prox = resto.slice(mNota[0].length).search(
                        /\bNF(?:S?\s*-?\s*e)?(?:\s+n[ºo°]?)?\s*[:#.-]?\s*\d+\b/i
                    );
                    const blocoNF = prox >= 0
                        ? resto.slice(0, mNota[0].length + prox)
                        : resto;

                    if (!/\bDocumentos?\s*:/i.test(blocoNF)) return false;
                    if (!new RegExp(`\\b0*${escDoc}\\b`, 'i').test(blocoNF)) return false;
                    if (!/\bTermos?\s+de\s+Recebimentos?\b|\bRecebimento\s+Definitivo\b|\bTRD\b/i.test(blocoNF)) return false;

                    return { ok: true, modo: 'bloco-nf', nota };
                }

                async function _pConfirmarSolicitacaoPorProadNFAntesDoTRD(
                    providencias, chavePrincipal, numeroNota
                ) {
                    const principal = _pProc(chavePrincipal);
                    const nota = _pNotaDeReferencia(numeroNota);
                    if (!principal || !nota) return null;

                    const chaveCache = `${principal}|${nota}`;
                    if (CACHE_SOLICITACAO_NOTA.has(chaveCache)) {
                        return CACHE_SOLICITACAO_NOTA.get(chaveCache);
                    }

                    const fila = [];
                    const vistos = new Set();
                    for (const p of (providencias || [])) {
                        const proc = _pProc(p?.numero);
                        const aberta = p?.emAberto === true || /^Em Aberto/i.test(p?.situacao || '');
                        if (!proc || !aberta || vistos.has(proc)) continue;
                        vistos.add(proc);
                        fila.push(p);
                        if (fila.length >= MAX_PROVIDENCIAS_RAPIDAS) break;
                    }
                    if (!fila.length) return null;

                    const confirmados = [];
                    const diag = (nivel, mensagem) => {
                        const fn = nivel === 'erro' ? console.error
                            : nivel === 'aviso' ? console.warn : console.log;
                        try { fn.call(console, `[PROAD worker][solicitação-prévia] ${mensagem}`); } catch (_) {}
                    };

                    for (const p of fila) {
                        const proc = _pProc(p.numero);
                        try {
                            const [n, a] = proc.split('/');
                            // A prova prévia serve justamente para evitar resultado baseado em
                            // snapshot antigo: usa ficha fresca da providência.
                            const ficha = await lerFicha(n, a, { forcarFetch: true });
                            const todosDocs = proadListarDocumentos(ficha.doc);
                            const docs = todosDocs
                                .filter(d => /certid|solicita[cç][aã]o\s+de\s+provid[eê]ncia|pagamento/i.test(d.descricao || ''))
                                .sort((x, y) => {
                                    const sx = /CERTID[AÃ]O\s*-\s*Solicita[cç][aã]o\s+de\s+Provid[eê]ncia/i.test(x.descricao || '') ? 1 : 0;
                                    const sy = /CERTID[AÃ]O\s*-\s*Solicita[cç][aã]o\s+de\s+Provid[eê]ncia/i.test(y.descricao || '') ? 1 : 0;
                                    return (sy - sx) || (Number(y.numero || 0) - Number(x.numero || 0));
                                })
                                .slice(0, 2);

                            if (!docs.length) {
                                diag('aviso', `${proc}: sem Certidão/Solicitação candidata para provar ${principal} + NF ${nota}.`);
                                continue;
                            }

                            for (const cand of docs) {
                                try {
                                    _pCoberturaInc('certidoes');
                                    const texto = await obterTextoCertidao(proc, ficha, cand, diag);
                                    const prova = _pTextoReferenciaDocPrincipal(
                                        texto, principal, '', null, nota
                                    );
                                    if (!prova?.ok || prova.modo !== 'proad-nf') continue;

                                    confirmados.push({
                                        numero: proc,
                                        situacao: p?.situacao || 'Em Aberto',
                                        docCertidao: cand.numero || '',
                                        descricaoCertidao: cand.descricao || '',
                                        modoConfirmacao: 'proad-nf',
                                        notaConfirmada: nota,
                                        temTRDNoSnapshot: todosDocs.some(d => FILTRO_TRD.test(d.descricao || ''))
                                    });
                                    diag('info', `${proc} DOC ${cand.numero}: Solicitação comprovada ANTES do TRD por ${principal} + NF ${nota}.`);
                                    break;
                                } catch (e) {
                                    diag('aviso', `${proc} DOC ${cand.numero || '?'}: ${e?.message || e}`);
                                }
                            }
                        } catch (e) {
                            diag('aviso', `${proc}: falha ao validar certidão antes do TRD — ${e?.message || e}`);
                        }
                    }

                    const unicos = [];
                    const procVistos = new Set();
                    for (const c of confirmados) {
                        if (procVistos.has(c.numero)) continue;
                        procVistos.add(c.numero);
                        unicos.push(c);
                    }

                    if (unicos.length === 1) {
                        CACHE_SOLICITACAO_NOTA.set(chaveCache, unicos[0]);
                        return unicos[0];
                    }
                    if (unicos.length > 1) {
                        diag('aviso', `AMBIGUIDADE: ${unicos.length} providências Em Aberto citam ${principal} + NF ${nota}: ${unicos.map(x => x.numero).join(', ')}. Nada será preenchido.`);
                    }
                    return null;
                }

                function _pAplicarSolicitacaoPreConfirmada(registro, vinculo, chavePrincipal, numeroNota) {
                    if (!registro || !vinculo?.numero) return registro;
                    const nota = vinculo.notaConfirmada || _pNotaDeReferencia(numeroNota) || null;
                    registro.solicitacaoProvidencia = vinculo.numero;
                    registro.solicitacaoSituacao = vinculo.situacao || 'Em Aberto';
                    registro.solicitacaoIdentificadaPor = `PROAD ${chavePrincipal} + NF ${nota || numeroNota} explicitamente citados na certidão (prova anterior ao TRD)`;
                    registro.docCertidaoSolicitacao = vinculo.docCertidao || '';

                    if (registro.docNumero) {
                        CACHE_SOLICITACAO_DOC.set(
                            `${chavePrincipal}|${registro.docNumero}|${nota || ''}`,
                            {
                                numero: vinculo.numero,
                                situacao: vinculo.situacao || 'Em Aberto',
                                docCertidao: vinculo.docCertidao || '',
                                modoConfirmacao: 'proad-nf',
                                notaConfirmada: nota
                            }
                        );
                    }
                    return registro;
                }

                function _pUuidDynamicContent(referencia) {
                    try {
                        const candidatos = typeof referencia === 'string' ? [referencia]
                            : Array.isArray(referencia) ? referencia
                            : Array.isArray(referencia?.candidatosPdf) ? referencia.candidatosPdf
                            : referencia?.url ? [referencia.url] : [];
                        for (const bruto of candidatos) {
                            const s = String(bruto || '');
                            const m = s.match(/[?&]arquivoProtocoloSelecionadoRandomUuid=([^&#"'<>\s]+)/i);
                            if (m) return decodeURIComponent(m[1]);
                            try {
                                const u = new URL(s, location.href);
                                const v = u.searchParams.get('arquivoProtocoloSelecionadoRandomUuid');
                                if (v) return v;
                            } catch (_) {}
                        }
                    } catch (_) {}
                    return null;
                }

                function _pCertidaoVinculaNotaAoDocEstritamente(
                    texto, chavePrincipal, numeroNota, docNumero, competencia = null
                ) {
                    const t = String(texto || '').replace(/\s+/g, ' ').trim();
                    const principal = _pProc(chavePrincipal);
                    const nota = _pNotaDeReferencia(numeroNota);
                    const doc = String(docNumero || '').replace(/\D/g, '');
                    if (!t || !principal || !nota || !doc) return false;

                    // Se a certidão citar PROAD(s), o principal precisa estar entre eles.
                    const proads = [...t.matchAll(/\b(\d{3,6}\s*\/\s*20\d{2})\b/g)]
                        .map(m => _pProc(m[1]))
                        .filter(Boolean);
                    if (proads.length && !proads.includes(principal)) return false;

                    // Se houver rótulo EXPLÍCITO de competência/período, precisa ser o mesmo do TRD.
                    // Não usa "referente a" como rótulo: essa expressão também aparece em frases
                    // genéricas com vários meses e causava falso negativo.
                    if (competencia) {
                        const comp = String(competencia).replace(/\s+/g, '');
                        const temRotuloComp = /(?:compet[eê]ncia|per[ií]odo)/i.test(t);
                        if (temRotuloComp) {
                            const escComp = comp.replace('/', '\\s*\\/\\s*');
                            const reComp = new RegExp(
                                `(?:compet[eê]ncia|per[ií]odo)[^]{0,80}?${escComp}`,
                                'i'
                            );
                            if (!reComp.test(t)) return false;
                        }
                    }

                    // A NF pesquisada precisa estar explicitamente escrita na certidão.
                    const escNota = String(Number(nota) || nota)
                        .replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
                    const reNF = new RegExp(
                        `\\b(?:NF(?:S?\\s*-?\\s*e)?|Nota\\s+Fiscal(?:\\s+Eletr[ôo]nica)?)`
                        + `(?:\\s+n[ºo°]?)?\\s*[:#.-]?\\s*0*${escNota}\\b`,
                        'i'
                    );
                    const mNF = reNF.exec(t);
                    if (!mNF) return false;

                    // Analisa somente o bloco dessa NF, até a próxima NF.
                    const resto = t.slice(mNF.index, mNF.index + 900);
                    const depoisInicio = resto.slice(mNF[0].length);
                    const prox = depoisInicio.search(
                        /\b(?:NF(?:S?\s*-?\s*e)?|Nota\s+Fiscal(?:\s+Eletr[ôo]nica)?)(?:\s+n[ºo°]?)?\s*[:#.-]?\s*\d+\b/i
                    );
                    const bloco = prox >= 0
                        ? resto.slice(0, mNF[0].length + prox)
                        : resto;

                    const escDoc = String(Number(doc) || doc)
                        .replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

                    // Forma direta: DOC 4 / documento 4.
                    const reDocDireto = new RegExp(
                        `\\b(?:DOC\\.?|documento)(?:\\s+n[ºo°]?)?\\s*[:#.-]?\\s*0*${escDoc}\\b`,
                        'i'
                    );
                    if (reDocDireto.test(bloco)) return true;

                    // Forma em lista: "... 3, 4 e 5 Termos de Recebimento".
                    // Exige o nº do DOC no mesmo bloco da NF E menção inequívoca a TRD/recebimento.
                    const temDoc = new RegExp(`\\b0*${escDoc}\\b`, 'i').test(bloco);
                    const temTRD = /\bTRD\b|\bTermos?\s+de\s+Recebimentos?\b|\bRecebimento\s+Definitivo\b/i.test(bloco);

                    return temDoc && temTRD;
                }

                async function _pCertidaoConfirmaTRDdaNotaNaProvidencia(
                    prov, chavePrincipal, numeroNota, registroTRD
                ) {
                    const proc = _pProc(prov?.numero);
                    if (!proc || !registroTRD?.docNumero) return null;

                    const [n, a] = proc.split('/');
                    const ficha = await lerFicha(n, a);
                    const docs = proadListarDocumentos(ficha.doc)
                        .filter(d => /certid|solicita[cç][aã]o\s+de\s+provid[eê]ncia|pagamento/i.test(d.descricao || ''))
                        .sort((x, y) => {
                            const sx = /CERTID[AÃ]O\s*-\s*Solicita[cç][aã]o\s+de\s+Provid[eê]ncia/i.test(x.descricao || '') ? 1 : 0;
                            const sy = /CERTID[AÃ]O\s*-\s*Solicita[cç][aã]o\s+de\s+Provid[eê]ncia/i.test(y.descricao || '') ? 1 : 0;
                            return (sy - sx) || (Number(y.numero || 0) - Number(x.numero || 0));
                        })
                        .slice(0, 2);

                    const diag = (nivel, mensagem) => {
                        const fn = nivel === 'erro' ? console.error
                            : nivel === 'aviso' ? console.warn : console.log;
                        try { fn.call(console, `[PROAD worker][fallback-certidão] ${mensagem}`); } catch (_) {}
                    };

                    for (const cand of docs) {
                        try {
                            const textoPdf = await obterTextoCertidao(proc, ficha, cand, diag);
                            const ok = _pCertidaoVinculaNotaAoDocEstritamente(
                                textoPdf,
                                chavePrincipal,
                                numeroNota,
                                registroTRD.docNumero,
                                registroTRD.competencia || null
                            );
                            if (!ok) continue;

                            diag(
                                'info',
                                `${proc} DOC ${cand.numero}: certidão CONFIRMOU NF `
                                + `${_pNotaDeReferencia(numeroNota) || numeroNota} ↔ TRD DOC ${registroTRD.docNumero}`
                                + (registroTRD.competencia ? ` / ${registroTRD.competencia}` : '')
                            );
                            return {
                                numero: proc,
                                situacao: prov?.situacao || '',
                                docCertidao: cand.numero || '',
                                descricaoCertidao: cand.descricao || ''
                            };
                        } catch (e) {
                            diag('aviso', `${proc} DOC ${cand.numero || '?'}: ${e?.message || e}`);
                        }
                    }
                    return null;
                }

                // Ponto ÚNICO de leitura de certidão. Guarda a evidência bruta (o texto) por
                // idArquivo; quem chama continua validando por nota. Dois caminhos usam este
                // helper: a descoberta da Solicitação e o fallback de confirmação na
                // providência — antes só o primeiro aproveitava o cache.
                async function obterTextoCertidao(proc, ficha, cand, diag) {
                    const chave = cand?.rowKey || '';
                    if (chave && CACHE_CERTIDAO_TEXTO.has(chave)) {
                        const texto = CACHE_CERTIDAO_TEXTO.get(chave);
                        diag('info', `${proc} DOC ${cand.numero}: texto da certidão reaproveitado `
                            + `(${texto.length} chars, sem novo download)`);
                        return texto;
                    }
                    diag('info', `${proc} DOC ${cand.numero}: selecionando documento e obtendo PDF.`);
                    const obtido = await _pPdfCertidaoComRetry404(proc, ficha, cand, diag);
                    const texto = await proadTextoDoPdf(obtido.buf);
                    if (chave) CACHE_CERTIDAO_TEXTO.set(chave, texto);
                    return texto;
                }

                async function _pPdfCertidaoComRetry404(proc, ficha, cand, diag) {
                    const tentativa = async (fichaUsada, candUsado, numeroTentativa) => {
                        // Atalho comprovado (inclusive para esta certidão): idArquivo = data-rk.
                        const direto = await baixarPdfDireto(candUsado.rowKey);
                        if (direto) {
                            diag('info', `${proc} DOC ${candUsado.numero}: PDF direto `
                                + `(idArquivo=${candUsado.rowKey}, ${(direto.byteLength / 1024).toFixed(0)} KB)`);
                            return { buf: direto, ficha: fichaUsada, cand: candUsado, uuid: null };
                        }

                        const ref = await selecionar(fichaUsada, candUsado);
                        const uuid = _pUuidDynamicContent(ref);
                        diag('info', `${proc} DOC ${candUsado.numero}: tentativa ${numeroTentativa} (via postback)`
                            + (uuid ? ` · UUID ${uuid}` : ' · UUID não exposto na resposta'));
                        const buf = await baixarPdf(ref);
                        return { buf, ficha: fichaUsada, cand: candUsado, uuid };
                    };

                    try {
                        return await tentativa(ficha, cand, 1);
                    } catch (e) {
                        const msg = String(e?.message || e || '');
                        if (!/\bPDF HTTP 404(?: dynamiccontent)?\b/i.test(msg)) throw e;

                        diag('aviso', `${proc} DOC ${cand.numero}: dynamiccontent retornou 404; `
                            + 'refazendo ficha + rowSelect uma única vez para obter UUID novo.');

                        // O ViewState e o RandomUuid são temporários. Não reaproveita a ficha
                        // estática do primeiro postback: força uma GET nova do processo.
                        CACHE_FICHAS.delete(proc);
                        CACHE_FICHAS_EM_CURSO.delete(proc);
                        await _pPausa(90);

                        const [n, a] = proc.split('/');
                        const fichaNova = await lerFicha(n, a);
                        const docsNovos = proadListarDocumentos(fichaNova.doc);
                        const numeroAlvo = String(cand.numero || '').replace(/^0+/, '') || '0';
                        const candNovo = docsNovos.find(d => {
                            const nDoc = String(d.numero || '').replace(/^0+/, '') || '0';
                            return nDoc === numeroAlvo;
                        }) || docsNovos.find(d => String(d.descricao || '').trim() === String(cand.descricao || '').trim());

                        if (!candNovo) throw new Error(`retry 404: DOC ${cand.numero} não encontrado na ficha fresca ${proc}`);

                        const segunda = await tentativa(fichaNova, candNovo, 2);
                        diag('info', `${proc} DOC ${candNovo.numero}: retry após 404 concluído com sucesso.`);
                        return segunda;
                    }
                }

                async function _pIdentificarProvidenciaPorDocPrincipal(
                    providencias, chavePrincipal, registroTRD
                ) {
                    if (!registroTRD || registroTRD.solicitacaoProvidencia) return null;

                    const diagnosticos = registroTRD.diagnosticosSolicitacao
                        || (registroTRD.diagnosticosSolicitacao = []);
                    const diag = (nivel, mensagem) => {
                        const item = { nivel, mensagem: String(mensagem || '') };
                        diagnosticos.push(item);
                        const fn = nivel === 'erro' ? console.error
                            : nivel === 'aviso' ? console.warn : console.log;
                        try { fn.call(console, `[PROAD worker][solicitação] ${item.mensagem}`); } catch (_) {}
                    };

                    const docNumero = String(registroTRD.docNumero || '').replace(/\D/g, '');
                    if (!docNumero) {
                        diag('aviso', 'TRD encontrado, mas sem número de DOC para validar a Solicitação.');
                        return null;
                    }

                    diag('info', `Iniciando validação da Solicitação para TRD DOC ${docNumero} do PROAD ${chavePrincipal}.`);

                    // Mantém a ordenação existente, mas NÃO executa as providências em paralelo.
                    // O PrimeFaces usa estado de sessão + dynamiccontent temporário; múltiplos
                    // rowSelect simultâneos podem invalidar o RandomUuid uns dos outros.
                    const fila = _pOrdenarProvidenciasRapido(
                        providencias || [], null, registroTRD.cnpj || ''
                    ).sort((a, b) => {
                        const aa = a?.emAberto === true || /^Em Aberto/i.test(a?.situacao || '');
                        const bb = b?.emAberto === true || /^Em Aberto/i.test(b?.situacao || '');
                        return Number(bb) - Number(aa);
                    }).slice(0, 5);
                    const confirmados = [];

                    for (const p of fila) {
                        const proc = _pProc(p?.numero);
                        if (!proc) {
                            diag('aviso', 'Providência candidata sem número de processo válido.');
                            continue;
                        }

                        try {
                            diag('info', `${proc}: abrindo ficha da providência.`);
                            const [n, a] = proc.split('/');
                            const ficha = await lerFicha(n, a);

                            const todosDocs = proadListarDocumentos(ficha.doc);
                            const docs = todosDocs
                                .filter(d =>
                                    /certid|solicita[cç][aã]o\s+de\s+provid[eê]ncia|pagamento/i.test(d.descricao || '')
                                )
                                .sort((x, y) => {
                                    // Certidão/Solicitação primeiro; depois mais recente.
                                    const sx = /CERTID[AÃ]O\s*-\s*Solicita[cç][aã]o\s+de\s+Provid[eê]ncia/i.test(x.descricao || '') ? 1 : 0;
                                    const sy = /CERTID[AÃ]O\s*-\s*Solicita[cç][aã]o\s+de\s+Provid[eê]ncia/i.test(y.descricao || '') ? 1 : 0;
                                    return (sy - sx) || (Number(y.numero || 0) - Number(x.numero || 0));
                                })
                                .slice(0, 2);

                            if (!docs.length) {
                                diag('aviso', `${proc}: nenhum documento candidato a Certidão/Solicitação. `
                                    + `Documentos visíveis: ${todosDocs.slice(0, 6).map(d => `DOC ${d.numero}: ${d.descricao}`).join(' | ') || '(nenhum)'}`);
                                continue;
                            }

                            diag('info', `${proc}: candidato(s) ${docs.map(d => `DOC ${d.numero} — ${d.descricao}`).join(' | ')}`);

                            // Também sequencial dentro da mesma providência: o segundo DOC só é
                            // aberto se o primeiro não confirmar. Isso preserva o estado JSF.
                            for (const cand of docs) {
                                try {
                                    const textoPdf = await obterTextoCertidao(proc, ficha, cand, diag);

                                    const confirma = _pTextoReferenciaDocPrincipal(
                                        textoPdf,
                                        chavePrincipal,
                                        docNumero,
                                        registroTRD.competencia || null,
                                        registroTRD.notaCasada || registroTRD.numeroNota || null
                                    );

                                    if (!confirma || !confirma.ok) {
                                        diag('aviso', `${proc} DOC ${cand.numero}: PDF lido (${textoPdf.length} chars), `
                                            + `mas NÃO confirmou ${chavePrincipal} / DOC ${docNumero} / ${registroTRD.competencia || 'sem competência'}. `
                                            + `Início: "${textoPdf.replace(/\s+/g, ' ').slice(0, 180)}"`);
                                        continue;
                                    }

                                    const resumoProva = confirma.modo === 'proad-nf'
                                        ? `${chavePrincipal} + NF ${confirma.nota || registroTRD.notaCasada || registroTRD.numeroNota || '?'}`
                                        : confirma.modo === 'bloco-nf'
                                            ? `bloco da NF ${confirma.nota || '?'} + TRD DOC ${docNumero}`
                                            : `${chavePrincipal} / DOC ${docNumero}`
                                                + (registroTRD.competencia ? ` / ${registroTRD.competencia}` : '');
                                    diag('info', `${proc} DOC ${cand.numero}: PDF lido (${textoPdf.length} chars) e vínculo CONFIRMADO por ${resumoProva}.`);

                                    const confirmado = {
                                        numero: proc,
                                        situacao: p?.situacao || '',
                                        docCertidao: cand.numero || '',
                                        descricaoCertidao: cand.descricao || '',
                                        // 'doc-direto' → vale para todas as NFs do TRD
                                        // 'bloco-nf'   → só vale para a NF cujo bloco foi conferido
                                        // 'proad-nf'   → prova direta do par PROAD+NF; só vale para esta NF
                                        modoConfirmacao: confirma.modo,
                                        notaConfirmada: confirma.nota || null
                                    };

                                    // Com uma única providência aberta, a prova encerra a busca.
                                    // Com várias, não escolhe a primeira por ordem: coleta todas as
                                    // confirmações e só aceita se houver uma única providência compatível.
                                    confirmados.push(confirmado);
                                    if (fila.length === 1) {
                                        diag('info', `Solicitação confirmada: ${proc}. Encerrando busca.`);
                                        return confirmado;
                                    }
                                    break;
                                    } catch (e) {
                                    diag('erro', `${proc} DOC ${cand.numero || '?'}: FALHOU ao obter/ler o PDF — ${e?.message || e}`);
                                }
                            }
                        } catch (e) {
                            diag('erro', `${proc}: falha antes/durante a validação da certidão — ${e?.message || e}`);
                        }
                    }

                    if (confirmados.length === 1) {
                        const unico = confirmados[0];
                        diag('info', `Solicitação confirmada de forma unívoca entre ${fila.length} providência(s): ${unico.numero}.`);
                        return unico;
                    }
                    if (confirmados.length > 1) {
                        diag('aviso', `AMBIGUIDADE: ${confirmados.length} providências confirmaram a mesma evidência (${confirmados.map(x => x.numero).join(', ')}). Solicitação não preenchida.`);
                        return null;
                    }
                    diag('info', `${fila.length} providência(s) candidatas percorridas; nenhuma confirmou DOC, bloco NF ou o par PROAD+NF pesquisado.`);
                    return null;
                }

                async function _pEnriquecerSolicitacaoDoPrincipal(
                    registro, chavePrincipal, providenciasConhecidas, numeroNota, cnpj, fichaPrincipal = null
                ) {
                    if (!registro?.casouPelaNota || registro.solicitacaoProvidencia) return registro;

                    // A chave depende de COMO a certidão confirmou o vínculo:
                    //   doc-direto → a certidão cita "documento 437": independe da nota
                    //   bloco-nf   → o 437 só foi aceito dentro do bloco daquela NF, então
                    //                generalizar pularia a conferência do bloco das demais
                    //   proad-nf   → a certidão citou o PROAD principal + a NF exata; prova
                    //                específica desta nota, também sem generalização
                    // Consulta as duas: a específica primeiro, a geral depois.
                    const chaveDocNota = `${chavePrincipal}|${registro.docNumero}|${registro.notaCasada || registro.numeroNota || ''}`;
                    const chaveDoc = `${chavePrincipal}|${registro.docNumero}`;
                    const jaConhecidaNota = CACHE_SOLICITACAO_DOC.get(chaveDocNota);
                    const jaConhecidaDoc = CACHE_SOLICITACAO_DOC.get(chaveDoc);
                    const jaConhecida = jaConhecidaNota || jaConhecidaDoc;
                    if (jaConhecida) {
                        registro.solicitacaoProvidencia = jaConhecida.numero;
                        registro.solicitacaoSituacao = jaConhecida.situacao || '';
                        const modoCache = jaConhecida.modoConfirmacao || (jaConhecidaNota ? 'nota-especifica' : 'doc-direto');
                        registro.solicitacaoIdentificadaPor = modoCache === 'proad-nf'
                            ? `PROAD ${chavePrincipal} + NF ${jaConhecida.notaConfirmada || _pNotaDeReferencia(numeroNota) || numeroNota} explicitamente citados na certidão (em cache)`
                            : modoCache === 'trd-providencia'
                                ? `NF ${jaConhecida.notaConfirmada || _pNotaDeReferencia(numeroNota) || numeroNota} confirmada em TRD da própria providência Em Aberto (em cache)`
                                : modoCache === 'bloco-nf' || modoCache === 'nota-especifica'
                                    ? `bloco da NF ${jaConhecida.notaConfirmada || _pNotaDeReferencia(numeroNota) || numeroNota} validado na certidão (em cache)`
                                    : `referência explícita ao DOC ${registro.docNumero} (em cache)`;
                        registro.docCertidaoSolicitacao = jaConhecida.docCertidao || '';
                        console.log(`[PROAD worker] solicitação ${jaConhecida.numero} reaproveitada do cache `
                            + (jaConhecidaNota
                                ? `para a NF ${jaConhecida.notaConfirmada || _pNotaDeReferencia(numeroNota) || numeroNota} do DOC ${registro.docNumero}`
                                : `para o DOC ${registro.docNumero} (prova direta generalizável)`));
                        return registro;
                    }

                    const reunidas = [];
                    const vistos = new Set();
                    const adicionar = p => {
                        const n = _pProc(p?.numero);
                        if (!n || vistos.has(n) || /^Cancelad/i.test(p?.situacao || '')) return;
                        vistos.add(n);
                        reunidas.push(p);
                    };

                    for (const p of (providenciasConhecidas || [])) adicionar(p);

                    // O índice da seção é rápido, mas pode ser parcial/paginado. Já a aba
                    // "Providências" do processo principal é a fonte completa. Quando o TRD
                    // está no principal, consulta AS DUAS fontes em paralelo e faz merge.
                    const fontes = await Promise.allSettled([
                        _pProvidenciasVinculadasPeloIndice(
                            chavePrincipal, numeroNota, cnpj
                        ),
                        fichaPrincipal
                            ? Promise.race([
                                listarProvidencias(fichaPrincipal),
                                new Promise(resolve => setTimeout(() => resolve([]), 3400))
                              ])
                            : Promise.resolve([])
                    ]);

                    for (const fonte of fontes) {
                        if (fonte.status !== 'fulfilled') continue;
                        for (const p of (fonte.value || [])) adicionar(p);
                    }

                    if (!reunidas.length) {
                        registro.solicitacaoDiagnostico = 'nenhuma providência vinculada localizada';
                        console.warn(
                            `[PROAD worker] ${chavePrincipal}: TRD DOC ${registro.docNumero} encontrado, `
                            + `mas nenhuma providência vinculada foi listada`
                        );
                        return registro;
                    }

                    // Providência Em Aberto serve apenas para PRIORIZAR a leitura.
                    // Nunca preenche sem abrir a certidão e confirmar o vínculo com o DOC do TRD.
                    const abertas = [];
                    const abertasVistas = new Set();
                    for (const p of reunidas) {
                        const n = _pProc(p?.numero);
                        if (!n || abertasVistas.has(n)) continue;
                        const emAberto = p?.emAberto === true || /^Em Aberto/i.test(p?.situacao || '');
                        if (!emAberto) continue;
                        abertasVistas.add(n);
                        abertas.push(p);
                    }

                    // Regra de negócio: Solicitação só pode vir de providência Em Aberto.
                    // Se todas já foram concluídas/fechadas, não percorre certidões antigas.
                    if (!abertas.length) {
                        registro.solicitacaoDiagnostico = 'nenhuma providência em aberto; Solicitação não pesquisada';
                        console.log(
                            `[PROAD worker] ${chavePrincipal}: nenhuma providência Em Aberto; `
                            + `mantendo TRD DOC ${registro.docNumero} e deixando Solicitação vazia.`
                        );
                        return registro;
                    }

                    let vinculo = null;

                    if (abertas.length === 1) {
                        const unica = abertas[0];
                        console.log(
                            `[PROAD worker] ${chavePrincipal}: única providência Em Aberto ${unica.numero}; `
                            + `abrindo a certidão para validar referência ao TRD DOC ${registro.docNumero}`
                        );

                        // Caso comum e rápido: valida primeiro APENAS a única providência aberta.
                        vinculo = await Promise.race([
                            _pIdentificarProvidenciaPorDocPrincipal(
                                [unica], chavePrincipal, registro
                            ),
                            new Promise(resolve => setTimeout(() => resolve(null), 5200))
                        ]);

                        if (!vinculo) {
                            // v11.40.2 — fallback seguro para providência única.
                            // Há certidões que confirmam o PROAD/empresa/objeto, mas não escrevem o número
                            // do DOC do TRD que está no processo principal. Nesse caso NÃO aceitamos a
                            // providência só por ser única: abrimos o TRD da própria providência e exigimos
                            // casamento exato com a mesma NF. Se ambos os TRDs tiverem competência, ela
                            // também precisa coincidir.
                            const procUnica = _pProc(unica.numero);
                            if (procUnica) {
                                console.log(
                                    `[PROAD worker] ${chavePrincipal}: certidão da única providência ${procUnica} `
                                    + `não confirmou o DOC ${registro.docNumero}; tentando o TRD da própria providência `
                                    + `para validar a NF ${_pNotaDeReferencia(numeroNota) || numeroNota}`
                                );
                                try {
                                    const achadoProv = await procurarTRDEmProcesso(
                                        procUnica,
                                        numeroNota,
                                        `validação da Solicitação ${procUnica} por TRD próprio (de ${chavePrincipal})`,
                                        procUnica,
                                        { restante: 4 },
                                        4
                                    );
                                    const regProv = achadoProv?.registro;
                                    const compPrincipal = String(registro.competencia || '').replace(/\s+/g, '');
                                    const compProvidencia = String(regProv?.competencia || '').replace(/\s+/g, '');
                                    const competenciaOk = !compPrincipal || !compProvidencia || compPrincipal === compProvidencia;

                                    if (regProv?.casouPelaNota && competenciaOk) {
                                        vinculo = {
                                            numero: procUnica,
                                            situacao: unica.situacao || 'Em Aberto',
                                            docCertidao: '',
                                            docTRDProvidencia: regProv.docNumero || '',
                                            modoConfirmacao: 'trd-providencia',
                                            nota: regProv.notaCasada || _pNotaDeReferencia(numeroNota) || null
                                        };
                                        console.log(
                                            `[PROAD worker] Solicitação confirmada por TRD próprio: ${procUnica} `
                                            + `DOC ${regProv.docNumero || '?'} casa com a NF ${_pNotaDeReferencia(numeroNota) || numeroNota}`
                                            + (compPrincipal && compProvidencia ? ` e competência ${compProvidencia}` : '')
                                            + `. Vinculando à Solicitação.`
                                        );
                                    } else if (regProv?.casouPelaNota && !competenciaOk) {
                                        console.warn(
                                            `[PROAD worker] ${procUnica}: TRD próprio casa com a NF, mas a competência diverge `
                                            + `(${compProvidencia || '(vazia)'} × ${compPrincipal || '(vazia)'}); Solicitação não preenchida.`
                                        );
                                    } else {
                                        console.warn(
                                            `[PROAD worker] ${procUnica}: nenhum TRD próprio confirmou a NF `
                                            + `${_pNotaDeReferencia(numeroNota) || numeroNota}; Solicitação não preenchida.`
                                        );
                                    }
                                } catch (e) {
                                    console.warn(
                                        `[PROAD worker] ${procUnica}: falha ao validar a Solicitação pelo TRD próprio — ${e?.message || e}`
                                    );
                                }
                            }

                            if (!vinculo) {
                                registro.solicitacaoDiagnostico =
                                    `única providência em aberto ${unica.numero} não pôde ser validada pela certidão nem por TRD próprio da mesma NF`;
                                console.warn(
                                    `[PROAD worker] ${chavePrincipal}: a única providência Em Aberto ${unica.numero} `
                                    + `NÃO foi preenchida porque nem a certidão confirmou o DOC ${registro.docNumero} `
                                    + `nem um TRD da própria providência confirmou a mesma NF.`
                                );
                                return registro;
                            }
                        }
                    } else {
                        // Com mais de uma, testa SOMENTE as providências Em Aberto.
                        const filaValidacao = abertas;

                        console.log(
                            `[PROAD worker] ${chavePrincipal}: ${abertas.length} providência(s) em aberto; `
                            + `validando por leitura de certidão a referência ao TRD DOC ${registro.docNumero} em`,
                            filaValidacao.map(p => `${p.numero}${p.situacao ? ` [${p.situacao}]` : ''}`)
                        );

                        vinculo = await Promise.race([
                            _pIdentificarProvidenciaPorDocPrincipal(
                                filaValidacao, chavePrincipal, registro
                            ),
                            new Promise(resolve => setTimeout(() => resolve(null), 6200))
                        ]);

                        if (!vinculo) {
                            registro.solicitacaoDiagnostico =
                                `nenhuma certidão validou explicitamente o DOC ${registro.docNumero}`;
                            console.warn(
                                `[PROAD worker] ${chavePrincipal}: nenhuma certidão das providências `
                                + `${filaValidacao.map(p => p.numero).join(', ')} confirmou com segurança `
                                + `o DOC ${registro.docNumero}`
                            );
                            return registro;
                        }
                    }

                    registro.solicitacaoProvidencia = vinculo.numero;
                    registro.solicitacaoSituacao = vinculo.situacao || '';
                    registro.solicitacaoIdentificadaPor = vinculo.modoConfirmacao === 'trd-providencia'
                        ? `NF ${vinculo.nota || _pNotaDeReferencia(numeroNota) || numeroNota} confirmada em TRD da própria providência Em Aberto`
                        : vinculo.modoConfirmacao === 'proad-nf'
                            ? `PROAD ${chavePrincipal} + NF ${vinculo.notaConfirmada || _pNotaDeReferencia(numeroNota) || numeroNota} explicitamente citados na certidão`
                            : `referência explícita ao DOC ${registro.docNumero} do PROAD principal`;
                    registro.docCertidaoSolicitacao = vinculo.docCertidao || '';
                    if (vinculo.docTRDProvidencia) registro.docTRDProvidenciaSolicitacao = vinculo.docTRDProvidencia;

                    // Só generaliza para as outras NFs do TRD quando a certidão citou o DOC
                    // diretamente. No formato Saúde/Unimed a confirmação está amarrada ao bloco
                    // da NF, e cada nota precisa ter o seu bloco conferido.
                    const entrada = {
                        numero: vinculo.numero,
                        situacao: vinculo.situacao || '',
                        docCertidao: vinculo.docCertidao || '',
                        modoConfirmacao: vinculo.modoConfirmacao || '',
                        notaConfirmada: vinculo.notaConfirmada || vinculo.nota || null
                    };
                    if (vinculo.modoConfirmacao === 'doc-direto') {
                        CACHE_SOLICITACAO_DOC.set(chaveDoc, entrada);
                    } else {
                        CACHE_SOLICITACAO_DOC.set(chaveDocNota, entrada);
                        if (vinculo.modoConfirmacao === 'trd-providencia') {
                            console.log(`[PROAD worker] vínculo confirmado pelo TRD da própria providência para a NF `
                                + `${vinculo.nota || '?'}: cache restrito a esta nota.`);
                        } else if (vinculo.modoConfirmacao === 'proad-nf') {
                            console.log(`[PROAD worker] vínculo confirmado por PROAD + NF explícitos na certidão `
                                + `(${chavePrincipal} / NF ${vinculo.notaConfirmada || '?'}): cache restrito a esta nota.`);
                        } else {
                            console.log(`[PROAD worker] vínculo confirmado pelo bloco da NF `
                                + `${vinculo.notaConfirmada || '?'}: cache restrito a esta nota, `
                                + `as demais NFs do DOC ${registro.docNumero} serão conferidas uma a uma`);
                        }
                    }

                    console.log(
                        `[PROAD worker] solicitação ${vinculo.numero} vinculada ao TRD DOC ${registro.docNumero} `
                        + (vinculo.modoConfirmacao === 'trd-providencia'
                            ? `por TRD da própria providência que confirmou a mesma NF`
                            : vinculo.modoConfirmacao === 'proad-nf'
                                ? `por PROAD principal + NF explicitamente citados na certidão`
                                : `por referência explícita na certidão`)
                    );
                    return registro;
                }

                async function resolverPedido({ proad, numeroNota, cnpj, tetoPdfs, permitirRelatorioMedicao = false, dataReferencia = null }) {
                    const inicio = performance.now();
                    _pCoberturaAtiva = {
                        providencias: 0, certidoes: 0, trdCandidatos: 0, trdPdfs: 0,
                        genericosCandidatos: 0, genericosPdfs: 0, genericosSemTexto: 0
                    };
                    const chave = _pProc(proad);
                    // Defesa no próprio worker: toda a busca usa a referência fiscal normalizada.
                    numeroNota = _pNotaDeReferencia(numeroNota) || numeroNota;
                    const teto = Math.max(1, Number(tetoPdfs) || 5);
                    const orcamento = { restante: teto };
                    let diagnosticoPrincipal = '';
                    let solicitacaoPreConfirmada = null;
                    // v11.40.20: evita revisitar, no fallback final de medição, providências
                    // que a busca integrada da Manutenção já verificou nesta mesma NF.
                    const providenciasAtesteManutencaoTentadas = new Set();

                    if (!chave) {
                        const r = await procurarTRDPorNotaECnpj(numeroNota, cnpj, Math.min(teto, 4));
                        r.tempoBuscaMs = Math.round(performance.now() - inicio);
                        // O fallback de Relatório de Medição é propositalmente limitado
                        // a um PROAD principal conhecido: sem essa âncora, a busca global
                        // poderia casar relatório de outra contratação com a mesma NF.
                        return r;
                    }

                    const [numero, ano] = chave.split('/');

                    // Primeiro dispara as duas fontes leves. A providência vinculada
                    // é preferida porque normalmente contém poucos documentos e evita abrir
                    // dezenas de TRDs do processo principal.
                    const promessaVinculadasIndice = _pProvidenciasVinculadasPeloIndice(
                        chave, numeroNota, cnpj
                    ).catch(() => []);
                    const promessaFichaPrincipal = lerFicha(numero, ano)
                        .then(ficha => ({ ficha, erro: null }))
                        .catch(erro => ({ ficha: null, erro }));

                    const vinculadasIndice = await promessaVinculadasIndice;
                    _pCoberturaInc('providencias', vinculadasIndice.length);
                    if (vinculadasIndice.length) {
                        if (permitirRelatorioMedicao) {
                            // v11.40.20 — Manutenção: percorre cada providência uma única vez,
                            // tentando TRD e imediatamente Relatório de Medição antes da próxima.
                            // Não faz a prova prévia em todas as certidões, porque o próprio TRD/
                            // Relatório confirmado pela NF já identifica com segurança a providência.
                            console.log(`[PROAD worker] ${chave}: ${vinculadasIndice.length} providência(s) vinculada(s) — Manutenção: tentando TRD → medição por providência`);
                            const emIndice = await _pBuscarAtesteManutencaoNasProvidencias(
                                vinculadasIndice, chave, numeroNota, cnpj, orcamento,
                                providenciasAtesteManutencaoTentadas
                            );
                            if (emIndice) {
                                emIndice.tempoBuscaMs = Math.round(performance.now() - inicio);
                                return emIndice;
                            }
                        } else {
                            // v11.40.6 — antes de procurar TRD dentro da providência, verifica a
                            // prova mais barata e independente: certidão que cite PROAD + NF.
                            solicitacaoPreConfirmada = await _pConfirmarSolicitacaoPorProadNFAntesDoTRD(
                                vinculadasIndice, chave, numeroNota
                            );

                            if (solicitacaoPreConfirmada) {
                                console.log(
                                    `[PROAD worker] ${chave}: Solicitação ${solicitacaoPreConfirmada.numero} `
                                    + `já comprovada por PROAD + NF; a busca do TRD seguirá independente dessa prova.`
                                );

                                // Se a ficha fresca da própria providência já mostrou um TRD,
                                // aproveita esse caminho curto. Se não mostrou, não gasta timeout
                                // procurando às cegas e segue direto para o processo principal.
                                if (solicitacaoPreConfirmada.temTRDNoSnapshot) {
                                    const provConfirmada = vinculadasIndice.find(
                                        p => _pProc(p?.numero) === _pProc(solicitacaoPreConfirmada.numero)
                                    ) || {
                                        numero: solicitacaoPreConfirmada.numero,
                                        situacao: solicitacaoPreConfirmada.situacao || 'Em Aberto',
                                        emAberto: true
                                    };
                                    const trdNaProvidencia = await _pBuscarProvidenciasEmParalelo(
                                        [provConfirmada], chave, numeroNota, orcamento
                                    );
                                    if (trdNaProvidencia) {
                                        _pAplicarSolicitacaoPreConfirmada(
                                            trdNaProvidencia, solicitacaoPreConfirmada, chave, numeroNota
                                        );
                                        trdNaProvidencia.tempoBuscaMs = Math.round(performance.now() - inicio);
                                        return trdNaProvidencia;
                                    }
                                }
                                console.log(`[PROAD worker] ${chave}: seguindo para o TRD do processo principal.`);
                            } else {
                                console.log(`[PROAD worker] ${chave}: ${vinculadasIndice.length} providência(s) vinculada(s) pelo índice da seção — tentando TRD antes do principal`);
                                const emIndice = await _pBuscarProvidenciasEmParalelo(
                                    vinculadasIndice, chave, numeroNota, orcamento
                                );
                                if (emIndice) {
                                    emIndice.tempoBuscaMs = Math.round(performance.now() - inicio);
                                    return emIndice;
                                }
                            }
                        }
                    }

                    // v11.40.7 — se o índice da seção não revelou a vinculação, consulta
                    // a aba Providências DO PRÓPRIO processo antes de varrer TRDs antigos.
                    // Foi o que faltou no 2139/2024: a 26304/2026 existia, mas o índice
                    // rápido não expunha a origem e o robô lia vários TRDs antigos primeiro.
                    let principalAntecipado = null;
                    let providenciasFichaAntecipadas = [];
                    if (!vinculadasIndice.length && !solicitacaoPreConfirmada) {
                        principalAntecipado = await promessaFichaPrincipal;
                        if (principalAntecipado?.ficha) {
                            try {
                                providenciasFichaAntecipadas = (await listarProvidencias(principalAntecipado.ficha))
                                    .filter(p => p?.emAberto === true || /^Em Aberto/i.test(p?.situacao || ''));
                                _pCoberturaInc('providencias', providenciasFichaAntecipadas.length);
                                if (providenciasFichaAntecipadas.length) {
                                    console.log(`[PROAD worker] ${chave}: ${providenciasFichaAntecipadas.length} providência(s) Em Aberto localizada(s) na ficha principal — tentando ANTES dos TRDs antigos.`);
                                    if (permitirRelatorioMedicao) {
                                        const rapido = await _pBuscarAtesteManutencaoNasProvidencias(
                                            providenciasFichaAntecipadas, chave, numeroNota, cnpj,
                                            { restante: Math.min(4, teto) },
                                            providenciasAtesteManutencaoTentadas
                                        );
                                        if (rapido) {
                                            rapido.tempoBuscaMs = Math.round(performance.now() - inicio);
                                            return rapido;
                                        }
                                    } else {
                                        solicitacaoPreConfirmada = await _pConfirmarSolicitacaoPorProadNFAntesDoTRD(
                                            providenciasFichaAntecipadas, chave, numeroNota
                                        );
                                        if (solicitacaoPreConfirmada) {
                                            const provConfirmada = providenciasFichaAntecipadas.find(
                                                p => _pProc(p?.numero) === _pProc(solicitacaoPreConfirmada.numero)
                                            ) || { numero: solicitacaoPreConfirmada.numero, situacao: 'Em Aberto', emAberto: true };
                                            if (solicitacaoPreConfirmada.temTRDNoSnapshot) {
                                                const rapido = await _pBuscarProvidenciasEmParalelo(
                                                    [provConfirmada], chave, numeroNota, { restante: Math.min(4, teto) }
                                                );
                                                if (rapido) {
                                                    _pAplicarSolicitacaoPreConfirmada(rapido, solicitacaoPreConfirmada, chave, numeroNota);
                                                    rapido.tempoBuscaMs = Math.round(performance.now() - inicio);
                                                    return rapido;
                                                }
                                            }
                                        } else {
                                            const rapido = await _pBuscarProvidenciasEmParalelo(
                                                providenciasFichaAntecipadas, chave, numeroNota, { restante: Math.min(4, teto) }
                                            );
                                            if (rapido) {
                                                rapido.tempoBuscaMs = Math.round(performance.now() - inicio);
                                                return rapido;
                                            }
                                        }
                                    }
                                }
                            } catch (e) {
                                console.warn(`[PROAD worker] ${chave}: falha na tentativa antecipada pelas Providências do principal — ${e?.message || e}`);
                            }
                        }
                    }

                    // v11.35.1: se ESTE trabalhador já está exatamente no PROAD
                    // principal solicitado, tente o TRD no DOM já carregado antes de
                    // consultar listas/providências. No caso do principal pesado isso
                    // evita o falso "não localizado" causado por timeout do GET.
                    let fichaPrincipalJaAberta = _pFichaAtualDoProcesso(chave);
                    if (fichaPrincipalJaAberta) {
                        // A ficha foi aberta especificamente para este pedido. Aguarda a
                        // lista de documentos estabilizar antes de concluir que não há TRD.
                        const limiteDocs = Date.now() + 2200;
                        while (!proadListarDocumentos(document).length && Date.now() < limiteDocs) {
                            await _pPausa(80);
                        }
                        fichaPrincipalJaAberta = _pFichaAtualDoProcesso(chave) || fichaPrincipalJaAberta;

                        // A coluna de documentos é rolável: o DOM só contém o trecho visível.
                        // Em processos grandes isso mostra um punhado de TRDs em vez de todos —
                        // era o que escondia o DOC 60 (NF 88) entre os 21 do 38305/2025.
                        try {
                            const doDom = proadListarDocumentos(fichaPrincipalJaAberta.doc).length;
                            const [n, a] = chave.split('/');
                            const fichaCompleta = await lerFicha(n, a, { forcarFetch: true });
                            const doFetch = proadListarDocumentos(fichaCompleta.doc).length;
                            if (doFetch > doDom) {
                                console.log(`[PROAD worker] ${chave}: DOM lista ${doDom} documento(s), `
                                    + `a ficha baixada lista ${doFetch} — usando a completa`);
                                fichaPrincipalJaAberta = fichaCompleta;
                            }
                        } catch (e) {
                            console.warn(`[PROAD worker] ${chave}: não consegui comparar com a ficha baixada `
                                + `(${e.message}); seguindo com o DOM`);
                        }

                        CACHE_FICHAS.set(chave, fichaPrincipalJaAberta);
                        try {
                            const candidatosAbertos = proadListarDocumentos(fichaPrincipalJaAberta.doc)
                                .filter(d => FILTRO_TRD.test(d.descricao))
                                .sort((a, b) => Number(b.numero || 0) - Number(a.numero || 0));
                            console.log(`[PROAD worker] ${chave} já aberto: ${candidatosAbertos.length} TRD(s) visível(is)`,
                                candidatosAbertos.slice(0, 6).map(d => `DOC ${d.numero}: ${d.descricao}`));

                            const noPrincipalAberto = await procurarTRDEmProcesso(
                                chave, numeroNota, `PROAD ${chave} (já aberto)`, null,
                                { restante: 5 }, 5, dataReferencia
                            );
                            if (noPrincipalAberto.registro?.casouPelaNota) {
                                noPrincipalAberto.registro.proadPrincipalSIGEO = chave;
                                noPrincipalAberto.registro.tempoBuscaMs = Math.round(performance.now() - inicio);
                                noPrincipalAberto.registro.origemFichaJaAberta = true;
                                if (solicitacaoPreConfirmada) {
                                    _pAplicarSolicitacaoPreConfirmada(
                                        noPrincipalAberto.registro, solicitacaoPreConfirmada, chave, numeroNota
                                    );
                                } else {
                                    await _pEnriquecerSolicitacaoDoPrincipal(
                                        noPrincipalAberto.registro,
                                        chave,
                                        [],
                                        numeroNota,
                                        cnpj,
                                        fichaPrincipalJaAberta
                                    );
                                }
                                return noPrincipalAberto.registro;
                            }
                        } catch (e) {
                            diagnosticoPrincipal = `principal aberto: ${e.message}`;
                            console.warn(`[PROAD worker] principal já aberto ${chave}: falha ao abrir/analisar documento:`, e.message);
                        }
                    }

                    // As providências do índice já foram tentadas antes do principal aberto.
                    // A promessa da ficha principal continua rodando em paralelo desde o início.

                    // Só agora usa a ficha principal. Se ela tiver estourado o prazo, a busca
                    // não é abortada: apenas perdemos esse fallback específico.
                    const principal = principalAntecipado || await promessaFichaPrincipal;
                    const fichaPrincipal = principal.ficha;
                    let providenciasFicha = providenciasFichaAntecipadas.length ? providenciasFichaAntecipadas : [];

                    if (fichaPrincipal && !providenciasFicha.length) {
                        try {
                            providenciasFicha = await listarProvidencias(fichaPrincipal);
                            _pCoberturaInc('providencias', providenciasFicha.filter(p => p?.emAberto === true || /^Em Aberto/i.test(p?.situacao || '')).length);
                        } catch (e) {
                            console.warn('[PROAD worker] falha ao abrir Providências do principal:', e.message);
                        }
                    } else {
                        console.warn(`[PROAD worker] principal ${chave} indisponível:`, principal.erro?.message || principal.erro);
                    }

                    // Junta as providências obtidas pelos dois caminhos e evita repetir as que
                    // já foram tentadas pelo índice da seção.
                    const jaTentadas = new Set(vinculadasIndice.map(p => _pProc(p.numero)));
                    const adicionais = _pOrdenarProvidenciasRapido(
                        providenciasFicha
                            .filter(p => p?.emAberto === true || /^Em Aberto/i.test(p?.situacao || ''))
                            .filter(p => !jaTentadas.has(_pProc(p.numero))),
                        _pNotaDeReferencia(numeroNota), cnpj
                    ).slice(0, MAX_PROVIDENCIAS_RAPIDAS);

                    if (!permitirRelatorioMedicao && !solicitacaoPreConfirmada && (vinculadasIndice.length || adicionais.length)) {
                        solicitacaoPreConfirmada = await _pConfirmarSolicitacaoPorProadNFAntesDoTRD(
                            [...vinculadasIndice, ...adicionais], chave, numeroNota
                        );
                        if (solicitacaoPreConfirmada) {
                            console.log(
                                `[PROAD worker] ${chave}: Solicitação ${solicitacaoPreConfirmada.numero} `
                                + `comprovada pela certidão; mantendo a busca do documento de ateste separada.`
                            );
                        }
                    }

                    if (adicionais.length && !solicitacaoPreConfirmada) {
                        const emProvidencia = permitirRelatorioMedicao
                            ? await _pBuscarAtesteManutencaoNasProvidencias(
                                adicionais, chave, numeroNota, cnpj, orcamento,
                                providenciasAtesteManutencaoTentadas
                              )
                            : await _pBuscarProvidenciasEmParalelo(
                                adicionais, chave, numeroNota, orcamento
                              );
                        if (emProvidencia) {
                            emProvidencia.tempoBuscaMs = Math.round(performance.now() - inicio);
                            return emProvidencia;
                        }
                    }

                    // O processo principal é o último fallback e só é consultado se sua ficha
                    // conseguiu carregar. Uma lentidão do principal nunca mais transforma uma
                    // providência válida em "TRD não localizado" antes de ela ser tentada.
                    if (fichaPrincipal) {
                        const orcamentoPrincipal = { restante: 3 };
                        try {
                            const noPrincipal = await procurarTRDEmProcesso(
                                chave, numeroNota, `PROAD ${chave}`, null, orcamentoPrincipal, 3, dataReferencia
                            );
                            if (noPrincipal.registro?.casouPelaNota) {
                                noPrincipal.registro.proadPrincipalSIGEO = chave;
                                noPrincipal.registro.tempoBuscaMs = Math.round(performance.now() - inicio);
                                if (solicitacaoPreConfirmada) {
                                    _pAplicarSolicitacaoPreConfirmada(
                                        noPrincipal.registro, solicitacaoPreConfirmada, chave, numeroNota
                                    );
                                } else {
                                    await _pEnriquecerSolicitacaoDoPrincipal(
                                        noPrincipal.registro,
                                        chave,
                                        [...vinculadasIndice, ...adicionais],
                                        numeroNota,
                                        cnpj,
                                        fichaPrincipal
                                    );
                                }
                                return noPrincipal.registro;
                            }
                        } catch (e) {
                            diagnosticoPrincipal = `principal: ${e.message}`;
                            console.warn(`[PROAD worker] principal ${chave}:`, e.message);
                        }
                    }

                    // v11.40.6 — se a Solicitação já foi provada pela certidão mas o TRD
                    // não apareceu no principal, tenta o TRD da própria providência SOMENTE agora.
                    // Assim a prova da Solicitação não fica dependente do TRD e o caminho comum
                    // evita gastar tempo abrindo documentos da providência antes do principal.
                    if (solicitacaoPreConfirmada) {
                        const todasProv = [...vinculadasIndice, ...adicionais];
                        const provConfirmada = todasProv.find(
                            p => _pProc(p?.numero) === _pProc(solicitacaoPreConfirmada.numero)
                        ) || {
                            numero: solicitacaoPreConfirmada.numero,
                            situacao: solicitacaoPreConfirmada.situacao || 'Em Aberto',
                            emAberto: true
                        };
                        try {
                            const noTRDdaProvidencia = await _pBuscarProvidenciasEmParalelo(
                                [provConfirmada], chave, numeroNota, { restante: 4 }
                            );
                            if (noTRDdaProvidencia) {
                                _pAplicarSolicitacaoPreConfirmada(
                                    noTRDdaProvidencia, solicitacaoPreConfirmada, chave, numeroNota
                                );
                                noTRDdaProvidencia.tempoBuscaMs = Math.round(performance.now() - inicio);
                                return noTRDdaProvidencia;
                            }
                        } catch (e) {
                            console.warn(
                                `[PROAD worker] ${chave}: Solicitação ${solicitacaoPreConfirmada.numero} comprovada, `
                                + `mas falhou a busca de TRD dentro da própria providência: ${e?.message || e}`
                            );
                        }
                    }

                    // Fallback geral: algumas unidades usam CI/Comunicação Interna como documento
                    // de ateste no lugar do TRD. Só procura depois de esgotar TRDs e somente
                    // em providências Em Aberto ou no PROAD principal conhecido.
                    const providenciasParaCI = [];
                    const vistosCI = new Set();
                    for (const p of [...vinculadasIndice, ...adicionais]) {
                        const n = _pProc(p?.numero);
                        const aberta = p?.emAberto === true || /^Em Aberto/i.test(p?.situacao || '');
                        if (!n || !aberta || vistosCI.has(n)) continue;
                        vistosCI.add(n);
                        providenciasParaCI.push(p);
                    }

                    for (const prov of providenciasParaCI) {
                        try {
                            const achadoCI = await procurarCIEmProcesso(
                                prov.numero,
                                numeroNota,
                                `CI de ateste na providência ${prov.numero} [Em Aberto] (de ${chave})`,
                                prov.numero,
                                2
                            );
                            if (achadoCI.registro?.casouPelaNota) {
                                achadoCI.registro.proadPrincipalSIGEO = chave;
                                achadoCI.registro.solicitacaoSituacao = prov.situacao || 'Em Aberto';
                                if (solicitacaoPreConfirmada) {
                                    _pAplicarSolicitacaoPreConfirmada(
                                        achadoCI.registro, solicitacaoPreConfirmada, chave, numeroNota
                                    );
                                }
                                achadoCI.registro.tempoBuscaMs = Math.round(performance.now() - inicio);
                                return achadoCI.registro;
                            }
                        } catch (e) {
                            console.warn(`[PROAD worker] CI na providência ${prov.numero}:`, e.message);
                        }
                    }

                    if (fichaPrincipal) {
                        try {
                            const noPrincipalCI = await procurarCIEmProcesso(
                                chave,
                                numeroNota,
                                `CI de ateste no PROAD ${chave}`,
                                null,
                                Number.POSITIVE_INFINITY
                            );
                            if (noPrincipalCI.registro?.casouPelaNota) {
                                const regCI = noPrincipalCI.registro;
                                regCI.proadPrincipalSIGEO = chave;
                                regCI.tempoBuscaMs = Math.round(performance.now() - inicio);
                                if (solicitacaoPreConfirmada) {
                                    _pAplicarSolicitacaoPreConfirmada(
                                        regCI, solicitacaoPreConfirmada, chave, numeroNota
                                    );
                                }

                                // O próprio CI pode trazer "PROAD: 25037/2026". Só transforma
                                // isso em Solicitação se o mesmo processo também estiver listado
                                // como providência Em Aberto do principal.
                                const refCI = _pProc(regCI.proadReferenciadoCI || '');
                                const abertasCI = providenciasParaCI;
                                const abertaReferenciada = refCI
                                    ? abertasCI.find(p => _pProc(p?.numero) === refCI)
                                    : null;
                                if (!regCI.solicitacaoProvidencia && abertaReferenciada) {
                                    regCI.solicitacaoProvidencia = refCI;
                                    regCI.solicitacaoSituacao = abertaReferenciada.situacao || 'Em Aberto';
                                    regCI.solicitacaoIdentificadaPor = 'PROAD explicitamente citado no CI e confirmado Em Aberto';
                                } else if (!regCI.solicitacaoProvidencia) {
                                    // Segunda possibilidade segura: exatamente uma providência Em Aberto
                                    // menciona a NF/Fatura na própria linha da aba Providências.
                                    const seguraPorNota = _pSolicitacaoSeguraParaNota(abertasCI, numeroNota);
                                    if (seguraPorNota) {
                                        const pSegura = abertasCI.find(p => _pProc(p?.numero) === seguraPorNota);
                                        regCI.solicitacaoProvidencia = seguraPorNota;
                                        regCI.solicitacaoSituacao = pSegura?.situacao || 'Em Aberto';
                                        regCI.solicitacaoIdentificadaPor = 'providência Em Aberto que menciona a NF/Fatura';
                                    }
                                }
                                return regCI;
                            }
                        } catch (e) {
                            console.warn(`[PROAD worker] CI de ateste no principal ${chave}:`, e.message);
                        }
                    }

                    // Manutenção Predial: somente depois de esgotar a busca de TRD,
                    // tenta Relatório de Medição da MESMA NF. Pode estar em providência
                    // vinculada ou diretamente no PROAD principal.
                    if (permitirRelatorioMedicao) {
                        const providenciasParaMedicao = [];
                        const vistosMedicao = new Set();
                        for (const p of [...vinculadasIndice, ...adicionais]) {
                            const n = _pProc(p?.numero);
                            if (!n || vistosMedicao.has(n) || providenciasAtesteManutencaoTentadas.has(n)) continue;
                            vistosMedicao.add(n);
                            providenciasParaMedicao.push(p);
                        }

                        if (providenciasParaMedicao.length) {
                            const emProvidencia = await _pBuscarMedicoesEmProvidenciasParalelo(
                                providenciasParaMedicao, chave, numeroNota, cnpj
                            );
                            if (emProvidencia) {
                                if (solicitacaoPreConfirmada) {
                                    _pAplicarSolicitacaoPreConfirmada(
                                        emProvidencia, solicitacaoPreConfirmada, chave, numeroNota
                                    );
                                }
                                emProvidencia.tempoBuscaMs = Math.round(performance.now() - inicio);
                                return emProvidencia;
                            }
                        }

                        if (fichaPrincipal) {
                            try {
                                let solicitacaoSegura = _pSolicitacaoSeguraParaNota(
                                    providenciasParaMedicao, numeroNota
                                );
                                if (!solicitacaoSegura && providenciasParaMedicao.length) {
                                    solicitacaoSegura = await _pIdentificarProvidenciaPorDocumentos(
                                        providenciasParaMedicao, numeroNota
                                    );
                                }
                                const noPrincipal = await procurarMedicaoEmProcesso(
                                    chave,
                                    numeroNota,
                                    cnpj,
                                    `relatório de medição no PROAD ${chave}`,
                                    solicitacaoSegura,
                                    Number.POSITIVE_INFINITY
                                );
                                if (noPrincipal.registro?.casouPelaNota) {
                                    noPrincipal.registro.proadPrincipalSIGEO = chave;
                                    noPrincipal.registro.tempoBuscaMs = Math.round(performance.now() - inicio);
                                    noPrincipal.registro.competencia = null;
                                    if (solicitacaoPreConfirmada) {
                                        _pAplicarSolicitacaoPreConfirmada(
                                            noPrincipal.registro, solicitacaoPreConfirmada, chave, numeroNota
                                        );
                                    }
                                    return noPrincipal.registro;
                                }
                            } catch (e) {
                                console.warn(`[PROAD worker] relatório de medição no principal ${chave}:`, e.message);
                            }
                        }
                    }

                    // v11.40.7 — ÚLTIMA rede de segurança: títulos desconhecidos.
                    // Primeiro testa documentos genéricos das providências Em Aberto e,
                    // por fim, poucos documentos recentes do principal. A confirmação
                    // continua exigindo NF exata no PDF + linguagem forte de ateste.
                    const processosFallback = [];
                    const vistosFallback = new Set();
                    for (const p of [...vinculadasIndice, ...adicionais, ...providenciasFichaAntecipadas]) {
                        const proc = _pProc(p?.numero);
                        const aberta = p?.emAberto === true || /^Em Aberto/i.test(p?.situacao || '');
                        if (!proc || !aberta || vistosFallback.has(proc)) continue;
                        vistosFallback.add(proc);
                        processosFallback.push({ processo: proc, solicitacao: proc, origem: `providência ${proc}` });
                        if (processosFallback.length >= 3) break;
                    }
                    if (!vistosFallback.has(chave)) {
                        processosFallback.push({ processo: chave, solicitacao: solicitacaoPreConfirmada?.numero || null, origem: `PROAD ${chave}` });
                    }

                    const genericosConfirmados = [];
                    for (const alvo of processosFallback) {
                        try {
                            const generico = await procurarAtesteGenericoEmProcesso(
                                alvo.processo, numeroNota, cnpj, alvo.origem,
                                alvo.solicitacao, permitirRelatorioMedicao,
                                dataReferencia, alvo.processo === chave ? 5 : 3
                            );
                            if (generico) {
                                generico.proadPrincipalSIGEO = chave;
                                if (solicitacaoPreConfirmada) {
                                    _pAplicarSolicitacaoPreConfirmada(generico, solicitacaoPreConfirmada, chave, numeroNota);
                                }
                                genericosConfirmados.push(generico);
                            }
                        } catch (e) {
                            console.warn(`[PROAD worker] ${alvo.processo}: fallback final por conteúdo indisponível — ${e?.message || e}`);
                        }
                    }

                    if (genericosConfirmados.length) {
                        const solicitacoes = [...new Set(genericosConfirmados
                            .map(r => _pProc(r?.solicitacaoProvidencia || ''))
                            .filter(Boolean))];
                        // Se duas providências diferentes comprovarem a mesma NF, não escolhe
                        // por ordem/recência. Um resultado no principal sem Solicitação não cria
                        // ambiguidade quando há exatamente uma providência comprovada.
                        if (solicitacoes.length > 1) {
                            console.warn(`[PROAD worker] ${chave} NF ${numeroNota}: fallback por conteúdo AMBÍGUO entre `
                                + `${solicitacoes.join(', ')}; nada será preenchido.`);
                        } else {
                            const escolhido = solicitacoes.length
                                ? (genericosConfirmados.find(r => _pProc(r?.solicitacaoProvidencia || '') === solicitacoes[0]) || genericosConfirmados[0])
                                : genericosConfirmados[0];
                            escolhido.tempoBuscaMs = Math.round(performance.now() - inicio);
                            return escolhido;
                        }
                    }

                    const tempo = Math.round(performance.now() - inicio);
                    const tentadas = vinculadasIndice.length + adicionais.length;
                    const resumoCobertura = _pResumoCobertura();
                    console.warn(`[PROAD worker] ${chave} NF ${numeroNota || '?'}: resultado negativo após ${resumoCobertura}.`);
                    return {
                        encontrado: false,
                        motivo: `TRD ou CI${permitirRelatorioMedicao ? ' ou Relatório de Medição' : ''} da nota ${numeroNota || '?'} não localizado na busca objetiva em ${chave}`
                            + (tentadas ? ` + ${tentadas} providência(s) vinculada(s)` : '')
                            + (solicitacaoPreConfirmada ? `; Solicitação ${solicitacaoPreConfirmada.numero} confirmada por PROAD+NF` : '')
                            + (!fichaPrincipal ? `; ficha principal indisponível (${principal.erro?.message || 'timeout'})` : '')
                            + (diagnosticoPrincipal ? `; ${diagnosticoPrincipal}` : '')
                            + `; ${resumoCobertura}`
                            + ` (${tempo} ms)`,
                        proadConsultado: chave,
                        tempoBuscaMs: tempo,
                        solicitacaoProvidencia: solicitacaoPreConfirmada?.numero || '',
                        solicitacaoSituacao: solicitacaoPreConfirmada?.situacao || '',
                        solicitacaoIdentificadaPor: solicitacaoPreConfirmada
                            ? `PROAD ${chave} + NF ${_pNotaDeReferencia(numeroNota) || numeroNota} explicitamente citados na certidão; TRD não localizado`
                            : '',
                        docCertidaoSolicitacao: solicitacaoPreConfirmada?.docCertidao || ''
                    };
                }

        const PEDIDOS_EM_CURSO = new Set();
        const PEDIDOS_ENFILEIRADOS = new Set();
        let FILA_PEDIDOS_PROAD = Promise.resolve();

        function _pEnfileirarPedido(pedido) {
            if (!pedido || !pedido.id
                || PEDIDOS_EM_CURSO.has(pedido.id)
                || PEDIDOS_ENFILEIRADOS.has(pedido.id)) return;

            const alvo = _pProc(pedido.proad);

            // Abas de outro processo continuam ignorando o pedido.
            if (pedido.exigirProcessoAtual && alvo && _pProcessoAtualDaPagina() !== alvo) return;

            PEDIDOS_ENFILEIRADOS.add(pedido.id);

            // Claim imediato: o SIGEO sabe que a aba correta recebeu o pedido,
            // mesmo se ele precisar aguardar a NF anterior terminar.
            if (pedido.exigirProcessoAtual && alvo) {
                try {
                    GM_setValue(CHAVES.resposta, {
                        id: pedido.id, parcial: true, tipo: 'claim-alvo',
                        processoAtual: alvo, enfileirado: true, quando: Date.now()
                    });
                } catch (_) {}
            }

            FILA_PEDIDOS_PROAD = FILA_PEDIDOS_PROAD
                .catch(() => {})
                .then(async () => {
                    PEDIDOS_ENFILEIRADOS.delete(pedido.id);
                    console.log(
                        `[PROAD worker] iniciando pedido enfileirado ${pedido.id} · `
                        + `${alvo || '(sem PROAD)'} NF ${_pNotaDeReferencia(pedido.numeroNota) || pedido.numeroNota}`
                    );
                    await _pAtenderPedido(pedido);
                });
        }

        async function _pAtenderPedido(pedido) {
            if (!pedido || !pedido.id || PEDIDOS_EM_CURSO.has(pedido.id)) return;
            const alvo = _pProc(pedido.proad);

            // Reserva o id ANTES de aguardar o DOM. Os pulsos do cliente podem chegar
            // enquanto a aba ainda está carregando; sem esta reserva, a mesma aba
            // iniciaria várias execuções do mesmo pedido.
            PEDIDOS_EM_CURSO.add(pedido.id);

            // v11.36: pedidos com PROAD Principal conhecido são EXCLUSIVOS da aba
            // que está naquele processo. Abas em outros PROADs não respondem nem
            // iniciam fetches concorrentes.
            let claimAntecipado = false;
            if (pedido.exigirProcessoAtual && alvo) {
                const atualInicial = _pProcessoAtualDaPagina();
                if (atualInicial !== alvo) {
                    PEDIDOS_EM_CURSO.delete(pedido.id);
                    return;
                }

                // A URL/cabeçalho já confirma que ESTA é a aba dedicada correta.
                // Reivindica imediatamente; não espera o DOM completo para avisar o SIGEO.
                try {
                    GM_setValue(CHAVES.resposta, {
                        id: pedido.id, parcial: true, tipo: 'claim-alvo',
                        processoAtual: atualInicial, quando: Date.now()
                    });
                    claimAntecipado = true;
                } catch (_) {}

                await _pAguardarProcessoPronto(alvo, 6500);
                if (_pProcessoAtualDaPagina() !== alvo) {
                    PEDIDOS_EM_CURSO.delete(pedido.id);
                    return;
                }
            }

            const t0 = performance.now();
            const processoAtual = _pProcessoAtualDaPagina();
            const workerAlvo = !!(alvo && processoAtual === alvo);

            if (workerAlvo && !claimAntecipado) {
                try {
                    GM_setValue(CHAVES.resposta, {
                        id: pedido.id, parcial: true, tipo: 'claim-alvo',
                        processoAtual, quando: Date.now()
                    });
                } catch (_) {}
            }

            const notaPedidoNormalizada = _pNotaDeReferencia(pedido.numeroNota) || pedido.numeroNota;
            console.log('[PROAD worker] pedido exclusivo:', pedido.proad, 'nota', notaPedidoNormalizada,
                notaPedidoNormalizada !== pedido.numeroNota
                    ? `(recebida ${pedido.numeroNota}; normalizada)`
                    : (workerAlvo ? '(aba-alvo)' : '(fallback)'));

            let resposta;
            try {
                resposta = {
                    id: pedido.id, ok: true, dados: await resolverPedido(pedido),
                    workerAlvo, processoAtual
                };
            } catch (e) {
                resposta = {
                    id: pedido.id, ok: false, erro: e?.message || String(e),
                    workerAlvo, processoAtual
                };
            } finally {
                PEDIDOS_EM_CURSO.delete(pedido.id);
            }

            try {
                GM_setValue(CHAVES.resposta, resposta);
                console.log(`[PROAD worker] resposta em ${Math.round(performance.now() - t0)} ms`,
                    workerAlvo ? '(aba-alvo)' : '');
            } catch (e) {
                console.error('[PROAD worker] falha ao responder:', e);
            }
        }

        GM_addValueChangeListener(CHAVES.pedido, (nome, anterior, pedido, remoto) => {
            if (!remoto || !pedido || !pedido.id) return;
            _pEnfileirarPedido(pedido);
        });

        // Se a aba foi aberta DEPOIS que o SIGEO publicou o pedido, o listener não
        // recebe o valor antigo. Ao terminar de iniciar, lê o pedido pendente e assume
        // somente se esta aba estiver no processo solicitado.
        setTimeout(() => {
            try {
                const pendente = GM_getValue(CHAVES.pedido, null);
                if (pendente?.id && (Date.now() - Number(pendente.quando || 0)) < 20000) {
                    _pEnfileirarPedido(pendente);
                }
            } catch (_) {}
        }, 120);

        console.log('%c[PROAD worker] pronto — esta aba atende os pedidos do SIGEO',
            'color:#0a7;font-weight:bold');
    }

    // ══════════════════════════════════════════════════════════════════════════
    // LADO SIGEO — o cliente
    // ══════════════════════════════════════════════════════════════════════════
    const _cacheTRD = new Map();     // "19458/2026|35" → resultado
    const _cacheTRDEmCurso = new Map(); // evita duas buscas simultâneas da mesma NF/PROAD
    const PROAD_CACHE_PERSISTENTE = 'proad_trd_confirmados_v114008';
    const PROAD_CACHE_TTL_MS = 30 * 24 * 60 * 60 * 1000;

    function _lerTRDPersistente(chave) {
        try {
            const todos = GM_getValue(PROAD_CACHE_PERSISTENTE, {}) || {};
            const item = todos[chave];
            if (!item || !item.quando || (Date.now() - item.quando) > PROAD_CACHE_TTL_MS) return null;
            return item.dados || null;
        } catch (_) { return null; }
    }

    function _gravarTRDPersistente(chave, dados) {
        if (!dados?.encontrado || dados?.avisoNota) return;

        // Um TRD encontrado diretamente no PROAD principal pode ainda precisar da
        // Solicitação de Providência. Não congela esse resultado incompleto por 30 dias:
        // na próxima consulta ele deve poder tentar novamente o vínculo por certidão.
        const origemNoPrincipal = !!(
            _pProc(dados?.proadConsultado)
            && _pProc(dados?.proadConsultado) === _pProc(dados?.proadPrincipalSIGEO)
        );
        if (
            origemNoPrincipal
            && dados?.tipoDocumento !== 'relatorio-medicao'
            && !dados?.solicitacaoProvidencia
        ) return;

        try {
            const todos = GM_getValue(PROAD_CACHE_PERSISTENTE, {}) || {};
            todos[chave] = { quando: Date.now(), dados };
            const chaves = Object.keys(todos);
            if (chaves.length > 250) {
                chaves.sort((a, b) => (todos[a]?.quando || 0) - (todos[b]?.quando || 0));
                for (const k of chaves.slice(0, chaves.length - 200)) delete todos[k];
            }
            GM_setValue(PROAD_CACHE_PERSISTENTE, todos);
        } catch (_) { /* cache é apenas otimização */ }
    }

    let _abaProadAberta = null;      // aba que NÓS abrimos (para fechar depois)
    let _timerFecharAba = null;

    function _trabalhadorEstaVivo() {
        try {
            const ultimo = GM_getValue(PROAD_CHAVES.vivo, 0);
            return (Date.now() - Number(ultimo || 0)) < 8000;
        } catch (e) { return false; }
    }

    async function _garantirTrabalhador() {
        if (_trabalhadorEstaVivo()) return true;

        proadLog('nenhuma aba do PROAD atendendo — abrindo uma em segundo plano');
        try {
            _abaProadAberta = GM_openInTab(PROAD_CFG.base + PROAD_CFG.paginaLeve,
                { active: false, insert: true, setParent: true });
        } catch (e) {
            proadLog('não consegui abrir a aba:', e.message);
            return false;
        }

        const limite = Date.now() + PROAD_CFG.timeoutAbrirAbaMs;
        while (Date.now() < limite) {
            await _pPausa(500);
            if (_trabalhadorEstaVivo()) { proadLog('trabalhador no ar'); return true; }
        }
        return false;
    }

    function _agendarFechamentoDaAba() {
        if (!_abaProadAberta) return;
        clearTimeout(_timerFecharAba);
        _timerFecharAba = setTimeout(() => {
            try { _abaProadAberta.close(); proadLog('aba do PROAD fechada por ociosidade'); } catch (e) {}
            _abaProadAberta = null;
        }, PROAD_CFG.ociosidadeParaFecharMs);
    }

    function _urlFichaProad(chave) {
        const p = _pProc(chave);
        if (!p) return PROAD_CFG.base + PROAD_CFG.paginaLeve;
        const [n, a] = p.split('/');
        return `${PROAD_CFG.base}${PROAD_CFG.caminhoFicha}?faces-redirect=true&numeroProtocolo=${n}&numeroAno=${a}`;
    }

    function _abrirAbaProadAlvo(chave) {
        try {
            proadLog(`abrindo trabalhador dedicado no PROAD ${chave}`);
            return GM_openInTab(_urlFichaProad(chave),
                { active: false, insert: true, setParent: true });
        } catch (e) {
            console.warn('[SIGEO×PROAD] não consegui abrir o PROAD alvo:', e.message);
            return null;
        }
    }

    function _enviarPedido(proad, numeroNota, cnpj, permitirRelatorioMedicao = false, dataReferencia = null) {
        return new Promise((resolve) => {
            const chaveAlvo = _pProc(proad);
            const id = `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`;
            let ouvinte = null, temporizador = null, timerAbrir = null, timerPulso = null;
            let houveClaimAlvo = false, encerrado = false;
            const iniciarTimeout = (ms) => {
                clearTimeout(temporizador);
                temporizador = setTimeout(() => encerrar(melhorNegativo || {
                    encontrado:false,
                    motivo: chaveAlvo
                        ? `a aba dedicada do PROAD ${chaveAlvo} não concluiu a leitura a tempo`
                        : 'o trabalhador do PROAD não respondeu a tempo'
                }), ms);
            };
            let abaDedicada = null;
            let melhorNegativo = null;

            const encerrar = (resultado) => {
                if (encerrado) return;
                encerrado = true;
                try { if (ouvinte !== null) GM_removeValueChangeListener(ouvinte); } catch (_) {}
                clearTimeout(temporizador); clearTimeout(timerAbrir); clearInterval(timerPulso);
                // v11.36.11: NÃO fecha automaticamente a aba dedicada.
                // Durante o diagnóstico precisamos preservar console, viewer e estado JSF
                // exatamente como ficaram após a leitura. O usuário pode fechá-la manualmente.
                if (abaDedicada) {
                    try {
                        console.log('[SIGEO×PROAD] aba dedicada mantida aberta para diagnóstico.');
                    } catch (_) {}
                }
                resolve(resultado);
            };

            const montarPedido = () => ({
                id, proad: chaveAlvo, numeroNota, cnpj, dataReferencia,
                tetoPdfs: PROAD_CFG.maxTrdsPorProcesso,
                permitirRelatorioMedicao: !!permitirRelatorioMedicao,
                exigirProcessoAtual: !!chaveAlvo,
                pulso: Date.now(), quando: Date.now()
            });
            const publicar = () => {
                try { GM_setValue(PROAD_CHAVES.pedido, montarPedido()); }
                catch (e) { encerrar({ encontrado:false, motivo:'falha ao enfileirar o pedido: '+e.message }); }
            };

            try {
                ouvinte = GM_addValueChangeListener(PROAD_CHAVES.resposta,
                    (nome, anterior, resposta, remoto) => {
                        if (!remoto || !resposta || resposta.id !== id) return;
                        if (resposta.parcial && resposta.tipo === 'claim-alvo') {
                            houveClaimAlvo = true;
                            clearTimeout(timerAbrir);
                            // A aba correta já assumiu. Dá tempo apenas para ela concluir
                            // TRD + certidão, sem reabrir trabalhador nem aceitar falso timeout.
                            iniciarTimeout(30000);
                            return;
                        }
                        const resultado = resposta.ok ? resposta.dados
                            : { encontrado:false, motivo: resposta.erro || 'falha no trabalhador PROAD' };

                        if (Array.isArray(resultado?.diagnosticosSolicitacao)
                            && resultado.diagnosticosSolicitacao.length) {
                            console.groupCollapsed(
                                `[SIGEO×PROAD] Diagnóstico da Solicitação — ${chaveAlvo || proad || '(sem PROAD)'} `
                                + `NF ${numeroNota || '?'}`
                            );
                            for (const d of resultado.diagnosticosSolicitacao) {
                                const msg = `[SIGEO×PROAD][Solicitação] ${d?.mensagem || d}`;
                                if (d?.nivel === 'erro') console.error(msg);
                                else if (d?.nivel === 'aviso') console.warn(msg);
                                else console.log(msg);
                            }
                            if (resultado?.solicitacaoDiagnostico) {
                                console.warn('[SIGEO×PROAD][Solicitação] Resultado:', resultado.solicitacaoDiagnostico);
                            }
                            console.groupEnd();
                        }

                        if (resultado?.encontrado) return encerrar(resultado);
                        melhorNegativo = resultado || melhorNegativo;
                        // Em modo exclusivo só a aba-alvo pode responder. Portanto a
                        // resposta negativa dela é final; não existe corrida com outras abas.
                        if (chaveAlvo && resposta.workerAlvo) return encerrar(melhorNegativo);
                        if (!chaveAlvo) return encerrar(melhorNegativo);
                    });
            } catch (e) {
                return encerrar({ encontrado:false, motivo:'GM_addValueChangeListener indisponível' });
            }

            publicar();

            if (chaveAlvo) {
                // Dá uma janela curta para uma aba JÁ aberta exatamente no processo.
                // Se ninguém reivindicar, abre uma aba dedicada diretamente na ficha.
                timerAbrir = setTimeout(() => {
                    if (encerrado || houveClaimAlvo) return;
                    abaDedicada = _abrirAbaProadAlvo(chaveAlvo);
                }, 500);

                // Re-publica o MESMO pedido com pulso novo. Isso garante que uma aba
                // recém-aberta em document-start receba o evento depois de carregar.
                timerPulso = setInterval(() => {
                    if (!encerrado && !houveClaimAlvo) publicar();
                }, 650);
            }

            iniciarTimeout(PROAD_CFG.timeoutPedidoMs);
        });
    }

    /**
     * Busca o TRD de uma nota. Delega ao trabalhador que roda na aba do PROAD.
     * Nunca lança: em caso de falha devolve { encontrado:false, motivo }.
     */
    async function buscarTRDnoPROAD(proadPrincipal, numeroNota, cnpj, permitirRelatorioMedicao = false, dataReferencia = null) {
        const chaveProc = _pProc(proadPrincipal);
        const notaBusca = _pNotaDeReferencia(numeroNota) || '';
        const sufixoModo = permitirRelatorioMedicao ? '|fallback-medicao' : '';
        const chaveCache = chaveProc
            ? `${chaveProc}|${notaBusca}${sufixoModo}`
            : `nota:${notaBusca}|cnpj:${_pSoDigitos(cnpj)}${sufixoModo}`;

        if (_cacheTRD.has(chaveCache)) return _cacheTRD.get(chaveCache);
        const persistido = _lerTRDPersistente(chaveCache);
        if (persistido) {
            _cacheTRD.set(chaveCache, persistido);
            proadLog(`⚡ TRD recuperado do cache: DOC ${persistido.docNumero || '?'} @ ${persistido.proadConsultado || ''}`);
            return persistido;
        }

        if (_cacheTRDEmCurso.has(chaveCache)) {
            return await _cacheTRDEmCurso.get(chaveCache);
        }

        if (!chaveProc && !notaBusca) {
            const r = { encontrado: false, motivo: 'sem PROAD principal e sem número de nota' };
            _cacheTRD.set(chaveCache, r);
            return r;
        }

        const promessa = (async () => {
            // Com PROAD Principal conhecido, _enviarPedido() trabalha em modo
            // exclusivo e abre diretamente a ficha correta se necessário. O worker
            // genérico só é necessário nos raros fallbacks sem PROAD principal.
            if (!chaveProc && !await _garantirTrabalhador()) {
                const motivo = 'nenhuma aba do PROAD respondeu (abra o PROAD logado e repita)';
                console.warn('[SIGEO×PROAD] ' + motivo);
                return { encontrado: false, motivo };
            }

            const resultado = await _enviarPedido(chaveProc, notaBusca, cnpj, permitirRelatorioMedicao, dataReferencia);
            if (!chaveProc) _agendarFechamentoDaAba();

            if (resultado.encontrado) {
                _cacheTRD.set(chaveCache, resultado);
                _gravarTRDPersistente(chaveCache, resultado);
                const rotuloDoc = resultado.tipoDocumento === 'relatorio-medicao' ? 'Relatório de Medição' : 'TRD';
                proadLog(`✅ ${rotuloDoc} DOC ${resultado.docNumero}`
                    + (resultado.tipoDocumento === 'relatorio-medicao' ? '' : ` · competência ${resultado.competencia}`)
                    + ` · última assinatura ${resultado.ultimaAssinatura}`
                    + (resultado.solicitacaoProvidencia
                        ? ` · solicitação ${resultado.solicitacaoProvidencia}`
                        : ` · solicitação não identificada`));
            } else {
                console.warn(`[SIGEO×PROAD] TRD não localizado para `
                    + `${chaveProc || '(sem PROAD)'} nota ${notaBusca}:`, resultado.motivo);
            }
            return resultado;
        })();

        _cacheTRDEmCurso.set(chaveCache, promessa);
        try {
            return await promessa;
        } finally {
            _cacheTRDEmCurso.delete(chaveCache);
        }
    }

    /**
     * Enriquece a linha com o TRD sem interromper o lote.
     * Saúde: o PROAD Principal vem do Cadastro de Credenciados (CNPJ → PROAD).
     * Demais módulos: mantém o PROAD da contratação informado pelo SIGEO.
     */
    async function enriquecerComTRD(documento, registroSelecionado, contexto = 'padrao', linhaInfo = null) {
        try {
            // Busca pelo número fiscal real, não pela chave interna longa da NFS-e.
            const numeroNota = _pNumeroNotaParaPROAD(documento, registroSelecionado) || null;
            documento.numeroFiscalNormalizado = numeroNota || '';

            const cnpj = registroSelecionado?.fornecedor?.documento
                || documento?.fornecedor?.documento
                || documento?.xml?.cnpj
                || null;
            const contratoEmpenho = obterContratoEmpenhoParaCadastro(documento, registroSelecionado);

            let proad = null;
            if (contexto === 'saude') {
                proad = await obterProadPrincipalSaudePorCnpj(cnpj);
                documento.origemProadTRD = proad ? 'cadastro-saude' : 'busca-global-nf-cnpj';
                documento.proadPrincipalCadastro = proad || '';
                documento.proadPrincipalTRD = proad || '';
                if (!proad) {
                    console.warn(`[SIGEO×PROAD] Saúde: CNPJ ${normalizarCNPJLocal(cnpj) || '(vazio)'} sem PROAD Principal inequívoco no Cadastro; fallback por NF+CNPJ.`);
                }
            } else if (contexto === 'manutencao') {
                const achado = await obterProadPrincipalManutencaoSeguro(contratoEmpenho, cnpj);
                if (achado) {
                    proad = achado.proad;
                    documento.proadPrincipalCadastro = proad;
                    documento.origemProadTRD = 'cadastro-manutencao';
                    documento.criterioProadCadastro = achado.criterio;
                } else if (linhaInfo) {
                    // Exceção: Cadastro não conseguiu resolver de forma coerente. Lê a
                    // contratação ATUAL da própria NF no modal do SIGEO, sem salvar nada.
                    const proadAtualSIGEO = await obterProadPrincipalAtualNoModalSIGEO(linhaInfo, numeroNota, 'Manutenção');
                    if (proadAtualSIGEO) {
                        proad = proadAtualSIGEO;
                        documento.origemProadTRD = 'sigeo-modal-atual';
                        console.log(
                            `[SIGEO×PROAD] Manutenção NF ${numeroNota || '?'}: `
                            + `usando contratação atual exibida pelo SIGEO → ${proad}`
                        );
                    }
                }
            } else if (contexto === 'servicos') {
                const ehNFSe = registroEhNFSe(registroSelecionado) || !!documento?.ehNFSe;

                if (ehNFSe) {
                    // v11.40.27 — NFS-e: a contratação ATUAL da própria NF é a fonte
                    // prioritária do PROAD. O Cadastro pode conter histórico do fornecedor
                    // e o campo processoAdministrativo da listagem/API pode estar defasado
                    // em relação à contratação que o modal efetivamente exibe.
                    documento.destinoPlanilha = 'servicos';

                    const cadastroServicos = await obterProadPrincipalCadastroGeral('servicos', contratoEmpenho, cnpj);
                    const proadCadastro = _pProc(cadastroServicos?.proad || '');
                    if (proadCadastro) documento.proadPrincipalCadastro = proadCadastro;

                    let proadAtualSIGEO = null;
                    if (linhaInfo) {
                        proadAtualSIGEO = await obterProadPrincipalAtualNoModalSIGEO(linhaInfo, numeroNota, 'Serviços');
                    }

                    if (proadAtualSIGEO) {
                        proad = proadAtualSIGEO;
                        documento.origemProadTRD = 'sigeo-modal-atual-nfse';
                        if (proadCadastro && proadCadastro !== proadAtualSIGEO) {
                            console.warn(
                                `[SIGEO×PROAD] Serviços NF ${numeroNota || '?'}: `
                                + `Cadastro histórico ${proadCadastro} diverge da contratação atual ${proadAtualSIGEO}; `
                                + 'prevalece a própria NFS-e.'
                            );
                        }
                        console.log(
                            `[SIGEO×PROAD] Serviços NF ${numeroNota || '?'}: `
                            + `PROAD atual confirmado na própria NFS-e → ${proad}`
                        );
                    } else if (proadCadastro) {
                        // Se o modal não puder ser lido, mantém um fallback funcional pelo
                        // Cadastro de Serviços, mas sem consultar Mercadoria para uma NFS-e.
                        proad = proadCadastro;
                        documento.origemProadTRD = 'cadastro-servicos-fallback-nfse';
                        documento.criterioProadCadastro = cadastroServicos?.criterio;
                        console.warn(
                            `[SIGEO×PROAD] Serviços NF ${numeroNota || '?'}: `
                            + `não foi possível ler a contratação atual; usando Cadastro de Serviços → ${proad}`
                        );
                    }
                } else {
                    // Documentos que NÃO são NFS-e continuam podendo pertencer ao universo
                    // Água/Correios/Energia/Mercadoria/Telefonia. Só aqui há confronto entre
                    // os dois Cadastros.
                    const achado = await obterProadPrincipalServicosOuMercadoria(contratoEmpenho, cnpj);
                    if (achado) {
                        proad = achado.proad;
                        documento.proadPrincipalCadastro = proad;
                        documento.origemProadTRD = achado.origem;
                        documento.criterioProadCadastro = achado.criterio;
                        if (!documento.destinoPlanilha && achado.destino) documento.destinoPlanilha = achado.destino;
                    } else if (linhaInfo) {
                        const proadAtualSIGEO = await obterProadPrincipalAtualNoModalSIGEO(linhaInfo, numeroNota, 'Serviços');
                        if (proadAtualSIGEO) {
                            proad = proadAtualSIGEO;
                            documento.origemProadTRD = 'sigeo-modal-atual';
                            console.log(
                                `[SIGEO×PROAD] Serviços NF ${numeroNota || '?'}: `
                                + `usando contratação atual exibida pelo SIGEO → ${proad}`
                            );
                        }
                    }
                }
            }

            // Fallback dos módulos não-Saúde: PROAD informado pelo SIGEO.
            if (!proad && contexto !== 'saude') {
                proad = _pProc(registroSelecionado?.contratacao?.processoAdministrativo || documento?.contratacao?.processoAdministrativo || '');
                documento.origemProadTRD = 'sigeo-fallback';
            }
            documento.proadPrincipalTRD = proad || '';
            // O ateste (ou, na falta, a emissão) orienta a escolha entre TRDs de um
            // contrato com muitas medições: o TRD da nota é juntado por perto.
            const dataReferencia = registroSelecionado?.dataAteste
                || documento?.dataAteste
                || registroSelecionado?.dataEmissao
                || documento?.xml?.dataEmissao
                || null;
            documento.trd = await buscarTRDnoPROAD(
                proad, numeroNota, cnpj, contexto === 'manutencao', dataReferencia
            );
        } catch (e) {
            console.warn('[SIGEO×PROAD] enriquecimento falhou:', e.message);
            documento.trd = { encontrado: false, motivo: e.message };
        }
    }

    // ─── Células da planilha ───────────────────────────────────────────────────
    // Competência TRD · Última assinatura TRD · TRD (documento).
    // A data de ateste do SIGEO segue na coluna 6: as duas ficam lado a lado,
    // sem comparação automática.
    function _celulasTRD(doc, incluirSolicitacao = false) {
        const t = doc?.trd;

        if (!t || !t.encontrado) {
            const motivo = t?.motivo || 'TRD não consultado';
            const solicitacaoConfirmada = _pProc(t?.solicitacaoProvidencia || '') || '';
            const titulo = solicitacaoConfirmada
                ? `Solicitação ${solicitacaoConfirmada} confirmada por PROAD+NF, mas TRD não localizado: ${motivo}`
                : `TRD não localizado: ${motivo}`;
            const aviso = { fundo: CORES.AMARELO_CLARO, titulo };
            const celulas = [_cel('', aviso), _cel('', aviso), _cel('TRD não localizado', aviso)];
            return incluirSolicitacao
                ? [_cel(solicitacaoConfirmada, aviso), ...celulas]
                : celulas;
        }

        const solicitacao = _pProc(t.solicitacaoProvidencia || '') || '';
        const ehMedicao = t.tipoDocumento === 'relatorio-medicao';
        const ehCI = t.tipoDocumento === 'ci-ateste';
        const rotuloDocumento = ehMedicao ? 'Relatório de Medição' : (ehCI ? 'CI/Comunicação Interna de ateste' : 'TRD');
        const detalhe = [
            ehMedicao ? 'Fallback: Relatório de Medição (nenhum TRD localizado)' : '',
            ehCI ? 'Fallback: CI/Comunicação Interna aceita como documento de ateste (nenhum TRD localizado)' : '',
            solicitacao ? `Solicitação de Providência: ${solicitacao}${t.solicitacaoSituacao ? ` [${t.solicitacaoSituacao}]` : ''}` : '',
            t.ondeEstava ? `Encontrado em: ${t.ondeEstava}` : '',
            t.descricao || '',
            t.contrato ? `Contrato ${t.contrato}` : '',
            t.fornecedor || '',
            t.notas?.length ? `Nota(s) no ${rotuloDocumento}: ${t.notas.join(', ')}` : '',
            (t.valorGlobal !== null && t.valorGlobal !== undefined)
                ? `Valor global: ${Formatacao.formatarValorBrasileiro(t.valorGlobal)}` : '',
            t.assinaturas?.length
                ? 'Assinaturas: ' + t.assinaturas.map(a => `${a.nome || '?'} (${a.data || 's/ data'})`).join(' · ')
                : 'Sem assinatura digital legível',
            t.avisoNota || '',
            t.avisoCnpj || '',
            t.totalTRDsNoProcesso > 1 ? `${t.totalTRDsNoProcesso} TRDs no processo` : '',
            t.semTexto ? 'PDF digitalizado: sem camada de texto' : ''
        ].filter(Boolean).join(' | ');

        const incerto = !!t.avisoNota || !!t.avisoCnpj || t.semTexto;
        const estilo = incerto ? { fundo: CORES.AMARELO_CLARO, titulo: detalhe } : { titulo: detalhe };
        const celulas = [
            // Relatório de Medição nunca fornece Competência TRD para a planilha.
            // CI de ateste fornece competência quando ela estiver explicitamente escrita no PDF.
            _cel(ehMedicao ? '' : (t.competencia || ''), estilo),
            _cel(t.ultimaAssinatura || '', estilo),
            _cel(`${ehMedicao ? 'MEDIÇÃO ' : (ehCI ? 'CI ' : '')}DOC ${t.docNumero || '?'} @ ${t.proadConsultado}`, estilo)
        ];

        if (!incluirSolicitacao) return celulas;

        const estiloSolicitacao = solicitacao
            ? estilo
            : {
                fundo: CORES.AMARELO_CLARO,
                titulo: `${rotuloDocumento} localizado, mas não foi possível identificar com segurança uma Solicitação de Providência Em Aberto referente à NF.`
              };
        return [_cel(solicitacao, estiloSolicitacao), ...celulas];
    }

