  /**
   * Registra um listener no load do XHR já interceptado pelo script principal,
   * sem sobrescrever XMLHttpRequest.prototype.open novamente.
   * Captura os dados da tabela de documentos fiscais via evento customizado.
   */
  function registrarListenerTabelaAutonomos() {
    const URL_TABELA = '/sidof-service/documentosFiscais/jt';

    const originalOpen = XMLHttpRequest.prototype.open;
    XMLHttpRequest.prototype.open = function (method, url) {
      // Adiciona listener apenas nas chamadas à tabela de docs fiscais
      if (typeof url === 'string' && url.includes(URL_TABELA)) {
        this.addEventListener('load', function () {
          try {
            if (this.status === 200) {
              const ct = this.getResponseHeader('content-type') || '';
              if (ct.includes('application/json')) {
                const data = JSON.parse(this.responseText);
                if (Array.isArray(data?.results)) {
                  autonomosDadosTabela = data.results;
                  autonomosLog('Tabela capturada pelo módulo autônomo:', autonomosDadosTabela.length);
                  controlarExibicaoBotoesAutonomo();
                }
              }
            }
          } catch (e) {
            autonomosErr('Erro ao capturar tabela no listener autônomo:', e);
          }
        });
      }
      return originalOpen.apply(this, arguments);
    };
  }


  function extrairRegistroDaLinha(row, indice) {
    const txtLinha = texto(row);
    const cpfCnpj = txtLinha.match(/\d{2,3}\.?\d{3}\.?\d{3}\/?\d{4}-?\d{2}|\d{3}\.?\d{3}\.?\d{3}-?\d{2}/)?.[0] || '';
    const numeroDoc = txtLinha.match(/\b\d{8,}RA\d+\b/i)?.[0] || '';
    const datas = txtLinha.match(/\b\d{2}\/\d{2}\/\d{4}\b/g) || [];
    const valor = txtLinha.match(/R\$\s*[\d.]+,\d{2}/)?.[0] || '';

    return {
      __fallback: true,
      __rowIndex: indice,
      tipo: /\bRPA\b/i.test(txtLinha) ? 'RPA' : '',
      numero: numeroDoc,
      numeroDocumento: numeroDoc,
      documentoFiscalNumero: numeroDoc,
      dataEmissao: datas[0] || '',
      dataAteste: datas[1] || '',
      valor: valor ? valor.replace(/[R$\s]/g, '').replace(/\./g, '').replace(',', '.') : '',
      fornecedor: { documento: cpfCnpj },
      linhaFallbackTexto: txtLinha
    };
  }

  function registroEAutonomo(registro, row = null) {
    if (registro && String(registro?.tipo || '').toUpperCase() === 'RPA') return true;
    if (row && /\bRPA\b/i.test(texto(row))) return true;
    return false;
  }

  function coletarLinhasSelecionadas() {
    const matTable = document.querySelector('mat-table');
    if (!matTable) return [];

    const rows = Array.from(matTable.querySelectorAll('mat-row'));
    const resultado = [];

    rows.forEach((row, indice) => {
      const checkbox = row.querySelector('input[type="checkbox"]');
      if (checkbox?.checked) {
        resultado.push({ indice, row, checkbox });
      }
    });

    return resultado;
  }

  function obterNomeFornecedorDaLinha(row) {
    // Tenta a célula com classe específica da coluna Fornecedor
    const celula = row.querySelector('mat-cell.cdk-column-fornecedor, mat-cell[class*="column-fornecedor"]');
    if (celula) {
      const clone = celula.cloneNode(true);
      clone.querySelectorAll('span[data-tipo], mat-icon, .mat-icon').forEach(el => el.remove());
      const txt = clone.textContent.trim();
      if (txt && !/^[\d.\-\/]+$/.test(txt)) return txt;
    }
    // Fallback: a célula do Fornecedor vem logo após a célula do CPF/CNPJ na mat-table.
    // Pega todas as células, localiza a que contém o CPF/CNPJ e retorna a PRÓXIMA.
    const celulas = Array.from(row.querySelectorAll('mat-cell'));
    for (let i = 0; i < celulas.length - 1; i++) {
      const txt = celulas[i].textContent.trim().replace(/[.\-\/]/g, '');
      // Identifica célula de CPF (11 dígitos) ou CNPJ (14 dígitos)
      if (/^\d{11}$/.test(txt) || /^\d{14}$/.test(txt)) {
        const clone = celulas[i + 1].cloneNode(true);
        clone.querySelectorAll('span[data-tipo], mat-icon, .mat-icon').forEach(el => el.remove());
        return clone.textContent.trim();
      }
    }
    return '';
  }

  function obterRegistrosSelecionadosAutonomos() {
    const linhasSelecionadas = coletarLinhasSelecionadas();
    if (!linhasSelecionadas.length) return [];

    return linhasSelecionadas
      .map(ls => {
        const registroXHR = autonomosDadosTabela[ls.indice];
        const registro = registroXHR || extrairRegistroDaLinha(ls.row, ls.indice);
        const nomeTela = obterNomeFornecedorDaLinha(ls.row);
        return { ...registro, __nomeFornecedorTela: nomeTela, linha: ls };
      })
      .filter(item => registroEAutonomo(item, item?.linha?.row || null));
  }

  function marcarLinhasAutonomo() {
