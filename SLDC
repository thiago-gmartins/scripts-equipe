                    this.adicionarBotaoProximoComponenteExportarCSVDoSIGEO(botaoServicos, componenteOriginalSIGEO);
                }
                servicosSelecionados = servicosSelecionadosAgora;
            } else {
                servicosSelecionados.length = 0;
                const botaoExistente = this.document.querySelector("#sigeo-botao-processar-servicos");
                if (botaoExistente) botaoExistente.remove();
            }

