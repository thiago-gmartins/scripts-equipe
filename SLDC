    // ========== LEITURA DO PDF POR COORDENADAS ==========
    // Agrupa os itens de texto do PDF.js em linhas pela coordenada Y, guardando
    // o X de cada pedaço. É o que permite ler tabelas em que o rótulo está numa
    // linha ("IRRF (R$)") e o valor na linha imediatamente abaixo ("9.727,04").
    function montarLinhasPDF(itens, pagina) {
        const TOLERANCIA_Y = 3;
        const linhas = [];

        (itens || []).forEach(item => {
            const texto = String(item?.str || '').trim();
            if (!texto) return;
            const x = Array.isArray(item.transform) ? item.transform[4] : 0;
            const y = Array.isArray(item.transform) ? item.transform[5] : 0;
            // Largura real do PDF.js; se não vier, estima pelo tamanho do texto.
            const largura = Number.isFinite(item?.width) && item.width > 0
                ? item.width
                : texto.length * 4.5;

            let linha = linhas.find(l => Math.abs(l.y - y) <= TOLERANCIA_Y);
            if (!linha) {
                linha = { y, pagina, itens: [] };
                linhas.push(linha);
            }
            linha.itens.push({ x, largura, centro: x + largura / 2, texto });
        });

        linhas.forEach(l => {
            l.itens.sort((a, b) => a.x - b.x);
            l.texto = l.itens.map(i => i.texto).join(' ');
        });

        // No PDF o Y cresce de baixo para cima: ordena de cima para baixo.
        linhas.sort((a, b) => b.y - a.y);
        return linhas;
    }

    const _REGEX_NUMERO_BR = /^-?(?:\d{1,3}(?:\.\d{3})+|\d+),\d{2}$/;

    /**
     * Procura o valor associado a um rótulo: primeiro na mesma linha (à direita),
     * depois nas linhas seguintes, escolhendo o número mais alinhado horizontal-
     * mente ao rótulo — que é como as tabelas de tributos das NFS-e se organizam.
     */
    function valorNoRotuloOuAbaixo(linhas, regexRotulo, maxLinhasAbaixo = 2) {
        if (!Array.isArray(linhas)) return null;

        for (let i = 0; i < linhas.length; i++) {
            const linha = linhas[i];
            const indiceRotulo = linha.itens.findIndex(it => regexRotulo.test(it.texto));
            if (indiceRotulo === -1) continue;

            const rotulo = linha.itens[indiceRotulo];

            // 1) Valor na MESMA linha, logo depois do rótulo.
            for (let j = indiceRotulo + 1; j < linha.itens.length; j++) {
                const texto = linha.itens[j].texto.replace(/R\$/gi, '').trim();
                if (_REGEX_NUMERO_BR.test(texto)) return numeroDeTexto(texto);
                // Outro rótulo antes de qualquer número: o valor está abaixo.
                if (/[A-Za-zÀ-ÿ]{3}/.test(texto)) break;
            }

            // 2) Valor nas linhas de baixo, na MESMA COLUNA do rótulo. A comparação
            // é feita pelo centro (o rótulo costuma ser bem mais largo que o
            // número, e o número costuma vir alinhado à direita da coluna).
            const inicioRotulo = rotulo.x;
            const fimRotulo = rotulo.x + rotulo.largura;

            for (let k = i + 1; k <= Math.min(i + maxLinhasAbaixo, linhas.length - 1); k++) {
                const candidatos = linhas[k].itens
                    .map(it => ({ ...it, texto: it.texto.replace(/R\$/gi, '').trim() }))
                    .filter(it => _REGEX_NUMERO_BR.test(it.texto));

                if (!candidatos.length) continue;

                // Preferência: número cujo centro cai dentro da largura do rótulo.
                const TOLERANCIA_X = 12;
                const naColuna = candidatos.filter(
                    c => c.centro >= inicioRotulo - TOLERANCIA_X && c.centro <= fimRotulo + TOLERANCIA_X
                );
                const escolha = (naColuna.length ? naColuna : candidatos)
                    .sort((a, b) => Math.abs(a.centro - (inicioRotulo + fimRotulo) / 2)
                                  - Math.abs(b.centro - (inicioRotulo + fimRotulo) / 2))[0];

                return numeroDeTexto(escolha.texto);
            }
        }
        return null;
    }

    /**
     * Retenções lidas do PDF — usado como plano B quando o documento não tem XML
     * (caso das NFS-e municipais que chegam ao SIGEO só em PDF, como a de São Paulo).
     * Mantém a mesma regra do XML: Retenções Federais = IRRF + contribuições sociais
     * retidas (PIS + COFINS + CSLL), somando campo a campo.
     */
    function extrairRetencoesPDF(linhas) {
        if (!Array.isArray(linhas) || !linhas.length) return null;

        const v = regex => valorNoRotuloOuAbaixo(linhas, regex);

        const inss = v(/contribui[çc][ãa]o\s+previdenci[áa]ria/i);
        const irrf = v(/\birrf\b/i);

        // A NFS-e paulistana já traz PIS + COFINS + CSLL somados em
        // "Contribuições Sociais - Retidas". Quando esse campo não existe,
        // somamos os três separadamente.
        let contribuicoesSociais = v(/contribui[çc][õo]es\s+sociais/i);
        let pis = null, cofins = null, csll = null;

        if (contribuicoesSociais === null) {
            pis = v(/\bpis(?:\/pasep)?\b/i);
            cofins = v(/\bcofins\b/i);
            csll = v(/\bcsll\b/i);
            const partes = [pis, cofins, csll].filter(n => n !== null);
            contribuicoesSociais = partes.length
                ? arredondar2(partes.reduce((a, b) => a + b, 0))
                : null;
        }

        const federais = (irrf === null && contribuicoesSociais === null)
            ? null
            : arredondar2((irrf || 0) + (contribuicoesSociais || 0));

        const issqnApurado = v(/valor\s+do\s+iss\b/i);
        const baseISSQN = v(/base\s+de\s+c[áa]lculo/i);

        // ISSQN retido só quando a nota diz explicitamente que houve retenção —
        // na dúvida a célula fica em branco, para não afirmar o que o PDF não diz.
        let issqnRetido = null;
        const textoTudo = linhas.map(l => l.texto).join(' ');
        if (/iss\s*retido[^a-z]{0,10}(sim|s\b|1\b)/i.test(textoTudo)) {
            issqnRetido = issqnApurado;
        } else if (/iss\s*retido[^a-z]{0,10}(n[ãa]o|n\b|2\b)/i.test(textoTudo)) {
            issqnRetido = 0;
        }

        if (federais === null && inss === null && issqnApurado === null) return null;

        return {
            inss, irrf, contribuicoesSociais, federais,
            issqnApurado, issqnRetido, baseISSQN,
            origem: 'pdf', modelo: ''
        };
    }

    /**
     * Número, valor e data lidos do PDF — usados APENAS para conferir o que o
     * SIGEO registrou (nunca para preencher a planilha). Notas sem XML não têm
     * fonte oficial legível por máquina; o papel do PDF aqui é levantar a mão
     * quando o que está na nota não bate com o que está no SIGEO.
     */
    function extrairTotaisPDF(linhas, texto) {
        const v = regex => valorNoRotuloOuAbaixo(linhas, regex);

        // Bruto da nota × líquido a pagar: em NFCom com retenção os dois diferem,
        // e o SIGEO pode ter registrado qualquer um dos dois legitimamente.
        const valorBruto =
            v(/valor\s+total\s+(?:d[ao]\s+)?(?:nff|nota|nfs?-?e|documento)/i) ??
            v(/valor\s+total\s+d[oa]\s+servi[çc]o/i) ??
            v(/valor\s+(?:total\s+)?d[oa]s?\s+servi[çc]os/i);

        const valorAPagar =
            v(/total\s+a\s+pagar/i) ??
            v(/valor\s+l[íi]quido/i);

        const textoPlano = String(texto || '');

        const casaData = textoPlano.match(
            /data\s*(?:e\s*hora)?\s*d[ae]?\s*emiss[ãa]o[^0-9]{0,25}(\d{2}\/\d{2}\/\d{4})/i
        );
        const dataEmissao = casaData ? casaData[1] : '';

        const casaNumero = textoPlano.match(
            /(?:n[úu]mero\s+da\s+nota|nota\s+fiscal\s+fatura\s+n[ºo]?|n[úu]mero\s+da\s+nfs?-?e)[^0-9]{0,12}(\d{1,12})/i
        );
        const numero = casaNumero ? casaNumero[1].replace(/^0+/, '') : '';

        return { valorBruto, valorAPagar, dataEmissao, numero };
    }

    // ========== PARSEAR NOTA FISCAL DO TEXTO DO PDF ==========
    function parsearNotaFiscalPDF(texto, linhas) {
        const dados = {
            numero: '',
            cnpj: '',
            razaoSocial: '',
            valorServicos: '',
            dataEmissao: '',
            material: '',
            textoCompleto: texto
        };

        // Regex para número da nota fiscal
        // Padrões comuns: "Nota Fiscal nº 123", "NF-e: 456", "Número: 789"
        const regexNumero = /(?:Número\s+da\s+Nota|N[úu]mero\s+da\s+NFS?-?\s*e?|Nota\s*Fiscal|NF\s*-?\s*e?|N[úu]mero|Nº)[\s:ºnº-]*(\d[\d.\/\-\.]*)/i;
        const matchNumero = texto.match(regexNumero);
        if (matchNumero) {
            dados.numero = matchNumero[1];
        }

        // Regex para CNPJ
        // Formato: 12.345.678/0001-90 ou 12345678000190
        const CNPJ_TRT3 = '01298583000141'; // já sem formatação

        const regexCNPJ = /(?:CNPJ|CPF|NIF)[\s:]*(\d{2}\.?\d{3}\.?\d{3}\/?\d{4}-?\d{2})/i;
        const matchCNPJ = texto.match(regexCNPJ);

        if (matchCNPJ) {
            const cnpjCapturado = matchCNPJ[1].replace(/\D/g, '');

            // Só atribui se não for o CNPJ do TRT3
            if (cnpjCapturado !== CNPJ_TRT3) {
                dados.cnpj = cnpjCapturado;
            }
        }

        // Regex para Razão Social
        // Geralmente aparece após "Razão Social:", "Prestador:", "Emitente:"
        const regexRazaoSocial = /(?:Raz[ãa]o\s*Social|Prestador|Emitente)[\s:]*([A-ZÀ-Ú][A-ZÀ-Ú\s\.&-]{10,100})/i;
        const matchRazaoSocial = texto.match(regexRazaoSocial);
        if (matchRazaoSocial) {
            dados.razaoSocial = matchRazaoSocial[1].trim();
        }

        const regexValor = /\bVALOR\b[^:=]*[:=]\s*R?\$?\s*(\d{1,3}(?:[\.\s]\d{3})*(?:[.,]\d{2}))/i;

        const matchValor = texto.match(regexValor);
        if (matchValor) {
            // Normaliza o número: remove separadores de milhar e troca vírgula por ponto
            dados.valorServicos = matchValor[1]
                .replace(/\./g, '')   // remove pontos de milhar
                .replace(',', '.');   // converte vírgula decimal para ponto
        }

        // Regex para Data de Emissão
        // Formatos: 01/12/2024, 01-12-2024, 2024-12-01
        const regexData = /(?:Data\s+e\s+Hora\s+da\s+emiss[ãa]o\s+da\s+NFS?-?\s?e?|Data\s*de?\s*Emiss[ãa]o|Emiss[ãa]o|Data)[\s:]*(\d{2}[\/\-]\d{2}[\/\-]\d{4})(?:\s+(\d{2}:\d{2}:\d{2}))?/i;
        const matchData = texto.match(regexData);
        if (matchData) {
            const dataStr = matchData[1];
            // Converter para formato ISO se necessário
            if (dataStr.match(/^\d{2}[\/\-]\d{2}[\/\-]\d{4}$/)) {
                const [dia, mes, ano] = dataStr.split(/[\/\-]/);
                dados.dataEmissao = `${ano}-${mes}-${dia}T00:00:00`;
            } else {
                dados.dataEmissao = dataStr + 'T00:00:00';
            }
        }

        // Extração do tomador do PDF
        const regexTomadorBloco = /TOMADOR\s+DO\s+SERVI[ÇC]O[\s\S]{0,200}?(?:CNPJ|CPF)[\s\/\w]*?([\d]{2}[\. ]?[\d]{3}[\. ]?[\d]{3}[\/]?[\d]{4}[-]?[\d]{2})[\s\S]{0,200}?Nome[^\n]*\n?([A-ZÀÁÂÃÄÅÆÇÈÉÊËÌÍÎÏÐÑÒÓÔÕÖÙÚÛÜ\s\.&\-]{5,80})/i;
        const matchTomador = texto.match(regexTomadorBloco);
        if (matchTomador) {
            dados.tomadorCnpj = matchTomador[1].replace(/\D/g, '');
            dados.tomadorNome = matchTomador[2].trim();
        } else {
            // Padrão DANFE/NFe: busca CNPJ do TRT3 após DESTINATÁRIO
            const CNPJ_TRT3_PDF = '01298583000141';

            // Tenta achar dentro do bloco DESTINATÁRIO
            const regexDestBloco = /DESTINAT[AÁ]RIO[\s\S]{0,500}?(\d{2}\.?\d{3}\.?\d{3}\/?\d{4}-?\d{2})/i;
            const matchDest = texto.match(regexDestBloco);
            if (matchDest) {
                const cnpjDest = matchDest[1].replace(/\D/g, '');
                if (cnpjDest === CNPJ_TRT3_PDF) {
                    dados.tomadorCnpj = cnpjDest;
                }
            }

            // Fallback: busca o CNPJ do TRT3 em qualquer lugar do texto
            if (!dados.tomadorCnpj) {
                const regexCnpjNudo = /(\d{2}\.?\d{3}\.?\d{3}\/?\d{4}-?\d{2})/g;
                let m2;
                while ((m2 = regexCnpjNudo.exec(texto)) !== null) {
                    if (m2[1].replace(/\D/g, '') === CNPJ_TRT3_PDF) {
                        dados.tomadorCnpj = CNPJ_TRT3_PDF;
                        break;
                    }
                }
            }
        }

                const regexMunicipio = new RegExp('\\b(?:PREFEITURA\\s+DE|Prefeitura\\s+(?:Municipal\\s+)?de|MUNIC[IÍ]PIO\\s+DE)\\s+([A-ZÀ-Ÿ\\s\\-]+)', 'i');

        const matchMunicipio = texto.match(regexMunicipio);
        if (matchMunicipio) {
            const txtMunicipio = matchMunicipio[1];
            dados.municipio = txtMunicipio;
        }
        else {
            dados.municipio = null;
        }

        // Regex que captura números decimais antes do símbolo %
        // Aceita formatos: 2,01% ou 2.01% e também números inteiros como 1%
        const regexAliquota = /alíquota[^0-9]*?([\d]+(?:[.,][\d]+)?)\s*%/i;

        const matchAliquota = texto.match(regexAliquota);

        if (matchAliquota) {
            // Captura o número (grupo 1)
            let numero = matchAliquota[1];

            // Substitui vírgula por ponto para padronizar
            numero = numero.replace(',', '.');

            // Converte para número decimal (dividindo por 100)
            let numeroPontoFlutuante = parseFloat(numero);
            let ajustado = normalizarNumeroPercentual(numeroPontoFlutuante);
            dados.aliquotaISS = ajustado;
        }
        else {
            dados.aliquotaISS = null;
        }

        const regexMaterial = /m\s*a\s*t\s*e\s*r\s*i\s*a\s*[l|i]\s*s?[^:=]*[:=]\s*r?\s*\$?\s*(\d{1,3}(?:[\.\s]\d{3})*(?:[.,]\d{2}))/i;

        const matchMaterial = texto.match(regexMaterial);
        if (matchMaterial) {
            const valor = matchMaterial[1]
                .replace(/\./g, '')   // remove pontos de milhar
                .replace(',', '.');   // converte vírgula decimal para ponto

            dados.material = parseFloat(valor);
        } else {
            dados.material = null;
        }


        dados.localPrestaçãoServiço = extrairTextoPorRegex(texto, /local(?:\s+da\s+presta[çc]?[ãa]?o)?(?:\s+dos?\s+servi[çc]os?)?:\s*(.+?)(?:\n|$)/i);

        // Linhas com coordenadas + valores lidos do PDF. NÃO alimentam a
        // planilha: servem para conferir o que o SIGEO registrou.
        dados.linhas = Array.isArray(linhas) ? linhas : [];
        dados.retencoes = extrairRetencoesPDF(dados.linhas);
        dados.totais = extrairTotaisPDF(dados.linhas, texto);

        // PDF digitalizado (imagem): o PDF.js não devolve texto nenhum. Sem esse
        // aviso o robô emitia linha em branco silenciosamente — que foi o que
        // aconteceu com a NFS-e de São Paulo.
        dados.semCamadaTexto = String(texto || '').replace(/\s/g, '').length < 40;
        if (dados.semCamadaTexto) {
            console.warn('[SIGEO Script] PDF sem camada de texto (documento digitalizado/imagem): ' +
                         'não é possível ler tomador, data e retenções pelo PDF.');
        }

        logDebug('[SIGEO Script] Dados extraídos do PDF:', dados);
        return dados;
    }

    function extrairTextoPorRegex(texto, regex) {
        if (!texto || !regex)
            return '';

        let matchTexto = texto.match(regex);

        if (matchTexto) {
            return matchTexto[1];
        }
    }


