  function bgTexto(el) {
    return String(el?.textContent || '').trim();
  }

  function bgIsVisible(win, el) {
    if (!el) return false;
    const r = el.getBoundingClientRect();
    const s = win.getComputedStyle(el);
    return r.width > 0 && r.height > 0 && s.visibility !== 'hidden' && s.display !== 'none';
  }

  function bgClick(win, el) {
    if (!el) return false;
    try {
      el.scrollIntoView({ block: 'center', inline: 'center' });
    } catch {}
    el.dispatchEvent(new win.MouseEvent('pointerdown', { bubbles: true }));
    el.dispatchEvent(new win.MouseEvent('mousedown', { bubbles: true }));
    el.dispatchEvent(new win.MouseEvent('mouseup', { bubbles: true }));
    el.dispatchEvent(new win.MouseEvent('click', { bubbles: true }));
    if (typeof el.click === 'function') el.click();
    return true;
  }

  async function bgEsperar(condicao, timeout = 10000, intervalo = 100) {
    const inicio = Date.now();
    while (Date.now() - inicio < timeout) {
      const valor = await condicao();
      if (valor) return valor;
      await sleep(intervalo);
    }
    return null;
  }

  /**
   * Fecha todos os modais/dialogs abertos no iframe e aguarda a tela
   * de contratações estabilizar. Deve ser chamado antes de processar
   * cada documento quando o iframe é compartilhado entre múltiplos docs.
   */
  async function bgResetarEstadoIframe(doc, win) {
    autonomosLog('🔄 Resetando estado do iframe...');

    // Fecha qualquer dialog aberto (Cancelar, Fechar, ×, ESC)
    const tentativas = 3;
    for (let t = 0; t < tentativas; t++) {
      const dialogs = Array.from(doc.querySelectorAll('mat-dialog-container, .cdk-overlay-pane'));
      if (dialogs.length === 0) break;

      // Tenta fechar pelo botão Cancelar, depois Fechar, depois ×
      for (const regex of [/^cancelar$/i, /^fechar$/i, /^[×x✕]$/i]) {
        bgFecharDialogPorTexto(doc, win, regex);
      }

      // Tenta ESC
      doc.dispatchEvent(new win.KeyboardEvent('keydown', { key: 'Escape', bubbles: true }));
      await sleep(250);
    }

    // Aguarda qualquer overlay sumir
    await bgEsperar(() => {
      const overlays = doc.querySelectorAll('mat-dialog-container, .cdk-overlay-backdrop');
      return overlays.length === 0 ? true : null;
    }, 3000, 100);

    // Pausa para o Angular estabilizar (maior em lotes grandes)
    await sleep(500);
    autonomosLog('✅ Estado do iframe resetado.');
  }

