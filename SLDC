        // Alertas preventivos independentes do cruzamento com o Google Sheets.
        // Só entram nesta rotina visual as notas com indicação de retenção
        // previdenciária (INSS) no SIGEO. Para elas, NF de mês anterior recebe
        // badge amarelo e, após o prazo calculado, também badge de INSS vencido.
        injetarAlertasNFMesAnterior() {
            const matTable = this.document.querySelector('mat-table');
            if (!matTable) return;

            const todasAsLinhas = Array.from(matTable.querySelectorAll('mat-row'));
            todasAsLinhas.forEach((matRow, indice) => {
                if (!this.dadosConsultaTabelaDocsFiscais || indice >= this.dadosConsultaTabelaDocsFiscais.length) return;

                const registro = this.dadosConsultaTabelaDocsFiscais[indice];
                // RPA não é nota fiscal; mantém o módulo de autônomos fora deste alerta.
                if (String(registro?.tipo || '').toUpperCase() === 'RPA') return;

                const celulaRazaoSocial = matRow.querySelector('mat-cell:nth-child(3)');
                if (!celulaRazaoSocial) return;

                const chaveNF = extrairChaveNFDoRegistro(registro);
                if (!chaveNF?.dataEmissao) {
                    const antigoMes = celulaRazaoSocial.querySelector('[data-id="sigeo-badge-nf-mes-anterior"]');
                    if (antigoMes) antigoMes.remove();
                    const antigoINSS = celulaRazaoSocial.querySelector('[data-id="sigeo-badge-inss-vencido"]');
                    if (antigoINSS) antigoINSS.remove();
                    return;
                }

                // O alerta de mês anterior só interessa aos casos com INSS no SIGEO.
                // Sem retenção previdenciária, remove qualquer badge residual e não sinaliza a NF.
                const temINSSNoSIGEO = _registroTemRetencaoPrevidenciaria(registro);
                if (!temINSSNoSIGEO) {
                    const antigoMes = celulaRazaoSocial.querySelector('[data-id="sigeo-badge-nf-mes-anterior"]');
                    if (antigoMes) antigoMes.remove();
                    const antigoINSS = celulaRazaoSocial.querySelector('[data-id="sigeo-badge-inss-vencido"]');
                    if (antigoINSS) antigoINSS.remove();
