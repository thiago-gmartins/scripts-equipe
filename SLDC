    function xmlToHtml(node, level = 0) {
        const indent = level * 20;
        const container = document.createElement('div');
        if (level == 0) {
            container.style.overflowX = 'auto';
        }
        container.style.paddingLeft = `${indent}px`;

        // Helper: cria um <span> com classe e texto, sem interpretar HTML
        // (o XML da nota vem do fornecedor — nunca injetar via innerHTML).
        const spanSeguro = (classe, textoSpan) => {
            const s = document.createElement('span');
            s.className = classe;
            s.textContent = textoSpan;
            return s;
        };

        if (node.nodeType === Node.ELEMENT_NODE) {
            const tagElement = document.createElement('div');
            tagElement.className = 'xml-element';

            const openTag = document.createElement('span');
            openTag.className = 'xml-tag';
            openTag.appendChild(document.createTextNode('<'));
            openTag.appendChild(spanSeguro('xml-tag-name', node.nodeName));

            if (node.attributes.length > 0) {
                for (let attr of node.attributes) {
                    const attrSpan = document.createElement('span');
                    attrSpan.className = 'xml-attribute';
                    attrSpan.appendChild(document.createTextNode(' '));
                    attrSpan.appendChild(spanSeguro('xml-attr-name', attr.name));
                    attrSpan.appendChild(document.createTextNode('="'));
                    attrSpan.appendChild(spanSeguro('xml-attr-value', attr.value));
                    attrSpan.appendChild(document.createTextNode('"'));
                    openTag.appendChild(attrSpan);
                }
            }
            openTag.appendChild(document.createTextNode('>'));
            tagElement.appendChild(openTag);

            let hasElementChildren = false;
            for (let child of node.childNodes) {
                if (child.nodeType === Node.ELEMENT_NODE) {
                    hasElementChildren = true;
                    break;
                }
            }

            if (!hasElementChildren && node.textContent) {
                const textNode = document.createElement('span');
                textNode.className = 'xml-text';
                textNode.textContent = node.textContent;
                tagElement.appendChild(textNode);

                const closeTag = document.createElement('span');
                closeTag.className = 'xml-tag';
                closeTag.appendChild(document.createTextNode('</'));
                closeTag.appendChild(spanSeguro('xml-tag-name', node.nodeName));
                closeTag.appendChild(document.createTextNode('>'));
                tagElement.appendChild(closeTag);
            } else {
                for (let child of node.childNodes) {
                    if (child.nodeType === Node.ELEMENT_NODE) {
                        tagElement.appendChild(xmlToHtml(child, level + 1));
                    } else if (child.nodeType === Node.TEXT_NODE && child.textContent.trim() !== '') {
                        const textNode = document.createElement('div');
                        textNode.className = 'xml-text';
                        textNode.style.paddingLeft = `${(level + 1) * 20}px`;
                        textNode.textContent = child.textContent.trim();
                        tagElement.appendChild(textNode);
                    }
                }

                const closeTag = document.createElement('div');
                closeTag.className = 'xml-tag';
                closeTag.style.paddingLeft = `${indent}px`;
                closeTag.appendChild(document.createTextNode('</'));
                closeTag.appendChild(spanSeguro('xml-tag-name', node.nodeName));
                closeTag.appendChild(document.createTextNode('>'));
                tagElement.appendChild(closeTag);
            }

            container.appendChild(tagElement);
        } else if (node.nodeType === Node.TEXT_NODE && node.textContent.trim() !== '') {
            const textNode = document.createElement('div');
            textNode.className = 'xml-text';
            textNode.textContent = node.textContent.trim();
            container.appendChild(textNode);
        }

        return container;
    }

    function converterTextoXmlParaXMLDoc(xmlString) {
