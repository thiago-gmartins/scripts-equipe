    function gerarLinhasCopiaPorColunas(docs, colunas) {
        // Mapeamento para busca pelo nome da coluna no objeto doc.xml ou doc
        const mapCampos = {
            tomador: doc => doc.tomadorOk === true ? 'SIM' : 'NÃO',
            cnpj: doc => Formatacao.formatarCNPJApenasNumeros(doc?.fornecedor.documento || doc.xml?.cnpj || ''),
            especialidade: doc => doc.especialidade || '',
            valorBruto: doc => Formatacao.formatarValorBrasileiro(doc.valorDocumento || ''),
            numeroNF: doc => _numeroSIGEOParaColagem(doc),
            dataEmissao: doc => Formatacao.formatarDataBrasileira(doc.dataEmissao || doc.xml?.dataEmissao || ''),
            dataAteste: doc => doc.dataAteste || ''
            // TRD e Solicitação de Providência trazidos do PROAD (ver módulo SIGEO×PROAD)
            , solicitacaoProvidencia: doc => _pProc(doc?.trd?.solicitacaoProvidencia || '') || ''
            , competenciaTRD: doc => doc?.trd?.competencia || ''
            , assinaturaTRD: doc => doc?.trd?.ultimaAssinatura || ''
            , documentoTRD: doc => doc?.trd?.encontrado
                ? `${doc.trd.tipoDocumento === 'relatorio-medicao' ? 'MEDIÇÃO ' : (doc.trd.tipoDocumento === 'ci-ateste' ? 'CI ' : '')}DOC ${doc.trd.docNumero || '?'} @ ${doc.trd.proadConsultado || ''}`
                : 'TRD/CI não localizado'
            , aliquotaISS: doc => (doc.aliquotaISS || '').toString().replace('.', ',') || ''
            , municipioISS: doc => doc.municipioISS || ''
            , numContrato: doc => doc?.contratacao?.codigoContrato || ''
            , valorDocumento: doc => Formatacao.formatarValorBrasileiro(doc.valor || '')
            , numDocumento: doc => _numeroSIGEOParaColagem(doc)
            , naturezaRendimento: doc => obterPrimeiraNaturezaRendimento(doc)?.naturezaRendimento?.id || ''
            , naturezaRendimentoPJ: doc => { const nums = (doc?.fornecedor?.documento || '').replace(/[^0-9]/g, ''); return nums.length === 14 ? (obterPrimeiraNaturezaRendimento(doc)?.naturezaRendimento?.id || '') : ''; }
            , banco: doc => {
                let item = obterContaBancariaParaSaida(doc);
                let codigoBanco = item?.agencia?.banco?.id || '';

                return codigoBanco;
            }


            , agencia: doc => {
                let item = obterContaBancariaParaSaida(doc);
                let codigoAgencia = item?.agencia?.codigo?.toString() || '';
                if (!codigoAgencia) {
                    return '';
                }

                if (codigoAgencia.length < 4) {
                    return codigoAgencia.padStart(4, '0');
                }
                return codigoAgencia;
            }
            , conta: doc => {
                let item = obterContaBancariaParaSaida(doc);
                // != null preserva DV "0" (número zero é falsy) e DVs alfanuméricos como "X"
                let digitoVerificador = (item?.digitoVerificador != null && item.digitoVerificador !== '') ? `${item.digitoVerificador}` : '';
                let conta = `${item?.numero || ''}${digitoVerificador}`;
                return conta;
            }
            , percentualCentroCustos: doc => formatarPercentual2(_centroCustosPartes(doc).percentual)
            , valorServidor: doc => ''
            , valorMagistrado: doc => ''
            , valorPrimeiroGrau: doc => Formatacao.formatarValorBrasileiro(doc?.ateste?.valorPrimeiroGrau || '0.00')
            , valorSegundoGrau: doc => Formatacao.formatarValorBrasileiro(doc?.ateste?.valorSegundoGrau || '0.00')
            , numPROAD: doc => (doc?.contratacao.processoAdministrativo || '').replace('PROAD', '').trim()
            , numCNPJCPF: doc => doc?.fornecedor.tipoPessoa == 'FISICA' ? Formatacao.formatarCPFApenasNumeros(doc.fornecedor.documento) : Formatacao.formatarCNPJApenasNumeros(doc?.fornecedor?.documento)
            , setor: doc => doc?.contratacao?.setor?.sigla || ''
            , dataVencimento: doc => Formatacao.formatarDataBrasileira(doc?.documentoAluguel?.dataVencimento || '')
            , periodo: doc => doc.periodoInicial && doc.periodoFinal ? `${Formatacao.formatarDataBrasileira(doc.periodoInicial)} a ${Formatacao.formatarDataBrasileira(doc.periodoFinal)}`
                : doc.periodoInicial ? `A partir de ${Formatacao.formatarDataBrasileira(doc.periodoInicial)}` : doc.periodoFinal ? `Até ${Formatacao.formatarDataBrasileira(doc.periodoInicial)}` : ''
            , inicioVigencia: doc => Formatacao.formatarDataBrasileira(doc?.contratacao?.dataInicioVigencia) || ''
            , fimVigencia: doc => Formatacao.formatarDataBrasileira(doc?.contratacao?.dataFimVigencia) || ''
            , calcularNaturezaRendimento: doc => doc?.contratacao?.calculaRetencaoNaturezaRendimento?.toUpperCase() == 'SIM' ? 'Sim' : 'Não'
            , calcularRetençãoPrevidenciária: doc => doc?.contratacao?.retencaoPrevidenciaria?.toUpperCase() == 'SIM' ? 'Sim' : 'Não'
            , baseCálculoRetençãoPrevidenciária: doc => {
                let retencoesPrevidenciárias = { valorBaseCalculo: '', valorRetencao: '' };

                if (doc?.retencoesPrevidenciarias && Array.isArray(doc?.retencoesPrevidenciarias)) {
                    if (doc?.retencoesPrevidenciarias.length > 0) {
                        let retencao = doc?.retencoesPrevidenciarias[0];

                        retencoesPrevidenciárias.valorBaseCalculo = Formatacao.formatarValorBrasileiro(retencao.valorBaseCalculo || '0.00');
                        retencoesPrevidenciárias.valorRetencao = Formatacao.formatarValorBrasileiro(retencao.valorRetencao || '0.00');
                    }
                }

                return retencoesPrevidenciárias.valorBaseCalculo;
            }
            , retençãoTotal: doc => {
                let retencoesPrevidenciárias = { valorBaseCalculo: '', valorRetencao: '' };

                if (doc?.retencoesPrevidenciarias && Array.isArray(doc?.retencoesPrevidenciarias)) {
                    if (doc?.retencoesPrevidenciarias.length > 0) {
                        let retencao = doc?.retencoesPrevidenciarias[0];

                        retencoesPrevidenciárias.valorBaseCalculo = Formatacao.formatarValorBrasileiro(retencao.valorBaseCalculo || '0.00');
                        retencoesPrevidenciárias.valorRetencao = Formatacao.formatarValorBrasileiro(retencao.valorRetencao || '0.00');
                    }
                }

                return retencoesPrevidenciárias.valorRetencao;
            },
            municipioEstadoPrestador: doc => doc?.municipioEstadoPrestador,
            localPrestaçãoServiço: doc => doc?.xml?.localPrestaçãoServiço || doc?.pdf?.localPrestaçãoServiço || '',
            material: doc => doc?.xml?.material ? Formatacao.formatarValorBrasileiro(doc?.xml?.material) : doc?.pdf?.material ? Formatacao.formatarValorBrasileiro(doc?.pdf?.material) : '',
            glosa: doc => Formatacao.formatarValorBrasileiro(doc?.ateste?.valorGlosa || '0.00'),
        };

        let copia = docs.map(doc => {
            return colunas.map(c => c in mapCampos ? mapCampos[c](doc) : '\t').join('\t');
        }).join('\n');


        return copia;
    }

    function mostrarErroSnackbar(mensagem) {
        // Remove snackbar anterior se existir
        let sn = document.getElementById('snackbar-msg');
        if (sn) sn.remove();

        const snackbar = document.createElement('div');
        snackbar.id = 'snackbar-msg';
        snackbar.textContent = mensagem;
        snackbar.style.backgroundColor = '#d32f2f'; // vermelho escuro (Material Error)
        snackbar.style.color = '#fff';
        snackbar.style.padding = '14px 24px';
        snackbar.style.borderRadius = '4px';
        snackbar.style.boxShadow = '0px 2px 10px rgba(0,0,0,0.3)';
        snackbar.style.fontFamily = 'Roboto, Arial, sans-serif';
        snackbar.style.fontSize = '14px';
        snackbar.style.zIndex = '10000';
        snackbar.style.opacity = '0';
        snackbar.style.transition = 'opacity 0.3s ease-in-out';

        document.body.appendChild(snackbar);
        requestAnimationFrame(() => {
            snackbar.style.opacity = '1';
