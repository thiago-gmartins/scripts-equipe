    function compararSIGEOComDadosReciboAluguel(nomeCampo, valorSIGEO, valorReciboAluguel) {
        let resultadoComparacao = {
            icone: '',
            mensagem: '',
            corStatus: ''
        };

        if (valorReciboAluguel != valorSIGEO) {
            resultadoComparacao.mensagem = `Campo ${nomeCampo} divergente entre SIGEO e Recibo de Aluguel:\nSIGEO: ${valorSIGEO}\nRecibo de Aluguel: ${valorReciboAluguel}`;
            resultadoComparacao.icone = 'question_mark';
            resultadoComparacao.corStatus = CORES.VERMELHO_CLARO;
        }
        else {
            resultadoComparacao.mensagem = `Campo ${nomeCampo} SIGEO igual ao Recibo de Aluguel :\nSIGEO: ${valorSIGEO}\nRecibo de Aluguel: ${valorReciboAluguel}`;
            resultadoComparacao.icone = 'check_circle';
            resultadoComparacao.corStatus = CORES.VERDE_CLARO;
        }


        return resultadoComparacao;
    }

    function compararSIGEOComDadosDaNF(nomeCampo, valorSIGEO, valorPDF, valorXML) {

        let resultadoComparacao = {
            icone: '',
            mensagem: '',
            corStatus: ''
        };

        if (!valorPDF && !valorXML) {
            resultadoComparacao.icone = 'info';
            resultadoComparacao.mensagem = `Campo ${nomeCampo} encontrado apenas no SIGEO.`;
