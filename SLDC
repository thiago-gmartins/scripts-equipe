    // ─── Utilitários numéricos e de escape ──────────────────────────────────
    function numeroDeTexto(valor) {
        if (valor === null || valor === undefined || valor === '') return null;
        if (typeof valor === 'number') return Number.isFinite(valor) ? valor : null;
        let s = String(valor).trim().replace(/R\$/gi, '').replace(/\s/g, '');
        if (!s) return null;
        if (s.includes(',')) s = s.replace(/\./g, '').replace(',', '.');
        const n = parseFloat(s);
        return Number.isFinite(n) ? n : null;
    }

    function arredondar2(n) {
        return Math.round(((Number(n) || 0) + Number.EPSILON) * 100) / 100;
    }

    function formatarValorOuVazio(valor) {
        const n = numeroDeTexto(valor);
        return n === null ? '' : Formatacao.formatarValorBrasileiro(n);
    }

    function escaparHtml(texto) {
        return String(texto === null || texto === undefined ? '' : texto)
            .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    function escaparAtributo(texto) {
        return escaparHtml(texto).replace(/"/g, '&quot;');
    }

    /**
     * Célula da saída. `texto` é o que vai para a planilha; `html` (opcional) é o
     * que aparece na tela; `vermelho` pinta na tela E na colagem.
     */
    function _cel(texto, opcoes = {}) {
        return {
            texto: (texto === null || texto === undefined) ? '' : String(texto),
            html: opcoes.html || null,
            vermelho: !!opcoes.vermelho,
            titulo: opcoes.titulo || '',
            fundo: opcoes.fundo || ''
        };
    }

    // ─── Status visual da conferência (somente tela; nunca entra na colagem) ──
    function _montarStatusConferencia(divergencias = [], avisos = []) {
        const unicos = lista => [...new Set((lista || []).filter(Boolean).map(v => String(v).trim()).filter(Boolean))];
        const divs = unicos(divergencias);
        const warns = unicos(avisos);

        if (divs.length) {
            return {
                nivel: 'erro',
                rotulo: divs.length === 1 ? 'DIVERGÊNCIA' : `DIVERGÊNCIA · ${divs.length}`,
                titulo: ['Divergências encontradas:', ...divs.map(v => `• ${v}`), ...(warns.length ? ['Alertas adicionais:', ...warns.map(v => `• ${v}`)] : [])].join('\n')
            };
        }
        if (warns.length) {
            return {
                nivel: 'alerta',
                rotulo: warns.length === 1 ? 'REVISAR' : `REVISAR · ${warns.length}`,
                titulo: ['Pontos para revisão:', ...warns.map(v => `• ${v}`)].join('\n')
            };
        }
        return { nivel: 'ok', rotulo: 'OK', titulo: 'Conferência automática sem divergências ou alertas nos campos validados.' };
    }

    function _htmlStatusConferencia(status) {
        const s = status || _montarStatusConferencia();
        const paleta = s.nivel === 'erro'
            ? { fundo: '#ffebee', texto: '#b71c1c', borda: '#c62828', icone: '✕' }
            : s.nivel === 'alerta'
                ? { fundo: '#fff8e1', texto: '#8d5a00', borda: '#f9a825', icone: '⚠' }
                : { fundo: '#e8f5e9', texto: '#1b5e20', borda: '#2e7d32', icone: '✓' };
        return `<span title="${escaparAtributo(s.titulo || '')}" style="display:inline-flex;align-items:center;gap:5px;white-space:nowrap;padding:4px 8px;border-radius:999px;border:1px solid ${paleta.borda};background:${paleta.fundo};color:${paleta.texto};font-size:11px;font-weight:800;letter-spacing:.2px;box-shadow:0 1px 2px rgba(0,0,0,.08);"><span aria-hidden="true">${paleta.icone}</span>${escaparHtml(s.rotulo || '')}</span>`;
    }

    function _corStatusLinha(status) {
        if (status?.nivel === 'erro') return '#c62828';
        if (status?.nivel === 'alerta') return '#f9a825';
        return '#2e7d32';
    }

    // ─── Campos de controle para colagem segura nas planilhas ───────────────
    let _nomeUsuarioSIGEOCache = null;

    function _decodificarPayloadJWT(token) {
        try {
            const parte = String(token || '').split('.')[1];
            if (!parte) return null;
            const base64 = parte.replace(/-/g, '+').replace(/_/g, '/');
            const json = decodeURIComponent(atob(base64).split('').map(c =>
                '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2)).join(''));
            return JSON.parse(json);
        } catch (e) { return null; }
    }

    function obterNomeUsuarioSIGEO() {
        if (_nomeUsuarioSIGEOCache) return _nomeUsuarioSIGEOCache;
        const p = _decodificarPayloadJWT(BEARER_TOKEN);
        let nome = String(p?.name || '').trim();
        if (!nome) nome = [p?.given_name, p?.family_name].filter(Boolean).join(' ').trim();
        if (!nome) nome = String(p?.preferred_username || '').trim();

        // Mesmo estilo já usado nas planilhas: nome curto (primeiro + último).
        // Ex.: "Thiago Gonçalves Martins" → "Thiago Martins".
        const partes = nome.split(/\s+/).filter(Boolean);
        if (partes.length > 2) nome = `${partes[0]} ${partes[partes.length - 1]}`;
        if (nome && nome === nome.toUpperCase()) {
            nome = nome.toLocaleLowerCase('pt-BR').replace(/(^|\s)\S/g, m => m.toLocaleUpperCase('pt-BR'));
        }
        _nomeUsuarioSIGEOCache = nome;
        return nome;
    }

    function dataLiquidacaoHojePlanilha() {
        try {
            return new Intl.DateTimeFormat('pt-BR', {
                timeZone: 'America/Sao_Paulo', day: '2-digit', month: '2-digit', year: 'numeric'
            }).format(new Date());
        } catch (e) {
            return new Date().toLocaleDateString('pt-BR');
        }
    }

    function competenciaTRDParaPlanilha(doc) {
        if (doc?.trd?.tipoDocumento === 'relatorio-medicao') return '';
        const c = String(doc?.trd?.competencia || '').trim();
        let m = c.match(/^(\d{2})\/(\d{4})$/);
        if (m) return `${m[2]}-${m[1]}`;
        m = c.match(/^(\d{4})-(\d{2})$/);
        return m ? c : '';
    }

    function dataAssinaturaTRDParaPlanilha(doc) {
        const s = String(doc?.trd?.ultimaAssinatura || '').trim();
        const m = s.match(/\b(\d{2}\/\d{2}\/\d{4})\b/);
        return m ? m[1] : '';
    }

    function solicitacaoTRDParaPlanilha(doc) {
        return _pProc(doc?.trd?.solicitacaoProvidencia || '') || '';
    }

    function gerarCopiaCampo(docs, getter) {
        return docs.map(doc => String(getter(doc) ?? '')).join('\n');
    }

    function gerarCopiaDuasColunas(docs, getterA, getterB) {
        return docs.map(doc => `${String(getterA(doc) ?? '')}\t${String(getterB(doc) ?? '')}`).join('\n');
    }

    function _copiarControleUsuario(docs) {
        const nome = obterNomeUsuarioSIGEO();
        if (!nome) {
            mostrarErroSnackbar('Não foi possível identificar o usuário do SIGEO. Recarregue a tela para renovar o token.');
            return;
        }
        copiarClipboard(gerarCopiaCampo(docs, () => nome));
    }

    function _copiarControleDataPeriodo(docs) {
        copiarClipboard(gerarCopiaDuasColunas(docs, () => dataLiquidacaoHojePlanilha(), competenciaTRDParaPlanilha));
    }

    function _copiarControleProvidenciaTRD(docs, incluirData = true) {
        const texto = incluirData
            ? gerarCopiaDuasColunas(docs, solicitacaoTRDParaPlanilha, dataAssinaturaTRDParaPlanilha)
            : gerarCopiaCampo(docs, solicitacaoTRDParaPlanilha);
        copiarClipboard(texto);
    }

    // ─── Colagem contínua nas planilhas reorganizadas (v11.34.1) ─────────────
    // Saúde começa em F (CNPJ). Os demais módulos começam em I (Responsável
    // pela Análise). A ordem segue os cabeçalhos conferidos em 06/10/2026.
    // A colagem inclui apenas o bloco contínuo de campos preenchidos pelo robô.

    const _CAMPOS_SAUDE_ROBO = [
        'cnpj', 'tomador', 'banco', 'agencia', 'conta', 'valorBruto',
        'numeroNF', 'dataEmissao', 'especialidade', 'naturezaRendimento',
        'municipioISS', 'aliquotaISS', 'dataAteste', 'percentualCentroCustos',
        'valorPrimeiroGrau', 'valorSegundoGrau'
    ];

    const _ORDEM_COLAGEM_ROBO = {
        // saude: F:AA (22 campos), conforme cabeçalho.
        saude: [
            "CNPJ", "Responsável pela Análise", "Responsável pela Conferência", "PROAD do Ateste (SP)",
            "Nº Nota Fiscal", "Valor Bruto NF", "Data Emissão NF", "Data de Liquidação",
            "Período", "Data TRD", "Tomador Ok?", "Banco",
            "Agência", "Conta", "Especialidade", "Natureza de rendimento",
            "Municipio de Incidência ISSQN", "Alíquota ISSQN", "Data de Ateste", "% Centro de custos",
            "Custo 1 - Valor 1ª instância", "Custo 1 - Valor 2ª instância"
        ],
        // servicos: I:AE (23 campos), conforme cabeçalho.
        servicos: [
            "Responsável pela Análise", "Responsável pela Conferência", "Proad Principal", "PROAD do Ateste",
            "Nº Nota Fiscal / Fatura", "Valor Bruto DF", "Data Emissão DF", "Data Liquidação",
            "Período", "Data Recbto Definitivo", "Tomador Ok?", "Data do Ateste",
            "Natureza de Rendimento DARF", "Retenções Federais na NF", "INSS na NF", "ISSQN na NF",
            "Banco", "Agência", "C/CORRENTE", "Instância C. Custo 1",
            "% C. Custo 1", "Valor C. Custo 1 - PCO 1", "Valor C. Custo 2"
        ],
        // manutencao: I:AI (27 campos), conforme cabeçalho.
        manutencao: [
            "Responsável pela Análise", "Responsável pela Conferência", "Proad Principal", "PROAD do Ateste",
            "Nº Nota Fiscal", "Valor Bruto NF", "Data Emissão NF", "Data Liquidação",
            "Período", "Data Recbto Definitivo", "Tomador Ok?", "Data do Ateste",
            "Base Cálculo INSS SIGEO", "Retenção total INSS SIGEO", "Código Natureza de rendimento", "Material",
            "Retenções Federais na NF", "INSS na NF", "ISSQN na NF", "Banco",
            "Agência", "Conta", "Localidade da Prestação", "Instância C. Custo 1",
            "% C. Custo 1", "Valor C. Custo 1 - PCO 1", "Valor C. Custo 2"
        ],
        // mercadoria: I:AE (23 campos), conforme cabeçalho.
        mercadoria: [
            "Responsável pela Análise", "Responsável pela Conferência", "Proad Principal", "PROAD do Ateste",
            "Nº Nota Fiscal / Fatura", "Valor Bruto DF", "Data Emissão NF", "Data Liquidação",
            "Período", "Data Recbto Definitivo", "Tomador OK?", "Data do Ateste",
            "Natureza de Rendimento DARF", "Retenções Federais na NF", "INSS na NF", "ISSQN na NF",
            "Banco", "Agência", "C/CORRENTE", "Instância C. Custo 1",
            "% C. Custo 1", "Valor C. Custo 1 - PCO 1", "Valor C. Custo 2"
        ]
    };

    function _cnpjParaPlanilha(doc) {
        const bruto = doc?.fornecedor?.documento || doc?.xml?.cnpj || '';
        // Planilhas: CNPJ sempre como 14 dígitos, sem qualquer pontuação.
        return normalizarCNPJLocal(bruto) || '';
    }

    function _valoresRobotSaudeSemCNPJ(doc) {
        const linha = gerarLinhasCopiaPorColunas([doc], _CAMPOS_SAUDE_ROBO);
        const valores = String(linha || '').split('\t');
        // CNPJ é inserido explicitamente no prefixo comum, sempre com 14 dígitos e sem pontuação.
        return valores.slice(1);
    }

    function _valoresRobotServicosComProad(doc) {
        // Na planilha atual de Demais Documentos o PROAD Principal faz parte
        // do bloco salmão e deve ser colado em K, antes do PROAD do Ateste.
        return montarLinhaServicos(doc).celulasCopia.map(c => c?.texto ?? '');
    }

    function _valoresRobotServicosSemProad(doc) {
        // Mercadoria não possui PROAD Principal dentro do bloco de colagem,
        // mas já possui as quatro colunas do centro de custos: Instância, %, valor 1ª e valor 2ª.
        const todos = _valoresRobotServicosComProad(doc);
        return todos.slice(1);
    }

    function _valoresRobotManutencaoComProad(doc) {
        // Na planilha atual de Manutenção o PROAD Principal também está dentro
        // do bloco salmão; CNPJ permanece fora do bloco de colagem.
        return montarLinhaManutencao(doc).celulasCopia.map(c => c?.texto ?? '');
    }

    const CONFERENTE_PADRAO_PLANILHA = 'Viviane Renata';

    function _conferenteParaPlanilha(doc, modulo) {
        if (modulo !== 'saude') return CONFERENTE_PADRAO_PLANILHA;

        // Saúde: Viviane confere somente documentos a partir de R$ 5.000,00.
        // Se o valor não puder ser lido com segurança, deixa vazio em vez de inferir.
        const valorBruto = numeroDeTexto(doc?.valorDocumento);
        return valorBruto !== null && valorBruto >= 5000
            ? CONFERENTE_PADRAO_PLANILHA
            : '';
    }

    function _linhaColagemContinua(doc, modulo, nomeUsuario, dataLiquidacao) {
        const periodo = competenciaTRDParaPlanilha(doc);
        const solicitacao = solicitacaoTRDParaPlanilha(doc);
        const dataTRD = dataAssinaturaTRDParaPlanilha(doc);
        const cnpj = _cnpjParaPlanilha(doc);
        const conferente = _conferenteParaPlanilha(doc, modulo);

        let valores;
        if (modulo === 'saude') {
            // F:AA. Fonte fiscal preservada: tomador, banco, agência, conta,
            // valor, NF, emissão, especialidade e demais campos, nesta ordem.
            const fiscal = _valoresRobotSaudeSemCNPJ(doc);
            valores = [
                cnpj, nomeUsuario, conferente, solicitacao,
                fiscal[5], fiscal[4], fiscal[6], dataLiquidacao, periodo, dataTRD,
                ...fiscal.slice(0, 4), ...fiscal.slice(7)
            ];
        } else if (modulo === 'servicos' || modulo === 'mercadoria' || modulo === 'manutencao') {
            // I:AE (Serviços/Mercadoria) ou I:AI (Manutenção).
            // Fonte fiscal preservada: PROAD principal, tomador, NF, valor,
            // emissão, ateste e demais campos. CNPJ fica fora da colagem.
            const fiscal = modulo === 'manutencao'
                ? _valoresRobotManutencaoComProad(doc)
                : _valoresRobotServicosComProad(doc);
            valores = [
                nomeUsuario, conferente, fiscal[0], solicitacao,
                fiscal[2], fiscal[3], fiscal[4], dataLiquidacao, periodo, dataTRD,
                fiscal[1], ...fiscal.slice(5)
            ];
        } else {
            throw new Error(`Módulo de colagem não suportado: ${modulo}`);
        }

        const ordem = _ORDEM_COLAGEM_ROBO[modulo] || [];
        if (valores.length !== ordem.length) {
            throw new Error(`Ordem de colagem ${modulo} inconsistente: ${valores.length} valor(es) para ${ordem.length} coluna(s).`);
        }
        return valores;
    }

    function gerarTSVColagemContinua(docs, modulo) {
        const nomeUsuario = obterNomeUsuarioSIGEO();
        if (!nomeUsuario) {
            throw new Error('Não foi possível identificar o usuário logado no SIGEO.');
        }
        if (!_ORDEM_COLAGEM_ROBO[modulo]) {
            throw new Error(`Módulo de colagem desconhecido: ${modulo}`);
        }

        const dataLiquidacao = dataLiquidacaoHojePlanilha();
        return (docs || []).map(doc =>
            _linhaColagemContinua(doc, modulo, nomeUsuario, dataLiquidacao)
                .map(v => (v === null || v === undefined) ? '' : String(v))
                .join('\t')
        ).join('\n');
    }

    function copiarLinhaContinuaPlanilha(docs, modulo) {
        try {
            const texto = gerarTSVColagemContinua(docs, modulo);
            copiarClipboard(texto);
        } catch (e) {
            mostrarErroSnackbar('Não foi possível preparar a colagem: ' + e.message);
        }
    }

    function ligarBotaoColagemPlanilha(idBotao, docs, modulo) {
        const botao = document.getElementById(idBotao);
        if (!botao) {
            console.warn(`[SIGEO] Botão de colagem id=${idBotao} não localizado.`);
            return;
        }
        botao.onclick = () => copiarLinhaContinuaPlanilha(docs, modulo);
    }

    // ─── Fontes de dados comuns ─────────────────────────────────────────────
    function _proadPrincipal(doc) {
        return _pProc(doc?.proadPrincipalCadastro || doc?.proadPrincipalTRD || doc?.contratacao?.processoAdministrativo || '') || '';
    }

    function _tomadorCelula(doc) {
        const textoCopia = doc?.tomadorOk === true ? 'SIM' : 'NÃO';
        let html;
        if (!doc?.tomadorCnpj) {
            html = doc?.tomadorOk
                ? '<span style="color:green;font-size:1.3em;">✅</span>'
                : '<span title="Tomador não identificado na NF" style="color:gray;font-size:1.3em;">❓</span>';
        } else if (doc.tomadorOk) {
            html = `<span title="Tomador OK: ${escaparAtributo(doc.tomadorNome || '')} (${escaparAtributo(doc.tomadorFonte || '')})" style="color:green;font-size:1.3em;">✅</span>`;
        } else {
            html = `<span title="Tomador divergente: ${escaparAtributo(doc.tomadorCnpj)} - ${escaparAtributo(doc.tomadorNome || '')} (${escaparAtributo(doc.tomadorFonte || '')})" style="color:red;font-size:1.3em;">⚠️</span>`;
        }
        return _cel(textoCopia, { html });
    }

    function _contaBancariaPartes(doc) {
        const item = obterContaBancariaParaSaida(doc);
        if (!item) return { banco: '', bancoTitulo: '', agencia: '', conta: '' };
        const banco = item?.agencia?.banco?.id != null ? String(item.agencia.banco.id) : '';
        const bancoTitulo = item?.agencia?.banco?.sigla ? `${banco} - ${item.agencia.banco.sigla}` : banco;
        let agencia = item?.agencia?.codigo != null ? String(item.agencia.codigo) : '';
        if (agencia && agencia.length < 4) agencia = agencia.padStart(4, '0');
        const dv = (item?.digitoVerificador != null && item.digitoVerificador !== '')
            ? String(item.digitoVerificador) : '';
        const conta = `${item?.numero != null ? item.numero : ''}${dv}`;
        return { banco, bancoTitulo, agencia, conta };
    }

    // ─── Centro de custos: 1ª × 2ª instância ────────────────────────────────
    // Fonte: atestes do documento (API atestesDocumentosFiscais), onde
    // valorPrimeiroGrau = parcela da 1ª instância e
    // valorSegundoGrau  = valor do ateste − valorPrimeiroGrau (2ª instância).
    // Havendo mais de um ateste no documento, os valores são somados.
    function _centroCustosPartes(doc) {
        const registros = (Array.isArray(doc?.registrosAtestes) && doc.registrosAtestes.length)
            ? doc.registrosAtestes
            : (doc?.ateste ? [doc.ateste] : []);

        let v1 = 0;
        let v2 = 0;
        let temDados = false;

        registros.forEach(r => {
            const primeira = numeroDeTexto(r?.valorPrimeiroGrau);
            const segunda = numeroDeTexto(r?.valorSegundoGrau);
            if (primeira !== null || segunda !== null) temDados = true;
            v1 += (primeira || 0);
            v2 += (segunda || 0);
        });

        v1 = arredondar2(v1);
        v2 = arredondar2(v2);
        if (v1 < 0) v1 = 0;
        if (v2 < 0) v2 = 0;

        const total = arredondar2(v1 + v2);

        // Instância: 1 quando há valor na 1ª instância; 2 quando o valor está
        // exclusivamente na 2ª. O percentual é o aplicado à 1ª instância —
        // quando só existe 2ª instância, o rateio é de 100% para ela.
        let instancia = '';
        let percentual = null;

        if (temDados && total > 0) {
            if (v1 > 0) {
                instancia = '1';
                percentual = (v1 / total) * 100;
            } else {
                instancia = '2';
                percentual = 100;
            }
        }

        return { v1, v2, total, instancia, percentual, temDados, qtdAtestes: registros.length };
    }

    // Percentual no mesmo formato das linhas já preenchidas na planilha:
    // duas casas decimais, vírgula como separador e o símbolo de percentual
    // (ex.: 100,00% / 33,33%). Com o "%" colado junto, a planilha reconhece a
    // célula como percentual em vez de tratá-la como número solto.
    function formatarPercentual2(numero) {
        if (numero === null || numero === undefined || !Number.isFinite(Number(numero))) return '';
        return `${Number(numero).toFixed(2).replace('.', ',')}%`;
    }

    function _formatarValorCentroCusto(valor, temDados) {
        if (!temDados) return '';
        return Formatacao.formatarValorBrasileiro(valor) || '0,00';
    }

    function _tituloCentroCustos(cc) {
        if (!cc.temDados || !cc.instancia) {
            return 'Sem valores de ateste por instância — confira o rateio do centro de custos no SIGEO.';
        }
        const fmt = v => Formatacao.formatarValorBrasileiro(v) || '0,00';
        const soma = cc.qtdAtestes > 1 ? ` (soma de ${cc.qtdAtestes} atestes)` : '';
        return `1ª instância: ${fmt(cc.v1)} | 2ª instância: ${fmt(cc.v2)} | Total: ${fmt(cc.total)}${soma}`;
    }

    // Duas células: Instância do centro de custos e % aplicado.
    function _celulasCentroCustos(doc) {
        const cc = _centroCustosPartes(doc);
        const titulo = _tituloCentroCustos(cc);
        return [
            _cel(cc.instancia, { titulo, vermelho: !cc.instancia }),
            _cel(formatarPercentual2(cc.percentual), { titulo, vermelho: !cc.instancia })
        ];
    }

    // Quatro células para COLAGEM nas planilhas atuais: Instância, %, valor 1ª e valor 2ª.
    // A tela de conferência continua mostrando apenas Instância e %, para não aumentar largura.
    function _celulasCentroCustosCopia(doc) {
        const cc = _centroCustosPartes(doc);
        const titulo = _tituloCentroCustos(cc);
        return [
            _cel(cc.instancia, { titulo, vermelho: !cc.instancia }),
            _cel(formatarPercentual2(cc.percentual), { titulo, vermelho: !cc.instancia }),
            _cel(_formatarValorCentroCusto(cc.v1, cc.temDados), { titulo }),
            _cel(_formatarValorCentroCusto(cc.v2, cc.temDados), { titulo })
        ];
    }

    // ─── Localidade da prestação ────────────────────────────────────────────
    // Nome do município informado como local da prestação no XML. Quando o XML
    // não resolve, cai para o texto livre da nota e, por último, para o PDF.
    function _localidadePrestacao(doc) {
        const doXml = String(doc?.xml?.localidadePrestacao || '').trim();
        if (doXml) return doXml;

        const textoLivre = String(doc?.xml?.['localPrestaçãoServiço'] || '').trim();
        if (textoLivre) return municipioIBGEPorTexto(textoLivre) || textoLivre;

        const doPdf = String(doc?.pdf?.municipio || '').trim();
        if (doPdf) return municipioIBGEPorTexto(doPdf) || doPdf;

        return '';
    }

    function _celulaLocalidadePrestacao(doc) {
        const nome = _localidadePrestacao(doc);
        const codigo = String(doc?.xml?.codigoMunicipioPrestacao || '').trim();
        return _cel(nome, {
            vermelho: !nome,
            titulo: nome
                ? (codigo ? `Código IBGE do município de prestação: ${codigo}` : 'Localidade obtida do texto da nota fiscal.')
                : 'Localidade da prestação não localizada no XML — confira a nota fiscal.'
        });
    }

    // v11.40.26 — alguns XMLs chegam com valores monetários inteiros em centavos
    // (ex.: 11268450 em vez de 112684.50). Não corrige por aparência nem por tamanho:
    // só reconhece escala x100 quando DUAS fontes independentes confirmam o SIGEO:
    // 1) XML / 100 = valor SIGEO; 2) total dos atestes = valor SIGEO.
    // Assim a mesma escala pode ser aplicada com segurança às retenções do mesmo XML.
    function _fatorEscalaMonetariaXMLConfirmado(doc) {
        const valorXml = numeroDeTexto(doc?.xml?.valorServicos);
        const valorSigeo = numeroDeTexto(doc?.valor);
        if (valorXml === null || valorSigeo === null || valorSigeo <= 0) return 1;

        const cc = _centroCustosPartes(doc);
        const totalAtestes = cc?.temDados ? numeroDeTexto(cc.total) : null;
        if (totalAtestes === null) return 1;

        const bateSigeo = Math.abs(arredondar2(totalAtestes) - arredondar2(valorSigeo)) < 0.02;
        const xmlDiv100Bate = Math.abs(arredondar2(valorXml / 100) - arredondar2(valorSigeo)) < 0.02;
        return (bateSigeo && xmlDiv100Bate) ? 0.01 : 1;
    }

    function _retencoesXMLComEscalaSegura(doc) {
        const raw = doc?.xml?.retencoes || {};
        const fator = _fatorEscalaMonetariaXMLConfirmado(doc);
        if (fator === 1) return raw;

        const ajustado = { ...raw };
        for (const campo of [
            'inss', 'irrf', 'contribuicoesSociais', 'federais',
            'issqnApurado', 'issqnRetido', 'baseISSQN'
        ]) {
            const n = numeroDeTexto(raw?.[campo]);
            if (n !== null) ajustado[campo] = arredondar2(n * fator);
        }
        ajustado.escalaMonetariaCorrigida = true;
        ajustado.fatorEscalaMonetaria = fator;
        return ajustado;
    }

    // Dados da NF priorizando XML, com fallback opcional para o SIGEO.
    //
    // Exceção: NFCom (modelo 62). Ela NÃO é NFS-e — o XML entrega o líquido a
    // pagar (já descontadas as retenções), enquanto a coluna pede o valor BRUTO
    // do documento, que é o que o SIGEO registra. Nesses documentos o SIGEO
    // manda em número, valor e data; o XML fica só para as retenções e para a
    // conferência.
    function _dadosNotaPreferindoXML(doc, {
        fallbackSigeo = true,
        validarCnpjXml = false,
        validarDataXml = false
    } = {}) {
        const xml = doc?.xml || null;
        const ehNFCom = xml?.retencoes?.modelo === 'NFCom';

        const numeroXml  = String(xml?.numero || '').trim();
        const numeroSigeo = String(doc?.numero || '').trim();
        const valorXmlOriginal = numeroDeTexto(xml?.valorServicos);
        const fatorEscalaXml = _fatorEscalaMonetariaXMLConfirmado(doc);
        const valorXml = valorXmlOriginal === null ? null : arredondar2(valorXmlOriginal * fatorEscalaXml);
        const valorSigeo = numeroDeTexto(doc?.valor);
        const dataXml    = xml?.dataEmissao || '';
        const dataSigeo  = doc?.dataEmissao || '';
        const cnpjXml    = normalizarCNPJLocal(xml?.cnpj || '');
        const cnpjSigeo  = normalizarCNPJLocal(doc?.fornecedor?.documento || '');

        // Em NFCom o SIGEO é a fonte dos dados do documento.
        const numero = (ehNFCom && numeroSigeo)
            ? numeroSigeo
            : (numeroXml || (fallbackSigeo ? numeroSigeo : ''));

        let valor = (ehNFCom && valorSigeo !== null)
            ? valorSigeo
            : (valorXml !== null ? valorXml : (fallbackSigeo ? valorSigeo : null));

        const dataEmissao = (ehNFCom && dataSigeo)
            ? dataSigeo
            : (dataXml || (fallbackSigeo ? dataSigeo : ''));

        const divergencias = [];
        const camposDivergentes = [];
        let avisoValor = fatorEscalaXml !== 1
            ? `XML monetário recebido em escala x100; escala corrigida porque SIGEO e total dos atestes confirmam ${Formatacao.formatarValorBrasileiro(valorSigeo)}.`
            : '';

        // CNPJ: nova validação para Manutenção e Serviços. Quando existe XML,
        // ele é a referência documental; o PDF fica como fallback no caminho sem XML.
        if (validarCnpjXml && cnpjXml && cnpjSigeo && cnpjXml !== cnpjSigeo) {
            divergencias.push(`CNPJ: SIGEO ${cnpjSigeo} × XML ${cnpjXml}`);
            camposDivergentes.push('cnpj');
        }

        if (numeroXml && numeroSigeo) {
            const numeroXmlRef = _pNotaDeReferencia(numeroXml) || numeroXml.replace(/\D/g, '').replace(/^0+/, '');
            const numeroSigeoRef = _pNotaDeReferencia(doc?.numeroFiscalNormalizado || numeroSigeo)
                || numeroSigeo.replace(/\D/g, '').replace(/^0+/, '');
            if (numeroXmlRef && numeroSigeoRef && numeroSigeoRef !== numeroXmlRef) {
                divergencias.push(`Nº: SIGEO ${numeroSigeo} × XML ${numeroXml}`);
                camposDivergentes.push('numero');
            }
        }

        if (valorXml !== null && valorSigeo !== null &&
            arredondar2(valorXml) !== arredondar2(valorSigeo)) {

            const federais = numeroDeTexto(xml?.retencoes?.federais);
            const explicadoPelasRetencoes = ehNFCom && federais !== null &&
                Math.abs(arredondar2(valorXml + federais) - arredondar2(valorSigeo)) < 0.02;

            // Desempate conservador: se o total independente dos atestes coincide com o
            // valor do SIGEO e NÃO coincide com o XML, usa o SIGEO na coluna de valor.
            // A divergência continua sinalizada para conferência; não "corrige" XML no escuro.
            const ccValor = _centroCustosPartes(doc);
            const totalAtestes = ccValor?.temDados ? numeroDeTexto(ccValor.total) : null;
            const atesteConfirmaSIGEO = totalAtestes !== null &&
                Math.abs(arredondar2(totalAtestes) - arredondar2(valorSigeo)) < 0.02;
            const atesteConfirmaXML = totalAtestes !== null &&
                Math.abs(arredondar2(totalAtestes) - arredondar2(valorXml)) < 0.02;

            if (!ehNFCom && atesteConfirmaSIGEO && !atesteConfirmaXML) {
                valor = valorSigeo;
                avisoValor = `XML informa ${Formatacao.formatarValorBrasileiro(valorXml)}, mas o SIGEO informa ${Formatacao.formatarValorBrasileiro(valorSigeo)} e o total dos atestes confirma ${Formatacao.formatarValorBrasileiro(totalAtestes)}; valor do SIGEO usado na colagem.`;
            }

            if (explicadoPelasRetencoes) {
                // Diferença esperada da NFCom (bruto × líquido): não é erro.
                avisoValor = `Valor bruto do SIGEO (${Formatacao.formatarValorBrasileiro(valorSigeo)}); o XML da NFCom traz o líquido a pagar (${Formatacao.formatarValorBrasileiro(valorXml)} = bruto − retenções de ${Formatacao.formatarValorBrasileiro(federais)}).`;
            } else if (ehNFCom) {
                divergencias.push(`Valor: SIGEO ${Formatacao.formatarValorBrasileiro(valorSigeo)} × XML da NFCom ${Formatacao.formatarValorBrasileiro(valorXml)} — diferença não explicada pelas retenções`);
                camposDivergentes.push('valor');
            } else {
                divergencias.push(`Valor: SIGEO ${Formatacao.formatarValorBrasileiro(valorSigeo)} × XML ${Formatacao.formatarValorBrasileiro(valorXml)}`);
                camposDivergentes.push('valor');
            }
        }

        // Data de emissão: antes o XML era apenas escolhido como fonte. Agora,
        // nos módulos solicitados, a divergência SIGEO × XML é explicitamente marcada.
        if (validarDataXml && dataXml && dataSigeo) {
            const dataXmlFmt = Formatacao.formatarDataBrasileira(dataXml);
            const dataSigeoFmt = Formatacao.formatarDataBrasileira(dataSigeo);
            if (dataXmlFmt && dataSigeoFmt && dataXmlFmt !== dataSigeoFmt) {
                divergencias.push(`Emissão: SIGEO ${dataSigeoFmt} × XML ${dataXmlFmt}`);
                camposDivergentes.push('dataEmissao');
            }
        }

        return {
            numero,
            valor,
            dataEmissao,
            origem: ehNFCom ? 'sigeo' : (xml ? 'xml' : 'sigeo'),
            divergencias,
            camposDivergentes: [...new Set(camposDivergentes)],
            avisoValor
        };
    }

    // ─── Linha de MANUTENÇÃO PREDIAL ────────────────────────────────────────
    function montarLinhaManutencao(doc) {
        const xml = doc?.xml || null;
        const ret = _retencoesXMLComEscalaSegura(doc);
        const conferencia = _conferenciaPDF(doc, { validarCnpj: true });
        const alertaRetencao = xml ? null : _celulaRetencaoSemXML(conferencia);
        const nf = _dadosNotaPreferindoXML(doc, { validarCnpjXml: true, validarDataXml: true });
        const banco = _contaBancariaPartes(doc);

        // Retenção previdenciária apurada no SIGEO
        let baseCalcSigeo = null;
        let retencaoSigeo = null;
        if (Array.isArray(doc?.retencoesPrevidenciarias) && doc.retencoesPrevidenciarias.length > 0) {
            baseCalcSigeo = numeroDeTexto(doc.retencoesPrevidenciarias[0].valorBaseCalculo);
            retencaoSigeo = numeroDeTexto(doc.retencoesPrevidenciarias[0].valorRetencao);
        }

        // INSS do XML × Retenção total do SIGEO — regra já existente na Manutenção.
        const inssXml = (ret.inss === null || ret.inss === undefined) ? null : ret.inss;
        const semAmbos = (inssXml === null && (retencaoSigeo === null || retencaoSigeo === 0));
        const divergeINSS = !semAmbos && arredondar2(inssXml || 0) !== arredondar2(retencaoSigeo || 0);

        const celRetencaoSigeo = divergeINSS
            ? _cel('VER SIGEO', {
                vermelho: true,
                titulo: `Divergência de INSS — SIGEO: ${retencaoSigeo === null ? '(vazio)' : Formatacao.formatarValorBrasileiro(retencaoSigeo)} × XML: ${inssXml === null ? '(vazio)' : Formatacao.formatarValorBrasileiro(inssXml)}. Conferir antes de liquidar.`
              })
            : _cel(formatarValorOuVazio(retencaoSigeo));

        const celInssNota = divergeINSS
            ? _cel('VER SIGEO', {
                vermelho: true,
                titulo: `INSS da nota (XML): ${inssXml === null ? '(vazio)' : Formatacao.formatarValorBrasileiro(inssXml)} × Retenção total do SIGEO: ${retencaoSigeo === null ? '(vazio)' : Formatacao.formatarValorBrasileiro(retencaoSigeo)}.`
              })
            : _cel(formatarValorOuVazio(ret.inss));

        const material = numeroDeTexto(xml?.material) !== null
            ? numeroDeTexto(xml.material)
            : numeroDeTexto(doc?.pdf?.material);

        const divergencias = nf.divergencias.concat(conferencia.divergencias);
        // Para o Status, INSS XML × SIGEO só é uma divergência documental quando há XML.
        if (xml && divergeINSS) {
            divergencias.push(`INSS: SIGEO ${retencaoSigeo === null ? '(vazio)' : Formatacao.formatarValorBrasileiro(retencaoSigeo)} × XML ${inssXml === null ? '(vazio)' : Formatacao.formatarValorBrasileiro(inssXml)}`);
        }
        if (doc?.tomadorCnpj && doc?.tomadorOk === false) {
            divergencias.push(`Tomador: NF informa ${doc.tomadorCnpj}${doc.tomadorNome ? ` - ${doc.tomadorNome}` : ''}`);
        }

        const avisos = [];
        if (!doc?.tomadorCnpj) avisos.push('Tomador não identificado automaticamente na nota.');
        if (conferencia.semTexto) avisos.push('PDF sem camada de texto: conferência manual necessária.');
        if (conferencia.avisosRetencao.length) avisos.push(...conferencia.avisosRetencao);

        // Alertas de prazo do INSS também entram no Status visual do modal.
        // Mantém a mesma regra dos badges da tela principal: só alerta quando
        // a própria NF possui indicação de retenção previdenciária no SIGEO.
        const dataEmissaoAlertaINSS = nf.dataEmissao || doc?.dataEmissao || '';
        const temINSSNoSIGEO = _registroTemRetencaoPrevidenciaria(doc);
        const nfMesAnteriorComINSS = temINSSNoSIGEO && _nfEhDeMesAnterior(dataEmissaoAlertaINSS);
        const vencimentoINSSAlerta = temINSSNoSIGEO ? _calcularVencimentoINSSPorEmissao(dataEmissaoAlertaINSS) : null;
        const inssVencidoAlerta = !!(vencimentoINSSAlerta && _dataLocalSemHora(new Date()) > vencimentoINSSAlerta);

        if (nfMesAnteriorComINSS) {
            avisos.push(`NF de mês anterior com INSS — emissão ${_formatarDataISOParaBR(dataEmissaoAlertaINSS)}.`);
        }
        if (inssVencidoAlerta) {
            avisos.push(`INSS vencido — vencimento calculado ${_formatarDateBR(vencimentoINSSAlerta)}. Conferir a data exata na planilha, especialmente em caso de feriado.`);
        }

        let statusVisual = _montarStatusConferencia(divergencias, avisos);

        // Quando não há divergência documental, substitui o rótulo genérico
        // "REVISAR" por um alerta explícito, para ficar visível sem hover.
        // INSS vencido tem prioridade sobre NF de mês anterior.
        if (!divergencias.length && inssVencidoAlerta) {
            statusVisual = {
                nivel: 'erro',
                rotulo: 'INSS VENCIDO',
                titulo: ['Atenção:', ...avisos.map(v => `• ${v}`)].join('\n')
            };
        } else if (!divergencias.length && nfMesAnteriorComINSS) {
            statusVisual = {
                nivel: 'alerta',
                rotulo: 'NF MÊS ANTERIOR',
                titulo: ['Atenção:', ...avisos.map(v => `• ${v}`)].join('\n')
            };
        }

        const tituloNota = divergencias.length
            ? `Divergência na conferência — ${divergencias.join(' | ')}. Conferir antes de liquidar.`
            : (conferencia.semTexto
                ? 'Documento sem XML e com PDF digitalizado (imagem): dados do SIGEO, sem conferência automática.'
                : '');

        const campos = new Set([...(nf.camposDivergentes || []), ...(conferencia.camposDivergentes || [])]);
        const fundoCampo = campo => campos.has(campo) ? CORES.VERMELHO_CLARO : '';

        const celulasPlanilha = [
                _cel(_proadPrincipal(doc)),
                _tomadorCelula(doc),
                _cel(_numeroSIGEOExato(doc), { titulo: tituloNota, fundo: fundoCampo('numero') }),
                _cel(formatarValorOuVazio(nf.valor), {
                    titulo: [tituloNota, nf.avisoValor].filter(Boolean).join(' | '),
                    fundo: fundoCampo('valor')
                }),
                _cel(Formatacao.formatarDataBrasileira(nf.dataEmissao || ''), { titulo: tituloNota, fundo: fundoCampo('dataEmissao') }),
                _cel(Formatacao.formatarDataBrasileira(doc?.dataAteste || '')),
                _cel(formatarValorOuVazio(baseCalcSigeo)),
                celRetencaoSigeo,
                _cel(obterCodigoNaturezaRendimento(doc)),
                _cel(formatarValorOuVazio(material)),
                _cel(formatarValorOuVazio(ret.federais), alertaRetencao || { titulo: _tituloFederaisXML(ret) }),
                celInssNota,
                _cel(formatarValorOuVazio(ret.issqnRetido), alertaRetencao || {}),
                _cel(banco.banco, { titulo: banco.bancoTitulo }),
                _cel(banco.agencia),
                _cel(banco.conta),
                _celulaLocalidadePrestacao(doc)
            ];
        const celulasCopiaPlanilha = [...celulasPlanilha];
        celulasCopiaPlanilha[2] = _cel(_numeroSIGEOParaColagem(doc), { titulo: tituloNota, fundo: fundoCampo('numero') });
        return {
            doc,
            statusVisual,
            // Colagem: Nº da NF vem sempre exatamente do SIGEO; inclui também os valores de centro de custos.
            celulasCopia: [...celulasCopiaPlanilha, ..._celulasCentroCustosCopia(doc)],
            // Tela: mantém apenas Instância e %, como antes.
            celulas: [...celulasPlanilha, ..._celulasCentroCustos(doc), ..._celulasTRD(doc, true)]
        };
    }

    // ─── Linha de SERVIÇOS ──────────────────────────────────────────────────
    // ─── Conferência SIGEO × nota, quando NÃO há XML ────────────────────────
    // Regra: sem XML (documento que não é NFS-e), a planilha leva SOMENTE o que
    // está no SIGEO — o PDF não é fonte, é conferente. Quando o que se lê na
    // nota não bate com o registro do SIGEO, a célula vai marcada, para a
    // conferência olhar antes de liquidar.
    function _conferenciaPDF(doc, { validarCnpj = false } = {}) {
        const resultado = {
            aplicavel: false,
            semTexto: false,
            divergencias: [],
            camposDivergentes: [],
            avisosRetencao: []
        };

        if (doc?.xml) return resultado;               // com XML, a fonte oficial já resolve
        const pdf = doc?.pdf;
        if (!pdf) return resultado;

        if (pdf.semCamadaTexto) {
            resultado.semTexto = true;
            return resultado;
        }

        resultado.aplicavel = true;

        const totais = pdf.totais || {};
        const fmt = n => Formatacao.formatarValorBrasileiro(n);

        // CNPJ do prestador: PDF é fallback de conferência quando não há XML.
        if (validarCnpj) {
            const cnpjSigeo = normalizarCNPJLocal(doc?.fornecedor?.documento || '');
            const cnpjPdf = normalizarCNPJLocal(pdf?.cnpj || '');
            if (cnpjSigeo && cnpjPdf && cnpjSigeo !== cnpjPdf) {
                resultado.divergencias.push(`CNPJ: SIGEO ${cnpjSigeo} × nota ${cnpjPdf}`);
                resultado.camposDivergentes.push('cnpj');
            }
        }

        // Valor: o SIGEO pode ter registrado o bruto OU o líquido a pagar — só
        // acusa quando não bate com nenhum dos dois lidos na nota.
        const valorSigeo = numeroDeTexto(doc?.valor);
        const lidos = [totais.valorBruto, totais.valorAPagar].filter(v => v !== null && v !== undefined);
        if (valorSigeo !== null && lidos.length) {
            const bate = lidos.some(v => arredondar2(v) === arredondar2(valorSigeo));
            if (!bate) {
                resultado.divergencias.push(
                    `Valor: SIGEO ${fmt(valorSigeo)} × nota ${lidos.map(fmt).join(' / ')}`
                );
                resultado.camposDivergentes.push('valor');
            }
        }

        // Número da nota
        const numeroSigeo = String(doc?.numero || '').replace(/\D/g, '').replace(/^0+/, '');
        const numeroPdf = String(totais.numero || '').replace(/\D/g, '').replace(/^0+/, '');
        if (numeroSigeo && numeroPdf && numeroSigeo !== numeroPdf) {
            resultado.divergencias.push(`Nº: SIGEO ${doc.numero} × nota ${totais.numero}`);
            resultado.camposDivergentes.push('numero');
        }

        // Data de emissão
        const dataSigeo = Formatacao.formatarDataBrasileira(doc?.dataEmissao || '');
        if (dataSigeo && totais.dataEmissao && dataSigeo !== totais.dataEmissao) {
            resultado.divergencias.push(`Emissão: SIGEO ${dataSigeo} × nota ${totais.dataEmissao}`);
            resultado.camposDivergentes.push('dataEmissao');
        }

        // Retenções: sem XML nada é preenchido, mas se a nota mostra retenção o
        // usuário precisa saber que existe algo a lançar à mão.
        const ret = pdf.retencoes;
        if (ret) {
            if (ret.federais !== null && ret.federais !== undefined && ret.federais > 0) {
                resultado.avisosRetencao.push(`Retenções federais na nota: ${fmt(ret.federais)}`);
            }
            if (ret.issqnRetido !== null && ret.issqnRetido !== undefined && ret.issqnRetido > 0) {
                resultado.avisosRetencao.push(`ISSQN retido na nota: ${fmt(ret.issqnRetido)}`);
            }

            const inssPdf = ret.inss;
            let inssSigeo = null;
            if (Array.isArray(doc?.retencoesPrevidenciarias) && doc.retencoesPrevidenciarias.length > 0) {
                inssSigeo = numeroDeTexto(doc.retencoesPrevidenciarias[0].valorRetencao);
            }
            if (inssPdf !== null && inssPdf !== undefined && inssPdf > 0 &&
                arredondar2(inssPdf) !== arredondar2(inssSigeo || 0)) {
                resultado.divergencias.push(
                    `INSS: SIGEO ${inssSigeo === null ? '(vazio)' : fmt(inssSigeo)} × nota ${fmt(inssPdf)}`
                );
                resultado.camposDivergentes.push('inss');
            }
        }

        return resultado;
    }

    // Título e marcação das células de retenção quando não há XML.
    function _celulaRetencaoSemXML(conferencia, extra = '') {
        if (conferencia.semTexto) {
            return {
                vermelho: true,
                titulo: 'Documento sem XML e com PDF digitalizado (imagem): não foi possível conferir a nota. Verifique manualmente.'
            };
        }
        if (conferencia.avisosRetencao.length) {
            return {
                vermelho: true,
                titulo: `Sem XML — a planilha traz apenas o SIGEO. ${conferencia.avisosRetencao.join(' | ')}. Conferir e lançar à mão se for o caso.`
            };
        }
        return {
            titulo: extra || 'Documento sem XML — colunas de retenção da nota ficam em branco (não há fonte oficial).'
        };
    }

    // Tooltip da célula de retenções federais quando a fonte é o XML.
    function _tituloFederaisXML(ret) {
        const partes = [];
        if ((ret?.irrf !== null && ret?.irrf !== undefined) ||
            (ret?.contribuicoesSociais !== null && ret?.contribuicoesSociais !== undefined)) {
            partes.push(`IRRF: ${formatarValorOuVazio(ret.irrf) || '0,00'} + Contribuições sociais retidas: ${formatarValorOuVazio(ret.contribuicoesSociais) || '0,00'}`);
        }
        if (ret?.modelo === 'NFCom') {
            partes.push('NFCom (modelo 62): soma das retenções de todos os itens da fatura.');
        }
        return partes.join(' | ');
    }

    // Fonte ÚNICA do número fiscal na colagem: exatamente o que o SIGEO trouxe em doc.numero.
    // XML, PDF e TRD/PROAD continuam podendo ser usados para conferência e localização,
    // mas nunca alteram o número que será levado para a planilha.
    function _numeroSIGEOExato(doc) {
        return (doc?.numero === null || doc?.numero === undefined) ? '' : String(doc.numero);
    }

    // Ao colar TSV no Google Sheets, uma sequência apenas numérica iniciada por zero
    // pode ser convertida automaticamente em número (ex.: 00123 -> 123). O apóstrofo
    // é o marcador de texto do Sheets e não aparece visualmente na célula; assim, o
    // conteúdo exibido permanece exatamente 00123.
    function _numeroSIGEOParaColagem(doc) {
        const numero = _numeroSIGEOExato(doc);
        if (!numero) return '';
        return /^0\d+$/.test(numero) ? `'${numero}` : numero;
    }

    function _numeroFiscalParaPlanilha(valor, doc = null) {
        const original = String(valor ?? '').trim();
        if (!original) return '';

        const digitos = _pSoDigitos(original);
        const notaTRD = _pNotaDeReferencia(doc?.trd?.notaCasada || '');
        const notaBusca = _pNotaDeReferencia(doc?.numeroFiscalNormalizado || '');

        // Quando o próprio TRD já confirmou a NF, ele é a evidência mais forte
        // para substituir uma chave interna longa exibida pelo SIGEO.
        if (notaTRD && digitos.length >= 10) return notaTRD;

        // Formato clássico da chave interna NFS-e: AAAA + zeros + número fiscal.
        if (/^20\d{2}0{5,}[1-9]\d{0,7}$/.test(digitos)) {
            return _pNotaDeReferencia(digitos) || original;
        }

        // Se a busca PROAD e a representação exibida convergem para a mesma NF,
        // usa a forma fiscal normalizada; nunca troca um número curto divergente.
        const refOriginal = _pNotaDeReferencia(original);
        if (notaBusca && refOriginal && notaBusca === refOriginal) return notaBusca;

        return original;
    }

    function montarLinhaServicos(doc) {
        const xml = doc?.xml || null;
        const ret = _retencoesXMLComEscalaSegura(doc);
        const ehMercadoria = doc?.destinoPlanilha === 'mercadoria';
        const conferencia = _conferenciaPDF(doc, { validarCnpj: !ehMercadoria });
        const alertaRetencao = xml ? null : _celulaRetencaoSemXML(conferencia);
        const nf = _dadosNotaPreferindoXML(doc, {
            validarCnpjXml: !ehMercadoria,
            validarDataXml: !ehMercadoria
        });
        const banco = _contaBancariaPartes(doc);

        // Nova validação em Serviços: INSS do XML × Retenção Previdenciária do SIGEO.
        // Mercadoria/NFCom permanece fora desta regra nesta versão.
        let retencaoSigeo = null;
        if (Array.isArray(doc?.retencoesPrevidenciarias) && doc.retencoesPrevidenciarias.length > 0) {
            retencaoSigeo = numeroDeTexto(doc.retencoesPrevidenciarias[0].valorRetencao);
        }
        const inssXml = (ret.inss === null || ret.inss === undefined) ? null : numeroDeTexto(ret.inss);
        const semAmbosINSS = (inssXml === null || inssXml === 0) && (retencaoSigeo === null || retencaoSigeo === 0);
        const divergeINSS = !ehMercadoria && !!xml && !semAmbosINSS &&
            arredondar2(inssXml || 0) !== arredondar2(retencaoSigeo || 0);

        const divergencias = nf.divergencias.concat(conferencia.divergencias);
        if (divergeINSS) {
            divergencias.push(`INSS: SIGEO ${retencaoSigeo === null ? '(vazio)' : Formatacao.formatarValorBrasileiro(retencaoSigeo)} × XML ${inssXml === null ? '(vazio)' : Formatacao.formatarValorBrasileiro(inssXml)}`);
        }
        if (!ehMercadoria && doc?.tomadorCnpj && doc?.tomadorOk === false) {
            divergencias.push(`Tomador: NF informa ${doc.tomadorCnpj}${doc.tomadorNome ? ` - ${doc.tomadorNome}` : ''}`);
        }

        const avisos = [];
        if (!ehMercadoria && !doc?.tomadorCnpj) avisos.push('Tomador não identificado automaticamente na nota.');
        if (conferencia.semTexto) avisos.push('PDF sem camada de texto: conferência manual necessária.');
        if (conferencia.avisosRetencao.length) avisos.push(...conferencia.avisosRetencao);
        const statusVisual = _montarStatusConferencia(divergencias, avisos);

        const tituloNota = divergencias.length
            ? `Divergência na conferência — ${divergencias.join(' | ')}. Conferir antes de liquidar.`
            : (conferencia.semTexto
                ? 'Documento sem XML e com PDF digitalizado (imagem): dados do SIGEO, sem conferência automática.'
                : '');

        const campos = new Set([...(nf.camposDivergentes || []), ...(conferencia.camposDivergentes || [])]);
        const fundoCampo = campo => campos.has(campo) ? CORES.VERMELHO_CLARO : '';
        const celInssNota = divergeINSS
            ? _cel('VER SIGEO', {
                vermelho: true,
                fundo: CORES.VERMELHO_CLARO,
                titulo: `Divergência de INSS — SIGEO: ${retencaoSigeo === null ? '(vazio)' : Formatacao.formatarValorBrasileiro(retencaoSigeo)} × XML: ${inssXml === null ? '(vazio)' : Formatacao.formatarValorBrasileiro(inssXml)}. Conferir antes de liquidar.`
              })
            : _cel(formatarValorOuVazio(ret.inss), alertaRetencao || {});

        const celulasPlanilha = [
                _cel(_proadPrincipal(doc)),
                _tomadorCelula(doc),
                _cel(_numeroSIGEOExato(doc), { titulo: tituloNota, fundo: fundoCampo('numero') }),
                _cel(formatarValorOuVazio(nf.valor), {
                    titulo: [tituloNota, nf.avisoValor].filter(Boolean).join(' | '),
                    fundo: fundoCampo('valor')
                }),
                _cel(Formatacao.formatarDataBrasileira(nf.dataEmissao || ''), { titulo: tituloNota, fundo: fundoCampo('dataEmissao') }),
                _cel(Formatacao.formatarDataBrasileira(doc?.dataAteste || '')),
                _cel(obterCodigoNaturezaRendimento(doc)),
                _cel(formatarValorOuVazio(ret.federais), alertaRetencao || { titulo: _tituloFederaisXML(ret) }),
                celInssNota,
                _cel(formatarValorOuVazio(ret.issqnRetido), alertaRetencao || {}),
                _cel(banco.banco, { titulo: banco.bancoTitulo }),
                _cel(banco.agencia),
                _cel(banco.conta)
            ];
        const celulasCopiaPlanilha = [...celulasPlanilha];
        celulasCopiaPlanilha[2] = _cel(_numeroSIGEOParaColagem(doc), { titulo: tituloNota, fundo: fundoCampo('numero') });
        return {
            doc,
            statusVisual,
            // Colagem: Nº da NF vem sempre exatamente do SIGEO; inclui também os valores de centro de custos nas colunas AD/AE.
            celulasCopia: [...celulasCopiaPlanilha, ..._celulasCentroCustosCopia(doc)],
            // Tela: mantém apenas Instância e %, como antes.
            celulas: [...celulasPlanilha, ..._celulasCentroCustos(doc), ..._celulasTRD(doc, true)]
        };
    }

    // ─── Unimed ─────────────────────────────────────────────────────────────
    function documentoEUnimed(doc) {
        const cnpj = String(doc?.fornecedor?.documento || '').replace(/\D/g, '');
        return cnpj.startsWith(CNPJ_RAIZ_UNIMED);
    }

    /**
     * Lê CONTRATO e tipo (mensalidade × coparticipação) da descrição do serviço.
     * Ex.: "CONTRATO: 00339763 - Mensalidade: 07/2026 - Assistencia Medica ..."
     *      "CONTRATO: 00339755 - Referencia 07/2026 - COPARTICIPACAO/CUSTO OPERACIONAL ..."
     */
    function extrairContratoDescricaoUnimed(doc) {
        const candidatos = [
            doc?.xml?.descricaoServico,
            doc?.xml?.servico?.discriminacao,
            doc?.pdf?.textoCompleto,
            doc?.pdfTexto,
            doc?.xml?.xmlCompleto
        ].filter(Boolean).map(String);

        for (const texto of candidatos) {
            const mContrato = texto.match(/CONTRATO\s*:?\s*0*(\d{4,})/i);
            if (!mContrato) continue;

            const contrato = mContrato[1];
            // Recorta o trecho após o contrato para não pegar palavra de outro bloco.
            const trecho = texto.slice(mContrato.index, mContrato.index + 400);
            let tipo = '';
            if (/COPARTICIPA[CÇ][AÃ]O/i.test(trecho)) tipo = 'coparticipacao';
            else if (/MENSALIDADE/i.test(trecho)) tipo = 'mensalidade';

            const mapa = CONTRATOS_UNIMED[contrato];
            const descricao = (mapa && tipo) ? mapa[tipo] : '';

            if (!descricao) {
                console.warn(`[SIGEO Unimed] Contrato ${contrato} (tipo="${tipo || 'não identificado'}") sem descrição cadastrada em CONTRATOS_UNIMED.`);
            }
            return { contrato, tipo, descricao };
        }

        console.warn('[SIGEO Unimed] Não foi possível localizar "CONTRATO:" na descrição do documento.', doc?.uuid);
        return { contrato: '', tipo: '', descricao: '' };
    }

    function montarLinhaUnimed(doc) {
        const banco = _contaBancariaPartes(doc);
        const ret = doc?.xml?.retencoes || {};
        const { contrato, descricao } = extrairContratoDescricaoUnimed(doc);
        const cc = _centroCustosPartes(doc);
        const tituloCC = _tituloCentroCustos(cc);

        const celulas = [
                _cel(_proadPrincipal(doc)),
                _cel(Formatacao.formatarCNPJApenasNumeros(doc?.fornecedor?.documento)),
                _tomadorCelula(doc),
                _cel(_numeroSIGEOExato(doc)),
                _cel(formatarValorOuVazio(doc?.valor)),
                _cel(Formatacao.formatarDataBrasileira(doc?.dataEmissao || '')),
                _cel(Formatacao.formatarDataBrasileira(doc?.dataAteste || '')),
                _cel(obterCodigoNaturezaRendimento(doc)),
                _cel(banco.banco, { titulo: banco.bancoTitulo }),
                _cel(banco.agencia),
                _cel(banco.conta),
                _cel(contrato),
                _cel(descricao, {
                    vermelho: !descricao,
                    titulo: descricao ? '' : 'Descrição não identificada — confira o contrato e o tipo (mensalidade/coparticipação) na nota.'
                }),
                // Tributos da nota (do XML): IRRF + contribuições sociais retidas,
                // base de cálculo do ISSQN e ISSQN retido.
                _cel(formatarValorOuVazio(ret.federais), {
                    titulo: (ret.irrf !== null && ret.irrf !== undefined) || (ret.contribuicoesSociais !== null && ret.contribuicoesSociais !== undefined)
                        ? `IRRF: ${formatarValorOuVazio(ret.irrf) || '0,00'} + Contribuições sociais retidas: ${formatarValorOuVazio(ret.contribuicoesSociais) || '0,00'}`
                        : ''
                }),
                _cel(formatarValorOuVazio(ret.baseISSQN)),
                _cel(formatarValorOuVazio(ret.issqnRetido)),
                // Centro de custos: valores rateados entre 1ª e 2ª instância.
                // Unimed permanece com o layout da v11.13.3, sem colunas TRD adicionais.
                _cel(_formatarValorCentroCusto(cc.v1, cc.temDados), { titulo: tituloCC, vermelho: !cc.temDados }),
                _cel(_formatarValorCentroCusto(cc.v2, cc.temDados), { titulo: tituloCC, vermelho: !cc.temDados })
            ];
        const celulasCopia = [...celulas];
        celulasCopia[3] = _cel(_numeroSIGEOParaColagem(doc));
        return { doc, celulas, celulasCopia };
    }

    // ─── Renderização: tela, TSV e HTML de colagem ──────────────────────────
    function _htmlBotoesDoc(doc) {
        const botaoXML = doc?.xml ? htmlBotaoXML(doc.uuid) : '';
        const botaoPDF = doc?.pdf ? htmlBotaoPDF(doc.uuid) : '';
        return `${botaoPDF}${botaoXML}`;
    }

    function montarTabelaSaida(colunas, linhas, opcoes = {}) {
        const idCopiar = opcoes.idCopiar || 'copiar-tudo';
        const titulo = opcoes.titulo || '';
        const total = linhas.length;
        const textoCopiar = opcoes.textoCopiar || '📋 Copiar bloco do robô';
        const botoesExtrasHtml = (opcoes.botoesExtras || []).map(b => `
            <button id="${escaparAtributo(b.id)}" mat-raised-button="" color="primary"
