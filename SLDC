        existente = criarBotaoProcessarAutonomos();

        if (anchor.matches && anchor.matches('app-exportacao-csv')) {
          if (anchor.nextSibling) {
            anchor.parentElement.insertBefore(existente, anchor.nextSibling);
          } else {
            anchor.parentElement.appendChild(existente);
          }
        } else if (anchor.parentElement) {
          anchor.parentElement.insertBefore(existente, anchor.nextSibling || null);
        } else {
          document.body.appendChild(existente);
        }
      }
    } else {
      removerBotaoAutonomos();
