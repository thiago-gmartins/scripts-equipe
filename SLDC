    async function processarLinha(linhaInfo, indiceDentreSelecionados, registroSelecionado, tipo) {
        logDebug(`[SIGEO Script] Processando linha ${indiceDentreSelecionados + 1}...`);

        const documento = {
            indice: indiceDentreSelecionados + 1,
            xml: null,
            csv: null,
            pdf: null,
            pdfTexto: null,
            status: 'processando',
            fontes: []
        };

        try {

            if (tipo == 'servico') {
                await processarLinhaServico(linhaInfo, documento, registroSelecionado);
            }

            if (tipo == 'credenciado') {
                await processarLinhaCredenciadoSaude(linhaInfo, documento, registroSelecionado);
            }


            if (tipo == 'aluguel') {
                let dadosPDF = await capturarPDFAluguel(registroSelecionado.id, BEARER_TOKEN);
                documento.pdf = dadosPDF;
                documento.pdfTexto = dadosPDF.textoCompleto;
                documento.fontes.push('pdf');
                logDebug(`[SIGEO Script] ✓ PDF capturado para recibo de aluguel id = ${registroSelecionado?.id}`, documento.pdf);
            }

            if (tipo == 'manutenção-predial') {
                await processarLinhaManutençãoPredial(linhaInfo, documento, registroSelecionado);
            }

            documento.valorDocumento = registroSelecionado.valor;
            documento.especialidade = registroSelecionado?.areaAtuacao?.descricao;
            let aliquotaISS = documento.xml?.servico?.valores?.aliquota || documento.pdf?.aliquotaISS;

            if (aliquotaISS) {
                let pontoFluatuanteISS = parseFloat(aliquotaISS);
                // Foi observado que em documentos do interior, a alíquota vem com o total percentual: 5 em vez de 0.05 para 5%, como ocorre em BH
                if (pontoFluatuanteISS >= 1) {
                    let numeroAjustado = normalizarNumeroPercentual(pontoFluatuanteISS);
                    logDebug(`Ajustando valor do alíquota originalmente = ${pontoFluatuanteISS} no documento para ${numeroAjustado}`)
                    documento.aliquotaISS = numeroAjustado;
                }
                else {
                    documento.aliquotaISS = pontoFluatuanteISS;
                }
                logDebug(`Formatado alíquota de valor = ${aliquotaISS} como ${documento.aliquotaISS}`);
            }
            else {
                documento.aliquotaISS = null;
            }

            // Captura informações do ateste
            let dadosAteste = await capturarAtestes(registroSelecionado.id, BEARER_TOKEN);
            if (dadosAteste && dadosAteste.length > 0) {
                documento.registrosAtestes = dadosAteste;

                let achatado = dadosAteste.reduce((acc, item, indice) => {
                    if (indice === 0) {
                        acc = { ...item };
                    }
                    else {
                        let chaves = Object.keys(item);
                        chaves.forEach(chave => acc[`${chave}_${indice}`] = item[chave]);
                    }
                });
                documento.ateste = achatado;

            }

            // Fechar overlay
            const overlayAberto = document.querySelector(".cdk-overlay-backdrop");
            if (overlayAberto) {
                overlayAberto.click();
            }

            documento.status = documento.fontes.length > 0 ? 'sucesso' : 'parcial';

        } catch (error) {
            console.error('[SIGEO Script] Erro ao processar linha:', error);
            documento.status = 'erro';
            documento.erro = error.message;
        }

        return documento;

    }

