    // ── Inicialização robusta: garante que o robô sobe mesmo quando o
    //    usuário já está na tela de documentos fiscais ao carregar/recarregar
    //    a página, sem depender do evento de navegação SPA.
    (function inicializacaoRobusta() {
        let _roboCriado = false;

        function _eTelaDocsFiscais() {
            return !!(
                document.querySelector('app-documentofiscal-ug') ||
                window.location.href.includes('documentosFiscaisUG') ||
                (document.querySelector('h2') &&
                 document.querySelector('h2').textContent.includes('Documentos Fiscais'))
            );
        }

        function _subirRobo() {
            if (_roboCriado) return;
            _roboCriado = true;
            logDebug('[SIGEO Script] 🚀 Robô iniciado via inicializacaoRobusta');
            carregarTabelaIBGE();
            const processamento = new ProcessamentoDocsFiscais(document);
            processamento.inicializarControleOpcoes();
            window._sigeoProcessamento = processamento;
            adicionarFiltroDataAteste();

            // Se a tabela já foi carregada antes do robô subir, alimenta os dados agora
            if (window._sigeoUltimosDadosTabela && window._sigeoUltimosDadosTabela.length > 0) {
                logDebug('[SIGEO Script] ♻️ Recuperando dados da tabela já carregada:', window._sigeoUltimosDadosTabela.length, 'registros');
                processamento.dadosConsultaTabelaDocsFiscais = window._sigeoUltimosDadosTabela;
                processamento.controlarExibicaoBotoesRobo();
            }

            // Sempre que a tabela for (re)carregada, reconecta os listeners
            window.addEventListener('_sigeoTabelaAtualizada', function (e) {
                const proc = window._sigeoProcessamento;
                if (!proc) return;
                const dados = e.detail?.results;
                if (dados) {
                    proc.dadosConsultaTabelaDocsFiscais = dados;
                    proc.controlarExibicaoBotoesRobo();
                }
            });
        }

        // 1) Tenta imediatamente se DOM já tiver o componente Angular
        if (_eTelaDocsFiscais()) {
            _subirRobo();
            return;
        }

        // 2) Polling curto (50 ms × 120 = até 6 s) aguardando o Angular montar
        let _tentativas = 0;
        const _poll = setInterval(() => {
            _tentativas++;
            if (_eTelaDocsFiscais()) {
                clearInterval(_poll);
                _subirRobo();
                return;
            }
            if (_tentativas >= 120) {
                clearInterval(_poll);
                logDebug('[SIGEO Script] inicializacaoRobusta: tela de docs fiscais não detectada no tempo limite.');
            }
        }, 50);

        // 3) MutationObserver como fallback adicional — detecta quando o
        //    componente Angular é inserido no DOM após o Angular terminar
        //    de rotear (ex.: primeiro acesso, navegação direta pela URL)
        const _obs = new MutationObserver(() => {
            if (_eTelaDocsFiscais()) {
                _obs.disconnect();
                clearInterval(_poll);
                _subirRobo();
            }
        });
        if (document.body) {
            _obs.observe(document.body, { childList: true, subtree: true });
        } else {
            document.addEventListener('DOMContentLoaded', () => {
                _obs.observe(document.body, { childList: true, subtree: true });
            });
        }
    })();

