    function normalizarNumeroPercentual(numero) {
        if (numero && !Number.isNaN(numero)) {
            let posicaoPontoDecimal = numero.toString().lastIndexOf('.');
            let quantidadeDigitos = 2; // Quantidade de dígitos do número decimal corresponde ao percentual

            if (posicaoPontoDecimal >= 0) {
                let quantidadeCasasDecimais = numero.toString().length - (posicaoPontoDecimal + 1); // Soma 1 para contar a partir do ponto decimal
                quantidadeDigitos += quantidadeCasasDecimais;
            }
            // Necessário usar o toFixed para resolver problemas como 2.01 que no javascript vira 0.020099999999999996 sem ajuste
            let numeroAjustado = (numero / 100).toFixed(quantidadeDigitos);
            return numeroAjustado;
        }
        return numero;

    }

    async function buscarMunicipioIBGE(codigoIBGE) {
        return new Promise((resolve, reject) => {
            GM_xmlhttpRequest({
                method: 'GET',
                url: `https://servicodados.ibge.gov.br/api/v1/localidades/municipios/${codigoIBGE}`,
                headers: {
                    'Accept': 'application/json'
                },
                onload: function (response) {
                    try {
                        if (response.status === 200) {
                            const dados = JSON.parse(response.responseText);
                            logDebug('✅ Município encontrado:', dados.nome);
                            resolve(dados);
                        } else if (response.status === 404) {
                            reject(new Error(`Município com código ${codigoIBGE} não encontrado`));
                        } else {
                            reject(new Error(`Erro na API: ${response.status} - ${response.statusText}`));
                        }
                    } catch (e) {
                        reject(new Error(`Erro ao processar resposta: ${e.message}`));
                    }
                },
                onerror: function (error) {
                    reject(new Error(`Erro na requisição: ${error.statusText || 'Falha na conexão'}`));
                },
                ontimeout: function () {
                    reject(new Error('Timeout na requisição à API do IBGE'));
                },
                timeout: 10000 // 10 segundos
            });
        });
    }

    function ajustarOpçõesAdicionais() {
        const originalDefineProperty = Object.defineProperty;

        Object.defineProperty = function (obj, prop, descriptor) {
            // Qualquer erro no interceptor NÃO pode derrubar a aplicação:
            // em caso de falha, segue com o descriptor original intacto.
            try {
                // Interceptar pageSize
                if (prop === 'pageSize') {
                    descriptor = ajustarValorPadrãoQuantidadeRegistros(descriptor) || descriptor;
                }

                // Interceptar pageSizeOptions
                if (prop === 'pageSizeOptions') {
                    descriptor = adicionarNovasOpçõesQuantidadeRegistros(descriptor) || descriptor;
                }
            } catch (e) {
                console.warn('[SIGEO] Erro no interceptor de defineProperty (ignorado):', e);
            }

            return originalDefineProperty.call(this, obj, prop, descriptor);
        };
    }

