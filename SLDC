    function _montarDadosSheetsPorCabecalho(data, aliasesExtras = {}) {
        const aliases = { ..._ALIASES_SHEETS_COMUNS, ...aliasesExtras };
        const { indices, dados } = _mapearTabelaSheetsPorCabecalho(data, aliases);
        if (!dados.length) return [];
        const valor = (cols, campo) => indices[campo] >= 0 ? String(cols[indices[campo]] ?? '').trim() : '';
