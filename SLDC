                url,
                headers: {
                    'Authorization': 'Bearer ' + tokenBearer,
                    'Accept': 'application/xml, text/xml, */*'
                },
                withCredentials: true, // importante para cookies
                responseType: 'blob',
                onload: async (res) => {
                    try {
                        logDebug('Status:', res.status);
                        logDebug('Response Headers:', res.responseHeaders);
                        // status HTTP real (GM ignora CORS, mas não ignora 403/401)
                        if (res.status !== 200) {
                            console.error('[SIGEO] Erro na requisição XML:', res.status, res.statusText);
                            resolve(null);
                            return;
                        }

                        // res.response já é um Blob quando responseType = 'blob'[web:183][web:191]
                        const blob = res.response;
                        const dados = await processarXMLBlob(blob);
                        resolve(dados);
                    } catch (e) {
                        console.error('[SIGEO] Erro ao processar XML:', e);
                        resolve(null);
                    }
                },
                onerror: (err) => {
                    console.error('[SIGEO] Erro GM_xmlhttpRequest XML:', err);
                    resolve(null);
                }
            });
        });
    }

    // ========== PROCESSAR UMA LINHA (VERSÃO ATUALIZADA - XML + PDF) ==========
    async function processarLinhaCredenciadoSaude(linhaInfo, documento, registroSelecionado) {
        if (linhaInfo.botoes.menu && (!documento.xml || !documento.pdf)) {
            logDebug('[SIGEO Script] [2/3] Clicando no botão de menu...', linhaInfo.botoes.menu);
