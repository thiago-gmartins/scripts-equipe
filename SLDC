  async function bgAbrirAbaParametros(modal, win) {
    // IMPORTANTE: bgIsVisible falha em iframe oculto (dimensões = 0).
    // Buscamos a aba pelo texto SEM filtrar visibilidade.
    // Busca especificamente os elementos de aba (tab labels), não elementos genéricos
    const candidatos = Array.from(modal.querySelectorAll(
      '.mat-tab-label, .mat-mdc-tab, [role="tab"], mat-tab-label-content, .mat-tab-label-content'
    ));

    // Fallback: qualquer elemento que contenha EXATAMENTE o texto da aba
    // (não o modal inteiro que contém todas as abas)
    let aba = candidatos.find(el =>
      /Par[aâ]metros Adicionais/i.test(bgTexto(el)) &&
      bgTexto(el).length < 50
    );

    // Se não achou por seletor específico, tenta por texto curto em qualquer elemento
    if (!aba) {
      aba = Array.from(modal.querySelectorAll('*')).find(el => {
        const txt = bgTexto(el);
        return /Par[aâ]metros Adicionais/i.test(txt) && txt.length < 50;
      });
    }

    if (!aba) {
      // Diagnóstico: mostrar todas as abas encontradas
      autonomosWarn('bgAbrirAbaParametros: aba não encontrada. Elementos com texto de aba:');
      const tabHeaders = Array.from(modal.querySelectorAll('mat-tab-header, .mat-tab-header, [role="tablist"]'));
      tabHeaders.forEach((h, i) => {
        autonomosWarn(`  tabheader[${i}]:`, h.textContent?.trim()?.substring(0, 100));
      });
      // Fallback: tenta clicar no 3º item de qualquer tablist (Parâmetros Adicionais é a 3ª aba)
      const tabItems = Array.from(modal.querySelectorAll('[role="tab"], .mat-tab-label, .mat-mdc-tab'));
      autonomosWarn(`  tabs encontradas sem filtro de visibilidade: ${tabItems.length}`);
      tabItems.forEach((t, i) => autonomosWarn(`    tab[${i}]: "${bgTexto(t)}"`));

      if (tabItems.length >= 3) {
        autonomosWarn('bgAbrirAbaParametros: tentando clicar na 3ª tab por posição');
        bgClick(win, tabItems[2]);
        await sleep(1500);
        return true;
      }
      return false;
    }

    autonomosLog('bgAbrirAbaParametros: aba encontrada:', bgTexto(aba));
    bgClick(win, aba);

    // Aguarda ativamente os selects da aba aparecerem no DOM
    // em vez de usar sleep fixo (Angular renderiza de forma lazy)
    const apareceu = await bgEsperar(() => {
      const selects = Array.from(modal.querySelectorAll('mat-select, select'));
      // A aba "Parâmetros Adicionais" tem tipoAtividade — quando aparecer,
      // o número de selects aumenta (de ~4 para ~7+)
      const total = selects.length;
      const fcList = selects.map(s => s.getAttribute('formcontrolname') || '').join(',');
      autonomosLog(`bgAbrirAbaParametros: aguardando selects da aba... total=${total} fcs=${fcList}`);
      // Considera carregado quando aparecer mais de 4 selects (os 4 são de "Dados do Contrato")
      if (total > 4) return true;
      return null;
    }, 8000, 200);

    if (!apareceu) {
      autonomosWarn('bgAbrirAbaParametros: selects da aba Parâmetros não apareceram após 8s. Selects disponíveis:');
      Array.from(modal.querySelectorAll('mat-select, select')).forEach((s, i) => {
        const fc = s.getAttribute('formcontrolname') || s.getAttribute('ng-reflect-name') || '(sem fc)';
        autonomosWarn(`  [${i}] fc="${fc}" texto="${bgTextoSelect(s)}"`);
      });
    }

    return true;
  }

