    // ========== INTERCEPTAÇÃO ==========
    (function interceptarCreateObjectURL() {
        const originalCreateObjectURL = URL.createObjectURL;

        URL.createObjectURL = function (blob) {
            const url = originalCreateObjectURL(blob);

            logDebug('[SIGEO Script] Blob capturado:', blob.type, blob.size);

            // XML
            if (aguardandoDocumento && aguardandoDocumento.tipo === 'xml') {
                if (blob.type.includes('xml') || blob.type.includes('text')) {
                    processarXMLBlob(blob).then(dadosXML => {
                        if (aguardandoDocumento && aguardandoDocumento.resolve) {
                            aguardandoDocumento.resolve(dadosXML);
                        }
                        aguardandoDocumento = null;
                    });
                }

            }

            // PDF
            if (aguardandoDocumento && aguardandoDocumento.tipo === 'pdf') {
                if (blob.type.includes('pdf')) {
                    logDebug('[SIGEO Script] PDF detectado, extraindo dados...');
                    extrairDadosPDF(blob).then(dadosPDF => {
                        if (aguardandoDocumento && aguardandoDocumento.resolve) {
                            aguardandoDocumento.resolve(dadosPDF);
                        }
                        aguardandoDocumento = null;
                    });
                }
            }

            // CSV
            if (blob.type.includes('csv')) {
                processarCSVBlob(blob);
                setTimeout(() => {
                    document.querySelectorAll('a[download]').forEach(link => {
                        if (link.href === url) link.remove();
                    });
                }, 50);
            }

            return url;
        };
    })();

    (function interceptarXHR() {
        const originalOpen = XMLHttpRequest.prototype.open;
        XMLHttpRequest.prototype.open = function (method, url) {
            this._requestUrl = url;
            return originalOpen.apply(this, arguments);
        };
    })();

    // ========== PROCESSAR XML BLOB ==========
    async function processarXMLBlob(blob) {
        try {
            const xmlText = await blob.text();
            const parser = new DOMParser();
            const xmlDoc = parser.parseFromString(xmlText, 'text/xml');

            const dadosXML = {
                numero: extrairValorXML(xmlDoc, ['Numero', 'numero', 'nNF', 'NumeroNF', 'NumeroNFe', 'nNFSe']),
                dataEmissao: extrairValorXML(xmlDoc, ['DataEmissao', 'dataEmissao', 'DataEmissaoNFe', 'dhEmi', 'dEmi', 'dhProc']),
                razaoSocial: extrairValorXML(xmlDoc, ['RazaoSocial', 'razaoSocial', 'xNome']),
                valorServicos: extrairValorXML(xmlDoc, ['ValorServicos', 'valorServicos', 'vNF', 'vServ', 'valor']),
                cnpj: extrairValorXML(xmlDoc, ['CNPJ', 'cnpj', 'Cnpj', 'CPF', 'Cpf', 'cpf', 'cnpj_cpf', 'cpf_cnpj', 'PrestadorCnpj']),
                tomadorCnpj: (() => {
                    // Padrão nacional NFS-e: tag <toma>
                    const tomaEls = xmlDoc.getElementsByTagNameNS('*', 'toma');
                    if (tomaEls.length > 0) {
                        const toma = tomaEls[0];
                        const cnpjEls = toma.getElementsByTagNameNS('*', 'CNPJ');
                        if (cnpjEls.length > 0) return cnpjEls[0].textContent.replace(/\D/g, '');
                        const cpfEls = toma.getElementsByTagNameNS('*', 'CPF');
                        if (cpfEls.length > 0) return cpfEls[0].textContent.replace(/\D/g, '');
                    }
                    // Padrão ABRASF: tag <Tomador><IdentificacaoTomador><CpfCnpj><Cnpj>
                    const tomadorEls = xmlDoc.getElementsByTagNameNS('*', 'Tomador');
                    if (tomadorEls.length > 0) {
                        const tomador = tomadorEls[0];
                        const cnpjEls = tomador.getElementsByTagNameNS('*', 'Cnpj');
                        if (cnpjEls.length > 0) return cnpjEls[0].textContent.replace(/\D/g, '');
                        const cpfEls = tomador.getElementsByTagNameNS('*', 'Cpf');
                        if (cpfEls.length > 0) return cpfEls[0].textContent.replace(/\D/g, '');
                    }
                    // Padrão ABRASF variante: tag <TomadorServico>
                    const tomServEls = xmlDoc.getElementsByTagNameNS('*', 'TomadorServico');
                    if (tomServEls.length > 0) {
                        const tomador = tomServEls[0];
                        const cnpjEls = tomador.getElementsByTagNameNS('*', 'Cnpj');
                        if (cnpjEls.length > 0) return cnpjEls[0].textContent.replace(/\D/g, '');
                        const cpfEls = tomador.getElementsByTagNameNS('*', 'Cpf');
                        if (cpfEls.length > 0) return cpfEls[0].textContent.replace(/\D/g, '');
                    }
                    // Padrão GovDigital (Poços de Caldas): <tomador><documento>
