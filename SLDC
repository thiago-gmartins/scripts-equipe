        /**
         * Aguarda até que um número específico de mat-row sejam adicionadas à mat-table
         * @param {number} quantidadeEsperada - Número de mat-row esperadas
         * @param {number} timeout - Tempo máximo de espera em ms (padrão: 10000)
         * @returns {Promise<NodeList>} Promise que resolve com as mat-row encontradas
         */
        aguardarMatRows(quantidadeEsperada, timeout = 10000) {
            return new Promise((resolve, reject) => {
                const matTable = this.document.querySelector('mat-table');

                if (!matTable) {
                    reject(new Error('mat-table não encontrada no documento'));
                    return;
                }

                // Verifica se já existem as linhas necessárias
                const rowsExistentes = matTable.querySelectorAll('mat-row');
                if (rowsExistentes.length >= quantidadeEsperada) {
                    logDebug(`[SIGEO] ${rowsExistentes.length} mat-row já existentes (esperado: ${quantidadeEsperada})`);
                    resolve(rowsExistentes);
                    return;
                }

                let timeoutId;

                const observer = new MutationObserver((mutations) => {
                    const rows = matTable.querySelectorAll('mat-row');
                    logDebug(`[SIGEO] mat-row detectadas: ${rows.length}/${quantidadeEsperada}`);

                    if (rows.length >= quantidadeEsperada) {
                        clearTimeout(timeoutId);
                        observer.disconnect();
                        logDebug(`[SIGEO] ✓ ${rows.length} mat-row carregadas com sucesso!`);
                        resolve(rows);
                    }
                });

                // Configura o observer para detectar adição de elementos filhos
                observer.observe(matTable, {
                    childList: true,      // Observa adição/remoção de filhos diretos
                    subtree: true         // Observa toda a árvore de descendentes
                });

                // Timeout para evitar espera infinita
                timeoutId = setTimeout(() => {
                    observer.disconnect();
                    const rows = matTable.querySelectorAll('mat-row');
                    if (rows.length >= quantidadeEsperada) {
                        resolve(rows);
                    }
                    else {
                        logDebug(`Apenas ${rows.length} mat-row carregadas em ${timeout}ms (esperado: ${quantidadeEsperada}). Possivelmente devido ao filtro por data de ateste = `, FILTRO_ATESTE_ATUAL);
                        resolve(rows);
                    }

                }, timeout);
            });
        }

