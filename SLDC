    // ─── Localidade da prestação no XML ─────────────────────────────────────
    // Cache das consultas ao IBGE por código de município (evita repetir a
    // mesma chamada de rede dentro do lote).
    const _cacheMunicipiosIBGEPorCodigo = new Map();

    async function nomeMunicipioPorCodigoIBGE(codigoIBGE) {
        const codigo = String(codigoIBGE || '').replace(/\D/g, '');
        if (!codigo) return '';
        if (_cacheMunicipiosIBGEPorCodigo.has(codigo)) return _cacheMunicipiosIBGEPorCodigo.get(codigo);

        // 1) Tabela local de Minas Gerais (sem rede)
        let nome = '';
        try {
            nome = municipioPorCodigoIBGE(codigo) || '';
        } catch (e) {
            nome = '';
        }

        // 2) API do IBGE — cobre municípios de qualquer UF
        if (!nome && codigo.length >= 7) {
            try {
                const dados = await buscarMunicipioIBGE(codigo);
                nome = dados?.nome || '';
            } catch (e) {
                console.warn(`[SIGEO Script] Não foi possível obter o município do código IBGE ${codigo}:`, e?.message || e);
            }
        }

        _cacheMunicipiosIBGEPorCodigo.set(codigo, nome);
        return nome;
    }

    // Procura uma tag apenas DENTRO de um elemento pai (ignora prefixo de
    // namespace) — evita, por exemplo, pegar o município do endereço do
    // prestador quando o que se quer é o do bloco de serviço.
    function _valorTagDentroDe(xmlDoc, nomesPai, nomesFilho) {
        for (const pai of nomesPai) {
            const elementosPai = xmlDoc.getElementsByTagNameNS('*', pai);
            for (const elementoPai of elementosPai) {
                for (const filho of nomesFilho) {
                    const elementosFilho = elementoPai.getElementsByTagNameNS('*', filho);
                    if (elementosFilho.length > 0 && elementosFilho[0].textContent.trim()) {
                        return elementosFilho[0].textContent.trim();
                    }
                }
            }
        }
        return '';
    }

    /**
     * Localidade da prestação do serviço declarada no XML.
     * Cobre o padrão nacional da NFS-e (<serv><locPrest><cLocPrestacao>), o
     * ABRASF (<Servico><CodigoMunicipio>) e variantes que trazem o nome do
     * município por extenso. Retorna { codigo, nome }.
     */
    async function extrairLocalidadePrestacaoXML(xmlDoc, xmlText) {
        // 1) Código do município da prestação
        let codigo =
            _valorTagDentroDe(xmlDoc, ['locPrest', 'LocPrest', 'localPrestacao', 'LocalPrestacao'],
                              ['cLocPrestacao', 'cMunPrestacao', 'CodigoMunicipio', 'codigoMunicipio'])
            || extrairValorXML(xmlDoc, ['cLocPrestacao', 'CodigoMunicipioPrestacao',
                                        'CodigoMunicipioPrestacaoServico', 'MunicipioPrestacaoServico'])
            || _valorTagDentroDe(xmlDoc, ['Servico', 'servico', 'serv'],
                                 ['CodigoMunicipio', 'codigoMunicipio', 'cMunPrestacao'])
            || '';

        codigo = String(codigo).replace(/\D/g, '');

        let nome = codigo ? await nomeMunicipioPorCodigoIBGE(codigo) : '';

        // 2) Nome por extenso, quando o XML não traz código (ou ele não resolveu)
        if (!nome) {
            const textoNome =
                extrairValorXML(xmlDoc, ['xLocPrestacao', 'NomeMunicipioPrestacao', 'MunicipioPrestacao',
                                         'CidadePrestacao', 'LocalidadePrestacao'])
                || _valorTagDentroDe(xmlDoc, ['LocalPrestacao', 'localPrestacao', 'LocalidadePrestacao', 'locPrest'],
                                     ['Municipio', 'municipio', 'Cidade', 'cidade', 'NomeMunicipio', 'xMun'])
                || extrairTextoPorRegex(xmlText, /local(?:idade)?\s+d[ae]\s+presta[çc][ãa]o[^:<]*:\s*([^\n\r<;|]+)/i)
                || '';

            const limpo = String(textoNome || '').trim();
            if (limpo && !/^\d+$/.test(limpo)) {
                nome = municipioIBGEPorTexto(limpo) || limpo;
            }
        }

        // 3) Último recurso: município de incidência do ISSQN
        if (!nome) {
            const codigoIncidencia = String(
                extrairValorXML(xmlDoc, ['cLocIncid', 'MunicipioIncidencia']) || ''
            ).replace(/\D/g, '');
            if (codigoIncidencia) nome = await nomeMunicipioPorCodigoIBGE(codigoIncidencia);
        }

        return { codigo, nome: nome || '' };
    }

    function extrairValorXML(xmlDoc, possiveisNomes) {
        for (const nome of possiveisNomes) {
            const nomeLower = nome.toLowerCase();
            let elementos = [];

            // 🔍 Percorre todos os elementos do XML e compara o nome em minúsculas
            const todos = xmlDoc.getElementsByTagName('*');
            for (const el of todos) {
                const localName = (el.localName || el.baseName || el.tagName).toLowerCase();

                // compara ignorando case e eventuais prefixos de namespace (ns2:, ns3:, etc)
                const nomeSemPrefixo = localName.includes(':')
                    ? localName.split(':').pop()
                    : localName;

                if (nomeSemPrefixo === nomeLower && el.textContent) {
                    return el.textContent.trim();
                }
            }
        }

        return '';
    }


    /**
     * Normaliza a data vinda do XML para ISO (yyyy-mm-dd), aceitando:
     *  - ISO / ISO com hora  (padrão nacional: 2026-08-04T13:59:59-03:00)
     *  - dd-mm-aaaa          (padrão Ipatinga/meumunicipio: 11-08-2026)
     *  - dd/mm/aaaa
     */
    function normalizarDataXML(valor) {
        if (!valor) return valor;
        const s = String(valor).trim();
        if (/^\d{4}-\d{2}-\d{2}/.test(s)) return s;
        const m = s.match(/^(\d{2})[-\/](\d{2})[-\/](\d{4})/);
        if (m) return `${m[3]}-${m[2]}-${m[1]}`;
        return s;
    }

    // ─── Suporte à NFCom (modelo 62 — serviços de comunicação) ──────────────
    // Diferença estrutural que quebrava a leitura: na NFS-e as retenções vêm UMA
    // vez; na NFCom elas vêm REPETIDAS item a item (<det><imposto><retTrib>).
    // Como extrairValorXML devolve a PRIMEIRA ocorrência, a fatura de 141 itens
    // saía com a retenção do item 1 (ex.: 21,54) no lugar do total da nota.
    // Aqui, só para NFCom, somamos todas as ocorrências — dando preferência ao
    // grupo de totais quando ele existe, para nunca dobrar valor.
    function _ehNFCom(xmlDoc) {
        try {
            const raiz = xmlDoc?.documentElement;
            const nomeRaiz = String(raiz?.localName || raiz?.nodeName || '')
                .toLowerCase().replace(/^.*:/, '');
            if (nomeRaiz === 'nfcom' || nomeRaiz === 'infnfcom' || nomeRaiz === 'nfcomproc') return true;
            if (xmlDoc.getElementsByTagNameNS('*', 'infNFCom').length > 0) return true;
            return String(extrairValorXML(xmlDoc, ['mod'])).trim() === '62';
        } catch (e) {
            return false;
        }
    }

    function _elementosPorNomeLocal(xmlDoc, nome) {
        const alvo = String(nome).toLowerCase();
        return Array.from(xmlDoc.getElementsByTagName('*')).filter(el => {
            const local = String(el.localName || el.baseName || el.tagName || '').toLowerCase();
            return (local.includes(':') ? local.split(':').pop() : local) === alvo;
        });
    }

    // O elemento está dentro do bloco de TOTAIS da nota (e não de um item)?
    function _dentroDeTotaisXML(el) {
        for (let no = el.parentNode; no && no.nodeType === 1; no = no.parentNode) {
            const local = String(no.localName || no.nodeName || '').toLowerCase().replace(/^.*:/, '');
            if (local === 'total' || local === 'totais' || local === 'vrettribtot' || local === 'grettribtot') {
                return true;
            }
        }
        return false;
    }

    // Soma todas as ocorrências da primeira tag encontrada da lista.
    // Se alguma ocorrência estiver no bloco de totais, apenas ela é considerada.
    function _somarTagXML(xmlDoc, nomes) {
        for (const nome of nomes) {
            const elementos = _elementosPorNomeLocal(xmlDoc, nome);
            if (!elementos.length) continue;

            const nosTotais = elementos.filter(_dentroDeTotaisXML);
            const usar = nosTotais.length ? nosTotais : elementos;

            let soma = 0;
            let encontrou = false;
            usar.forEach(el => {
                const v = numeroDeTexto(el.textContent);
                if (v !== null) { soma += v; encontrou = true; }
            });

            if (encontrou) return arredondar2(soma);
        }
        return null;
    }

    /**
     * Extrai as retenções da nota fiscal a partir do XML.
     *
     * Regra acordada com a área: "Retenções Federais na NF" = IRRF + Contribuições
     * Sociais Retidas (PIS + COFINS + CSLL), somando campo a campo — nunca derivando
     * do total da nota — justamente para flagrar fornecedor que informa em campo errado.
     *
     * Padrões cobertos:
     *  - NFS-e nacional (sped/nfse): vRetCP, vRetIRRF, vRetCSLL, vRetPis, vRetCofins,
     *    vISSQN + tpRetISSQN (2/3 = retido). Alguns emitentes lançam PIS+COFINS+CSLL
     *    agregados em vRetCSLL; nesse caso vPis/vCofins do bloco <piscofins> são
     *    débito próprio e NÃO entram na soma (só entram quando as tags de retenção
     *    estão vazias e tpRetPisCofins indica retenção pelo tomador).
     *  - ABRASF / Ipatinga: ValorInss, ValorIr, ValorPis, ValorCofins, ValorCsll,
     *    ValorIssRetido ou ValorISS + ISSRetido.
     */
    function extrairRetencoesXML(xmlDoc) {
        const ehNFCom = _ehNFCom(xmlDoc);

        const num = (...nomes) => {
            // NFCom: retenção é lançada item a item — soma tudo (ou usa o total).
            if (ehNFCom) {
                const somado = _somarTagXML(xmlDoc, nomes);
                if (somado !== null) return somado;
            }
            for (const nome of nomes) {
                const v = numeroDeTexto(extrairValorXML(xmlDoc, [nome]));
                if (v !== null) return v;
            }
            return null;
        };
        const txt = (...nomes) => String(extrairValorXML(xmlDoc, nomes) || '').trim().toUpperCase();

        // vRetPrev (previdência) e vIRRF são a grafia da NFCom/NF-e; as demais
        // cobrem NFS-e nacional, ABRASF e Ipatinga.
        const inss = num('vRetCP', 'vRetPrev', 'ValorInss', 'ValorINSS', 'InssRetido');
        const irrf = num('vRetIRRF', 'vIRRF', 'ValorIr', 'ValorIR', 'ValorIrrf');

        let csll   = num('vRetCSLL', 'ValorCsll');
        let pis    = num('vRetPis', 'ValorPis');
        let cofins = num('vRetCofins', 'ValorCofins');

        // Só recorre ao bloco <piscofins> quando NENHUMA tag de retenção veio
        // preenchida — vários emitentes lançam PIS+COFINS+CSLL agregados em
        // vRetCSLL, e somar vPis/vCofins nesse caso duplicaria o valor.
        if (csll === null && pis === null && cofins === null && txt('tpRetPisCofins') === '3') {
            pis = num('vPis');
            cofins = num('vCofins');
        }

        // v11.40.35 — ABRASF: alguns emissores informam as contribuições sociais
        // retidas agrupadas em ValorCsll e PIS/COFINS de débito próprio em
        // ValorPis/ValorCofins. Só excluímos esses dois campos da soma quando
        // o próprio XML confirma, centavo a centavo, a interpretação agrupada.
        // Não se cria retenção por diferença, não se usa alíquota presumida e
        // não se altera NFCom, padrão nacional ou XML sem evidência suficiente.
        if (!ehNFCom && csll > 0 && pis !== null && cofins !== null &&
            pis >= 0 && cofins >= 0 && (pis > 0 || cofins > 0) &&
            !['vRetCSLL', 'vRetPis', 'vRetCofins'].some(tag => _elementosPorNomeLocal(xmlDoc, tag).length)) {
            const nome = el => String(el?.localName || el?.nodeName || '').toLowerCase().replace(/^.*:/, '');
            const blocos = _elementosPorNomeLocal(xmlDoc, 'Valores').filter(el =>
                nome(el.parentNode) === 'servico' && nome(el.parentNode.parentNode) === 'infnfse');
            if (blocos.length === 1) {
                const filhos = Array.from(blocos[0].children || []);
                const campo = tag => {
                    const els = filhos.filter(el => nome(el) === tag.toLowerCase());
                    return els.length === 1 ? els[0].textContent.trim() : '';
                };
                const valor = tag => numeroDeTexto(campo(tag));
                const bruto = valor('ValorServicos');
                const liquido = valor('ValorLiquidoNfse');
                const ir = valor('ValorIr');
                const prev = valor('ValorInss');
                const flagISS = campo('IssRetido').toUpperCase();
                const iss = ['2', 'N', 'NAO', 'NÃO', 'FALSE'].includes(flagISS) ? 0
                    : ['1', 'S', 'SIM', 'TRUE'].includes(flagISS)
                        ? (valor('ValorIssRetido') ?? valor('ValorIss')) : null;
                const semOutrosAjustes = ['ValorDeducoes', 'OutrasRetencoes',
                    'DescontoIncondicionado', 'DescontoCondicionado'].every(tag => {
                    const v = valor(tag);
                    return v === 0 || (v === null && !filhos.some(el => nome(el) === tag.toLowerCase()));
                });
                const cent = v => Math.round(v * 100);
                if (semOutrosAjustes && [bruto, liquido, ir, prev, iss].every(v => v !== null && v >= 0) &&
                    bruto > 0 && liquido <= bruto &&
                    ir === irrf && prev === inss && valor('ValorCsll') === csll &&
                    valor('ValorPis') === pis && valor('ValorCofins') === cofins) {
                    const retencaoTotal = cent(bruto) - cent(liquido);
                    const agrupada = cent(ir) + cent(prev) + cent(iss) + cent(csll);
                    const separada = agrupada + cent(pis) + cent(cofins);
                    if (retencaoTotal === agrupada && retencaoTotal !== separada) {
                        pis = null;
                        cofins = null;
                        logDebug('[SIGEO] XML ABRASF: contribuições sociais agrupadas confirmadas pelo líquido da NF.');
                    }
                }
            }
        }

        const partesSociais = [csll, pis, cofins].filter(v => v !== null);
        const contribuicoesSociais = partesSociais.length
            ? arredondar2(partesSociais.reduce((a, b) => a + b, 0))
            : null;

        const federais = (irrf === null && contribuicoesSociais === null)
            ? null
            : arredondar2((irrf || 0) + (contribuicoesSociais || 0));

        // ISSQN: sempre o valor RETIDO.
        const issqnApurado = num('vISSQN', 'ValorISS', 'ValorIss');
        const valorIssRetido = num('ValorIssRetido');
        const tpRetISSQN = txt('tpRetISSQN');
        const flagRetido = txt('ISSRetido', 'IssRetido');

        let issqnRetido = null;
        if (valorIssRetido !== null) {
            issqnRetido = valorIssRetido;
        } else if (tpRetISSQN === '2' || tpRetISSQN === '3') {
            issqnRetido = issqnApurado;
        } else if (['SIM', 'S', '1', 'TRUE'].includes(flagRetido)) {
            issqnRetido = issqnApurado;
        } else if (tpRetISSQN === '1' || ['NAO', 'NÃO', 'N', '2', 'FALSE'].includes(flagRetido)) {
            issqnRetido = 0;
        }

        // Base de cálculo do ISSQN: no padrão nacional é o <vBC> irmão do <vISSQN>
        // (existe outro <vBC> no bloco IBSCBS, que NÃO serve); nos demais padrões,
        // vem em ValorBase/BaseCalculo.
        let baseISSQN = null;
        const elISSQN = Array.from(xmlDoc.getElementsByTagName('*'))
            .find(el => (el.localName || el.nodeName || '').toLowerCase().replace(/^.*:/, '') === 'vissqn');
        if (elISSQN && elISSQN.parentNode) {
            const irmao = Array.from(elISSQN.parentNode.children || [])
                .find(el => (el.localName || el.nodeName || '').toLowerCase().replace(/^.*:/, '') === 'vbc');
            if (irmao) baseISSQN = numeroDeTexto(irmao.textContent);
        }
        if (baseISSQN === null) baseISSQN = num('ValorBase', 'BaseCalculo', 'ValorBaseCalculo', 'BaseCalculoISS');

        return {
            inss, irrf, contribuicoesSociais, federais,
            issqnApurado, issqnRetido, baseISSQN,
            origem: 'xml',
            modelo: ehNFCom ? 'NFCom' : ''
        };
    }

    function interceptarNavegacaoSPA() {
        const originalOpen = XMLHttpRequest.prototype.open;
        const originalSend = XMLHttpRequest.prototype.send;

        XMLHttpRequest.prototype.open = function (method, url) {
            this._url = url;
            this._method = method;

            if (url.includes('https://api.sigeo.jt.jus.br/sidof-service/documentosFiscais/jt?pageSize=')) {

                const urlObj = new URL(url, window.location.origin);
                const params = urlObj.searchParams;
                if (params.has('pageSize')) {
                    let campoPageSize = document.querySelector('mat-select')?.textContent || '';

                    logDebug(`Capturada requisição de documentos fiscais com url=${url} e campo pageSize = `, campoPageSize);

                    params.set('pageSize', campoPageSize);
                    url = urlObj.toString();
                    this._url = url;
                    logDebug('[SIGEO] Nova URL:', url);
                }

            }
            return originalOpen.call(this, method, url, arguments);
        };

        XMLHttpRequest.prototype.send = function (body) {
            const url = this._url;

            // Detectar requisições de mudança de tela
            if (url && url.includes('/menu/path/jt?sistema=SIDOF&path=/')) {
                this.addEventListener('load', function () {
                    if (this.status === 200) {
                        // Extrair nome da tela da URL
                        const match = url.match(/path=\/([^&]+)/);
                        const nomeTela = match ? match[1] : 'desconhecida';

                        logDebug(`[SIGEO] 🔄 Navegação detectada para tela: ${nomeTela}`);
                        logDebug(`[SIGEO] URL completa: ${url}`);


                        if (nomeTela.toLowerCase().includes('documentosFiscaisUG'.toLowerCase())) {
                            setTimeout(() => {
                                logDebug(`Iniciando robô na tela de documentos fiscais.`);

                                carregarTabelaIBGE();
                                let processamento = new ProcessamentoDocsFiscais(document);
                                processamento.inicializarControleOpcoes();
                                window._sigeoProcessamento = processamento;
                                adicionarFiltroDataAteste();
                            }, 500);
                        }
                    }
                });
            }

            if (!this._sigeoListenerAdicionado) {
                this._sigeoListenerAdicionado = true;

                this.addEventListener('load', function () {
                    if (typeof this._url === 'string' && this._url.includes('/protocol/openid-connect/token') && this.status === 200) {
                        const ct = this.getResponseHeader('content-type') || '';
                        if (ct.includes('application/json')) {
                            try {
                                const jsonResp = JSON.parse(this.responseText);
                                if (jsonResp.access_token) {
                                    BEARER_TOKEN = jsonResp.access_token;
                                    if (BEARER_TOKEN) {
                                        logDebug('[SIGEO] Token Bearer capturado via send');
                                    }
                                    else {
                                        logDebug('[SIGEO] Token Bearer vazio via send');
                                    }
                                }
                            } catch (e) {
                                console.error('[SIGEO] Erro ao avaliar token:', e);
                            }
                        }
                    }
                }, false);
            }
            return originalSend.apply(this, arguments);
        }
    }


    interceptarNavegacaoSPA();
    ajustarOpçõesAdicionais();

    // ── Interceptação antecipada da tabela ──────────────────────────────────
    // Instala o listener XHR para /sidof-service/documentosFiscais/jt
    // ANTES de qualquer navegação, para nunca perder a primeira resposta.
    (function interceptacaoAntecipada() {
        const URL_TABELA = '/sidof-service/documentosFiscais/jt';
        const _origOpen = XMLHttpRequest.prototype.open;
        XMLHttpRequest.prototype.open = function (method, url) {
            if (typeof url === 'string' && url.includes(URL_TABELA)) {
                this.addEventListener('load', function () {
                    try {
                        if (this.status === 200 && (this.getResponseHeader('content-type') || '').includes('application/json')) {
