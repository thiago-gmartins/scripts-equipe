                        valorIss: extrairValorXML(xmlDoc, ['ValorIss']),
                        valorIssRetido: extrairValorXML(xmlDoc, ['ValorIssRetido']),
                        baseCalculo: extrairValorXML(xmlDoc, ['BaseCalculo']),
                        aliquota: extrairValorXML(xmlDoc, ['Aliquota', 'aliquota', 'alíquota', 'Alíquota', 'pAliqAplic']),
                        valorLiquidoNfse: extrairValorXML(xmlDoc, ['ValorLiquidoNfse']),
                    },
                    itemListaServico: extrairValorXML(xmlDoc, ['ItemListaServico']),
                    codigoTributacaoMunicipio: extrairValorXML(xmlDoc, ['CodigoTributacaoMunicipio']),
                    discriminacao: extrairValorXML(xmlDoc, ['Discriminacao'])
                },
                descricaoServico: extrairValorXML(xmlDoc, ['xDescServ', 'Discriminacao', 'DiscriminacaoServico', 'DescricaoServico']),
                localPrestaçãoServiço: extrairTextoPorRegex(xmlText, /local(?:\s+da\s+presta[çc]?[ãa]?o)?(?:\s+dos?\s+servi[çc]os?)?:\s*(.+?)(?:\n|$)/i),
                material: extrairTextoPorRegex(xmlText, /m\s*a\s*t\s*e\s*r\s*i\s*a\s*[l|i]\s*s?[^:=]*[:=]\s*r?\s*\$?\s*(\d{1,3}(?:[\.\s]\d{3})*(?:[.,]\d{2}))/i),
                // Retenções da NF (INSS, IRRF + contribuições sociais e ISSQN retido),
                // cobrindo padrão nacional (sped/nfse), ABRASF e Ipatinga/meumunicipio.
                retencoes: extrairRetencoesXML(xmlDoc),
                xmlCompleto: xmlText,
            };

            // Normaliza a data para ISO — o padrão Ipatinga entrega "11-08-2026" (dd-mm-aaaa).
            dadosXML.dataEmissao = normalizarDataXML(dadosXML.dataEmissao);

            // Localidade da prestação: nome do município (via código IBGE do XML
            // ou, na falta dele, pelo nome informado na própria nota).
            try {
                const localidade = await extrairLocalidadePrestacaoXML(xmlDoc, xmlText);
                dadosXML.codigoMunicipioPrestacao = localidade.codigo;
                dadosXML.localidadePrestacao = localidade.nome;
            } catch (e) {
                console.warn('[SIGEO Script] Falha ao extrair a localidade da prestação do XML:', e);
                dadosXML.codigoMunicipioPrestacao = '';
                dadosXML.localidadePrestacao = '';
            }

            if (dadosXML.material) {
                const valor = dadosXML.material
                    .replace(/\./g, '')   // remove milhares
                    .replace(',', '.');   // vírgula como decimal
                dadosXML.material = parseFloat(valor);
            }
            logDebug('[SIGEO Script] XML processado:', dadosXML);
            return dadosXML;
        } catch (error) {
            console.error('[SIGEO Script] Erro ao processar XML:', error);
            return null;
        }
    }

