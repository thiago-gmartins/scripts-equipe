  function bgLocalizarLinhaPorProad(doc, proadNormalizado) {
    if (!proadNormalizado) return null;
    const rows = Array.from(doc.querySelectorAll('mat-row, tr'));

    // 1ª passagem: busca exata normalizada (mais confiável)
    for (const row of rows) {
      const txt = bgTexto(row);
      if (!txt) continue;
      if (normalizarProad(txt).includes(proadNormalizado)) return row;
    }

    // 2ª passagem: tolerância a formatações alternativas
    // Ex: "3942/2026" pode aparecer como "3942/26", "03942/2026", "PROAD3942/2026" etc.
    const [numero, ano] = proadNormalizado.split('/');
    if (numero && ano) {
      const anoAbreviado = ano.slice(-2); // "2026" → "26"
      for (const row of rows) {
        const txt = normalizarProad(bgTexto(row));
        if (!txt) continue;
        // Tenta número/ano e número/anoAbreviado
        if (txt.includes(`${numero}/${ano}`) || txt.includes(`${numero}/${anoAbreviado}`)) return row;
        // Tenta com zeros à esquerda removidos
        if (txt.includes(`${parseInt(numero,10)}/${ano}`) || txt.includes(`${parseInt(numero,10)}/${anoAbreviado}`)) return row;
      }
    }

    return null;
  }

