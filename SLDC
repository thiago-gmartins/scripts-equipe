  function init() {
    registrarListenerTabelaAutonomos();
    iniciarMonitorDOM();

    // Expõe a função no escopo externo para que o script principal
    // possa chamá-la ao marcar/desmarcar checkboxes
    window._sigeoAutonomoControlar = controlarExibicaoBotoesAutonomo;
    window._sigeoAutonomoRemover  = removerBotaoAutonomos;

    // ── Recuperação imediata ────────────────────────────────────────────────
    // Se a interceptação antecipada já capturou os dados da tabela antes deste
    // módulo ser inicializado, alimenta autonomosDadosTabela agora mesmo.
    if (Array.isArray(window._sigeoUltimosDadosTabela) && window._sigeoUltimosDadosTabela.length > 0) {
      autonomosDadosTabela = window._sigeoUltimosDadosTabela;
      autonomosLog('Dados recuperados imediatamente de _sigeoUltimosDadosTabela:', autonomosDadosTabela.length);
    }

    // Sempre que a tabela for (re)carregada pelo script principal, sincroniza
    window.addEventListener('_sigeoTabelaAtualizada', function (e) {
      if (Array.isArray(e.detail?.results)) {
        autonomosDadosTabela = e.detail.results;
        autonomosLog('Tabela sincronizada via _sigeoTabelaAtualizada:', autonomosDadosTabela.length);
        adicionarListenerCheckboxes();
        controlarExibicaoBotoesAutonomo();
      }
    });

    // Polling agora é tratado por iniciarMonitorDOM() acima

    // Detecta navegação SPA (pushState / popstate / hashchange)
    const _originalPushState = history.pushState.bind(history);
    history.pushState = function (...args) {
      _originalPushState(...args);
      setTimeout(() => { adicionarListenerCheckboxes(); controlarExibicaoBotoesAutonomo(); }, 800);
    };
    window.addEventListener('popstate', () => {
      setTimeout(() => { adicionarListenerCheckboxes(); controlarExibicaoBotoesAutonomo(); }, 800);
    });
    window.addEventListener('hashchange', () => {
      setTimeout(() => { adicionarListenerCheckboxes(); controlarExibicaoBotoesAutonomo(); }, 800);
    });

    autonomosLog('Script 6.1.2 carregado.');
  }

  init();
    })(); // fim initModuloAutonomos

})();


function adicionarNovasOpçõesQuantidadeRegistros(descriptor) {
    logDebug('🔍 Interceptado pageSizeOptions', descriptor);

    if (descriptor.get || descriptor.set) {
        const originalSet = descriptor.set;

        let opcoesInternas = [5, 10, 15, 20, 50, 100, 200];

        descriptor.get = function () {
            return opcoesInternas;
        };

        descriptor.set = function (value) {
            logDebug('📝 pageSizeOptions SET chamado com:', value);

            // Se tentar setar [5,10,15,20], adicionar mais opções
            if (Array.isArray(value) && value.length === 4 && value[0] === 5) {
                logDebug('⚠️ Expandindo opções de', value, 'para incluir 50, 100, 200');
                opcoesInternas = [5, 10, 15, 20, 50, 100, 200];
            } else {
                opcoesInternas = value;
            }

            if (originalSet) {
                originalSet.call(this, opcoesInternas);
            }
        };
    }
    else if ('value' in descriptor && Array.isArray(descriptor.value)) {
        if (descriptor.value.length === 4 && descriptor.value[0] === 5) {
            logDebug('✅ Alterando pageSizeOptions value');
            descriptor.value = [5, 10, 15, 20, 50, 100, 200];
        }
    }
    return descriptor;
}

function ajustarValorPadrãoQuantidadeRegistros(descriptor) {
    logDebug('🔍 Interceptado pageSize', descriptor);

    const VALOR_PADRAO_PAGESIZE = 20;

    // Se tem getter/setter
    if (descriptor.get || descriptor.set) {
        const originalSet = descriptor.set;

        let valorInterno = VALOR_PADRAO_PAGESIZE; // Valor padrão que queremos

        // Sobrescrever getter
        descriptor.get = function () {
            return valorInterno;
        };

        // Sobrescrever setter
        descriptor.set = function (value) {
            logDebug('📝 pageSize SET chamado com valor:', value);

            // Se tentar setar 5, bloqueia e mantém o valor atual
            if (value === 5) {
                logDebug('⚠️ Bloqueado! Mantendo', valorInterno, 'ao invés de', value);
            } else {
                valorInterno = value;
            }

            // Chamar setter original se existir
            if (originalSet) {
                originalSet.call(this, valorInterno);
            }
        };
        return descriptor;
    }

    // Se usa 'value' direto
    if ('value' in descriptor && descriptor.value === 5) {
        logDebug('✅ Alterando pageSize value de', descriptor.value, 'para', VALOR_PADRAO_PAGESIZE);
        descriptor.value = VALOR_PADRAO_PAGESIZE;
    }
    return descriptor;
}

