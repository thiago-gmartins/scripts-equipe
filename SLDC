  /**
   * Extrai o valor interno de um mat-select via contexto Angular (__ngContext__).
   * Isso lê o FormControl diretamente, independente de renderização do DOM.
   * Funciona mesmo com OnPush / lazy rendering / produção (sem ng-reflect-value).
   */
  function bgLerValorAngularSelect(el) {
    if (!el) return null;

    try {
      // Angular 9+: __ngContext__ é um array; o componente fica em índices variáveis
      const ctx = el.__ngContext__;
      if (ctx) {
        // Percorre o contexto procurando o MatSelect com propriedade 'value'
        for (let i = 0; i < ctx.length; i++) {
          const node = ctx[i];
          if (!node || typeof node !== 'object') continue;
          // MatSelect tem _value ou value
          if ('_value' in node && node._value !== undefined && node._value !== null) {
            return node._value;
          }
          if ('value' in node && node.value !== undefined && node.value !== null
              && typeof node.value !== 'function') {
            return node.value;
          }
        }
      }
    } catch(e) {}

    // Fallback Angular ivy: __ngContext__ pode ser o LView diretamente
    try {
      const lView = el.__ngContext__;
      if (Array.isArray(lView)) {
        const componentIdx = lView.findIndex(
          n => n && typeof n === 'object' && ('_value' in n || ('value' in n && typeof n.value !== 'function'))
        );
        if (componentIdx >= 0) {
          const comp = lView[componentIdx];
          return comp._value ?? comp.value ?? null;
        }
      }
    } catch(e) {}

    return null;
  }

  /**
   * Lê o valor de um mat-select pelo formcontrolname dentro do modal.
   * Busca em TODOS os mat-tab-body do modal (o iframe é oculto, então
   * getBoundingClientRect retorna zero para todos — visibilidade não funciona).
   * Por isso buscamos pelo nome do campo, que é estável.
   */
  function bgLerSelectPorFormControl(modal, formControlName) {
    // Lista de possíveis nomes para cada campo (variações do sistema)
    const aliases = {
      tipoAtividade:    ['tipoAtividadeContratacao', 'tipoAtividade', 'tipo_atividade'],
      ehServidorFederal:['servidorPublicoFederal', 'ehServidorFederal', 'servidorFederal', 'isServidorFederal'],
      situacao:         ['situacaoServidorFederal', 'situacao', 'situação', 'status']
    };

    const nomes = aliases[formControlName] || [formControlName];

    for (const nome of nomes) {
      const el = modal.querySelector(
        `mat-select[formcontrolname="${nome}"], mat-select[ng-reflect-name="${nome}"], ` +
        `select[formcontrolname="${nome}"], select[ng-reflect-name="${nome}"]`
      );
      if (!el) continue;

      // Estratégia 1: __ngContext__ — independe de renderização
      const valorAngular = bgLerValorAngularSelect(el);
      if (valorAngular !== null && valorAngular !== undefined && String(valorAngular).trim()) {
        const txt = typeof valorAngular === 'object'
          ? (valorAngular.nome || valorAngular.name || valorAngular.descricao ||
             valorAngular.label || valorAngular.value || JSON.stringify(valorAngular))
          : String(valorAngular);
        if (txt.trim()) {
          autonomosLog(`bgLerSelectPorFormControl [${nome}] via __ngContext__:`, txt.trim());
          return txt.trim();
        }
      }

      // Estratégia 2: texto visível no trigger
      const txt = bgTextoSelect(el);
      if (txt) {
        autonomosLog(`bgLerSelectPorFormControl [${nome}] via trigger DOM:`, txt);
        return txt;
      }
    }

    // Nenhum nome encontrou — dump de todos os mat-select do modal para diagnóstico
    autonomosWarn(`bgLerSelectPorFormControl [${formControlName}] NAO encontrado. Todos os selects do modal:`);
    modal.querySelectorAll('mat-select, select').forEach((el, i) => {
      const fc = el.getAttribute('formcontrolname') || el.getAttribute('ng-reflect-name') || '(sem fc)';
      autonomosWarn(`  [${i}] fc="${fc}" texto="${bgTextoSelect(el)}"`);
    });

    return '';
  }

